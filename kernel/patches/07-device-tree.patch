+			MX50_PAD_KEY_ROW1__GPIO4_3 0xc4
+			MX50_PAD_KEY_ROW2__GPIO4_5 0xc4
+			MX50_PAD_KEY_ROW3__GPIO4_7 0xc4
+			MX50_PAD_KEY_COL0__GPIO4_0 0xc4
+			MX50_PAD_KEY_COL1__GPIO4_2 0xc4
+			MX50_PAD_KEY_COL2__GPIO4_4 0xc4
+			MX50_PAD_KEY_COL3__GPIO4_6 0xc4
