+// SPDX-License-Identifier: GPL-2.0+
+/* Kindle 4 NT D01100 LPDDR1: flat accepted board configuration.
+ * Fragment order and labels deliberately preserve the cold-accepted DTB.
+ * Historical staged sources are local under porting/dts-archive.
+ */
+
+/* Board fragment: imx50-kindle-k4.dts */
+// Initial boot-only device tree for Kindle 4 / Yoshi (D01100).
+// Board peripherals are deliberately added only after they are verified.
+
+
+#include "imx50.dtsi"
+
+/ {
+	model = "Amazon Kindle 4 (Yoshi)";
+	compatible = "amazon,kindle-4", "fsl,imx50";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@70000000 {
+		device_type = "memory";
+		reg = <0x70000000 0x10000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* Regions claimed by the 2.6.31 UIO platform device. */
+		legacy-uio@75000000 {
+			reg = <0x75000000 0x10000>;
+			no-map;
+		};
+
+		legacy-uio@75020000 {
+			reg = <0x75020000 0x16000>;
+			no-map;
+		};
+
+		/* Amazon watchdog reboot log: last two pages of 256 MiB RAM. */
+		watchdog-log@7fffe000 {
+			reg = <0x7fffe000 0x2000>;
+			no-map;
+		};
+	};
+};
+
+&iomuxc {
+	pinctrl_uart1_yoshi: uart1-yoshi-grp {
+		fsl,pins = <
+			MX50_PAD_UART1_TXD__UART1_TXD_MUX 0x1e4
+			MX50_PAD_UART1_RXD__UART1_RXD_MUX 0x1e4
+		>;
+	};
+};
+
+&uart1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart1_yoshi>;
+	status = "okay";
+};
+
+/* Keep the already-running hardware watchdog as the RAM-test fallback. */
+&wdog1 {
+	status = "disabled";
+};
+
+/* Stock mx50_yoshi_gpio.c:1040-1046: non-FINKLE accessory TX idle low. */
+&iomuxc {
+	pinctrl_accessory_tx_idle: accessory-tx-idle-grp {
+		fsl,pins = <MX50_PAD_UART4_TXD__GPIO6_16 0xc4>;
+	};
+};
+
+&gpio6 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_accessory_tx_idle>;
+	accessory-tx-idle-hog {
+		gpio-hog;
+		gpios = <16 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "accessory-tx-idle";
+	};
+};
+
+/* Board fragment: imx50-kindle-k4-usb.dts */
+// RAM-only USB serial probe. Keep the minimal board DTS as a separate target.
+
+
+/ {
+	model = "Amazon Kindle 4 (Yoshi, USB serial probe)";
+};
+
+&usbotg {
+	dr_mode = "peripheral";
+	phy_type = "utmi_wide";
+	disable-over-current;
+	/* Stock writes O_PWR_POL=1; its low-active comment is inaccurate. */
+	power-active-high;
+	status = "okay";
+};
+
+/* Board fragment: imx50-kindle-k4-pmic-bus.dts */
+// RAM-only probe: enable K4 CSPI pins without creating a PMIC SPI device.
+
+
+/ {
+	model = "Amazon Kindle 4 (Yoshi, PMIC bus probe)";
+};
+
+&iomuxc {
+	pinctrl_cspi_pmic: cspi-pmic-grp {
+		fsl,pins = <
+			MX50_PAD_CSPI_SCLK__CSPI_SCLK 0xc4
+			MX50_PAD_CSPI_MOSI__CSPI_MOSI 0xc4
+			MX50_PAD_CSPI_MISO__CSPI_MISO 0xc4
+			MX50_PAD_CSPI_SS0__CSPI_SS0 0x00
+		>;
+	};
+
+	pinctrl_pmic_irq: pmic-irq-grp {
+		fsl,pins = <
+			/* Old Yoshi pin setup: hysteresis, 100K pull-down. */
+			MX50_PAD_UART1_CTS__GPIO6_8 0x1c4
+		>;
+	};
+};
+
+&cspi {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_cspi_pmic>;
+	status = "okay";
+};
+
+/* Board fragment: imx50-kindle-k4-pmic-mfd.dts */
+// RAM-only probe of the MC13892 MFD core. Regulator supplies are added later.
+
+
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	model = "Amazon Kindle 4 (Yoshi, PMIC MFD probe)";
+};
+
+&cspi {
+	pmic@0 {
+		compatible = "amazon,kindle-k4-mc13892", "fsl,mc13892";
+		reg = <0>;
+		spi-max-frequency = <2000000>;
+		spi-cs-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_pmic_irq>;
+		interrupts-extended = <&gpio6 8 IRQ_TYPE_LEVEL_HIGH>;
+	};
+};
+
+/* Board fragment: imx50-kindle-k4-pmic-regulator.dts */
+// RAM-only registration probe of the K4's critical MC13892 rails.
+
+
+/ {
+	model = "Amazon Kindle 4 (Yoshi, PMIC regulator probe)";
+};
+
+&cspi {
+	pmic@0 {
+		regulators {
+			/* Constraints from the old Yoshi board data; retain boot voltages. */
+			sw1_reg: sw1 {
+				regulator-name = "k4-cpu-sw1";
+				regulator-min-microvolt = <600000>;
+				regulator-max-microvolt = <1375000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			sw2 {
+				regulator-name = "k4-sw2";
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <1850000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			sw3 {
+				regulator-name = "k4-sw3";
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <1850000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			viohi {
+				regulator-name = "k4-viohi";
+				regulator-min-microvolt = <2775000>;
+				regulator-max-microvolt = <2775000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vpll {
+				regulator-name = "k4-vpll";
+				regulator-min-microvolt = <1050000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vdig {
+				regulator-name = "k4-vdig";
+				/* Measured selector is 1.25 V; old 1.20 V is unavailable. */
+				regulator-min-microvolt = <1050000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vgen2 {
+				regulator-name = "k4-vgen2";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <3150000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vusb2 {
+				regulator-name = "k4-vusb2";
+				regulator-min-microvolt = <2400000>;
+				regulator-max-microvolt = <2775000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			vusb {
+				regulator-name = "k4-vusb";
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			/* Off in the measured baseline; old Yoshi uses it for audio. */
+			vgen1 {
+				regulator-name = "k4-vgen1-audio";
+			};
+		};
+	};
+};
+
+/* Board fragment: imx50-kindle-k4-emmc-id.dts */
+// RAM-only eMMC identification; the initramfs never mounts eMMC partitions.
+
+
+/ {
+	model = "Amazon Kindle 4 (Yoshi, eMMC ID probe)";
+};
+
+&iomuxc {
+	pinctrl_emmc_yoshi: emmc-yoshi-grp {
+		fsl,pins = <
+			/* CMD and CLK retain the old board's SION setting. */
+			MX50_PAD_SD3_CMD__ESDHC3_CMD 0x400001e4
+			MX50_PAD_SD3_CLK__ESDHC3_CLK 0x400000d4
+			MX50_PAD_SD3_D0__ESDHC3_DAT0 0x1d4
+			MX50_PAD_SD3_D1__ESDHC3_DAT1 0x1d4
+			MX50_PAD_SD3_D2__ESDHC3_DAT2 0x1d4
+			MX50_PAD_SD3_D3__ESDHC3_DAT3 0x1d4
+			MX50_PAD_SD3_D4__ESDHC3_DAT4 0x1d4
+			MX50_PAD_SD3_D5__ESDHC3_DAT5 0x1d4
+			MX50_PAD_SD3_D6__ESDHC3_DAT6 0x1d4
+			MX50_PAD_SD3_D7__ESDHC3_DAT7 0x1d4
+		>;
+	};
+};
+
+&esdhc3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_emmc_yoshi>;
+	bus-width = <8>;
+	non-removable;
+	no-1-8-v;
+	cap-mmc-highspeed;
+	max-frequency = <40000000>;
+	status = "okay";
+};
+
+/* Board fragment: imx50-kindle-k4-sdio-id.dts */
+// RAM-only SDIO enumeration; Wi-Fi power is inherited from the old kernel.
+
+
+/ {
+	model = "Amazon Kindle 4 (Yoshi, SDIO ID probe)";
+};
+
+&iomuxc {
+	pinctrl_sdio_yoshi: sdio-yoshi-grp {
+		fsl,pins = <
+			/* Old SD2 pad settings, including SION on CMD and CLK. */
+			MX50_PAD_SD2_CMD__ESDHC2_CMD 0x400001e6
+			MX50_PAD_SD2_CLK__ESDHC2_CLK 0x400001d6
+			MX50_PAD_SD2_D0__ESDHC2_DAT0 0x1d6
+			MX50_PAD_SD2_D1__ESDHC2_DAT1 0x1d6
+			MX50_PAD_SD2_D2__ESDHC2_DAT2 0x1d6
+			MX50_PAD_SD2_D3__ESDHC2_DAT3 0x1e6
+		>;
+	};
+};
+
+&esdhc2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_sdio_yoshi>;
