+		wrf-firmware = "amazon/k4/panel-stock.wrf";
+	};
+};
+
+/* Board fragment: imx50-kindle-k4-fb.dts */
+/ {
+	model = "Amazon Kindle 4 (Tequila, EPDC framebuffer)";
+
+	/* Keep the SRTC primary when the PMIC child probes. */
+	aliases {
+		rtc0 = &srtc;
+		rtc1 = &k4_fb_pmic;
+	};
+
+	framebuffer {
+		compatible = "amazon,k4-epdc-fb";
+		epdc = <&epdc>;
+		update-delay-ms = <100>;
+		idle-delay-ms = <500>;
+	};
+};
+
+/* Keep the original Tequila RF configuration in the integrated display board. */
+&esdhc2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	wifi@1 {
+		compatible = "atheros,ath6kl";
+		reg = <1>;
+		/* Original Tequila: idle ms, RSSI delta, enable, rate threshold. */
+		atheros,antenna-diversity-parameters = <10000 3 1 36>;
+	};
+};
+
+/* Keep the validated charge ceiling and source detection in the fb board. */
+&cspi {
+	k4_fb_pmic: pmic@0 {
+		fsl,mc13xxx-uses-rtc;
+	};
+};
+
+&k4_charger {
+	/* Original Tequila wall ceiling; USB budget separately caps the DAC. */
+	amazon,max-charge-current-microamp = <480000>;
+	amazon,usb-current-reserve-microamp = <60000>;
+	amazon,charger-detect-supply = <&charger_detector>;
+};
+
+/* The USB controller orders this rail before clocks and after child teardown. */
+&cspi {
+	pmic@0 {
+		regulators {
+			k4_vusb2: vusb2 {
+				/delete-property/ regulator-always-on;
+				/* Original Tequila code waits 10 ms after enable. */
+				regulator-enable-ramp-delay = <10000>;
+			};
+		};
+	};
+};
+
+&usbotg {
+	phy-supply = <&k4_vusb2>;
+};
+
+/* Board fragment: imx50-kindle-k4-panel-flash.dts */
+/ {
+	model = "Amazon Kindle 4 (Tequila, panel Flash read only)";
+};
+
+&iomuxc {
+	pinctrl_k4_panel_flash: k4-panel-flash {
+		fsl,pins = <
+			MX50_PAD_ECSPI2_SCLK__ECSPI2_SCLK 0x0c4
+			MX50_PAD_ECSPI2_MOSI__ECSPI2_MOSI 0x0c4
+			MX50_PAD_ECSPI2_MISO__ECSPI2_MISO 0x1c4
+			MX50_PAD_ECSPI2_SS0__ECSPI2_SS0 0x0e4
+		>;
+	};
+};
+
+&ecspi2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_k4_panel_flash>;
+	status = "okay";
+
+	panel_flash: panel-flash@0 {
+		compatible = "amazon,kindle-panel-flash";
+		reg = <0>;
+		spi-max-frequency = <1000000>;
+	};
+};
+
+/* Board fragment: imx50-kindle-k4-panel-waveform.dts */
+/ {
+	model = "Amazon Kindle 4 (Tequila, factory WBF metadata)";
+};
+
+&epdc {
+	/delete-property/ wbf-firmware;
+	nvmem = <&panel_flash>;
+	nvmem-names = "wbf";
+	/* Original flash layout: WBF ends before panel calibration at 0x30000. */
+	wbf-nvmem-offset = <0x886>;
+	wbf-nvmem-size = <0x2f77a>;
+};
+
+/* Board fragment: imx50-kindle-k4-panel-decoder.dts */
+/ {
+	model = "Amazon Kindle 4 (Tequila, decoded factory WBF)";
+};
+
+&epdc {
+	/delete-property/ wrf-firmware;
+	wbf-decode;
+};
+
+/* Board fragment: imx50-kindle-k4-display-stop.dts */
+/ {
+	model = "Amazon Kindle 4 (Tequila, display and SRAM STOP)";
+};
+
+&pm {
+	status = "okay";
+	fsl,stop-with-ocram;
+	fsl,srpg-in-stop;
+	fsl,oscillator-startup-cycles = <256>;
+	clocks = <&clks IMX5_CLK_GPC_DVFS>, <&clks IMX5_CLK_EMI_SLOW_GATE>;
+	clock-names = "gpc", "weim";
+};
+
+&soc {
+	ocram_probe: ocram-probe@53fd4000 {
+		compatible = "fsl,imx50-ocram-probe";
+		reg = <0x53fd4000 0x1000>, <0x14000000 0x1000>, <0x63f80000 0x1000>;
+		reg-names = "ccm", "databahn", "pll1";
+		sram = <&ocram_code>, <&ocram_data>, <&ocram_tables>;
+	};
+
+	/* Inherit sys_clk_root and CCGR6 CG1; probe checks the gate before use. */
+	sram@f8000000 {
+		compatible = "mmio-sram";
+		reg = <0xf8000000 0x20000>;
+		ranges = <0 0xf8000000 0x20000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		ocram_tables: tables-sram@0 {
+			reg = <0 0x8000>;
+			pool;
+		};
+
+		ocram_code: code-sram@1e000 {
+			reg = <0x1e000 0x1000>;
+			protect-exec;
+		};
+		ocram_data: data-sram@1f000 {
+			reg = <0x1f000 0x1000>;
+			pool;
+		};
+	};
+};
+
+/* Board fragment: imx50-kindle-k4-display-vstby.dts */
+/ {
+	model = "Amazon Kindle 4 (Tequila, display and retained-LDO VSTBY)";
+};
+
+&sw1_reg {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-suspend-microvolt = <850000>;
+	};
+};
+
+&cspi {
+	pmic@0 {
+		regulators {
+			sw2 {
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <950000>;
+				};
+			};
+			sw3 {
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <950000>;
+				};
+			};
+		};
+	};
+};
+
+&cspi {
+	k4_display_standby_pmic: pmic@0 { };
+};
+
+&pm {
+	amazon,standby-pmic = <&k4_display_standby_pmic>;
+	amazon,standby-microvolt = <850000 950000 950000>;
+};
+
+/* Board fragment: imx50-kindle-k4-display-vusb2.dts */
+/ {
+	model = "Amazon Kindle 4 (Tequila, display and VUSB2 standby)";
+};
+
+&pm {
+	/* The USB controller already owns device sleep supply ordering. */
+	amazon,standby-mode0-power-off-mask = <0x80000>;
+};
+
+/* Board fragment: imx50-kindle-k4-accessory-inputs.dts */
+/ {
+	model = "Amazon Kindle 4 (Tequila, accessory input stage)";
+	accessory_inputs: accessory-inputs {
+		compatible = "amazon,k4-accessory-inputs";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_accessory_inputs>;
+		detect-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
+		charging-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
+		wakeup-source;
+	};
+};
+
+&iomuxc {
+	pinctrl_accessory_inputs: accessory-inputs-grp {
+		fsl,pins = <
+			/* Match old input pulls: detect down, charge-status up. */
+			MX50_PAD_EIM_DA13__GPIO1_13 0xcc
+			MX50_PAD_EIM_DA14__GPIO1_14 0xec
+		>;
+	};
+};
+
+/* Board fragment: imx50-kindle-k4-restart.dts */
+&cspi {
+	pmic@0 {
+		restart {
+			compatible = "amazon,kindle-k4-restart";
+			reset-gpios = <&gpio6 28 GPIO_ACTIVE_LOW>;
+			/* Own the WDI pad in hardware-watchdog mode until reboot. */
+			pinctrl-names = "default", "watchdog", "reset";
+			pinctrl-0 = <&pinctrl_restart_watchdog>;
+			pinctrl-1 = <&pinctrl_restart_watchdog>;
+			pinctrl-2 = <&pinctrl_restart_gpio>;
+		};
+	};
+};
+
+&iomuxc {
+	pinctrl_restart_watchdog: restart-watchdog-grp {
+		fsl,pins = <MX50_PAD_WDOG__WDOG1_WDOG_RST_B_DEB 0x0c>;
+	};
+	pinctrl_restart_gpio: restart-gpio-grp {
+		/* Original high-drive push-pull/no keeper/no hysteresis. */
+		fsl,pins = <MX50_PAD_WDOG__GPIO6_28 0x4>;
+	};
