+		linux,keymap = <
+			MATRIX_KEY(0, 0, KEY_LEFTCTRL)
+			MATRIX_KEY(1, 0, KEY_MENU)
+			MATRIX_KEY(2, 0, KEY_PAGEDOWN)
+			MATRIX_KEY(3, 0, KEY_F21)
+			MATRIX_KEY(4, 0, KEY_F23)
+			MATRIX_KEY(5, 0, KEY_PAGEUP)
+			MATRIX_KEY(6, 0, KEY_HOME)
+			MATRIX_KEY(7, 0, KEY_BACK)
