+  spi-rx-bus-width:
+    const: 1
+  spi-tx-bus-width:
+    const: 1
+  spi-cpha: false
+  spi-cpol: false
+  spi-cs-high: false
+  spi-3wire: false
+  spi-lsb-first: false
+
+required:
+  - compatible
+  - reg
+  - spi-max-frequency
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
