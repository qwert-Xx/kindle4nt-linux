+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/amazon,k4-accessory-inputs.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amazon Kindle K4 accessory inputs and Apollo output
+
+maintainers:
+  - codex <codex@localhost>
+
+description: |
+  ACC_PG detects an accessory charging source. ACC_CHRG_B is a separate
+  active-low charging-status input. The controller variant also owns the
+  Apollo output regulator and follows the stock USB/screensaver/PM policy.
+  It does not increase the charging-current budget. Its MC13892 GPO3 node
+  uses amazon,accessory-active-low because the board output is enabled
+  by clearing GPO3EN, unlike the generic regulator polarity.
+
+properties:
+  compatible:
+    enum:
+      - amazon,k4-accessory-inputs
+      - amazon,k4-accessory-controller
+  detect-gpios:
+    maxItems: 1
+    description: Active-high ACC_PG input.
+  charging-gpios:
+    maxItems: 1
+    description: Active-low ACC_CHRG_B input.
+  output-supply:
+    description: Exclusive Apollo output regulator.
+  usb-source:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: USB power_supply providing the physical ONLINE property.
+  wakeup-source: true
+  pinctrl-names:
+    items:
+      - const: default
+  pinctrl-0: true
+
+required:
+  - compatible
+  - detect-gpios
+  - charging-gpios
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: amazon,k4-accessory-controller
+    then:
+      required:
+        - output-supply
+        - usb-source
+
+additionalProperties: false
