+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/fsl,imx50-anatop-clocks.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Freescale i.MX50 analog display clocks
+
+maintainers:
+  - codex <codex@localhost>
+
+description: |
+  Initial display clock provider. Clock index 0 is the 480 MHz APLL,
+  index 1 is PFD5. The analog bandgap must already be powered. APLL
+  startup preserves unrelated analog and charger settings.
+  The APBH clock supplies register access, not the PFD frequency source.
+
+properties:
+  compatible:
+    const: fsl,imx50-anatop-clocks
+  reg:
+    maxItems: 1
+  '#clock-cells':
+    const: 1
+  clocks:
+    maxItems: 1
+  clock-names:
+    const: apbh
+
+required:
+  - compatible
+  - reg
+  - '#clock-cells'
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/imx5-clock.h>
+    clock-controller@41018000 {
+        compatible = "fsl,imx50-anatop-clocks";
+        reg = <0x41018000 0x1000>;
+        #clock-cells = <1>;
+        clocks = <&clks IMX5_CLK_APBH_DMA>;
+        clock-names = "apbh";
+    };
