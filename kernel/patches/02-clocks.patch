+// SPDX-License-Identifier: GPL-2.0-only
+/* i.MX50 display PFD5 and its 480 MHz analog PLL. */
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define FRAC1		0x20
+#define MISC		0x60
+#define PLLCTRL		0x70
+#define SET		4
+#define CLR		8
+#define PFD5_FRAC	GENMASK(13, 8)
+#define PFD5_GATE	BIT(15)
+
+struct imx50_pfd5 {
+	struct clk_hw hw;
+	void __iomem *base;
+};
+#define to_pfd5(hw) container_of(hw, struct imx50_pfd5, hw)
+
+struct imx50_apll {
+	struct clk_hw hw;
+	void __iomem *base;
+	u32 saved;
+	bool started;
+};
+#define to_apll(hw) container_of(hw, struct imx50_apll, hw)
+
+static bool imx50_apll_ready(void __iomem *base)
+{
+	u32 misc = readl(base + MISC);
+
+	/* POWERUP=1, HOLD_RING_OFF=0, bandgap REF_PWD=0, LOCK=1. */
+	return (misc & (BIT(0) | BIT(7) | BIT(18))) == BIT(0) &&
+	       (readl(base + PLLCTRL) & BIT(31));
+}
+
+static void imx50_apll_restore(struct imx50_apll *pll)
+{
+	/* Only bits owned by the startup sequence; preserve charger/bandgap. */
+	writel(BIT(0), pll->base + MISC + CLR);
+	if (pll->saved & BIT(7))
+		writel(BIT(7), pll->base + MISC + SET);
+	else
+		writel(BIT(7), pll->base + MISC + CLR);
+	readl(pll->base + MISC);
+	pll->started = false;
+}
+
+static int imx50_apll_prepare(struct clk_hw *hw)
+{
+	struct imx50_apll *pll = to_apll(hw);
+	u32 misc = readl(pll->base + MISC), val;
+	int ret;
+
+	if (misc & BIT(0))
+		return imx50_apll_ready(pll->base) ? 0 : -EIO;
+	/* Bandgap startup is a separate shared analog-power dependency. */
+	if (misc & BIT(18))
+		return -EOPNOTSUPP;
+	pll->saved = misc;
+	writel(BIT(7), pll->base + MISC + SET);
+	writel(BIT(0), pll->base + MISC + SET);
+	readl(pll->base + MISC);
+	usleep_range(15, 30);
+	writel(BIT(7), pll->base + MISC + CLR);
+	readl(pll->base + MISC);
+	usleep_range(15, 30);
+	ret = readl_poll_timeout(pll->base + PLLCTRL, val, val & BIT(31), 5, 1000);
+	if (ret) {
+		imx50_apll_restore(pll);
+		return ret;
+	}
+	pll->started = true;
+	return 0;
+}
+
+static void imx50_apll_unprepare(struct clk_hw *hw)
+{
+	struct imx50_apll *pll = to_apll(hw);
+
+	/* A PLL inherited on may supply consumers not yet represented in CCF. */
+	if (pll->started)
+		imx50_apll_restore(pll);
+}
+
+static int imx50_apll_prepared(struct clk_hw *hw)
+{
+	return imx50_apll_ready(to_apll(hw)->base);
+}
+
+static unsigned long imx50_apll_rate(struct clk_hw *hw, unsigned long parent)
+{
+	return 480000000;
+}
+
+static const struct clk_ops imx50_apll_ops = {
+	.prepare = imx50_apll_prepare,
+	.unprepare = imx50_apll_unprepare,
+	.is_prepared = imx50_apll_prepared,
+	.recalc_rate = imx50_apll_rate,
+};
+
+static unsigned long imx50_pfd5_rate(struct clk_hw *hw, unsigned long parent)
+{
+	u32 frac = (readl(to_pfd5(hw)->base + FRAC1) >> 8) & 0x3f;
+
+	return frac >= 18 && frac <= 35 ? div_u64((u64)parent * 18, frac) : 0;
+}
+
+static u32 imx50_pfd5_frac(unsigned long rate, unsigned long parent)
+{
+	u64 frac;
+
+	if (!rate)
+		return 35;
+	frac = div_u64((u64)parent * 18 + rate / 2, rate);
+	return clamp_t(u64, frac, 18, 35);
+}
+
+static long imx50_pfd5_round(struct clk_hw *hw, unsigned long rate,
+			   unsigned long *parent)
+{
+	return div_u64((u64)*parent * 18, imx50_pfd5_frac(rate, *parent));
+}
+
+static int imx50_pfd5_set(struct clk_hw *hw, unsigned long rate,
+			unsigned long parent)
+{
+	void __iomem *base = to_pfd5(hw)->base;
+	u32 frac = imx50_pfd5_frac(rate, parent);
+
+	/* Never alter a running fractional divider or any sibling PFD. */
+	if (!(readl(base + FRAC1) & PFD5_GATE))
+		return -EBUSY;
+	writel(PFD5_FRAC, base + FRAC1 + CLR);
+	writel(frac << 8, base + FRAC1 + SET);
+	if (((readl(base + FRAC1) & PFD5_FRAC) >> 8) != frac)
+		return -EIO;
+	/* RM says STABLE toggles on reprogramming; it is not a ready-high bit. */
+	udelay(1);
+	return 0;
+}
+
+static int imx50_pfd5_enable(struct clk_hw *hw)
+{
+	void __iomem *base = to_pfd5(hw)->base;
+	u32 frac = (readl(base + FRAC1) >> 8) & 0x3f;
+
+	if (!imx50_apll_ready(base) || frac < 18 || frac > 35)
+		return -EINVAL;
+	writel(PFD5_GATE, base + FRAC1 + CLR);
+	udelay(1);
+	return readl(base + FRAC1) & PFD5_GATE ? -EIO : 0;
+}
+
+static void imx50_pfd5_disable(struct clk_hw *hw)
+{
+	void __iomem *base = to_pfd5(hw)->base;
+
+	writel(PFD5_GATE, base + FRAC1 + SET);
+	readl(base + FRAC1);
+}
+
+static int imx50_pfd5_enabled(struct clk_hw *hw)
+{
+	return !(readl(to_pfd5(hw)->base + FRAC1) & PFD5_GATE);
+}
+
+static const struct clk_ops imx50_pfd5_ops = {
+	.recalc_rate = imx50_pfd5_rate,
+	.round_rate = imx50_pfd5_round,
+	.set_rate = imx50_pfd5_set,
+	.enable = imx50_pfd5_enable,
+	.disable = imx50_pfd5_disable,
+	.is_enabled = imx50_pfd5_enabled,
+};
+
+static ssize_t registers_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct imx50_pfd5 *pfd = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "frac0=%08x frac1=%08x misc=%08x pllctrl=%08x\n",
+		readl(pfd->base + 0x10), readl(pfd->base + FRAC1),
+		readl(pfd->base + MISC), readl(pfd->base + PLLCTRL));
+}
+static DEVICE_ATTR_RO(registers);
+static struct attribute *imx50_anatop_attrs[] = {
+	&dev_attr_registers.attr, NULL,
+};
+ATTRIBUTE_GROUPS(imx50_anatop);
+
+static int imx50_anatop_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	const char *parent = "imx50_apll";
+	struct clk_init_data init = {
+		.name = "imx50_pfd5",
+		.ops = &imx50_pfd5_ops,
+		.flags = CLK_IGNORE_UNUSED | CLK_SET_RATE_GATE,
+		.parent_names = &parent,
+		.num_parents = 1,
+	};
+	struct clk_hw_onecell_data *data;
+	struct imx50_pfd5 *pfd;
+	struct imx50_apll *pll;
+	struct clk_init_data pll_init = {
+		.name = "imx50_apll",
+		.ops = &imx50_apll_ops,
+		.flags = CLK_IGNORE_UNUSED,
+	};
+	struct clk *apbh;
+	int ret;
+
+	apbh = devm_clk_get_enabled(dev, "apbh");
+	if (IS_ERR(apbh))
+		return dev_err_probe(dev, PTR_ERR(apbh), "APBH access clock\n");
+	pfd = devm_kzalloc(dev, sizeof(*pfd), GFP_KERNEL);
+	pll = devm_kzalloc(dev, sizeof(*pll), GFP_KERNEL);
+	data = devm_kzalloc(dev, struct_size(data, hws, 2), GFP_KERNEL);
+	if (!pfd || !pll || !data)
+		return -ENOMEM;
+	pfd->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(pfd->base))
+		return PTR_ERR(pfd->base);
+	dev_info(dev, "baseline FRAC0=%08x FRAC1=%08x MISC=%08x PLLCTRL=%08x\n",
+		readl(pfd->base + 0x10), readl(pfd->base + FRAC1),
+		readl(pfd->base + MISC), readl(pfd->base + PLLCTRL));
+	/* Yoshi stock clock init disables ANADIG charger detection. The board
+	 * uses MAX14656 and the PMIC instead; preserve PLL/bandgap bits.
+	 */
+	if (of_machine_is_compatible("amazon,kindle-4")) {
+		u32 before = readl(pfd->base + MISC);
+
+		writel(BIT(16), pfd->base + MISC + SET);
+		if (!(readl(pfd->base + MISC) & BIT(16)))
+			return -EIO;
+		dev_info(dev, "stock charger detection disabled: MISC=%08x->%08x\n",
+			 before, readl(pfd->base + MISC));
+	}
+	data->num = 2;
+	pll->base = pfd->base;
+	pll->hw.init = &pll_init;
+	ret = devm_clk_hw_register(dev, &pll->hw);
+	if (ret)
+		return ret;
+	data->hws[0] = &pll->hw;
+	pfd->hw.init = &init;
+	platform_set_drvdata(pdev, pfd);
+	ret = devm_clk_hw_register(dev, &pfd->hw);
+	if (ret)
+		return ret;
+	data->hws[1] = &pfd->hw;
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, data);
+}
+
+static const struct of_device_id imx50_anatop_match[] = {
+	{ .compatible = "fsl,imx50-anatop-clocks" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx50_anatop_match);
+static struct platform_driver imx50_anatop_driver = {
+	.probe = imx50_anatop_probe,
+	.driver = {
+		.name = "imx50-anatop-clocks",
+		.of_match_table = imx50_anatop_match,
+		.suppress_bind_attrs = true,
+		.dev_groups = imx50_anatop_groups,
+	},
+};
+builtin_platform_driver(imx50_anatop_driver);
+MODULE_LICENSE("GPL");
