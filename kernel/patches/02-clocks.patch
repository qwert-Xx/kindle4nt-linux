+	.get_parent = pixel_parent,
+	.set_parent = pixel_set_parent,
+	.recalc_rate = pixel_rate,
+	.determine_rate = pixel_determine_rate,
+	.set_rate = pixel_set_rate,
+	.enable = pixel_enable,
+	.disable = pixel_disable,
+	.is_enabled = pixel_enabled,
+};
+
+struct clk * __init imx50_clk_epdc_pixel(void __iomem *base)
+{
+	static const char * const parents[] = { "osc", "imx50_pfd5", "pll1_sw", "ckih1" };
+	struct clk_init_data init = {
+		.name = "epdc_pix",
+		.ops = &pixel_ops,
+		.parent_names = parents,
+		.num_parents = ARRAY_SIZE(parents),
+		.flags = CLK_IGNORE_UNUSED | CLK_GET_RATE_NOCACHE |
+			 CLK_SET_RATE_GATE | CLK_SET_PARENT_GATE | CLK_OPS_PARENT_ENABLE,
+	};
+	struct imx50_pixel *p;
+	struct clk *ret;
+
+	p = kzalloc(sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return ERR_PTR(-ENOMEM);
+	p->hw.init = &init;
+	p->base = base;
+	p->stock_pll1 = of_machine_is_compatible("amazon,kindle-4");
+	ret = clk_register(NULL, &p->hw);
+	if (IS_ERR(ret))
+		kfree(p);
+	return ret;
+}
