+/* HVE selects the pad output-buffer voltage range, not a regulator voltage.
+ * i.MX50 RM 35.4.422/431: bit 13 selects 1.65--1.95 V; zero 2.7--3.3 V.
+ * Yoshi mx50_yoshi_io_init sets both groups before registering MMC hosts.
+ */
+static int imx50_init_groups(struct imx_pinctrl *ipctl)
+{
+	static const struct { const char *property; u16 offset; } groups[] = {
+		{ "fsl,sd2-low-voltage", 0x69c },
+		{ "fsl,nandf-low-voltage", 0x6c0 },
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(groups); i++) {
+		u32 before, after;
+
+		if (!of_property_read_bool(ipctl->dev->of_node, groups[i].property))
+			continue;
+		before = readl(ipctl->base + groups[i].offset);
+		writel(before | BIT(13), ipctl->base + groups[i].offset);
+		after = readl(ipctl->base + groups[i].offset);
+		dev_info(ipctl->dev, "pad group %03x: %08x -> %08x (HVE low voltage)\n",
+			 groups[i].offset, before, after);
+		if (!(after & BIT(13)))
+			return -EIO;
+	}
+	return 0;
+}
