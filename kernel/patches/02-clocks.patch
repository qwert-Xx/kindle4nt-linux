+/*
+ * Initial i.MX50 display clock support: preserve the inherited source and
+ * divider, and control only the two gates. PFD sources are intentionally
+ * unresolved until the i.MX50 ANATOP clock driver exists. No rate request may
+ * propagate to PLL1, which is shared with the CPU.
+ */
+struct imx50_display_gate {
+	struct clk_hw hw;
+	void __iomem *base;
+	u32 reg, asm_mask;
+	u8 mux_shift, gate_shift, busy_shift;
+	bool faulted, stock_configured;
+};
+
+#define to_imx50_display_gate(hw) container_of(hw, struct imx50_display_gate, hw)
+
+static u8 imx50_display_parent(struct clk_hw *hw)
+{
+	struct imx50_display_gate *g = to_imx50_display_gate(hw);
+
+	return (readl(g->base + 0x90) >> g->mux_shift) & 3;
+}
+
+static unsigned long imx50_display_rate(struct clk_hw *hw, unsigned long rate)
+{
+	struct imx50_display_gate *g = to_imx50_display_gate(hw);
+	u32 div = readl(g->base + g->reg) & 0x3f;
+
+	/* Unlike the usual i.MX divider, zero means gated, not divide-by-one. */
+	return div ? rate / div : 0;
+}
+
+static int imx50_display_enable(struct clk_hw *hw)
+{
+	struct imx50_display_gate *g = to_imx50_display_gate(hw);
+	unsigned long flags;
+	u32 val;
+	int ret = 0;
+
+	if (!clk_hw_get_rate(hw))
+		return -EINVAL;
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	val = readl(g->base + g->reg);
+	/* Auto-slow and divider transitions need a later, complete rate driver. */
+	if ((val & g->asm_mask) ||
+	    (readl(g->base + 0x8c) & BIT(g->busy_shift))) {
+		ret = -EBUSY;
+		goto out;
+	}
+	writel(readl(g->base + 0x80) | (3U << g->gate_shift), g->base + 0x80);
+	writel(val | GENMASK(31, 30), g->base + g->reg);
+	readl(g->base + g->reg);
+out:
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+	return ret;
+}
+
+static void imx50_display_disable(struct clk_hw *hw)
+{
+	struct imx50_display_gate *g = to_imx50_display_gate(hw);
+	unsigned long flags;
+
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	writel(readl(g->base + g->reg) & ~GENMASK(31, 30), g->base + g->reg);
+	writel(readl(g->base + 0x80) & ~(3U << g->gate_shift), g->base + 0x80);
+	readl(g->base + 0x80);
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+}
+
+static int imx50_display_is_enabled(struct clk_hw *hw)
+{
+	struct imx50_display_gate *g = to_imx50_display_gate(hw);
+
+	return !!(readl(g->base + g->reg) & GENMASK(31, 30)) &&
+	       !!(readl(g->base + 0x80) & (3U << g->gate_shift));
+}
+
+static const struct clk_ops imx50_display_ops = {
+	.get_parent = imx50_display_parent,
+	.recalc_rate = imx50_display_rate,
+	.enable = imx50_display_enable,
+	.disable = imx50_display_disable,
+	.is_enabled = imx50_display_is_enabled,
+};
+
+/* EPDC/PxP AXI factory route: explicit parent, direct divisor, auto-slow /32.
+ * Changes require the terminal clock stopped;
+ * only the source gate is opened to complete divider handshakes.
+ */
+static int imx50_epdc_axi_wait(struct imx50_display_gate *g)
+{
+	u32 val;
+
+	return readl_poll_timeout_atomic(g->base + 0x8c, val,
+			!(val & BIT(g->busy_shift)), 1, 1000);
+}
+
+static int imx50_epdc_axi_stop(struct imx50_display_gate *g)
+{
+	u32 src = readl(g->base + g->reg);
+	u32 end = readl(g->base + 0x80);
+	u32 gate = 3U << g->gate_shift;
+	int ret;
+
+	if (g->faulted)
+		return -EIO;
+	/* DISPLAY_AXI is shared with LCDIF; never retime its live consumer. */
+	if (g->reg == 0xa4 && (end & (3U << 20))) {
+		pr_warn("imx50 DISPLAY_AXI LCDIF busy: src=%08x ccgr6=%08x bypass=%08x csr2=%08x\n",
+			src, end, readl(g->base + 0x90), readl(g->base + 0x8c));
+		return -EBUSY;
+	}
+	if ((src & GENMASK(31, 30)) && (end & gate))
+		return -EBUSY;
+	ret = imx50_epdc_axi_wait(g);
+	if (ret)
+		return ret;
+	writel(end & ~gate, g->base + 0x80);
+	writel(src & ~(GENMASK(31, 30) | g->asm_mask), g->base + g->reg);
+	if ((readl(g->base + 0x80) & gate) ||
+	    (readl(g->base + g->reg) & (GENMASK(31, 30) | g->asm_mask))) {
+		g->faulted = true;
+		return -EIO;
+	}
+	return 0;
+}
+
+static int imx50_epdc_axi_set_parent(struct clk_hw *hw, u8 index)
+{
+	struct imx50_display_gate *g = to_imx50_display_gate(hw);
+	unsigned long flags;
+	u32 val;
+	int ret;
+
+	if (index > 2)
+		return -EINVAL;
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	ret = imx50_epdc_axi_stop(g);
+	if (ret)
+		goto out;
+	val = readl(g->base + 0x90);
+	writel((val & ~(3U << g->mux_shift)) | (index << g->mux_shift),
+	       g->base + 0x90);
+	ret = imx50_epdc_axi_wait(g);
+	if (!ret && imx50_display_parent(hw) != index)
+		ret = -EIO;
+	if (ret)
+		g->faulted = true;
+out:
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+	return ret;
+}
+
+static int imx50_epdc_axi_divisor(unsigned long parent, unsigned long target,
+		unsigned long lo, unsigned long hi, unsigned int *div,
+		unsigned long *rate)
+{
+	unsigned long best = ~0UL;
+	unsigned int d;
+	bool found = false;
+
+	if (!parent || !target || lo > hi)
+		return -EINVAL;
+	for (d = 1; d <= 63; d++) {
+		unsigned long value = parent / d;
+		unsigned long err = value > target ? value - target : target - value;
+
+		if (value < lo || value > hi)
+			continue;
+		if (!found || err < best) {
+			found = true;
+			best = err;
+			*div = d;
+			*rate = value;
+		}
+	}
+	return found ? 0 : -EINVAL;
+}
+
+static int imx50_epdc_axi_determine(struct clk_hw *hw, struct clk_rate_request *req)
+{
+	struct clk_hw *parent = clk_hw_get_parent(hw);
+	unsigned int div;
+	unsigned long rate;
+	int ret;
+
+	if (!parent)
+		return -EINVAL;
+	ret = imx50_epdc_axi_divisor(clk_hw_get_rate(parent), req->rate,
+				req->min_rate, req->max_rate, &div, &rate);
+	if (ret)
+		return ret;
+	req->rate = rate;
+	req->best_parent_hw = parent;
+	req->best_parent_rate = clk_hw_get_rate(parent);
+	return 0;
+}
+
+static int imx50_epdc_axi_set_rate(struct clk_hw *hw, unsigned long rate,
+				 unsigned long parent)
+{
+	struct imx50_display_gate *g = to_imx50_display_gate(hw);
+	unsigned long flags, rounded;
+	unsigned int div;
+	u32 val;
+	int ret;
+
+	ret = imx50_epdc_axi_divisor(parent, rate, 0, ~0UL, &div, &rounded);
+	if (ret)
+		return ret;
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	ret = imx50_epdc_axi_stop(g);
+	if (ret)
+		goto out;
+	val = readl(g->base + g->reg);
+	writel(val | GENMASK(31, 30), g->base + g->reg);
+	if ((readl(g->base + g->reg) & GENMASK(31, 30)) != GENMASK(31, 30)) {
+		ret = -EIO;
+		goto close;
+	}
+	writel((val & ~0x3f) | GENMASK(31, 30) | div, g->base + g->reg);
+	ret = imx50_epdc_axi_wait(g);
+	if (!ret && (readl(g->base + g->reg) & 0x3f) != div)
+		ret = -EIO;
+close:
+	writel(readl(g->base + g->reg) & ~GENMASK(31, 30), g->base + g->reg);
+	if (readl(g->base + g->reg) & GENMASK(31, 30))
+		ret = -EIO;
+	if (ret)
+		g->faulted = true;
+	else
+		g->stock_configured = true;
+out:
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+	return ret;
+}
+
+static int imx50_epdc_axi_enable(struct clk_hw *hw)
+{
+	struct imx50_display_gate *g = to_imx50_display_gate(hw);
+	unsigned long flags;
+	u32 val, gate = 3U << g->gate_shift;
+	int ret;
+
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	ret = -EIO;
+	if (g->faulted)
+		goto out;
+	val = readl(g->base + g->reg);
+	ret = -EINVAL;
+	if (!(val & 0x3f))
+		goto out;
+	ret = imx50_epdc_axi_wait(g);
+	if (ret)
+		goto out;
+	writel(readl(g->base + 0x80) | gate, g->base + 0x80);
+	writel(val | GENMASK(31, 30), g->base + g->reg);
+	/* Original Yoshi enable: ASM enabled with SLOW_DIV=5 (/32). */
+	val |= GENMASK(31, 30);
+	/* EPDC first access precedes idle proof. PxP's factory enable always
+	 * enables its hardware idle auto-slow, including an unchanged CCF rate.
+	 */
+	if (g->stock_configured || g->reg == 0xa4)
+		val = (val & ~(7U << (g->reg == 0xa4 ? 10 : 6))) | g->asm_mask | (5U << (g->reg == 0xa4 ? 10 : 6));
+	writel(val, g->base + g->reg);
+	if (readl(g->base + g->reg) != val ||
+	    (readl(g->base + 0x80) & gate) != gate) {
+		writel(val & ~(GENMASK(31, 30) | g->asm_mask), g->base + g->reg);
+		writel(readl(g->base + 0x80) & ~gate, g->base + 0x80);
+		g->faulted = true;
+		ret = -EIO;
+	}
+out:
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+	return ret;
+}
+
+static void imx50_epdc_axi_disable(struct clk_hw *hw)
+{
+	struct imx50_display_gate *g = to_imx50_display_gate(hw);
+	unsigned long flags;
+	u32 val;
+
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	val = readl(g->base + g->reg);
+	writel(val & ~g->asm_mask, g->base + g->reg);
+	writel(val & ~(GENMASK(31, 30) | g->asm_mask), g->base + g->reg);
+	writel(readl(g->base + 0x80) & ~(3U << g->gate_shift), g->base + 0x80);
+	if ((readl(g->base + g->reg) & (GENMASK(31, 30) | g->asm_mask)) ||
+	    (readl(g->base + 0x80) & (3U << g->gate_shift)))
+		g->faulted = true;
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+}
+
+static const struct clk_ops imx50_epdc_axi_ops = {
+	.get_parent = imx50_display_parent,
+	.set_parent = imx50_epdc_axi_set_parent,
+	.recalc_rate = imx50_display_rate,
+	.determine_rate = imx50_epdc_axi_determine,
+	.set_rate = imx50_epdc_axi_set_rate,
+	.enable = imx50_epdc_axi_enable,
+	.disable = imx50_epdc_axi_disable,
+	.is_enabled = imx50_display_is_enabled,
+};
+
+static struct clk *__init imx50_display_gate(const char *name,
+		const char * const *parents, void __iomem *base, u32 reg,
+		u32 asm_mask, u8 mux_shift, u8 gate_shift, u8 busy_shift)
+{
+	struct clk_init_data init = {
+		.name = name,
+		.ops = &imx50_display_ops,
+		.parent_names = parents,
+		.num_parents = 4,
+		.flags = CLK_GET_RATE_NOCACHE | CLK_IGNORE_UNUSED,
+	};
+	struct imx50_display_gate *g;
+	struct clk *ret;
+
+	g = kzalloc(sizeof(*g), GFP_KERNEL);
+	if (!g)
+		return ERR_PTR(-ENOMEM);
+	if (reg == 0xa8 || reg == 0xa4) {
+		init.ops = &imx50_epdc_axi_ops;
+		init.flags |= CLK_SET_RATE_GATE | CLK_SET_PARENT_GATE |
+			      CLK_OPS_PARENT_ENABLE;
+	}
+	g->hw.init = &init;
+	g->base = base;
+	g->reg = reg;
+	g->asm_mask = asm_mask;
+	g->mux_shift = mux_shift;
+	g->gate_shift = gate_shift;
+	g->busy_shift = busy_shift;
+	ret = clk_register(NULL, &g->hw);
+	if (IS_ERR(ret))
+		kfree(g);
+	return ret;
+}
