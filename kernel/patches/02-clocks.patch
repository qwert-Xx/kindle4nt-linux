+++ b/drivers/clk/imx/clk-imx50-pixel-rate.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __CLK_IMX50_PIXEL_RATE_H
+#define __CLK_IMX50_PIXEL_RATE_H
+
+#include <linux/errno.h>
+
+/* Direct divisor encoding: pre=1..3, post=1..4095; zero gates a stage. */
+static inline int imx50_pixel_dividers_policy(unsigned long parent, unsigned long target,
+		unsigned long min_rate, unsigned long max_rate, bool stock_pre1,
+		unsigned int *best_pre, unsigned int *best_post,
+		unsigned long *rounded)
+{
+	unsigned long best_error = ~0UL;
+	unsigned int pre;
+	int found = 0;
+
+	if (!parent || !target || min_rate > max_rate)
+		return -EINVAL;
+	for (pre = 1; pre <= (stock_pre1 ? 1 : 3); pre++) {
+		unsigned long input = parent / pre;
+		unsigned long post = input / target;
+		unsigned long first = 1, last = 4095;
+		unsigned int i;
+
+		if (!stock_pre1 && parent > 480000000UL * pre)
+			continue;
+		/* Bound floor(input / post), avoiding max_rate + 1 overflow. */
+		if (max_rate < input)
+			first = input / (max_rate + 1) + 1;
+		if (min_rate && input / min_rate < last)
+			last = input / min_rate;
+		if (first > last)
+			continue;
+		/* Test both neighbors of the ideal divisor, clamped to the field. */
+		if (post < first)
+			post = first;
+		if (post > last)
+			post = last;
+		for (i = 0; i < 2 && post + i <= last; i++) {
+			unsigned long rate = input / (post + i);
+			unsigned long error = rate > target ? rate - target : target - rate;
+
+			if (!found || error < best_error) {
+				*best_pre = pre;
+				*best_post = post + i;
+				*rounded = rate;
+				best_error = error;
+				found = 1;
+			}
+		}
+	}
+	return found ? 0 : -EINVAL;
+}
+
+static inline int imx50_pixel_dividers_range(unsigned long parent, unsigned long target,
+        unsigned long min_rate, unsigned long max_rate,
+        unsigned int *pre, unsigned int *post, unsigned long *rounded)
+{
+    return imx50_pixel_dividers_policy(parent, target, min_rate, max_rate,
+                                      false, pre, post, rounded);
+}
+
+static inline int imx50_pixel_dividers(unsigned long parent, unsigned long target,
+		unsigned int *best_pre, unsigned int *best_post,
+		unsigned long *rounded)
+{
+	return imx50_pixel_dividers_range(parent, target, 0, ~0UL,
+					best_pre, best_post, rounded);
+}
+
+#endif
--- /dev/null
+++ b/drivers/clk/imx/clk-imx50-pixel.c
@@ -0,0 +1,322 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* i.MX50 EPDC pixel clock: source, serial divisors, and both clock gates. */
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/slab.h>
+#include <linux/printk.h>
+#include <linux/of.h>
+#include "clk.h"
+#include "clk-imx50-pixel-rate.h"
+
+#define CCGR6	0x80
+#define CSR2	0x8c
+#define CLKSEQ	0x90
+#define EPDCPIX	0xa0
+#define PIX_GATE	GENMASK(31, 30)
+#define CCGR_GATE GENMASK(11, 10)
+#define PIX_PRE	GENMASK(13, 12)
+#define PIX_POST	GENMASK(11, 0)
+#define PIX_BUSY	BIT(8)
+#define PIX_MUX	GENMASK(13, 12)
+
+struct imx50_pixel {
+	struct clk_hw hw;
+	void __iomem *base;
+	bool faulted;
+	bool stock_pll1;
+};
+#define to_pixel(hw) container_of(hw, struct imx50_pixel, hw)
+
+static bool pixel_gated(struct imx50_pixel *p)
+{
+	u32 source = readl(p->base + EPDCPIX);
+	u32 terminal = readl(p->base + CCGR6);
+	bool gated = !(source & PIX_GATE) && !(terminal & CCGR_GATE);
+
+	if (!gated)
+		pr_warn_ratelimited("imx50 EPDC pixel clock busy: EPDCPIX=%08x CCGR6=%08x\n",
+				    source, terminal);
+	return gated;
+}
+
+static int pixel_wait(struct imx50_pixel *p)
+{
+	u32 val;
+
+	return readl_poll_timeout_atomic(p->base + CSR2, val,
+					!(val & PIX_BUSY), 1, 1000);
+}
+
+/* Boot firmware may stop only one of the two serial clock gates. The
+ * terminal is already stopped if either gate is wholly closed. Normalize
+ * that inactive state before touching mux/divisors, preserving sibling bits.
+ * Both gates open remains an active-clock rejection, never a forced stop.
+ */
+static int pixel_stop_for_change(struct imx50_pixel *p)
+{
+	u32 source = readl(p->base + EPDCPIX);
+	u32 terminal = readl(p->base + CCGR6);
+	int ret;
+
+	if ((source & PIX_GATE) && (terminal & CCGR_GATE)) {
+		pixel_gated(p); /* Rate-limited rejected-state diagnostic. */
+		return -EBUSY;
+	}
+	if (!(source & PIX_GATE) && !(terminal & CCGR_GATE))
+		return 0;
+	ret = pixel_wait(p);
+	if (ret)
+		return ret;
+	if (terminal & CCGR_GATE)
+		writel(terminal & ~CCGR_GATE, p->base + CCGR6);
+	if (source & PIX_GATE)
+		writel(source & ~PIX_GATE, p->base + EPDCPIX);
+	if (!pixel_gated(p)) {
+		p->faulted = true;
+		return -EIO;
+	}
+	return 0;
+}
+
+static u8 pixel_parent(struct clk_hw *hw)
+{
+	return (readl(to_pixel(hw)->base + CLKSEQ) & PIX_MUX) >> 12;
+}
+
+/* Yoshi factory code uses PLL1_SW with pre=1, including 800MHz input.
+ * This board exception conflicts with RM 5.4.41's 480MHz PODF input limit;
+ * see porting/EPDC-STOCK-CLOCKS.md. Never retune the shared PLL here.
+ */
+static bool pixel_stock_pll1(struct clk_hw *hw)
+{
+    return to_pixel(hw)->stock_pll1 && pixel_parent(hw) == 2;
+}
+
+static int pixel_set_parent(struct clk_hw *hw, u8 index)
+{
+	struct imx50_pixel *p = to_pixel(hw);
+	unsigned long flags;
+	u32 val;
+	int ret;
+
+	if (index > 3)
+		return -EINVAL;
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	ret = -EIO;
+	if (p->faulted)
+		goto out;
+	ret = pixel_stop_for_change(p);
+	if (ret)
+		goto out;
+	ret = pixel_wait(p);
+	if (ret)
+		goto out;
+	val = readl(p->base + CLKSEQ);
+	writel((val & ~PIX_MUX) | (index << 12), p->base + CLKSEQ);
+	ret = pixel_wait(p);
+	if (!ret && pixel_parent(hw) != index)
+		ret = -EIO;
+	if (ret)
+		p->faulted = true;
+out:
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+	return ret;
+}
+
+static unsigned long pixel_rate(struct clk_hw *hw, unsigned long parent)
+{
+	u32 val = readl(to_pixel(hw)->base + EPDCPIX);
+	u32 pre = (val & PIX_PRE) >> 12, post = val & PIX_POST;
+
+	return pre && post ? parent / pre / post : 0;
+}
+
+static int pixel_determine_rate(struct clk_hw *hw, struct clk_rate_request *req)
+{
+	struct clk_hw *parent_hw = clk_hw_get_parent(hw);
+	unsigned int pre, post;
+	unsigned long rounded, parent_rate;
+	int ret;
+
+	/* Parent changes are explicit; never retune a shared PLL or PFD here. */
+	if (!parent_hw)
+		return -EINVAL;
+	parent_rate = clk_hw_get_rate(parent_hw);
+	ret = imx50_pixel_dividers_policy(parent_rate, req->rate,
+					req->min_rate, req->max_rate, pixel_stock_pll1(hw),
+					&pre, &post, &rounded);
+	if (ret)
+		return ret;
+	req->best_parent_hw = parent_hw;
+	req->best_parent_rate = parent_rate;
+	req->rate = rounded;
+	return 0;
+}
+
+static int pixel_set_rate(struct clk_hw *hw, unsigned long rate, unsigned long parent)
+{
+	struct imx50_pixel *p = to_pixel(hw);
+	unsigned long flags, rounded;
+	unsigned int pre, post, current_pre;
+	u32 val;
+	bool source_on = false;
+	int ret;
+
+	ret = imx50_pixel_dividers_policy(parent, rate, 0, ~0UL,
+					 pixel_stock_pll1(hw), &pre, &post, &rounded);
+	if (ret)
+		return ret;
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	ret = -EIO;
+	if (p->faulted)
+		goto out;
+	ret = pixel_stop_for_change(p);
+	if (ret)
+		goto out;
+	ret = pixel_wait(p);
+	if (ret)
+		goto out;
+	/* EPDCPIX gates before the serial dividers. A stopped source cannot
+	 * complete their busy handshake. CCF keeps the parent running; open
+	 * only the source gate, leaving the terminal CCGR gate closed.
+	 */
+	val = readl(p->base + EPDCPIX);
+	current_pre = (val & PIX_PRE) >> 12;
+	if (!current_pre || (!pixel_stock_pll1(hw) &&
+		parent > 480000000UL * current_pre)) {
+		ret = -ERANGE;
+		goto out;
+	}
+	writel(val | PIX_GATE, p->base + EPDCPIX);
+	source_on = true;
+	if ((readl(p->base + EPDCPIX) & PIX_GATE) != PIX_GATE) {
+		ret = -EIO;
+		goto fault;
+	}
+	/* RM: post takes effect first on a combined write. Program separately. */
+	val = readl(p->base + EPDCPIX);
+	writel((val & ~PIX_POST) | PIX_POST, p->base + EPDCPIX);
+	ret = pixel_wait(p);
+	if (ret)
+		goto fault;
+	val = readl(p->base + EPDCPIX);
+	writel((val & ~PIX_PRE) | (pre << 12), p->base + EPDCPIX);
+	ret = pixel_wait(p);
+	if (ret)
+		goto fault;
+	val = readl(p->base + EPDCPIX);
+	writel((val & ~PIX_POST) | post, p->base + EPDCPIX);
+	ret = pixel_wait(p);
+	val = readl(p->base + EPDCPIX);
+	if (!ret && (val & (PIX_PRE | PIX_POST)) != ((pre << 12) | post))
+		ret = -EIO;
+fault:
+	if (ret)
+		p->faulted = true;
+out:
+	if (source_on) {
+		val = readl(p->base + EPDCPIX);
+		writel(val & ~PIX_GATE, p->base + EPDCPIX);
+		readl(p->base + EPDCPIX);
+	}
+	/* On timeout, leave both gates closed; never continue unboundedly. */
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+	return ret;
+}
+
+static int pixel_enable(struct clk_hw *hw)
+{
+	struct imx50_pixel *p = to_pixel(hw);
+	struct clk_hw *parent_hw = clk_hw_get_parent(hw);
+	unsigned long parent;
+	unsigned long flags;
+	u32 val, pre;
+	int ret;
+
+	if (!parent_hw)
+		return -EINVAL;
+	parent = clk_hw_get_rate(parent_hw);
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	ret = -EIO;
+	if (p->faulted)
+		goto out;
+	val = readl(p->base + EPDCPIX);
+	pre = (val & PIX_PRE) >> 12;
+	ret = -EINVAL;
+	if (!pre || !(val & PIX_POST) || !parent ||
+	    (!pixel_stock_pll1(hw) && parent > 480000000UL * pre))
+		goto out;
+	ret = pixel_wait(p);
+	if (ret)
+		goto out;
+	writel(readl(p->base + CCGR6) | CCGR_GATE, p->base + CCGR6);
+	writel(val | PIX_GATE, p->base + EPDCPIX);
+	if ((readl(p->base + EPDCPIX) & PIX_GATE) != PIX_GATE ||
+	    (readl(p->base + CCGR6) & CCGR_GATE) != CCGR_GATE) {
+		writel(val & ~PIX_GATE, p->base + EPDCPIX);
+		writel(readl(p->base + CCGR6) & ~CCGR_GATE, p->base + CCGR6);
+		ret = -EIO;
+		p->faulted = true;
+	}
+out:
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+	return ret;
+}
+
+static void pixel_disable(struct clk_hw *hw)
+{
+	struct imx50_pixel *p = to_pixel(hw);
+	unsigned long flags;
+
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	writel(readl(p->base + EPDCPIX) & ~PIX_GATE, p->base + EPDCPIX);
+	writel(readl(p->base + CCGR6) & ~CCGR_GATE, p->base + CCGR6);
+	readl(p->base + CCGR6);
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+}
+
+static int pixel_enabled(struct clk_hw *hw)
+{
+	struct imx50_pixel *p = to_pixel(hw);
+
+	return !!(readl(p->base + EPDCPIX) & PIX_GATE) &&
+	       !!(readl(p->base + CCGR6) & CCGR_GATE);
+}
