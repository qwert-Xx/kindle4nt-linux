+	struct sdhci_pltfm_host *pltfm_host = sdhci_priv(host);
+	struct pltfm_imx_data *imx_data = sdhci_pltfm_priv(pltfm_host);
+	struct esdhc_clock_snapshot sample;
+	unsigned long flags;
+
+	spin_lock_irqsave(&imx_data->clock_snapshot_lock, flags);
+	sample = imx_data->clock_snapshot;
+	spin_unlock_irqrestore(&imx_data->clock_snapshot_lock, flags);
+
+	return sysfs_emit(buf,
+		"samples=%u requested=%u source=%u actual=%u prescaler=%u divisor=%u sysctl_before=%08x sysctl_written=%08x prsstat=%08x dll_before=%08x dll_test=%08x dll_probed=%u stable_error=%d test_mode=%u settle_us=%u sysctl_disabled=%08x sysctl_restored=%08x\n",
+		sample.samples, sample.requested, sample.source, sample.actual,
+		sample.prescaler, sample.divisor, sample.sysctl_before,
+		sample.sysctl_written, sample.prsstat, sample.dll_before,
+		sample.dll_test, sample.dll_probed, sample.stable_error,
+		sample.test_mode, sample.settle_us,
+		sample.sysctl_disabled, sample.sysctl_restored);
