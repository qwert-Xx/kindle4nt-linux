+static void k4_pmic_capture(struct mmc_pwrseq_simple *p, unsigned int phase)
+{
+#if IS_REACHABLE(CONFIG_MFD_MC13XXX)
+	unsigned int i;
+	int ret = 0;
+
+	if (!p->diag_pmic || p->diag_count[phase] || (phase && !p->diag_count[0]))
+		return;
+	mutex_lock(&p->diag_lock);
+	p->diag_ns[phase] = ktime_get_ns();
+	mc13xxx_lock(p->diag_pmic);
+	for (i = 0; i < ARRAY_SIZE(k4_pmic_config_regs); i++) {
+		ret = mc13xxx_reg_read(p->diag_pmic, k4_pmic_config_regs[i],
+				       &p->diag_regs[phase][i]);
+		if (ret)
+			break;
+		p->diag_count[phase]++;
+	}
+	mc13xxx_unlock(p->diag_pmic);
+	p->diag_error[phase] = ret;
+	mutex_unlock(&p->diag_lock);
+#endif
+}
+
+#if IS_REACHABLE(CONFIG_MFD_MC13XXX) && IS_REACHABLE(CONFIG_SPI)
+static void k4_put_pmic_device(void *data) { put_device(data); }
+static int k4_find_pmic(struct mmc_pwrseq_simple *p, struct device *dev)
+{
+	struct device_node *np;
+	struct spi_device *spi;
+	struct device *supplier;
+	int ret;
+
+	if (!k4_diagnostic_snapshot || !p->retain_board_power)
+		return 0;
+	np = of_find_compatible_node(NULL, NULL, "amazon,kindle-k4-mc13892");
+	if (!np)
+		return -ENODEV;
+	supplier = bus_find_device_by_of_node(&spi_bus_type, np);
+	of_node_put(np);
+	if (!supplier)
+		return -EPROBE_DEFER;
+	spi = to_spi_device(supplier);
+	if (!device_is_bound(&spi->dev) || !spi_get_drvdata(spi)) {
+		put_device(&spi->dev);
+		return -EPROBE_DEFER;
+	}
+	ret = devm_add_action_or_reset(dev, k4_put_pmic_device, &spi->dev);
+	if (ret)
+		return ret;
+	if (!device_link_add(dev, &spi->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+		return -ENOMEM;
+	p->diag_pmic = spi_get_drvdata(spi);
+	return 0;
+}
+#else
+static int k4_find_pmic(struct mmc_pwrseq_simple *p, struct device *dev)
+{
+	return k4_diagnostic_snapshot && p->retain_board_power ? -ENODEV : 0;
+}
+#endif
