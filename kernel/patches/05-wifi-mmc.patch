+static void k4_sdio_capture(struct sdhci_host *host, unsigned int clock)
+{
+	struct sdhci_pltfm_host *pltfm = sdhci_priv(host);
+	struct pltfm_imx_data *d = sdhci_pltfm_priv(pltfm);
+	struct k4_sdio_registers v = { .requested = clock };
+	unsigned long flags;
+	unsigned int i;
+
+	if (!d->diag_iomux || !d->diag_ccm || !d->diag_gpio)
+		return;
+	/* Called from set_clock with all host access clocks on. No FIFO reads,
+	 * writes, IRQ acknowledgement or accesses from the sysfs reader.
+	 */
+	for (i = 0; i < ARRAY_SIZE(v.host); i++)
+		v.host[i] = readl(host->ioaddr + k4_sdio_host_offsets[i]);
+	for (i = 0; i < ARRAY_SIZE(v.iomux); i++)
+		v.iomux[i] = readl(d->diag_iomux + k4_sdio_iomux_offsets[i]);
+	for (i = 0; i < ARRAY_SIZE(v.ccm); i++)
+		v.ccm[i] = readl(d->diag_ccm + k4_sdio_ccm_offsets[i]);
+	for (i = 0; i < ARRAY_SIZE(v.gpio); i++)
+		v.gpio[i] = readl(d->diag_gpio + i * 4);
+	spin_lock_irqsave(&d->clock_snapshot_lock, flags);
+	v.sequence = ++d->diag_sequence;
+	if (clock >= 25000000 || d->diag_latest.requested < 25000000) {
+		for (i = 0; i < ARRAY_SIZE(k4_iomux_all_offsets); i++)
+			d->iomux_all[1][i] = readl(d->diag_iomux + k4_iomux_all_offsets[i]);
+		d->diag_latest = v;
+	}
+	if (!d->diag_first.sequence) {
+		d->diag_first = v;
+		memcpy(d->iomux_all[0], d->iomux_all[1], sizeof(d->iomux_all[0]));
+	}
+	spin_unlock_irqrestore(&d->clock_snapshot_lock, flags);
+}
+
+/* Reader copies cached control words only: never performs live MMIO. */
+static int k4_iomux_snapshot_show(struct seq_file *s, void *unused)
+{
+	struct pltfm_imx_data *d = s->private;
+	u32 (*v)[ARRAY_SIZE(k4_iomux_all_offsets)];
+	u32 sequence[3];
+	unsigned long flags;
+	unsigned int phase, i;
+	static const char * const names[] = { "first", "latest", "failure" };
+
+	v = kmalloc(sizeof(d->iomux_all), GFP_KERNEL);
+	if (!v)
+		return -ENOMEM;
+	spin_lock_irqsave(&d->clock_snapshot_lock, flags);
+	memcpy(v, d->iomux_all, sizeof(d->iomux_all));
+	sequence[0] = d->diag_first.sequence;
+	sequence[1] = d->diag_latest.sequence;
+	sequence[2] = d->diag_failed.sequence;
+	spin_unlock_irqrestore(&d->clock_snapshot_lock, flags);
+	for (phase = 0; phase < 3; phase++) {
+		seq_printf(s, "phase=%s sequence=%u words=%zu\n", names[phase],
+			   sequence[phase], ARRAY_SIZE(k4_iomux_all_offsets));
+		if (!sequence[phase])
+			continue;
+		for (i = 0; i < ARRAY_SIZE(k4_iomux_all_offsets); i++)
+			seq_printf(s, "IOMUX_%03x=%08x\n", k4_iomux_all_offsets[i], v[phase][i]);
+	}
+	kfree(v);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(k4_iomux_snapshot);
+
+static ssize_t register_snapshot_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct sdhci_host *host = dev_get_drvdata(dev);
+	struct sdhci_pltfm_host *pltfm = sdhci_priv(host);
+	struct pltfm_imx_data *d = sdhci_pltfm_priv(pltfm);
+	struct k4_sdio_registers v[2];
+	unsigned long flags;
+	unsigned int phase, i;
+	ssize_t n = 0;
+
+	spin_lock_irqsave(&d->clock_snapshot_lock, flags);
+	v[0] = d->diag_first;
+	v[1] = d->diag_latest;
+	spin_unlock_irqrestore(&d->clock_snapshot_lock, flags);
+	for (phase = 0; phase < 2; phase++) {
+		n += sysfs_emit_at(buf, n, "phase=%s sequence=%u requested=%u\n",
+			phase ? "latest" : "first", v[phase].sequence, v[phase].requested);
+		for (i = 0; i < ARRAY_SIZE(v[phase].host); i++)
+			n += sysfs_emit_at(buf, n, "ESDHC2_%03x=%08x\n", k4_sdio_host_offsets[i], v[phase].host[i]);
+		for (i = 0; i < ARRAY_SIZE(v[phase].iomux); i++)
+			n += sysfs_emit_at(buf, n, "IOMUX_%03x=%08x\n", k4_sdio_iomux_offsets[i], v[phase].iomux[i]);
+		for (i = 0; i < ARRAY_SIZE(v[phase].ccm); i++)
+			n += sysfs_emit_at(buf, n, "CCM_%03x=%08x\n", k4_sdio_ccm_offsets[i], v[phase].ccm[i]);
+		for (i = 0; i < ARRAY_SIZE(v[phase].gpio); i++)
+			n += sysfs_emit_at(buf, n, "GPIO5_%03x=%08x\n", i * 4, v[phase].gpio[i]);
+	}
+	return n;
+}
+static DEVICE_ATTR_RO(register_snapshot);
+static ssize_t failure_snapshot_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
