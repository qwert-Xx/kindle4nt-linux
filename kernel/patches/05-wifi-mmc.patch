+	for (phase = 0; phase < 1; phase++) {
+		n += sysfs_emit_at(buf, n, "phase=%s sequence=%u requested=%u\n",
+			"cmd52_error_irq", v[phase].sequence, v[phase].requested);
+		for (i = 0; i < ARRAY_SIZE(v[phase].host); i++)
+			n += sysfs_emit_at(buf, n, "ESDHC2_%03x=%08x\n", k4_sdio_host_offsets[i], v[phase].host[i]);
+		for (i = 0; i < ARRAY_SIZE(v[phase].iomux); i++)
+			n += sysfs_emit_at(buf, n, "IOMUX_%03x=%08x\n", k4_sdio_iomux_offsets[i], v[phase].iomux[i]);
+		for (i = 0; i < ARRAY_SIZE(v[phase].ccm); i++)
+			n += sysfs_emit_at(buf, n, "CCM_%03x=%08x\n", k4_sdio_ccm_offsets[i], v[phase].ccm[i]);
+		for (i = 0; i < ARRAY_SIZE(v[phase].gpio); i++)
+			n += sysfs_emit_at(buf, n, "GPIO5_%03x=%08x\n", i * 4, v[phase].gpio[i]);
+	}
+	return n;
+}
