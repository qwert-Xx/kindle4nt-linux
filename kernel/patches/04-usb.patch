+// SPDX-License-Identifier: GPL-2.0
+/* K4 peripheral PHY with a read-only gadget current budget provider. */
+#include <linux/atomic.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/usb/phy.h>
+
+#include "phy-generic.h"
+
+struct k4_usb_phy {
+	/* Generic PHY callbacks retrieve this first member via dev_get_drvdata. */
+	struct usb_phy_generic nop;
+	struct power_supply *supply;
+	atomic_t current_ma;
+};
+
+static enum power_supply_property k4_usb_properties[] = {
+	POWER_SUPPLY_PROP_CURRENT_MAX,
+};
+
+static int k4_usb_get_property(struct power_supply *supply,
+			      enum power_supply_property property,
+			      union power_supply_propval *value)
+{
+	struct k4_usb_phy *k4 = power_supply_get_drvdata(supply);
+
+	if (property != POWER_SUPPLY_PROP_CURRENT_MAX)
+		return -EINVAL;
+
+	value->intval = atomic_read(&k4->current_ma) * 1000;
+	return 0;
+}
+
+static const struct power_supply_desc k4_usb_supply_desc = {
+	.name = "k4-usb-budget",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = k4_usb_properties,
+	.num_properties = ARRAY_SIZE(k4_usb_properties),
+	.get_property = k4_usb_get_property,
+};
+
+static int k4_usb_set_power(struct usb_phy *phy, unsigned int ma)
+{
+	struct k4_usb_phy *k4 = dev_get_drvdata(phy->dev);
+	unsigned int budget = min(ma, 500U);
+
+	/* May run under the UDC spinlock: no SPI/I2C/regulator access here. */
+	if (atomic_xchg(&k4->current_ma, budget) != budget) {
+		dev_info(phy->dev, "gadget current budget %u mA\n", budget);
+		power_supply_changed(k4->supply);
+	}
+	return 0;
+}
+
+static void k4_usb_shutdown(struct usb_phy *phy)
+{
+	k4_usb_set_power(phy, 0);
+	usb_gen_phy_shutdown(phy);
+}
+
+static int k4_usb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct power_supply_config supply_config = {};
+	struct k4_usb_phy *k4;
+	int ret;
+
+	if (!of_machine_is_compatible("amazon,kindle-4"))
+		return -ENODEV;
+
+	k4 = devm_kzalloc(dev, sizeof(*k4), GFP_KERNEL);
+	if (!k4)
+		return -ENOMEM;
+	platform_set_drvdata(pdev, k4);
+	atomic_set(&k4->current_ma, 0);
+
+	ret = usb_phy_gen_create_phy(dev, &k4->nop);
+	if (ret)
+		return ret;
+
+	supply_config.drv_data = k4;
+	supply_config.of_node = dev->of_node;
+	/* A UDC suspend callback may lower the budget: do not wake ourselves. */
+	k4->supply = devm_power_supply_register_no_ws(dev, &k4_usb_supply_desc,
+						    &supply_config);
+	if (IS_ERR(k4->supply))
+		return dev_err_probe(dev, PTR_ERR(k4->supply),
+				     "cannot register USB current budget\n");
+
+	k4->nop.phy.init = usb_gen_phy_init;
+	k4->nop.phy.shutdown = k4_usb_shutdown;
+	k4->nop.phy.set_power = k4_usb_set_power;
+	k4->nop.phy.label = "k4-usb-phy";
+	return usb_add_phy_dev(&k4->nop.phy);
+}
+
+static void k4_usb_remove(struct platform_device *pdev)
+{
+	struct k4_usb_phy *k4 = platform_get_drvdata(pdev);
+
+	usb_remove_phy(&k4->nop.phy);
+}
+
+static const struct of_device_id k4_usb_match[] = {
+	{ .compatible = "amazon,k4-usb-phy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, k4_usb_match);
+
+static struct platform_driver k4_usb_driver = {
+	.probe = k4_usb_probe,
+	.remove_new = k4_usb_remove,
+	.driver = {
+		.name = "k4-usb-phy",
+		.of_match_table = k4_usb_match,
+	},
+};
+module_platform_driver(k4_usb_driver);
+
+MODULE_DESCRIPTION("Kindle K4 USB PHY gadget current budget");
+MODULE_LICENSE("GPL");
