+/* i.MX50 usb_common.c:708-712, 806-808: wrapper fields outside ARC. */
+static int usbmisc_imx50_init(struct imx_usbmisc_data *data)
+{
+	struct imx_usbmisc *usbmisc = dev_get_drvdata(data->dev);
+	unsigned long flags;
+	u32 ctrl, phy, clocks;
+
+	if (data->index > 1)
+		return -EINVAL;
+	spin_lock_irqsave(&usbmisc->lock, flags);
+	ctrl = readl(usbmisc->base);
+	phy = readl(usbmisc->base + MX53_USB_OTG_PHY_CTRL_0_OFFSET);
+	clocks = readl(usbmisc->base + MX53_USB_CLKONOFF_CTRL_OFFSET);
+	dev_dbg(data->dev, "imx50 USB%u before ctrl=%08x phy=%08x clocks=%08x\n",
+		data->index, ctrl, phy, clocks);
+	if (!data->index) {
+		ctrl &= ~BIT(24);
+		if (data->pwr_pol)
+			ctrl |= BIT(24);
+		writel(ctrl, usbmisc->base);
+	}
+	if (data->disable_oc) {
+		phy |= data->index ? MX53_BM_OVER_CUR_DIS_H1 :
+			MX53_BM_OVER_CUR_DIS_OTG;
+		writel(phy, usbmisc->base + MX53_USB_OTG_PHY_CTRL_0_OFFSET);
+	}
+	clocks &= ~BIT(17 + data->index);
+	writel(clocks, usbmisc->base + MX53_USB_CLKONOFF_CTRL_OFFSET);
+	spin_unlock_irqrestore(&usbmisc->lock, flags);
+	dev_info(data->dev, "imx50 USB%u ctrl=%08x phy=%08x clocks=%08x\n",
+		 data->index, ctrl, phy, clocks);
+	return 0;
+}
