+/* Hardware AUTO (8) selects automatic PWM/PFM in both normal and standby.
+ * Expose only the supported NORMAL policy; retain all other register fields.
+ */
+static unsigned int mc13892_sw_of_map_mode(unsigned int mode)
+{
+	return mode == 8 ? REGULATOR_MODE_NORMAL : REGULATOR_MODE_INVALID;
+}
+
+static int mc13892_sw_set_mode(struct regulator_dev *rdev, unsigned int mode)
+{
+	struct mc13xxx_regulator_priv *priv = rdev_get_drvdata(rdev);
+	int id = rdev_get_id(rdev), reg, shift, ret;
+
+	if (mode != REGULATOR_MODE_NORMAL || id < MC13892_SW1 || id > MC13892_SW4)
+		return -EINVAL;
+	reg = id < MC13892_SW3 ? MC13892_SWITCHERS4 : MC13892_SWITCHERS5;
+	shift = id == MC13892_SW2 ? 10 : id == MC13892_SW4 ? 8 : 0;
+	mc13xxx_lock(priv->mc13xxx);
+	ret = mc13xxx_reg_rmw(priv->mc13xxx, reg, 0xf << shift, 8 << shift);
+	mc13xxx_unlock(priv->mc13xxx);
+	return ret;
+}
+
+static unsigned int mc13892_sw_get_mode(struct regulator_dev *rdev)
+{
+	struct mc13xxx_regulator_priv *priv = rdev_get_drvdata(rdev);
+	int id = rdev_get_id(rdev), reg, shift, ret;
+	unsigned int value;
+
+	if (id < MC13892_SW1 || id > MC13892_SW4)
+		return REGULATOR_MODE_INVALID;
+	reg = id < MC13892_SW3 ? MC13892_SWITCHERS4 : MC13892_SWITCHERS5;
+	shift = id == MC13892_SW2 ? 10 : id == MC13892_SW4 ? 8 : 0;
+	mc13xxx_lock(priv->mc13xxx);
+	ret = mc13xxx_reg_read(priv->mc13xxx, reg, &value);
+	mc13xxx_unlock(priv->mc13xxx);
+	if (ret)
+		return REGULATOR_MODE_INVALID;
+	return mc13892_sw_of_map_mode((value >> shift) & 0xf);
+}
