+static ssize_t acquisition_state_show(struct device *dev,
+				      struct device_attribute *attr, char *buf)
+{
+	struct k4_papyrus_temp *p = i2c_get_clientdata(to_i2c_client(dev));
+	ssize_t length;
+
+	mutex_lock(&p->lock);
+	length = sysfs_emit(buf, "samples=%u last_error=%d irq_seen=%02x/%02x suspended=%u awake=%u display=%u vcom=%u power_error=%d shutdown_error=%d\n",
+			    p->samples, p->last_error, p->irq_seen[0], p->irq_seen[1],
+			    p->suspended, p->awake, p->display_on, p->vcom_on,
+			    p->power_error, p->shutdown_error);
+	mutex_unlock(&p->lock);
+	return length;
+}
+static DEVICE_ATTR_RO(acquisition_state);
+
+/* Non-clearing power/settings snapshot; does not trigger an acquisition. */
+static ssize_t rail_state_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	static const u8 regs[] = {
+		PAPYRUS_ENABLE, PAPYRUS_VP_ADJUST, PAPYRUS_VN_ADJUST,
+		PAPYRUS_VCOM_ADJUST, PAPYRUS_INT_ENABLE1, PAPYRUS_INT_ENABLE2,
+		PAPYRUS_PWR_SEQ0, PAPYRUS_PWR_SEQ1, PAPYRUS_PWR_SEQ2,
+		PAPYRUS_TMST_OS, PAPYRUS_TMST_HYST, PAPYRUS_PG_STATUS,
+	};
+	struct k4_papyrus_temp *p = i2c_get_clientdata(to_i2c_client(dev));
+	ssize_t length = 0;
+	int i, ret;
+
+	mutex_lock(&p->lock);
+	if (p->suspended || !p->awake) {
+		length = -EBUSY;
+		goto out;
+	}
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		ret = i2c_smbus_read_byte_data(p->client, regs[i]);
+		if (ret < 0) {
+			length = ret;
+			goto out;
+		}
+		length += sysfs_emit_at(buf, length, "%02x=%02x%c", regs[i], ret,
+					i == ARRAY_SIZE(regs) - 1 ? '\n' : ' ');
+	}
+out:
+	mutex_unlock(&p->lock);
+	return length;
+}
+static DEVICE_ATTR_RO(rail_state);
