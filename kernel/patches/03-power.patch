+static const struct power_supply_desc k4_charger_desc = {
+	.name = "k4-charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = k4_charger_props,
+	.num_properties = ARRAY_SIZE(k4_charger_props),
+	.get_property = k4_get_property,
+	.set_property = k4_set_property,
+	.property_is_writeable = k4_property_writeable,
+};
+
+static void k4_put_supply(void *data) { power_supply_put(data); }
+static void k4_put_gauge(void *data) { put_device(data); }
+
+static void k4_free_irqs(void *data)
+{
+	struct k4_charger *c = data;
+
+	while (c->irq_count)
+		mc13xxx_irq_free(c->pmic, k4_charge_irqs[--c->irq_count], c);
+}
+
+static void k4_unregister_notifier(void *data)
+{
+	struct k4_charger *c = data;
+
+	power_supply_unreg_notifier(&c->notifier);
+}
+
+static int k4_get_supply(struct k4_charger *c, const char *name,
+			 struct power_supply **supply)
+{
+	*supply = power_supply_get_by_phandle(k4_config_node(c->dev), name);
+	if (IS_ERR(*supply))
+		return PTR_ERR(*supply);
+	if (!*supply)
+		return -EPROBE_DEFER;
+	return devm_add_action_or_reset(c->dev, k4_put_supply, *supply);
+}
+
+static void k4_quiesce(struct platform_device *pdev)
+{
+	struct k4_charger *c = platform_get_drvdata(pdev);
+	int ret;
+
+	mutex_lock(&c->lock);
+	c->dying = true;
+	mutex_unlock(&c->lock);
+	cancel_delayed_work_sync(&c->work);
+	mutex_lock(&c->lock);
+	if (c->controlled) {
+		ret = k4_set_current(c, 0);
+		if (ret)
+			dev_err(c->dev, "shutdown stop failed: %d\n", ret);
+	}
+	k4_leds_update_locked(c);
+	mutex_unlock(&c->lock);
+}
+
+static void k4_cleanup(void *data)
+{
+	k4_quiesce(data);
+}
+
+static int k4_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *node;
+	struct power_supply_config config = {};
+	struct k4_charger *c;
+	u32 max_ua = 80000;
+	int ret;
+
+	if (of_find_property(k4_config_node(dev),
+			     "amazon,max-charge-current-microamp", NULL)) {
+		ret = of_property_read_u32(k4_config_node(dev),
+			"amazon,max-charge-current-microamp", &max_ua);
+		if (ret)
+			return ret;
+	}
+	if (max_ua < 80000 || max_ua > k4_current_ua[K4_CURRENT_CODES - 1])
+		return -EINVAL;
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	c->dev = dev;
+	c->pmic = dev_get_drvdata(dev->parent);
+	c->sample.error = -ENODATA;
+	c->reason = K4_CHARGE_READ_ERROR;
+	c->suspended = true;
+	c->board_max_code = k4_current_floor(max_ua);
+	c->limit_code = 1;
+	mutex_init(&c->lock);
+	INIT_DELAYED_WORK(&c->work, k4_work);
+	c->current_irq_due = jiffies;
+	atomic_set(&c->fault_seq, 0);
+	atomic_set_release(&c->current_irq_state, K4_CURRENT_IRQ_ENABLED);
+	platform_set_drvdata(pdev, c);
+	ret = k4_get_supply(c, "amazon,battery-supply", &c->battery);
+	if (ret)
+		return dev_err_probe(dev, ret, "battery supply unavailable\n");
+	ret = k4_get_supply(c, "amazon,usb-budget-supply", &c->usb);
+	if (ret)
+		return dev_err_probe(dev, ret, "USB budget unavailable\n");
+	if (of_find_property(k4_config_node(dev),
+			     "amazon,charger-detect-supply", NULL)) {
+		ret = k4_get_supply(c, "amazon,charger-detect-supply", &c->detector);
+		if (ret)
+			return dev_err_probe(dev, ret, "charger detector unavailable\n");
+		if (!c->detector->dev.parent)
+			return -EINVAL;
+		if (!device_link_add(dev, c->detector->dev.parent,
+				     DL_FLAG_AUTOREMOVE_CONSUMER))
+			return -ENOMEM;
+	}
+	node = of_parse_phandle(k4_config_node(dev), "amazon,battery-supply", 0);
+	if (!of_device_is_compatible(node, "ti,bq27210")) {
+		of_node_put(node);
+		return -EINVAL;
+	}
+	c->gauge = of_find_i2c_device_by_node(node);
+	of_node_put(node);
+	if (!c->gauge)
+		return -EPROBE_DEFER;
+	ret = devm_add_action_or_reset(dev, k4_put_gauge, &c->gauge->dev);
+	if (ret)
+		return ret;
+	if (!i2c_check_functionality(c->gauge->adapter,
+			I2C_FUNC_SMBUS_READ_BYTE_DATA | I2C_FUNC_SMBUS_READ_WORD_DATA))
+		return -EOPNOTSUPP;
+	if (!device_link_add(dev, &c->gauge->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+		return -ENOMEM;
+	config.drv_data = c;
+	c->supply = devm_power_supply_register_no_ws(dev, &k4_charger_desc, &config);
+	if (IS_ERR(c->supply))
+		return PTR_ERR(c->supply);
+	ret = k4_leds_init(c);
+	if (ret)
+		return ret;
+	/* On removal, stop event producers before cancelling the last work item. */
+	ret = devm_add_action_or_reset(dev, k4_cleanup, pdev);
+	if (ret)
+		return ret;
+	c->notifier.notifier_call = k4_notify;
+	ret = power_supply_reg_notifier(&c->notifier);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, k4_unregister_notifier, c);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, k4_free_irqs, c);
+	if (ret)
+		return ret;
+	for (; c->irq_count < ARRAY_SIZE(k4_charge_irqs); c->irq_count++) {
+		unsigned int irq = k4_charge_irqs[c->irq_count];
+
+		ret = mc13xxx_irq_request(c->pmic, irq,
+			(irq == 5 || irq == 7 || irq == 36 || irq == 37) ?
+				k4_fault_irq :
+			irq == MC13XXX_IRQ_CHGCURR ? k4_current_irq : k4_charge_irq,
+			"k4-charger", c);
+		if (ret)
+			return ret;
+	}
+	c->suspended = false;
+	queue_delayed_work(system_freezable_wq, &c->work, 0);
+	dev_info(dev, "observing; initial limit 80 mA, board maximum %u mA\n",
+		 k4_current_ua[c->board_max_code] / 1000);
+	return 0;
+}
+
+static void k4_suspend_irqs(struct k4_charger *c, bool mask)
+{
+	unsigned int i;
+
+	if (c->irqs_masked == mask)
+		return;
+	for (i = 0; i < c->irq_count; i++) {
+		if (mask)
+			mc13xxx_irq_mask(c->pmic, k4_charge_irqs[i]);
+		else
+			mc13xxx_irq_unmask(c->pmic, k4_charge_irqs[i]);
+	}
+	c->irqs_masked = mask;
+}
+
+static int k4_suspend(struct device *dev)
+{
+	struct k4_charger *c = dev_get_drvdata(dev);
+	struct k4_charge_sample battery = { 0 };
+	int voltage, ret;
+
+	mutex_lock(&c->lock);
+	/* Match stock: only a valid battery with a positive low voltage vetoes PM. */
+	battery.pack_id = i2c_smbus_read_byte_data(c->gauge, 0x7e);
+	ret = k4_property(c->battery, POWER_SUPPLY_PROP_PRESENT, &battery.present);
+	voltage = i2c_smbus_read_word_data(c->gauge, 0x08);
+	if (!ret && k4_pack_valid(&battery) && voltage > 0 && voltage <= 3420) {
+		mutex_unlock(&c->lock);
+		return -EBUSY;
+	}
+	c->suspended = true;
+	mutex_unlock(&c->lock);
+	cancel_delayed_work_sync(&c->work);
+	mutex_lock(&c->lock);
+	k4_leds_update_locked(c);
+	mutex_unlock(&c->lock);
+	/* Shared PMIC INT may now wake the SoC for the power button. */
+	k4_suspend_irqs(c, true);
+	return 0;
+}
+
+static int k4_resume(struct device *dev)
+{
+	struct k4_charger *c = dev_get_drvdata(dev);
+
+	/* Restore event delivery before allowing IRQs to queue new ADC work. */
+	k4_suspend_irqs(c, false);
+	mutex_lock(&c->lock);
+	c->suspended = false;
+	mutex_unlock(&c->lock);
+	queue_delayed_work(system_freezable_wq, &c->work, K4_POLL);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(k4_pm_ops, k4_suspend, k4_resume);
+
+static const struct of_device_id k4_charger_of_match[] = {
+	{ .compatible = "amazon,kindle-k4-mc13892-charger" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, k4_charger_of_match);
