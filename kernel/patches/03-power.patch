+static umode_t papyrus_visible(const void *data, enum hwmon_sensor_types type,
+			      u32 attr, int channel)
+{
+	return type == hwmon_temp && attr == hwmon_temp_input ? 0444 : 0;
+}
+
+static int papyrus_read(struct device *dev, enum hwmon_sensor_types type,
+			u32 attr, int channel, long *value)
+{
+	struct k4_papyrus_temp *p = dev_get_drvdata(dev);
+	bool notify = false;
+	int ret;
+
+	if (type != hwmon_temp || attr != hwmon_temp_input || channel)
+		return -EOPNOTSUPP;
+	mutex_lock(&p->lock);
+	ret = papyrus_temperature(p, value);
+	if (ret && p->display_on) {
+		p->power_error = ret;
+		papyrus_off(p);
+		notify = true;
+	}
+	mutex_unlock(&p->lock);
+	if (notify)
+		papyrus_notify(p);
+	return ret;
+}
+
+/* Stock papyrus-regulator.c:1014-1054 samples ambient every 60000 ms. */
+static void papyrus_temperature_work(struct work_struct *work)
+{
+	struct k4_papyrus_temp *p = container_of(to_delayed_work(work),
+					struct k4_papyrus_temp, temperature_work);
+	bool notify = false;
+	long temperature;
+	int ret;
+
+	mutex_lock(&p->lock);
+	if (p->suspended || p->stopping)
+		goto out;
+	ret = papyrus_sample(p, &temperature);
+	if (ret && p->display_on) {
+		p->power_error = ret;
+		papyrus_off(p);
+		notify = true;
+	}
+	mod_delayed_work(system_wq, &p->temperature_work,
+			 msecs_to_jiffies(PAPYRUS_TEMP_INTERVAL_MS));
+out:
+	mutex_unlock(&p->lock);
+	if (notify)
+		papyrus_notify(p);
+}
+
+static const struct hwmon_ops papyrus_hwmon_ops = {
+	.is_visible = papyrus_visible,
+	.read = papyrus_read,
+};
+
+int k4_papyrus_read_temperature(struct device *provider, long *temperature)
+{
+	struct k4_papyrus_temp *p = dev_get_drvdata(provider);
+
+	if (!temperature || !p || !READ_ONCE(p->ready))
+		return -ENODEV;
+	return papyrus_read(provider, hwmon_temp, hwmon_temp_input, 0, temperature);
+}
+EXPORT_SYMBOL_GPL(k4_papyrus_read_temperature);
+
+int k4_papyrus_cached_temperature(struct device *provider, long *temperature)
+{
+	struct k4_papyrus_temp *p = dev_get_drvdata(provider);
+	bool notify = false;
+	int ret = 0;
+
+	if (!temperature || !p || !READ_ONCE(p->ready))
+		return -ENODEV;
+	mutex_lock(&p->lock);
+	if (p->stopping) {
+		ret = -ENODEV;
+	} else if (p->temperature_valid) {
+		*temperature = p->temperature;
+	} else {
+		ret = papyrus_sample(p, temperature);
+		if (ret && p->display_on) {
+			p->power_error = ret;
+			papyrus_off(p);
+			notify = true;
+		}
+	}
+	mutex_unlock(&p->lock);
+	if (notify)
+		papyrus_notify(p);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(k4_papyrus_cached_temperature);
