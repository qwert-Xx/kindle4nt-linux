@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_K4_PROVIDER_H
+#define _LINUX_K4_PROVIDER_H
+#include <linux/device.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+struct k4_provider_ref {
+	struct device *dev;
+	struct module *owner;
+};
+
+static inline void k4_provider_release(void *data)
+{
+	struct k4_provider_ref *ref = data;
+
+	module_put(ref->owner);
+	put_device(ref->dev);
+}
+
+/* Takes the reference returned by of_find_*_device_by_node, including failure.
+ * Pin before reading provider private data; check its ready state afterwards.
+ * Deferred consumer probes unwind the reference through devres. Managed device
+ * links unbind consumers before their supplier; the module reference lasts until
+ * consumer devres teardown.
+ */
+static inline int devm_k4_provider_hold(struct device *consumer,
+				       struct device *provider)
+{
+	struct k4_provider_ref *ref;
+	int ret;
+
+	ref = devm_kzalloc(consumer, sizeof(*ref), GFP_KERNEL);
+	if (!ref) {
+		put_device(provider);
+		return -ENOMEM;
+	}
+	device_lock(provider);
+	if (!provider->driver || !try_module_get(provider->driver->owner)) {
+		device_unlock(provider);
+		put_device(provider);
+		return -EPROBE_DEFER;
+	}
+	ref->dev = provider;
+	ref->owner = provider->driver->owner;
+	device_unlock(provider);
+	if (!device_link_add(consumer, provider, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+		k4_provider_release(ref);
+		return -ENOMEM;
+	}
+	ret = devm_add_action_or_reset(consumer, k4_provider_release, ref);
+	return ret;
+}
+#endif
