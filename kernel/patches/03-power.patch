+static struct i2c_driver papyrus_driver = {
+	.probe = papyrus_probe,
+	.remove = papyrus_remove,
+	.shutdown = papyrus_remove,
+	.driver = {
+		.name = "k4-papyrus",
+		.of_match_table = papyrus_of_match,
+		.dev_groups = papyrus_groups,
+		.pm = pm_sleep_ptr(&papyrus_pm),
