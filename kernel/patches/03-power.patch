+static int mc13892_sw_set_suspend_voltage(struct regulator_dev *rdev, int uV)
+{
+	struct mc13xxx_regulator_priv *priv = rdev_get_drvdata(rdev);
+	int id = rdev_get_id(rdev), reg = mc13892_regulators[id].vsel_reg;
+	int base = 600000, selector, ret;
+	u32 value;
+
+	/* HI is shared with the live voltage: never change it to set standby. */
+	mc13xxx_lock(priv->mc13xxx);
+	ret = mc13xxx_reg_read(priv->mc13xxx, reg, &value);
+	if (ret)
+		goto out;
+	if (reg != MC13892_SWITCHERS0 && (value & MC13892_SWITCHERS0_SWxHI))
+		base = 1100000;
+	if (uV < base || uV > base + 31 * 25000 || (uV - base) % 25000) {
+		ret = -EINVAL;
+		goto out;
+	}
+	selector = (uV - base) / 25000;
+	ret = mc13xxx_reg_rmw(priv->mc13xxx, reg, MC13892_SWxSTBY_MASK,
+			      selector << MC13892_SWxSTBY_SHIFT);
+out:
+	mc13xxx_unlock(priv->mc13xxx);
+	return ret;
+}
