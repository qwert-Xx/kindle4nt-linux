+/* External bus buffer control; leave it on while clients may access the bus. */
+static int i2c_imx_enable_external_bus(struct device *dev)
+{
+	struct gpio_desc *enable;
+	u32 delay_ms = 0;
+	bool has_delay = device_property_present(dev, "bus-enable-delay-ms");
+	int ret;
+
+	if (has_delay) {
+		ret = device_property_read_u32(dev, "bus-enable-delay-ms", &delay_ms);
+		if (ret)
+			return dev_err_probe(dev, ret, "invalid bus enable delay\n");
+	}
+
+	/* Request high directly, without a low pulse on an inherited enable. */
+	enable = devm_gpiod_get_optional(dev, "bus-enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(enable))
+		return dev_err_probe(dev, PTR_ERR(enable), "can't enable I2C bus\n");
+	if (!enable) {
+		if (has_delay)
+			return dev_err_probe(dev, -EINVAL,
+					     "bus enable delay needs an enable GPIO\n");
+		return 0;
+	}
+
+	if (delay_ms)
+		msleep(delay_ms);
+	dev_info(dev, "external bus enabled (%u ms settle)\n", delay_ms);
+	return 0;
+}
