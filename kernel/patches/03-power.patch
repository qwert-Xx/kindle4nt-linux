+++ b/drivers/nvmem/k4-panel-flash.c
@@ -0,0 +1,232 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Read-only access to the factory NOR on a Kindle display panel. */
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/nvmem-provider.h>
+#include <linux/of.h>
+#include <linux/spi/spi.h>
+
+/* One full-duplex burst keeps native ECSPI chip select asserted. */
+#define K4_FLASH_PAYLOAD 24
+#define K4_FLASH_TRANSFER (4 + K4_FLASH_PAYLOAD)
+#define K4_FLASH_READ 0x03
+#define K4_FLASH_STATUS 0x05
+#define K4_FLASH_RDID 0x9f
+#define K4_FLASH_BUSY BIT(0)
+
+struct k4_flash_chip {
+	u8 id[3];
+	const char *name;
+	unsigned int size;
+};
+
+/* Full JEDEC IDs and geometry also appear in the upstream SPI NOR tables. */
+static const struct k4_flash_chip k4_flash_chips[] = {
+	{ { 0x20, 0x20, 0x12 }, "m25p20", 256 * 1024 },
+	{ { 0xc2, 0x20, 0x12 }, "mx25l2005a", 256 * 1024 },
+	{ { 0xc2, 0x25, 0x33 }, "mx25u4035", 512 * 1024 },
+	{ { 0xef, 0x30, 0x13 }, "w25x40", 512 * 1024 },
+	{ { 0xef, 0x50, 0x12 }, "w25q20bw", 256 * 1024 },
+};
+
+struct k4_flash {
+	struct spi_device *spi;
+	struct mutex lock;
+	bool stopped;
+	const struct k4_flash_chip *chip;
+	u8 *tx;
+	u8 *rx;
+};
+
+static int k4_flash_transfer(struct k4_flash *flash, size_t bytes)
+{
+	struct spi_transfer transfer = {
+		.tx_buf = flash->tx,
+		.rx_buf = flash->rx,
+		.len = bytes,
+	};
+	struct spi_message message;
+	int ret;
+
+	if (!bytes || bytes > K4_FLASH_TRANSFER)
+		return -EINVAL;
+	spi_message_init(&message);
+	spi_message_add_tail(&transfer, &message);
+	ret = spi_sync(flash->spi, &message);
+	if (ret)
+		return ret;
+	return message.actual_length == bytes ? 0 : -EIO;
+}
+
+static int k4_flash_status(struct k4_flash *flash)
+{
+	int ret;
+
+	memset(flash->tx, 0, 2);
+	flash->tx[0] = K4_FLASH_STATUS;
+	ret = k4_flash_transfer(flash, 2);
+	if (ret)
+		return ret;
+	return flash->rx[1] & K4_FLASH_BUSY ? -EBUSY : 0;
+}
+
+static int k4_flash_identify(struct k4_flash *flash)
+{
+	unsigned int i;
+	int ret;
+
+	memset(flash->tx, 0, 4);
+	flash->tx[0] = K4_FLASH_RDID;
+	ret = k4_flash_transfer(flash, 4);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(k4_flash_chips); i++) {
+		if (!memcmp(flash->rx + 1, k4_flash_chips[i].id, 3)) {
+			flash->chip = &k4_flash_chips[i];
+			return k4_flash_status(flash);
+		}
+	}
+	dev_err(&flash->spi->dev, "Unknown panel NOR JEDEC ID %02x%02x%02x\n",
+		flash->rx[1], flash->rx[2], flash->rx[3]);
+	return -ENODEV;
+}
+
+static int k4_flash_read(void *context, unsigned int offset,
+			 void *value, size_t bytes)
+{
+	struct k4_flash *flash = context;
+	u8 *out = value;
+	size_t count;
+	int ret = 0;
+
+	if (offset > flash->chip->size || bytes > flash->chip->size - offset)
+		return -EINVAL;
+	if (!bytes)
+		return 0;
+	mutex_lock(&flash->lock);
+	if (flash->stopped) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	ret = k4_flash_status(flash);
+	if (ret)
+		goto unlock;
+	while (bytes) {
+		count = min_t(size_t, bytes, K4_FLASH_PAYLOAD);
+		memset(flash->tx, 0, 4 + count);
+		flash->tx[0] = K4_FLASH_READ;
+		flash->tx[1] = offset >> 16;
+		flash->tx[2] = offset >> 8;
+		flash->tx[3] = offset;
+		ret = k4_flash_transfer(flash, 4 + count);
+		if (ret)
+			break;
+		memcpy(out, flash->rx + 4, count);
+		out += count;
+		offset += count;
+		bytes -= count;
+	}
+unlock:
+	mutex_unlock(&flash->lock);
+	return ret;
+}
+
+static ssize_t jedec_id_show(struct device *dev,
+			    struct device_attribute *attr, char *buf)
+{
+	struct k4_flash *flash = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%02x%02x%02x\n", flash->chip->id[0],
+			  flash->chip->id[1], flash->chip->id[2]);
+}
+static DEVICE_ATTR_RO(jedec_id);
+
+static struct attribute *k4_flash_attrs[] = {
+	&dev_attr_jedec_id.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(k4_flash);
+
+static int k4_flash_probe(struct spi_device *spi)
+{
+	struct nvmem_config config = { };
+	struct device *dev = &spi->dev;
+	struct k4_flash *flash;
+	int ret;
+
+	if (spi->mode != SPI_MODE_0 || spi->bits_per_word != 8)
+		return -EINVAL;
+	if (spi_max_transfer_size(spi) < K4_FLASH_TRANSFER ||
+	    spi_max_message_size(spi) < K4_FLASH_TRANSFER)
+		return -EMSGSIZE;
+	flash = devm_kzalloc(dev, sizeof(*flash), GFP_KERNEL);
+	if (!flash)
+		return -ENOMEM;
+	flash->spi = spi;
+	flash->tx = devm_kmalloc(dev, K4_FLASH_TRANSFER, GFP_KERNEL);
+	flash->rx = devm_kmalloc(dev, K4_FLASH_TRANSFER, GFP_KERNEL);
+	if (!flash->tx || !flash->rx)
+		return -ENOMEM;
+	mutex_init(&flash->lock);
+	ret = k4_flash_identify(flash);
+	if (ret)
+		return ret;
+	spi_set_drvdata(spi, flash);
+	config.dev = dev;
+	/* NVMEM consumers pin this module until their cells are released. */
+	config.owner = THIS_MODULE;
+	config.name = "k4-panel-flash";
+	config.id = NVMEM_DEVID_AUTO;
+	config.priv = flash;
+	config.size = flash->chip->size;
+	config.stride = 1;
+	config.word_size = 1;
+	config.read_only = true;
+	config.root_only = true;
+	config.reg_read = k4_flash_read;
+	ret = PTR_ERR_OR_ZERO(devm_nvmem_register(dev, &config));
+	if (ret)
+		return ret;
+	dev_info(dev, "%s: %u bytes, read-only factory data\n",
+		 flash->chip->name, flash->chip->size);
+	return 0;
+}
+
+static void k4_flash_remove(struct spi_device *spi)
+{
+	struct k4_flash *flash = spi_get_drvdata(spi);
+
+	/* Consumer links release cells first. Drain spi_sync before devres
+	 * unregisters nvmem and frees its callback context and transfer buffers.
+	 */
+	mutex_lock(&flash->lock);
+	flash->stopped = true;
+	mutex_unlock(&flash->lock);
+}
+
+static const struct of_device_id k4_flash_of_match[] = {
+	{ .compatible = "amazon,kindle-panel-flash" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, k4_flash_of_match);
+
+static const struct spi_device_id k4_flash_ids[] = {
+	{ "kindle-panel-flash", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, k4_flash_ids);
+
+static struct spi_driver k4_flash_driver = {
+	.driver = {
+		.name = "k4-panel-flash",
+		.of_match_table = k4_flash_of_match,
+		.dev_groups = k4_flash_groups,
+	},
+	.probe = k4_flash_probe,
+	.remove = k4_flash_remove,
+	.id_table = k4_flash_ids,
+};
+module_spi_driver(k4_flash_driver);
+
+MODULE_DESCRIPTION("Read-only Kindle panel SPI NOR factory data");
+MODULE_LICENSE("GPL");
