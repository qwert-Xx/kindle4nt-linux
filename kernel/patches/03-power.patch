+static enum power_supply_property k4_charger_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX,
+};
+
+static int k4_get_property(struct power_supply *supply,
+			   enum power_supply_property property,
+			   union power_supply_propval *value)
+{
+	struct k4_charger *c = power_supply_get_drvdata(supply);
+	unsigned int code;
+	int ret = 0;
+
+	mutex_lock(&c->lock);
+	if (property == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX) {
+		value->intval = k4_current_ua[c->limit_code];
+		goto out;
+	}
+	if (c->sample.error) {
+		ret = c->sample.error;
+		goto out;
+	}
+	switch (property) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		value->intval = !!(c->sample.sense0 & 0x40);
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		value->intval = c->full ? POWER_SUPPLY_STATUS_FULL :
+			(c->sample.current_ua > 0 && (c->sample.sense0 & 0x80) ?
+			 POWER_SUPPLY_STATUS_CHARGING : POWER_SUPPLY_STATUS_NOT_CHARGING);
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		code = (c->sample.charger0 & K4_CURRENT_MASK) >> 3;
+		if (code >= K4_CURRENT_CODES)
+			ret = -ENODATA;
+		else
+			value->intval = k4_current_ua[code];
+		break;
+	default:
+		ret = -EINVAL;
+	}
+out:
+	mutex_unlock(&c->lock);
+	return ret;
+}
+
+static int k4_set_property(struct power_supply *supply,
+			   enum power_supply_property property,
+			   const union power_supply_propval *value)
+{
+	struct k4_charger *c = power_supply_get_drvdata(supply);
+	unsigned int code;
+	int ret = 0;
+
+	if (property != POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX)
+		return -EINVAL;
+	if (value->intval < 0 || value->intval > k4_current_ua[c->board_max_code])
+		return -EINVAL;
+	code = k4_current_floor(value->intval);
+	mutex_lock(&c->lock);
+	if (code > c->board_max_code) {
+		ret = -EINVAL;
+	} else if (c->suspended || c->dying) {
+		ret = -EBUSY;
+	} else {
+		c->limit_code = code;
+		if (c->controlled) {
+			k4_update_locked(c);
+			ret = c->write_error;
+		}
+	}
+	mutex_unlock(&c->lock);
+	power_supply_changed(c->supply);
+	return ret;
+}
+
+static int k4_property_writeable(struct power_supply *supply,
+				 enum power_supply_property property)
+{
+	return property == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX;
+}
