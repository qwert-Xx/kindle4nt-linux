+// SPDX-License-Identifier: GPL-2.0-only
+/* Tequila charger policy. See porting/CHARGE-POLICY.md. */
+#include <linux/atomic.h>
+#include <linux/i2c.h>
+#include <linux/jiffies.h>
+#include <linux/leds.h>
+#include <linux/mfd/mc13xxx.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/power_supply.h>
+#include <linux/timekeeping.h>
+#include <linux/workqueue.h>
+
+#include "k4-charge-policy.h"
+
+#define K4_CHARGER0 48
+#define K4_POLL (2 * HZ)
+/* Tequila's original policy allows one restart of the 120 minute charger. */
+#define K4_BATTERY_RETRIES 1
+#define K4_RECOVERY_NS (10ULL * NSEC_PER_SEC)
+/* Gauge properties may be cached for five seconds after a DAC change. */
+#define K4_CURRENT_SETTLE (6 * HZ)
+
+/* IRQ APIs may sleep on the regmap bus; publish completed operations only. */
+enum k4_current_irq_state {
+	K4_CURRENT_IRQ_ENABLED,
+	K4_CURRENT_IRQ_MASKING,
+	K4_CURRENT_IRQ_MASKED,
+	K4_CURRENT_IRQ_UNMASKING,
+};
+
+struct k4_charger {
+	struct device *dev;
+	struct mc13xxx *pmic;
+	struct i2c_client *gauge;
+	struct power_supply *battery, *usb, *detector, *supply;
+	int gadget_ua, detector_ua;
+	struct mutex lock;
+	struct delayed_work work;
+	struct notifier_block notifier;
+	struct k4_charge_sample sample;
+	struct k4_charge_range range;
+	enum k4_charge_reason reason;
+	atomic_t fault_seq, current_irq_state;
+	unsigned int checked_fault_seq, battery_retries;
+	u64 healthy_since;
+	bool recovery_healthy;
+	unsigned long sampled_at, current_changed, current_irq_due;
+	int full, write_error;
+	int green_latched;
+	bool controlled, initialized, release_pending, suspended, dying;
+	/* Legacy field name: now tracks original software BPON hysteresis. */
+	bool precharge;
+	u64 bpon_restart_at;
+	bool irqs_masked;
+	unsigned int irq_count;
+	unsigned int board_max_code, limit_code;
+#ifdef CONFIG_CHARGER_K4_MC13892_LEDS
+	struct led_trigger charging_trigger, full_trigger;
+	bool led_triggers;
+#endif
+};
+
+static struct device_node *k4_config_node(struct device *dev)
+{
+	/* An attached child never falls back to the parent's supply properties. */
+	return dev->of_node ? dev->of_node : dev->parent->of_node;
+}
+
+static bool k4_fault_pending(struct k4_charger *c)
+{
+	return (unsigned int)atomic_read(&c->fault_seq) != c->checked_fault_seq;
+}
+
+#ifdef CONFIG_CHARGER_K4_MC13892_LEDS
+static void k4_leds_update_locked(struct k4_charger *c)
+{
+	enum k4_charge_indicator state;
+
+	if (!c->led_triggers)
+		return;
+	state = k4_stock_charge_indicator(&c->sample, c->reason,
+		c->suspended || c->dying || c->write_error ||
+		k4_fault_pending(c), &c->green_latched);
+	led_trigger_event(&c->charging_trigger,
+		state == K4_INDICATOR_CHARGING ? LED_FULL : LED_OFF);
+	led_trigger_event(&c->full_trigger,
+		state == K4_INDICATOR_FULL ? LED_FULL : LED_OFF);
+}
+
+static int k4_leds_init(struct k4_charger *c)
+{
+	int ret;
+
+	if (!of_property_read_bool(k4_config_node(c->dev),
+				   "amazon,charge-led-triggers"))
+		return 0;
+	c->charging_trigger.name = "k4-charge-active";
+	c->full_trigger.name = "k4-charge-full";
+	ret = devm_led_trigger_register(c->dev, &c->charging_trigger);
+	if (ret)
+		return ret;
+	ret = devm_led_trigger_register(c->dev, &c->full_trigger);
+	if (ret)
+		return ret;
+	c->led_triggers = true;
+	return 0;
+}
+#else
+static void k4_leds_update_locked(struct k4_charger *c) { }
+static int k4_leds_init(struct k4_charger *c)
+{
+	return of_property_read_bool(k4_config_node(c->dev),
+				    "amazon,charge-led-triggers") ? -EOPNOTSUPP : 0;
+}
+#endif
+
+/* MC13892 CHGFAULT is IRQ 7; generic CHGREV/CHGSHORT are different events. */
+static const unsigned int k4_charge_irqs[] = { 5, 6, 7, 11, 12, 36, 37 };
+
+static int k4_property(struct power_supply *supply,
+		       enum power_supply_property property, int *value)
+{
+	union power_supply_propval v;
+	int ret = power_supply_get_property(supply, property, &v);
+
+	if (!ret)
+		*value = v.intval;
+	return ret;
+}
+
+/* Caller holds c->lock. Fresh detector errors must not reuse a wall budget. */
+static int k4_source_budget(struct k4_charger *c, int *budget)
+{
+	int gadget = 0, detector = 0, ret;
+
+	*budget = 0;
+	c->gadget_ua = 0;
+	c->detector_ua = 0;
+	c->sample.usb_suspended = 0;
+	ret = k4_property(c->usb, POWER_SUPPLY_PROP_CURRENT_MAX, &gadget);
+	if (ret)
+		return ret;
+	if (c->detector) {
+		ret = k4_property(c->detector, POWER_SUPPLY_PROP_CURRENT_MAX, &detector);
+		if (ret)
+			return ret;
+	}
+	if (gadget < 0 || detector < 0)
+		return -EINVAL;
+	c->gadget_ua = gadget;
+	c->sample.usb_suspended = gadget == 2000;
+	c->detector_ua = detector;
+	*budget = max(gadget, detector);
+	return 0;
+}
+
+static int k4_sample(struct k4_charger *c, struct k4_charge_sample *s)
+{
+	unsigned int samples[4];
+	int ret;
+
+	memset(s, 0, sizeof(*s));
+	/* The ID byte is board data, not cryptographic battery authentication. */
+	ret = i2c_smbus_read_byte_data(c->gauge, 0x7e);
+	if (ret < 0)
+		return ret;
+	s->pack_id = ret;
+	/* Fresh BQ27210 temperature and voltage for the charge phase decision. */
+	ret = i2c_smbus_read_word_data(c->gauge, 0x06);
+	if (ret < 0)
+		return ret;
+	s->temp_decic = ret * 5 / 2 - 2731;
+	ret = i2c_smbus_read_word_data(c->gauge, 0x08);
+	if (ret < 0)
+		return ret;
+	s->voltage_uv = ret * 1000;
+	ret = k4_property(c->battery, POWER_SUPPLY_PROP_PRESENT, &s->present);
+	if (ret)
+		return ret;
+	ret = k4_property(c->battery, POWER_SUPPLY_PROP_CURRENT_NOW, &s->current_ua);
+	if (ret)
+		return ret;
+	ret = k4_property(c->battery, POWER_SUPPLY_PROP_CAPACITY, &s->capacity);
+	if (ret)
+		return ret;
+	ret = k4_source_budget(c, &s->usb_ua);
+	s->usb_suspended = c->gadget_ua == 2000;
+	if (ret)
+		return ret;
+	ret = mc13xxx_adc_do_conversion(c->pmic, MC13XXX_ADC_MODE_MULT_CHAN,
+				       3, 0, false, samples);
+	if (ret)
+		return ret;
+	s->input_mv = DIV_ROUND_CLOSEST(((samples[3] >> 2) & 0x3ff) * 12000, 1024);
+	mc13xxx_lock(c->pmic);
+	ret = mc13xxx_reg_read(c->pmic, 2, &s->sense0);
+	if (!ret)
+		ret = mc13xxx_reg_read(c->pmic, 5, &s->sense1);
+	if (!ret)
+		ret = mc13xxx_reg_read(c->pmic, 6, &s->powerup_sense);
+	if (!ret)
+		ret = mc13xxx_reg_read(c->pmic, K4_CHARGER0, &s->charger0);
+	mc13xxx_unlock(c->pmic);
+	return ret;
+}
+
+static int k4_apply_current(struct k4_charger *c, unsigned int code,
+			    bool retry_battery)
+{
+	unsigned int reg, sense, thermal, verify, fault;
+	unsigned int mask = K4_CURRENT_MASK, value = code << 3;
+	int ret, budget;
+	bool low_restart = c->precharge && c->sample.voltage_uv <= 3400000 &&
+		ktime_get_boottime_ns() >= c->bpon_restart_at + 10ULL * NSEC_PER_SEC;
+
+	if (code >= K4_CURRENT_CODES || code > c->board_max_code || code > c->limit_code)
+		return -EINVAL;
+	if (code) {
+		ret = k4_source_budget(c, &budget);
+		if (ret)
+			return ret;
+		c->sample.usb_ua = budget;
+		if (k4_fault_pending(c))
+			return -EINTR;
+	}
+	mc13xxx_lock(c->pmic);
+	ret = mc13xxx_reg_read(c->pmic, K4_CHARGER0, &reg);
+	if (ret)
+		goto out;
+	if (code) {
+		ret = mc13xxx_reg_read(c->pmic, 2, &sense);
+		if (ret)
+			goto out;
+		c->sample.sense0 = sense;
+		ret = mc13xxx_reg_read(c->pmic, 5, &thermal);
+		if (ret)
+			goto out;
+		c->sample.sense1 = thermal;
+		fault = (sense & K4_CHGFAULT_MASK) >> 8;
+		if (!k4_charge_mode_valid(reg) ||
+		    (sense & K4_USBOVS) || (thermal & K4_THWARN_MASK) ||
+		    (fault && !(retry_battery && fault == 2)) ||
+		    k4_fault_pending(c)) {
+			ret = -EPERM;
+			goto out;
+		}
+		if (!(sense & K4_CHGDETS) ||
+		    code > k4_source_code(&c->sample)) {
+			ret = -EAGAIN;
+			goto out;
+		}
+		/* A cleared fault no longer requires a battery-fault retry. */
+		if (!fault)
+			retry_battery = false;
+		if (retry_battery && c->battery_retries >= K4_BATTERY_RETRIES) {
+			ret = -EPERM;
+			goto out;
+		}
+	}
+	/* Even after RESETB, take DAC control and disable software trickle.
+	 * Otherwise ICHRG=0 alone can be superseded by the automatic defaults.
+	 */
+	if (!code) {
+		mask |= K4_TREN | K4_CHGAUTOVIB;
+		value |= K4_CHGAUTOVIB;
+	}
+	if (retry_battery || (code && low_restart) || (reg & mask) != value) {
+		/* Leaving our zero-current stop needs a new automatic charge cycle.
+		 * Do not replay inherited commands. Only stock low-voltage BPON
+		 * may periodically restart an already running charge cycle.
+		 */
+		if (code && (!(reg & K4_CURRENT_MASK) || retry_battery || low_restart))
+			value |= K4_CHGRESTART;
+		/* Count a write that may take effect even if SPI reports failure. */
+		if (code && retry_battery)
+			c->battery_retries++;
+		ret = mc13xxx_reg_rmw(c->pmic, K4_CHARGER0,
+				     mask | K4_CHARGE_COMMANDS, value);
+		if (ret)
+			goto out;
+		c->current_changed = jiffies;
+		c->sample.current_settled = 0;
+		value &= ~K4_CHARGE_COMMANDS;
+		dev_info(c->dev, "current code %u -> %u\n",
+			 (reg & K4_CURRENT_MASK) >> 3, code);
+	}
+	ret = mc13xxx_reg_read(c->pmic, K4_CHARGER0, &verify);
+	if (!ret && (verify & mask) != value)
+		ret = -EIO;
+	if (!ret && code && !k4_charge_mode_valid(verify))
+		ret = -EIO;
+	if (!ret && code && k4_fault_pending(c))
+		ret = -EINTR;
+	if (!ret) {
+		c->sample.charger0 = verify;
+		if (code && low_restart)
+			c->bpon_restart_at = ktime_get_boottime_ns();
+	}
+out:
+	mc13xxx_unlock(c->pmic);
+	/* Budget can fall while SPI is in flight. The caller stops on this race. */
+	if (!ret && code) {
+		ret = k4_source_budget(c, &budget);
+		if (!ret) {
+			c->sample.usb_ua = budget;
+			if (code > k4_source_code(&c->sample))
+				ret = -EAGAIN;
+		}
+	}
+	return ret;
+}
+
+static int k4_set_current(struct k4_charger *c, unsigned int code)
+{
+	return k4_apply_current(c, code, false);
+}
+
+static int k4_init_charge(struct k4_charger *c)
+{
+	unsigned int reg;
+	unsigned int mask = K4_CHARGE_PROFILE_MASK | K4_CURRENT_MASK | K4_TREN;
+	unsigned int profile = K4_CHARGE_PROFILE | (c->precharge ? K4_CHGAUTOB : 0);
+	int ret;
+
+	/* A separate, verified stop precedes changing voltage/mode settings. */
+	ret = k4_set_current(c, 0);
+	if (ret)
+		return ret;
+	/* Internal trickle/LPB needs distinct M3 ownership, unlike single path. */
+	if (!k4_charge_path_valid(&c->sample))
+		return -EOPNOTSUPP;
+	mc13xxx_lock(c->pmic);
+	ret = mc13xxx_reg_read(c->pmic, K4_CHARGER0, &reg);
+	if (ret)
+		goto out;
+	/* Switching the battery path or USB reverse supply is not implemented. */
+	if (reg & (K4_FETOVRD | K4_RVRSMODE)) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if ((reg & mask) != profile) {
+		ret = mc13xxx_reg_rmw(c->pmic, K4_CHARGER0,
+				     mask | K4_CHARGE_COMMANDS, profile);
+		if (ret)
+			goto out;
+	}
+	ret = mc13xxx_reg_read(c->pmic, K4_CHARGER0, &reg);
+	if (!ret && ((reg & mask) != profile ||
+		     !k4_charge_mode_valid(reg)))
+		ret = -EIO;
+	if (!ret)
+		c->sample.charger0 = reg;
+out:
+	mc13xxx_unlock(c->pmic);
+	return ret;
+}
+
+static int k4_release_control(struct k4_charger *c)
+{
+	int ret;
+
+	/* Keep the user's stop request even if this transfer fails. */
+	c->release_pending = true;
+	c->recovery_healthy = false;
+	ret = k4_set_current(c, 0);
+	c->write_error = ret;
+	if (!ret) {
+		c->controlled = false;
+		c->release_pending = false;
+	} else {
+		c->initialized = false;
+	}
+	return ret;
+}
+
+static bool k4_recovery_ready(struct k4_charger *c, unsigned int *target)
+{
+	struct k4_charge_sample safe = c->sample;
+	int full = c->full;
+	u64 now = ktime_get_boottime_ns();
+
+	/* Code 2 means either battery collapse or timeout, not timeout alone. */
+	if (safe.error || (safe.sense0 & K4_CHGFAULT_MASK) != 0x200 ||
+	    c->battery_retries >= K4_BATTERY_RETRIES ||
+	    !c->limit_code)
+		goto unhealthy;
+	/* Requalify every other guard without treating our stop as termination. */
+	safe.sense0 &= ~K4_CHGFAULT_MASK;
+	safe.current_settled = 0;
+	if (k4_charge_decide(&safe, k4_fault_pending(c), &full) != K4_CHARGE_ELIGIBLE)
+		goto unhealthy;
+	c->reason = K4_CHARGE_RECOVERY_WAIT;
+	if (!c->recovery_healthy) {
+		c->healthy_since = now;
+		c->recovery_healthy = true;
+		return false;
+	}
+	if (now < c->healthy_since || now - c->healthy_since < K4_RECOVERY_NS)
+		return false;
+	*target = k4_charge_target(&safe, K4_CHARGE_ELIGIBLE, c->limit_code);
+	return true;
+unhealthy:
+	c->recovery_healthy = false;
+	return false;
+}
+
+static void k4_update_locked(struct k4_charger *c)
+{
+	unsigned int sampled_seq = atomic_read(&c->fault_seq), target;
+	bool retry_battery, previous_bpon;
+	int ret;
+
+	c->sample.error = k4_sample(c, &c->sample);
+	k4_charge_ranges(&c->sample, &c->range, ktime_get_boottime_ns());
+	previous_bpon = c->precharge;
+	c->precharge = k4_precharge_next(&c->sample, c->precharge);
+	if (previous_bpon != c->precharge) {
+		c->initialized = false;
+		c->bpon_restart_at = ktime_get_boottime_ns();
+	}
+	c->sample.precharge = c->precharge;
+	/* A newer interrupt cannot be erased by completing an older sample. */
+	if (!c->sample.error)
+		c->checked_fault_seq = sampled_seq;
+	c->sampled_at = jiffies;
+	c->sample.current_settled = c->initialized &&
+		time_after_eq(jiffies, c->current_changed + K4_CURRENT_SETTLE);
+	/* USB gadget disconnect alone is not loss of the physical input. */
+	if (!c->sample.error && !(c->sample.sense0 & K4_CHGDETS) &&
+	    !c->sample.usb_ua && c->sample.input_mv < 4400) {
+		c->battery_retries = 0;
+		c->recovery_healthy = false;
+	}
+	if (c->controlled && c->release_pending) {
+		c->reason = k4_charge_decide(&c->sample,
+				k4_fault_pending(c), &c->full);
+		k4_release_control(c);
+		return;
+	}
+	/* Initialize only under explicit ownership, using a complete sample.
+	 * A reset or transient bus error is retried from a verified stop.
+	 */
+	if (c->controlled && !c->sample.error &&
+	    !k4_fault_pending(c) &&
+	    (!c->initialized || !k4_charge_mode_valid(c->sample.charger0))) {
+		ret = k4_init_charge(c);
+		if (ret) {
+			if (!k4_charge_path_valid(&c->sample))
+				c->reason = K4_CHARGE_PATH;
+			else
+				c->reason = K4_CHARGE_MODE;
+			goto failed;
+		}
+		c->initialized = true;
+	}
+	c->reason = k4_charge_decide(&c->sample, k4_fault_pending(c),
+				   &c->full);
+	if (!c->controlled) {
+		c->recovery_healthy = false;
+		return;
+	}
+	target = k4_charge_target(&c->sample, c->reason, c->limit_code);
+	retry_battery = k4_recovery_ready(c, &target);
+	ret = k4_apply_current(c, target, retry_battery);
+	if (ret == -EAGAIN) {
+		/* Normal unplug/enumeration races are not latched hardware faults. */
+		c->reason = c->sample.sense0 & 0x40 ?
+			K4_CHARGE_USB_BUDGET : K4_CHARGE_NO_INPUT;
+		ret = k4_set_current(c, 0);
+	}
+	if (!ret) {
+		c->write_error = 0;
+		if (retry_battery) {
+			c->initialized = true;
+			c->recovery_healthy = false;
+		}
+		return;
+	}
+failed:
+	/* Retry transport failures after fresh sampling and a verified stop.
+	 * Hardware fault state and the active-time budget remain independent.
+	 */
+	c->initialized = false;
+	c->recovery_healthy = false;
+	c->write_error = ret;
+	ret = k4_set_current(c, 0);
+	dev_err_ratelimited(c->dev, "charge write failed %d; stop result %d\n",
+			    c->write_error, ret);
+}
+
+/* The threaded handler cannot take c->lock: ADC completion shares its parent
+ * IRQ thread. An in-progress mask must never cause an early enable_irq().
+ * The next periodic sample retries rearming after such an interleaving.
+ */
+static void k4_current_irq_coalesce(struct k4_charger *c)
+{
+	if (atomic_cmpxchg(&c->current_irq_state, K4_CURRENT_IRQ_ENABLED,
+			   K4_CURRENT_IRQ_MASKING) != K4_CURRENT_IRQ_ENABLED)
+		return;
+	mc13xxx_irq_mask(c->pmic, MC13XXX_IRQ_CHGCURR);
+	atomic_set_release(&c->current_irq_state, K4_CURRENT_IRQ_MASKED);
+}
+
+static void k4_current_irq_rearm(struct k4_charger *c)
+{
+	if (atomic_cmpxchg(&c->current_irq_state, K4_CURRENT_IRQ_MASKED,
+			   K4_CURRENT_IRQ_UNMASKING) != K4_CURRENT_IRQ_MASKED)
+		return;
+	mc13xxx_irq_unmask(c->pmic, MC13XXX_IRQ_CHGCURR);
+	atomic_set_release(&c->current_irq_state, K4_CURRENT_IRQ_ENABLED);
+}
+
+static void k4_work(struct work_struct *work)
+{
+	struct k4_charger *c = container_of(to_delayed_work(work),
+					   struct k4_charger, work);
+
+	mutex_lock(&c->lock);
+	if (!c->suspended && !c->dying) {
+		/* Close the CHGCURR sampling window before ADC can raise an event. */
+		WRITE_ONCE(c->current_irq_due, jiffies + K4_POLL);
+		k4_current_irq_rearm(c);
+		k4_update_locked(c);
+		k4_leds_update_locked(c);
+		/* Do not replace an immediate event already queued by a notifier. */
+		queue_delayed_work(system_freezable_wq, &c->work, K4_POLL);
+	}
+	mutex_unlock(&c->lock);
+	power_supply_changed(c->supply);
+}
+
+static void k4_queue(struct k4_charger *c)
+{
+	if (!READ_ONCE(c->suspended) && !READ_ONCE(c->dying))
+		mod_delayed_work(system_freezable_wq, &c->work, 0);
+}
+
+static int k4_notify(struct notifier_block *notifier, unsigned long event, void *data)
+{
+	struct k4_charger *c = container_of(notifier, struct k4_charger, notifier);
+
+	if (event == PSY_EVENT_PROP_CHANGED &&
+	    (data == c->usb || data == c->battery || data == c->detector))
+		k4_queue(c);
+	return NOTIFY_OK;
+}
+
+/* CHGCURR is a current-threshold edge, not a protection fault.  Repeated
+ * edges must not turn the two-second poll into continuous ADC conversions.
+ * Mask this child IRQ until the next sample; latched threshold edges are
+ * reconciled from fresh sense/current readings. Protection IRQs stay enabled.
+ * queue_delayed_work coalesces them without postponing an earlier urgent work.
+ */
+static irqreturn_t k4_current_irq(int irq, void *data)
+{
+	struct k4_charger *c = data;
+	unsigned long now = jiffies, due = READ_ONCE(c->current_irq_due);
+	unsigned long delay = time_before(now, due) ? due - now : 0;
+
+	if (!READ_ONCE(c->suspended) && !READ_ONCE(c->dying)) {
+		k4_current_irq_coalesce(c);
+		queue_delayed_work(system_freezable_wq, &c->work, delay);
+	}
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t k4_charge_irq(int irq, void *data)
+{
+	struct k4_charger *c = data;
+
+	k4_queue(c);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t k4_fault_irq(int irq, void *data)
+{
+	struct k4_charger *c = data;
+
+	atomic_inc(&c->fault_seq);
+	k4_queue(c);
+	return IRQ_HANDLED;
+}
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct k4_charger *c = dev_get_drvdata(dev);
+	struct k4_charge_sample *s = &c->sample;
+	ssize_t len;
+
+	mutex_lock(&c->lock);
+	len = sysfs_emit(buf,
+		"control=%u reason=%s error=%d write_error=%d fault=%d full=%d age_ms=%u\n"
+		"id=%d present=%d temp_decic=%d voltage_uv=%d current_ua=%d capacity=%d\n"
+		"usb_ua=%d input_mv=%d sense0=0x%06x sense1=0x%06x charger0=0x%06x code=%u\n"
+		"limit_code=%u board_max_code=%u target_code=%u initialized=%u release_pending=%u\n"
+		"battery_retries=%u fault_code=%u fault_seq=%u\n"
+		"budget_code=%u powerup_sense=0x%06x serial_path=%u low_power_boot=%u bpon=%u\n"
+		"gadget_ua=%d detector_ua=%d detector_present=%u\n",
+		c->controlled, k4_charge_reason_name(c->reason), s->error,
+		c->write_error, k4_fault_pending(c) ||
+			(s->sense0 & (K4_USBOVS | K4_CHGFAULT_MASK)) ||
+			(s->sense1 & K4_THWARN_MASK),
+		c->full,
+		jiffies_to_msecs(jiffies - c->sampled_at), s->pack_id, s->present,
+		s->temp_decic, s->voltage_uv, s->current_ua, s->capacity, s->usb_ua,
+		s->input_mv, s->sense0, s->sense1, s->charger0,
+		(s->charger0 & K4_CURRENT_MASK) >> 3,
+		c->limit_code, c->board_max_code,
+		c->controlled && !c->release_pending ?
+			k4_charge_target(s, c->reason, c->limit_code) : 0,
+		c->initialized, c->release_pending,
+		c->battery_retries, (s->sense0 & K4_CHGFAULT_MASK) >> 8,
+		(unsigned int)atomic_read(&c->fault_seq),
+		k4_budget_code(s->usb_ua), s->powerup_sense,
+		!!(s->powerup_sense & K4_CHRGSSS), !!(s->sense1 & K4_LPBS),
+		c->precharge, c->gadget_ua, c->detector_ua, !!c->detector);
+	mutex_unlock(&c->lock);
+	return len;
+}
+static DEVICE_ATTR_RO(state);
+
+static ssize_t control_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct k4_charger *c = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", READ_ONCE(c->controlled));
+}
+
+static ssize_t control_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct k4_charger *c = dev_get_drvdata(dev);
+	bool enable;
+	int ret = kstrtobool(buf, &enable);
+
+	if (ret)
+		return ret;
+	mutex_lock(&c->lock);
+	if (c->suspended || c->dying) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (enable && (!c->controlled || c->release_pending)) {
+		k4_update_locked(c);
+		if (c->release_pending) {
+			ret = c->write_error;
+			goto out;
+		}
+		if (c->sample.error || k4_fault_pending(c)) {
+			ret = -EPERM;
+			goto out;
+		}
+		c->controlled = true;
+		c->initialized = false;
+		k4_update_locked(c);
+		ret = c->write_error;
+	} else if (!enable && c->controlled) {
+		ret = k4_release_control(c);
