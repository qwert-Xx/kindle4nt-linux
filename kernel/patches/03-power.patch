--- /dev/null
+++ b/drivers/regulator/k4-papyrus.c
@@ -0,0 +1,1045 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* K4 TPS65180B DISPLAY/VCOM sequencer and ambient temperature cache. */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/hwmon.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/k4-papyrus.h>
+#include <linux/k4-panel-flash.h>
+#include <linux/module.h>
+#include <linux/k4-provider.h>
+#include <linux/nvmem-consumer.h>
+#include "k4-panel-vcom.h"
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/pm.h>
+#include <linux/regulator/driver.h>
+#include <linux/workqueue.h>
+
+#include "../misc/k4-papyrus-registers.h"
+
+#define PAPYRUS_INT_STATUS1 0x07
+#define PAPYRUS_INT_STATUS2 0x08
+#define PAPYRUS_FAULT1 0x74
+#define PAPYRUS_FAULT2 0xfa
+#define PAPYRUS_EOC 0x01
+#define PAPYRUS_READ_THERM 0x80
+#define PAPYRUS_CONV_END 0x20
+#define PAPYRUS_FAULT_QUEUE 0x18
+#define PAPYRUS_RAILS 0x0f
+#define PAPYRUS_VCOM 0x10
+#define PAPYRUS_V3P3 0x20
+#define PAPYRUS_STANDBY 0x40
+#define PAPYRUS_ACTIVE 0x80
+#define PAPYRUS_PG_ALL 0xfa
+#define PAPYRUS_TEMP_INTERVAL_MS 60000
+
+/* SLVSA76G: the two documented TPS65180B revisions share this register map. */
+static bool papyrus_revision_supported(int revision)
+{
+	return revision == 0x70 || revision == 0x80;
+}
+
+struct k4_papyrus_temp {
+	struct i2c_client *client;
+	struct mutex lock;
+	unsigned int samples;
+	u8 irq_seen[2];
+	int last_error, irq;
+	bool suspended;
+	bool stopping, owned, awake, display_on, vcom_on, notify_pending, ready;
+	int power_error, shutdown_error;
+	struct gpio_desc *wakeup, *vcom, *pgood, *nint;
+	struct regulator_dev *rdev[2];
+	struct delayed_work monitor, temperature_work;
+	long temperature;
+	bool temperature_valid;
+	unsigned long next_temperature;
+	u8 vp, vn, vcom_dac, sequence[3], hot, cool;
+};
+
+/* All successful read-to-clear reads are saved even if the next read fails. */
+static int papyrus_ack(struct k4_papyrus_temp *p)
+{
+	int first, second;
+
+	first = i2c_smbus_read_byte_data(p->client, PAPYRUS_INT_STATUS1);
+	if (first < 0)
+		return first;
+	p->irq_seen[0] |= first;
+	second = i2c_smbus_read_byte_data(p->client, PAPYRUS_INT_STATUS2);
+	if (second < 0)
+		return second;
+	p->irq_seen[1] |= second;
+	if ((first & PAPYRUS_FAULT1) || (second & PAPYRUS_FAULT2))
+		return -EIO;
+	return second;
+}
+
+/* Transition bits self-clear; only completed power states permit sampling. */
+static int papyrus_power_state(struct k4_papyrus_temp *p)
+{
+	int value;
+
+	value = i2c_smbus_read_byte_data(p->client, PAPYRUS_ENABLE);
+	if (value < 0)
+		return value;
+	if (value & 0xc0)
+		return -EBUSY;
+	value = i2c_smbus_read_byte_data(p->client, PAPYRUS_PG_STATUS);
+	if (value < 0)
+		return value;
+	if (p->display_on) {
+		if ((value & PAPYRUS_PG_ALL) != PAPYRUS_PG_ALL)
+			return -EIO;
+		value = gpiod_get_value_cansleep(p->pgood);
+		return value < 0 ? value : value == 1 ? 0 : -EIO;
+	}
+	if (value & PAPYRUS_PG_ALL)
+		return -EBUSY;
+	value = gpiod_get_value_cansleep(p->pgood);
+	return value < 0 ? value : value ? -EBUSY : 0;
+}
+
+/* Caller holds lock. Poll GPIO and all six internal power-good bits. */
+static int papyrus_wait_power(struct k4_papyrus_temp *p, bool on)
+{
+	int i, pg, pin, enable, ret;
+
+	for (i = 0; i < 100; i++) {
+		usleep_range(1000, 1500);
+		pg = i2c_smbus_read_byte_data(p->client, PAPYRUS_PG_STATUS);
+		if (pg < 0)
+			return pg;
+		pin = gpiod_get_value_cansleep(p->pgood);
+		if (pin < 0)
+			return pin;
+		enable = i2c_smbus_read_byte_data(p->client, PAPYRUS_ENABLE);
+		if (enable < 0)
+			return enable;
+		if (on) {
+			ret = papyrus_ack(p);
+			if (ret < 0)
+				return ret;
+		}
+		if (!(enable & (PAPYRUS_ACTIVE | PAPYRUS_STANDBY)) &&
+		    (pg & PAPYRUS_PG_ALL) == (on ? PAPYRUS_PG_ALL : 0) && pin == on)
+			return 0;
+	}
+	return -ETIMEDOUT;
+}
+
+static unsigned int papyrus_down_ms(struct k4_papyrus_temp *p)
+{
+	/* Four 4-bit delays, plus settling allowance; no sample-specific limit. */
+	return (p->sequence[1] & 15) + (p->sequence[1] >> 4) +
+	       (p->sequence[2] & 15) + (p->sequence[2] >> 4) + 20;
+}
+
+static int papyrus_sleep(struct k4_papyrus_temp *p)
+{
+	int wake, vcom, ret;
+	gpiod_set_value_cansleep(p->vcom, 0);
+	gpiod_set_value_cansleep(p->wakeup, 0);
+	p->awake = p->display_on = p->vcom_on = false;
+	msleep(papyrus_down_ms(p));
+	/* Sleep removes the internal supplies. The open-drain PWRGOOD pin
+	 * may then float high; it is only meaningful while the chip is awake.
+	 * Check the shutdown controls here. Awake standby still checks all
+	 * internal PG bits and PWRGOOD in papyrus_wait_power().
+	 */
+	wake = gpiod_get_value_cansleep(p->wakeup);
+	vcom = gpiod_get_value_cansleep(p->vcom);
+	ret = wake < 0 ? wake : vcom < 0 ? vcom : wake || vcom ? -EIO : 0;
+	if (ret)
+		dev_err_ratelimited(&p->client->dev,
+			"sleep controls WAKEUP=%d VCOM=%d error=%d\n",
+			wake, vcom, ret);
+	return ret;
+}
+
+static int papyrus_off(struct k4_papyrus_temp *p)
+{
+	int ret = 0, fallback;
+	gpiod_set_value_cansleep(p->vcom, 0);
+	p->vcom_on = false;
+	if (p->awake) {
+		ret = i2c_smbus_write_byte_data(p->client, PAPYRUS_ENABLE,
+				PAPYRUS_STANDBY | PAPYRUS_V3P3 | PAPYRUS_RAILS);
+		if (!ret)
+			ret = papyrus_wait_power(p, false);
+	}
+	if (ret || !p->awake) {
+		/* GPIO shutdown still works when the bus or sequencer fails. */
+		fallback = papyrus_sleep(p);
+		if (fallback)
+			ret = fallback;
+	}
+	p->display_on = false;
+	p->shutdown_error = ret;
+	return ret;
+}
+
+static int papyrus_write_verify(struct k4_papyrus_temp *p, u8 reg, u8 value)
+{
+	int ret = i2c_smbus_write_byte_data(p->client, reg, value);
+
+	if (ret < 0) {
+		dev_err_ratelimited(&p->client->dev,
+			"profile write reg=%02x error=%d\n", reg, ret);
+		return ret;
+	}
+	ret = i2c_smbus_read_byte_data(p->client, reg);
+	if (ret != value)
+		dev_err_ratelimited(&p->client->dev,
+			"profile verify reg=%02x expected=%02x got=%d\n",
+			reg, value, ret);
+	return ret < 0 ? ret : ret == value ? 0 : -EIO;
+}
+
+/* Re-establish board/panel settings after every WAKEUP reset. No ACTIVE write. */
+static int papyrus_prepare(struct k4_papyrus_temp *p)
+{
+	u8 regs[] = { PAPYRUS_ENABLE, PAPYRUS_VP_ADJUST, PAPYRUS_VN_ADJUST,
+		PAPYRUS_VCOM_ADJUST, PAPYRUS_PWR_SEQ0, PAPYRUS_PWR_SEQ1,
+		PAPYRUS_PWR_SEQ2, PAPYRUS_TMST_OS, PAPYRUS_TMST_HYST,
+		PAPYRUS_INT_ENABLE1, PAPYRUS_INT_ENABLE2 };
+	u8 values[] = { PAPYRUS_V3P3 | PAPYRUS_RAILS, p->vp, p->vn,
+		p->vcom_dac, p->sequence[0], p->sequence[1], p->sequence[2],
+		p->hot, p->cool, PAPYRUS_FAULT1, PAPYRUS_FAULT2 };
+	int i, ret;
+
+	if (p->suspended || p->stopping)
+		return -EBUSY;
+	if (p->awake)
+		return papyrus_power_state(p);
+	gpiod_set_value_cansleep(p->vcom, 0);
+	gpiod_set_value_cansleep(p->wakeup, 1);
+	p->awake = true;
+	usleep_range(3000, 4000);
+	ret = i2c_smbus_read_byte_data(p->client, PAPYRUS_REVID);
+	if (ret < 0)
+		goto fail;
+	if (!papyrus_revision_supported(ret)) {
+		ret = -ENODEV;
+		goto fail;
+	}
+	ret = papyrus_power_state(p);
+	if (ret)
+		goto fail;
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		ret = papyrus_write_verify(p, regs[i], values[i]);
+		if (ret)
+			goto fail;
+	}
+	return 0;
+fail:
+	papyrus_sleep(p);
+	return ret;
+}
+
+static int papyrus_temperature(struct k4_papyrus_temp *p, long *result);
+
+static int papyrus_on(struct k4_papyrus_temp *p)
+{
+	long temperature;
+	int ret;
+
+	ret = papyrus_prepare(p);
+	if (ret)
+		goto fail;
+	/* Save/clear old faults, then verify persistent faults have not reasserted. */
+	ret = papyrus_ack(p);
+	if (ret < 0 && ret != -EIO)
+		goto fail;
+	usleep_range(1000, 1500);
+	ret = papyrus_ack(p);
+	if (ret < 0)
+		goto fail;
+	ret = papyrus_temperature(p, &temperature);
+	if (ret)
+		goto fail;
+	if (temperature >= (p->hot & 0x80 ? p->hot - 256 : p->hot) * 1000) {
+		ret = -ERANGE;
+		goto fail;
+	}
+	ret = i2c_smbus_write_byte_data(p->client, PAPYRUS_ENABLE,
+			PAPYRUS_ACTIVE | PAPYRUS_V3P3 | PAPYRUS_RAILS);
+	if (ret < 0)
+		goto fail;
+	ret = papyrus_wait_power(p, true);
+	if (ret)
+		goto fail;
+	p->display_on = true;
+	p->power_error = p->shutdown_error = 0;
+	p->next_temperature = jiffies + HZ;
+	return 0;
+fail:
+	p->power_error = ret;
+	papyrus_off(p);
+	return ret;
+}
+
+static int papyrus_wait_conversion(struct k4_papyrus_temp *p)
+{
+	int count, ret;
+
+	for (count = 0; count < 100; count++) {
+		usleep_range(1000, 1500);
+		ret = i2c_smbus_read_byte_data(p->client, PAPYRUS_TMST_CONFIG);
+		if (ret < 0)
+			return ret;
+		if (!(ret & PAPYRUS_READ_THERM) && (ret & PAPYRUS_CONV_END))
+			return ret;
+	}
+	return -ETIMEDOUT;
+}
+
+/* Caller holds lock. Only publish a value after this conversion's EOC. */
+static int papyrus_temperature(struct k4_papyrus_temp *p, long *result)
+{
+	int ret, config, raw;
+
+	if (p->suspended)
+		return -EBUSY;
+	ret = papyrus_prepare(p);
+	if (ret)
+		goto fault;
+	config = i2c_smbus_read_byte_data(p->client, PAPYRUS_TMST_CONFIG);
+	if (config < 0) {
+		ret = config;
+		goto fault;
+	}
+	if (config & PAPYRUS_READ_THERM) {
+		/* A prior failed transfer may have left a conversion running.
+		 * Drain it before acknowledging EOC and starting our own sample.
+		 */
+		config = papyrus_wait_conversion(p);
+		if (config < 0) {
+			ret = config;
+			goto fault;
+		}
+	}
+	/* Discard stale EOC only after caching all status and checking faults. */
+	ret = papyrus_ack(p);
+	if (ret < 0)
+		goto fault;
+	/* Preserve queue length; never assert the fault-counter-clear bit. */
+	ret = i2c_smbus_write_byte_data(p->client, PAPYRUS_TMST_CONFIG,
+				      (config & PAPYRUS_FAULT_QUEUE) |
+				      PAPYRUS_READ_THERM);
+	if (ret < 0)
+		goto fault;
+	ret = papyrus_wait_conversion(p);
+	if (ret < 0)
+		goto fault;
+	ret = papyrus_ack(p);
+	if (ret < 0)
+		goto fault;
+	if (!(ret & PAPYRUS_EOC)) {
+		ret = -EIO;
+		goto fault;
+	}
+	raw = i2c_smbus_read_byte_data(p->client, PAPYRUS_TMST_VALUE);
+	if (raw < 0) {
+		ret = raw;
+		goto fault;
+	}
+	/* Explicit sign extension; reserved encodings must not become a sample. */
+	if (raw & 0x80)
+		raw -= 256;
+	if (raw < -10 || raw > 85) {
+		ret = -ERANGE;
+		goto fault;
+	}
+	ret = papyrus_power_state(p);
+	if (ret)
+		goto fault;
+	*result = raw * 1000;
+	p->temperature = *result;
+	p->temperature_valid = true;
+	p->samples++;
+	p->last_error = 0;
+	return 0;
+
+fault:
+	/* This attempt failed; the next read rechecks hardware and starts fresh.
+	 * Do not reset display power to recover a thermistor bus transaction.
+	 */
+	p->last_error = ret;
+	return ret;
+}
+
+/* Caller holds lock. Restore WAKEUP when sampling an idle, sleeping chip. */
+static int papyrus_sample(struct k4_papyrus_temp *p, long *value)
+{
+	bool asleep = !p->awake;
+	int ret, sleep_ret;
+
+	if (p->suspended || p->stopping)
+		return -EBUSY;
+	ret = papyrus_temperature(p, value);
+	if (asleep) {
+		sleep_ret = papyrus_sleep(p);
+		if (!ret && sleep_ret)
+			ret = sleep_ret;
+	}
+	if (ret)
+		p->last_error = ret;
+	return ret;
+}
+
+static void papyrus_notify(struct k4_papyrus_temp *p)
+{
+	int i;
+
+	/* Never call consumers while holding the shared I2C/regulator mutex. */
+	for (i = 0; i < ARRAY_SIZE(p->rdev); i++)
+		if (!IS_ERR_OR_NULL(p->rdev[i]))
+			regulator_notifier_call_chain(p->rdev[i], REGULATOR_EVENT_FAIL, NULL);
+}
+
+static void papyrus_check(struct k4_papyrus_temp *p)
+{
+	bool notify = false;
+	long temperature;
+	int ret;
+
+	mutex_lock(&p->lock);
+	notify = p->notify_pending;
+	p->notify_pending = false;
+	if (p->stopping)
+		notify = false;
+	if (p->stopping || p->suspended || !p->awake)
+		goto out;
+	ret = papyrus_ack(p);
+	if (ret >= 0 && p->display_on)
+		ret = papyrus_power_state(p);
+	if (ret >= 0 && p->display_on && time_after_eq(jiffies, p->next_temperature)) {
+		ret = papyrus_temperature(p, &temperature);
+		if (!ret && temperature >= (p->hot & 0x80 ? p->hot - 256 : p->hot) * 1000)
+			ret = -ERANGE;
+		p->next_temperature = jiffies + HZ;
+	}
+	if (ret < 0) {
+		p->power_error = ret;
+		if (p->display_on) {
+			papyrus_off(p);
+			notify = true;
+		}
+	}
+	if (p->display_on)
+		mod_delayed_work(system_wq, &p->monitor, msecs_to_jiffies(50));
+out:
+	mutex_unlock(&p->lock);
+	if (notify)
+		papyrus_notify(p);
+}
+
+static void papyrus_monitor(struct work_struct *work)
+{
+	struct k4_papyrus_temp *p = container_of(to_delayed_work(work),
+						struct k4_papyrus_temp, monitor);
+
+	papyrus_check(p);
+}
+
+static irqreturn_t papyrus_irq(int irq, void *data)
+{
+	papyrus_check(data);
+	return IRQ_HANDLED;
+}
+
+static int papyrus_reg_enable(struct regulator_dev *rdev)
+{
+	struct k4_papyrus_temp *p = rdev_get_drvdata(rdev);
+	bool vcom = rdev_get_id(rdev) == 1;
+	int ret;
+
+	mutex_lock(&p->lock);
+	if (p->suspended || p->stopping) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (!vcom) {
+		ret = papyrus_on(p);
+	} else {
+		/* The regulator core owns the VCOM -> DISPLAY supply reference. */
+		ret = p->display_on ? papyrus_power_state(p) : -EIO;
+		if (!ret)
+			ret = papyrus_write_verify(p, PAPYRUS_ENABLE,
+					PAPYRUS_V3P3 | PAPYRUS_VCOM | PAPYRUS_RAILS);
+		if (!ret) {
+			gpiod_set_value_cansleep(p->vcom, 1);
+			usleep_range(1000, 1500);
+			ret = papyrus_ack(p);
+			if (ret >= 0)
+				ret = papyrus_power_state(p);
+		}
+		if (!ret) {
+			p->vcom_on = true;
+		} else {
+			p->power_error = ret;
+			papyrus_off(p);
+			p->notify_pending = true;
+		}
+	}
+	if (!ret || p->notify_pending)
+		mod_delayed_work(system_wq, &p->monitor,
+				 p->notify_pending ? 0 : msecs_to_jiffies(50));
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+static int papyrus_reg_disable(struct regulator_dev *rdev)
+{
+	struct k4_papyrus_temp *p = rdev_get_drvdata(rdev);
+	int ret = 0;
+
+	mutex_lock(&p->lock);
+	if (rdev_get_id(rdev) == 1) {
+		gpiod_set_value_cansleep(p->vcom, 0);
+		p->vcom_on = false;
+		if (p->awake)
+			ret = papyrus_write_verify(p, PAPYRUS_ENABLE,
+						  PAPYRUS_V3P3 | PAPYRUS_RAILS);
+		if (ret) {
+			p->power_error = ret;
+			papyrus_off(p);
+			p->notify_pending = true;
+			mod_delayed_work(system_wq, &p->monitor, 0);
+		}
+	} else {
+		ret = papyrus_off(p);
+	}
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+static int papyrus_reg_is_enabled(struct regulator_dev *rdev)
+{
+	struct k4_papyrus_temp *p = rdev_get_drvdata(rdev);
+	int enabled, ret;
+
+	mutex_lock(&p->lock);
+	enabled = rdev_get_id(rdev) == 1 ? p->vcom_on : p->display_on;
+	if (enabled) {
+		ret = papyrus_power_state(p);
+		if (ret)
+			enabled = ret;
+	}
+	mutex_unlock(&p->lock);
+	return enabled;
+}
+
+static int papyrus_reg_errors(struct regulator_dev *rdev, unsigned int *flags)
+{
+	struct k4_papyrus_temp *p = rdev_get_drvdata(rdev);
+
+	mutex_lock(&p->lock);
+	*flags = p->power_error || p->shutdown_error ? REGULATOR_ERROR_FAIL : 0;
+	mutex_unlock(&p->lock);
+	return 0;
+}
+
+static int papyrus_vcom_voltage(struct regulator_dev *rdev)
+{
+	struct k4_papyrus_temp *p = rdev_get_drvdata(rdev);
+
+	/* Regulator API uses magnitude; physical VCOM is negative. */
+	return DIV_ROUND_CLOSEST(p->vcom_dac * 2750000, 255);
+}
+
+static const struct regulator_ops papyrus_display_ops = {
+	.enable = papyrus_reg_enable,
+	.disable = papyrus_reg_disable,
+	.is_enabled = papyrus_reg_is_enabled,
+	.get_error_flags = papyrus_reg_errors,
+};
+
+static const struct regulator_ops papyrus_vcom_ops = {
+	.enable = papyrus_reg_enable,
+	.disable = papyrus_reg_disable,
+	.is_enabled = papyrus_reg_is_enabled,
+	.get_error_flags = papyrus_reg_errors,
+	.get_voltage = papyrus_vcom_voltage,
+};
