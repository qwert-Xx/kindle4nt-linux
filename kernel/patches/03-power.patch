--- /dev/null
+++ b/drivers/soc/imx/imx50-pxp.c
@@ -0,0 +1,656 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* i.MX50 ePXP synchronous kernel image service. No NEXT command chaining. */
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/dma-mapping.h>
+#include <linux/imx50-pxp.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/k4-provider.h>
+#include <linux/mutex.h>
+#include <linux/of_platform.h>
+#include <linux/overflow.h>
+#include <linux/platform_device.h>
+
+#define PXP_CTRL 0x000
+#define PXP_CTRL_SET 0x004
+#define PXP_CTRL_CLR 0x008
+#define PXP_STAT 0x010
+#define PXP_STAT_CLR 0x018
+#define PXP_NEXT 0x100
+#define PXP_RESET BIT(31)
+#define PXP_GATE BIT(30)
+#define PXP_ACTIVE (BIT(28) | BIT(3) | BIT(0))
+#define PXP_EVENTS GENMASK(3, 0)
+#define PXP_GUARD 4096
+#define PXP_RGB_GREY 0x1080
+#define PXP_HIST_CTRL 0x490
+
+struct imx50_pxp {
+	struct device *dev;
+	void __iomem *base;
+	struct clk_bulk_data clocks[2];
+	struct clk *axi_parent;
+	struct mutex lock;
+	struct completion done;
+	int irq, fault, park_error, last_result;
+	const char *stage;
+	u32 diag_ctrl, diag_stat, diag_next;
+	bool initialized, suspended, stopped, clocks_retained;
+	bool histogram_configured;
+	u32 irq_stat, irq_histogram;
+	u32 last_ctrl, lut_flags;
+	u64 completed, irqs, allocations, releases;
+	u8 *arena;
+	dma_addr_t dma;
+	size_t capacity;
+};
+
+static int imx50_pxp_validate(const struct imx50_pxp_image *im)
+{
+	size_t need;
+	u32 dw, dh;
+
+	if (!im || !im->src || !im->dst || im->width < 8 || im->height < 8 ||
+	    im->width > IMX50_PXP_MAX_DIMENSION || im->height > IMX50_PXP_MAX_DIMENSION ||
+	    ((im->width | im->height) & 7) ||
+	    im->src_stride < im->width * 4 || im->rotation > 270 || im->rotation % 90)
+		return -EINVAL;
+	dw = im->rotation % 180 ? im->height : im->width;
+	dh = im->rotation % 180 ? im->width : im->height;
+	if (im->dst_stride < dw)
+		return -EINVAL;
+	if (check_mul_overflow((size_t)(im->height - 1), (size_t)im->src_stride, &need) ||
+	    check_add_overflow(need, (size_t)im->width * 4, &need) || need > im->src_size)
+		return -EINVAL;
+	if (check_mul_overflow((size_t)(dh - 1), (size_t)im->dst_stride, &need) ||
+	    check_add_overflow(need, (size_t)dw, &need) || need > im->dst_size)
+		return -EINVAL;
+	return 0;
+}
+
+static irqreturn_t imx50_pxp_irq(int irq, void *data)
+{
+	struct imx50_pxp *p = data;
+	u32 stat = readl(p->base + PXP_STAT);
+
+	if (!(stat & PXP_EVENTS))
+		return IRQ_NONE;
+	/* Stock samples STATUS before acknowledging the completion IRQ. */
+	WRITE_ONCE(p->irq_histogram, readl(p->base + PXP_HIST_CTRL) & 0xf);
+	writel(BIT(1), p->base + PXP_CTRL_CLR);
+	writel(stat & PXP_EVENTS, p->base + PXP_STAT_CLR);
+	readl(p->base + PXP_STAT);
+	WRITE_ONCE(p->irq_stat, stat);
+	p->irqs++;
+	complete(&p->done);
+	return IRQ_HANDLED;
+}
+
+/* Caller owns lock; healthy idle completion is required before freeing. */
+static void imx50_pxp_free(struct imx50_pxp *p)
+{
+	if (!p->arena)
+		return;
+	dma_free_coherent(p->dev, p->capacity, p->arena, p->dma);
+	p->arena = NULL;
+	p->capacity = 0;
+	p->releases++;
+}
+
+static int imx50_pxp_reserve(struct imx50_pxp *p, size_t bytes)
+{
+	u8 *arena;
+	dma_addr_t dma;
+
+	if (p->capacity >= bytes)
+		return 0;
+	arena = dma_alloc_coherent(p->dev, bytes, &dma, GFP_KERNEL);
+	if (!arena)
+		return -ENOMEM;
+	if ((u64)dma + bytes - 1 > U32_MAX || (dma & 3)) {
+		dma_free_coherent(p->dev, bytes, arena, dma);
+		return -ERANGE;
+	}
+	imx50_pxp_free(p);
+	p->arena = arena;
+	p->dma = dma;
+	p->capacity = bytes;
+	p->allocations++;
+	return 0;
+}
+
+/* Clocks held, IRQ line disabled. Reject inherited activity before reset. */
+static int imx50_pxp_initialize(struct imx50_pxp *p, bool *owned)
+{
+	u32 value;
+	int ret;
+	if ((readl(p->base + PXP_CTRL) & PXP_ACTIVE) ||
+	    (readl(p->base + PXP_STAT) & PXP_EVENTS) ||
+	    (readl(p->base + PXP_NEXT) & BIT(0)))
+		return -EBUSY;
+	*owned = true;
+	/* A resume may leave the block gated. Ungate before asserting reset;
+	 * otherwise the reset request need not reach the internal clock domain.
+	 */
+	writel(PXP_RESET, p->base + PXP_CTRL_CLR);
+	ret = readl_poll_timeout(p->base + PXP_CTRL, value, !(value & PXP_RESET), 5, 1000);
+	if (ret)
+		return ret;
+	writel(PXP_GATE, p->base + PXP_CTRL_CLR);
+	ret = readl_poll_timeout(p->base + PXP_CTRL, value, !(value & PXP_GATE), 5, 1000);
+	if (ret)
+		return ret;
+	writel(PXP_RESET, p->base + PXP_CTRL_SET);
+	ret = readl_poll_timeout(p->base + PXP_CTRL, value,
+		(value & (PXP_RESET | PXP_GATE)) == (PXP_RESET | PXP_GATE), 5, 1000);
+	if (ret)
+		return ret;
+	writel(PXP_RESET, p->base + PXP_CTRL_CLR);
+	ret = readl_poll_timeout(p->base + PXP_CTRL, value, !(value & PXP_RESET), 5, 1000);
+	if (ret)
+		return ret;
+	writel(PXP_GATE, p->base + PXP_CTRL_CLR);
+	ret = readl_poll_timeout(p->base + PXP_CTRL, value, !value, 5, 1000);
+	if (ret)
+		return ret;
+	if (readl(p->base + PXP_STAT) || readl(p->base + PXP_NEXT))
+		return -EIO;
+	p->histogram_configured = false;
+	p->lut_flags = U32_MAX;
+	p->initialized = true;
+	return 0;
+}
+
+static int imx50_pxp_configure(struct imx50_pxp *p,
+			     const struct imx50_pxp_image *im, size_t output, u32 flags)
+{
+	u32 ctrl = PXP_RGB_GREY | ((im->rotation / 90) << 8);
+	struct { u32 reg, val; } regs[] = {
+		{ 0x000, ctrl }, { 0x020, p->dma + output }, { 0x030, 0 },
+		/* RM 43.4.5: hardware rotates OUTSIZE; keep source dimensions. */
+		{ 0x040, (im->width << 12) | im->height },
+		{ 0x050, p->dma + PXP_GUARD }, { 0x060, 0 }, { 0x070, 0 },
+		{ 0x080, ((im->width / 8) << 8) | (im->height / 8) },
+		{ 0x090, 0 }, { 0x0a0, 0 }, { 0x0b0, 0x10001000 },
+		{ 0x0c0, 0 }, { 0x0d0, BIT(30) },
+		/* NEXT is deliberately absent: WRITE of zero would enqueue DMA. */
+		{ 0x180, 0xffffff }, { 0x190, 0 },
+		{ 0x220, 0 }, { 0x260, 0 }, { 0x2a0, 0 }, { 0x2e0, 0 },
+		{ 0x320, 0 }, { 0x360, 0 }, { 0x3a0, 0 }, { 0x3e0, 0 },
+		{ 0x400, 4 }, { 0x410, 0x0096004d }, { 0x420, 0x0000001d },
+		{ 0x430, 0 }, { 0x440, 0 }, { 0x450, 0 }, { 0x460, 0 },
+	};
+	struct { u32 reg, val; } hist_regs[] = {
+		{ 0x490, 0x20 }, /* GRAY16 panel, stock pxp_dma.c:1263 */
+		{ 0x4a0, 0x00000f00 }, { 0x4b0, 0x0f0a0500 },
+		{ 0x4c0, 0x06040200 }, { 0x4d0, 0x0f0d0b09 },
+		{ 0x4e0, 0x03020100 }, { 0x4f0, 0x07060504 },
+		{ 0x500, 0x0b0a0908 }, { 0x510, 0x0f0e0d0c },
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		writel(regs[i].val, p->base + regs[i].reg);
+		if (readl(p->base + regs[i].reg) != regs[i].val)
+			return -EIO;
+	}
+	if (readl(p->base + PXP_CTRL) != ctrl ||
+	    (readl(p->base + PXP_STAT) & PXP_EVENTS) || readl(p->base + PXP_NEXT))
+		return -EBUSY;
+	/* Stock caches the transform; threshold at 0x80, then inversion. */
+	if (p->lut_flags != flags) {
+		writel(flags ? 0 : BIT(31), p->base + 0x470);
+		if (flags) {
+			for (i = 0; i < 256; i++) {
+				u32 addr = readl(p->base + 0x470) & 0xff;
+				u32 value = (flags & IMX50_PXP_MONOCHROME) ?
+					(addr < 0x80 ? 0 : 255) : addr;
+
+				writel((flags & IMX50_PXP_INVERT) ? 255 - value : value,
+				       p->base + 0x480);
+			}
+		}
+		p->lut_flags = flags;
+	}
+	/* Stock programs classification once, after the initial LUT setup. */
+	if (!p->histogram_configured) {
+		for (i = 0; i < ARRAY_SIZE(hist_regs); i++) {
+			/* HIST_CTRL low bits are STATUS; PARAM reserved bits are unspecified. */
+			u32 mask = hist_regs[i].reg == PXP_HIST_CTRL ? ~0xfU :
+				   0x1f1f1f1f;
+
+			writel(hist_regs[i].val, p->base + hist_regs[i].reg);
+			if ((readl(p->base + hist_regs[i].reg) & mask) != hist_regs[i].val)
+				return -EIO;
+		}
+		p->histogram_configured = true;
+	}
+	p->last_ctrl = ctrl;
+	return 0;
+}
+
+/* Called after idle/reset proof, before any job is submitted. No DMA while
+ * the inherited source is changed. The optional board parent supplies its
+ * factory baseline; arbitrary supported rates remain valid on other boards.
+ */
+static int imx50_pxp_stock_clock(struct imx50_pxp *p, bool *clocks)
+{
+	u32 value;
+	int ret;
+
+	writel(PXP_GATE, p->base + PXP_CTRL_SET);
+	ret = readl_poll_timeout(p->base + PXP_CTRL, value,
+		(value & (PXP_RESET | PXP_GATE | BIT(0))) == PXP_GATE, 5, 1000);
+	if (ret)
+		return ret;
+	clk_bulk_disable_unprepare(ARRAY_SIZE(p->clocks), p->clocks);
+	*clocks = false;
+	ret = clk_rate_exclusive_get(p->clocks[1].clk);
+	if (ret)
+		return ret;
+	ret = clk_set_parent(p->clocks[1].clk, p->axi_parent);
+	if (!ret)
+		ret = clk_set_rate(p->clocks[1].clk, 200000000);
+	clk_rate_exclusive_put(p->clocks[1].clk);
+	if (ret)
+		return ret;
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(p->clocks), p->clocks);
+	if (ret)
+		return ret;
+	*clocks = true;
+	writel(PXP_GATE, p->base + PXP_CTRL_CLR);
+	return readl_poll_timeout(p->base + PXP_CTRL, value, !value, 5, 1000);
+}
+
+int imx50_pxp_process(struct imx50_pxp *p, const struct imx50_pxp_image *im,
+		      u32 flags, u32 *histogram_out)
+{
+	size_t pixels, input_end, output, output_end, bytes, i;
+	u32 value, idle, histogram = 0;
+	u32 dw, dh;
+	bool clocks = false, line = false, started = false, completed = false, owned = false;
+	int ret, park_ret;
+
+	if (flags & ~(IMX50_PXP_INVERT | IMX50_PXP_MONOCHROME))
+		return -EINVAL;
+	ret = imx50_pxp_validate(im);
+	if (ret)
+		return ret;
+	dw = im->rotation % 180 ? im->height : im->width;
+	dh = im->rotation % 180 ? im->width : im->height;
+	ret = mutex_lock_interruptible(&p->lock);
+	if (ret)
+		return ret;
+	if (p->fault || p->suspended || p->stopped) {
+		ret = p->fault ? p->fault : -EHOSTDOWN;
+		goto unlock;
+	}
+	pixels = im->width * im->height;
+	input_end = PXP_GUARD + pixels * 4;
+	output = ALIGN(input_end + PXP_GUARD, PXP_GUARD);
+	output_end = output + pixels;
+	bytes = ALIGN(output_end + PXP_GUARD, PXP_GUARD);
+	p->stage = "reserve";
+	ret = imx50_pxp_reserve(p, bytes);
+	if (ret)
+		goto unlock;
+	if (IS_ENABLED(CONFIG_IMX50_PXP_DMA_DEBUG))
+		memset(p->arena, 0xa5, p->capacity);
+	for (i = 0; i < im->height; i++)
+		memcpy(p->arena + PXP_GUARD + i * im->width * 4,
+		       (const u8 *)im->src + i * im->src_stride, im->width * 4);
+	if (IS_ENABLED(CONFIG_IMX50_PXP_DMA_DEBUG))
+		memset(p->arena + output, 0xcc, pixels);
+	/*
+	 * The CCF/board clock tree supplies a valid rate; 200 MHz is not a
+	 * protocol requirement. A missing clock cannot execute a DMA job.
+	 */
+	if (!clk_get_rate(p->clocks[1].clk)) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+	p->stage = "access-clocks";
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(p->clocks), p->clocks);
+	if (ret)
+		goto unlock;
+	clocks = true;
+	if (!p->initialized) {
+		p->stage = "idle-reset";
+		ret = imx50_pxp_initialize(p, &owned);
+		if (ret)
+			goto park;
+		if (p->axi_parent) {
+			p->stage = "stock-clock";
+			ret = imx50_pxp_stock_clock(p, &clocks);
+			if (ret) {
+				if (clocks)
+					goto park;
+				p->fault = ret;
+				goto unlock;
+			}
+		}
+	} else {
+		idle = readl(p->base + PXP_CTRL);
+		if (idle != (PXP_GATE | p->last_ctrl) ||
+		    (readl(p->base + PXP_STAT) & PXP_EVENTS) || readl(p->base + PXP_NEXT)) {
+			ret = -EBUSY;
+			goto park;
+		}
+		owned = true;
+		writel(PXP_GATE, p->base + PXP_CTRL_CLR);
+		ret = readl_poll_timeout(p->base + PXP_CTRL, value,
+					value == p->last_ctrl, 5, 1000);
+		if (ret)
+			goto park;
+	}
+	p->stage = "configure";
+	ret = imx50_pxp_configure(p, im, output, flags);
+	if (ret)
+		goto park;
+	reinit_completion(&p->done);
+	WRITE_ONCE(p->irq_stat, 0);
+	enable_irq(p->irq);
+	line = true;
+	writel(BIT(1), p->base + PXP_CTRL_SET);
+	dma_wmb();
+	started = true;
+	writel(BIT(0), p->base + PXP_CTRL_SET);
+	p->stage = "completion";
+	if (!wait_for_completion_timeout(&p->done, msecs_to_jiffies(500))) {
+		ret = -ETIMEDOUT;
+		goto park;
+	}
+	value = READ_ONCE(p->irq_stat);
+	if ((value & PXP_EVENTS) != BIT(0)) {
+		ret = -EIO;
+		goto park;
+	}
+	ret = readl_poll_timeout(p->base + PXP_CTRL, value, !(value & BIT(0)), 5, 1000);
+	if (ret)
+		goto park;
+	completed = true;
+	histogram = READ_ONCE(p->irq_histogram);
+	dma_rmb();
+	if (!IS_ENABLED(CONFIG_IMX50_PXP_DMA_DEBUG))
+		goto park;
+	for (i = 0; i < p->capacity; i++) {
+		if ((i >= PXP_GUARD && i < input_end) || (i >= output && i < output_end))
+			continue;
+		if (p->arena[i] != 0xa5) {
+			ret = -EOVERFLOW;
+			goto park;
+		}
+	}
+	for (i = 0; i < im->height; i++) {
+		if (memcmp(p->arena + PXP_GUARD + i * im->width * 4,
+			   (const u8 *)im->src + i * im->src_stride, im->width * 4)) {
+			ret = -EILSEQ;
+			goto park;
+		}
+	}
+park:
+	/* Capture only while the owning access clocks are held, before park. */
+	if (clocks) {
+		p->diag_ctrl = readl(p->base + PXP_CTRL);
+		p->diag_stat = readl(p->base + PXP_STAT);
+		p->diag_next = readl(p->base + PXP_NEXT);
+	}
+	/* Do not gate an inherited/unexpected active owner. Keep its clock
+	 * references and our arena pinned, and refuse all later requests.
+	 */
+	if (!owned) {
+		p->fault = ret;
+		p->clocks_retained = clocks;
+		goto unlock;
+	}
+	if (line) {
+		writel(BIT(1), p->base + PXP_CTRL_CLR);
+		disable_irq(p->irq);
+		if (!ret && (readl(p->base + PXP_STAT) & PXP_EVENTS))
+			ret = -EIO;
+	}
+	/* Uncertain in-flight DMA stays in reset and retains the complete arena. */
+	idle = PXP_GATE | (started && !completed ? PXP_RESET : 0);
+	/* Reset supplies its own gate handshake; do not gate it before completion. */
+	writel(idle & PXP_RESET ? PXP_RESET : PXP_GATE, p->base + PXP_CTRL_SET);
+	park_ret = readl_poll_timeout(p->base + PXP_CTRL, value,
+		(value & (PXP_RESET | PXP_GATE | BIT(0))) == idle, 5, 1000);
+	p->park_error = park_ret;
+	if (!ret)
+		ret = park_ret;
+	if (ret)
+		p->fault = ret;
+	if (park_ret) {
+		/* A failed readback cannot establish that the engine stopped.
+		 * Pin access clocks as well as DMA until machine recovery.
+		 */
+		p->clocks_retained = clocks;
+		goto unlock;
+	}
+	if (clocks)
+		clk_bulk_disable_unprepare(ARRAY_SIZE(p->clocks), p->clocks);
+	if (!ret) {
+		for (i = 0; i < dh; i++)
+			memcpy((u8 *)im->dst + i * im->dst_stride,
+			       p->arena + output + i * dw, dw);
+		if (histogram_out)
+			*histogram_out = histogram;
+		p->completed++;
+	}
+unlock:
+	p->last_result = ret;
+	if (!ret)
+		p->stage = "complete";
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(imx50_pxp_process);
+
+int imx50_pxp_convert(struct imx50_pxp *p, const struct imx50_pxp_image *im)
+{
+	return imx50_pxp_process(p, im, 0, NULL);
+}
+EXPORT_SYMBOL_GPL(imx50_pxp_convert);
+
+int imx50_pxp_trim(struct imx50_pxp *p)
+{
+	int ret;
+
+	mutex_lock(&p->lock);
+	ret = p->fault;
+	if (!ret)
+		imx50_pxp_free(p);
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(imx50_pxp_trim);
+
+void imx50_pxp_get_stats(struct imx50_pxp *p, struct imx50_pxp_stats *s)
+{
+	mutex_lock(&p->lock);
+	*s = (struct imx50_pxp_stats) {
+		.completed = p->completed, .irqs = p->irqs, .fault = p->fault,
+		.park_error = p->park_error,
+		.allocations = p->allocations, .releases = p->releases,
+		.retained_bytes = p->capacity,
+		.clocks_retained = p->clocks_retained,
+	};
+	mutex_unlock(&p->lock);
+}
+EXPORT_SYMBOL_GPL(imx50_pxp_get_stats);
+
+struct imx50_pxp *devm_imx50_pxp_get(struct device *consumer, const char *property)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+	struct imx50_pxp *p;
+	int ret;
+
+	np = of_parse_phandle(consumer->of_node, property, 0);
+	if (!np)
+		return ERR_PTR(-ENODEV);
+	if (!of_device_is_compatible(np, "fsl,imx50-pxp")) {
+		of_node_put(np);
+		return ERR_PTR(-EINVAL);
+	}
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+	ret = devm_k4_provider_hold(consumer, &pdev->dev);
+	if (ret)
+		return ERR_PTR(ret);
+	p = platform_get_drvdata(pdev);
+	if (!p)
+		return ERR_PTR(-EPROBE_DEFER);
+	return p;
+}
+EXPORT_SYMBOL_GPL(devm_imx50_pxp_get);
+
+/* No MMIO from sysfs: report the job-owned cached sample. */
+static ssize_t diagnostic_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct imx50_pxp *p = dev_get_drvdata(dev);
+	ssize_t n;
+
+	mutex_lock(&p->lock);
+	n = sysfs_emit(buf, "stage=%s result=%d fault=%d initialized=%u completed=%llu ctrl=%08x stat=%08x next=%08x clocks_retained=%u\n",
+		p->stage ?: "none", p->last_result, p->fault, p->initialized,
+		(unsigned long long)p->completed, p->diag_ctrl, p->diag_stat,
+		p->diag_next, p->clocks_retained);
+	n += sysfs_emit_at(buf, n, "histogram=%x\n", p->irq_histogram);
+	mutex_unlock(&p->lock);
+	return n;
+}
+static DEVICE_ATTR_RO(diagnostic);
+static struct attribute *imx50_pxp_attrs[] = { &dev_attr_diagnostic.attr, NULL };
+ATTRIBUTE_GROUPS(imx50_pxp);
+
+static int imx50_pxp_suspend(struct device *dev)
+{
+	struct imx50_pxp *p = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&p->lock);
+	ret = p->fault;
+	if (!ret)
+		p->suspended = true;
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+static int imx50_pxp_resume(struct device *dev)
+{
+	struct imx50_pxp *p = dev_get_drvdata(dev);
+
+	mutex_lock(&p->lock);
+	p->suspended = false;
+	p->initialized = false;
+	mutex_unlock(&p->lock);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(imx50_pxp_pm, imx50_pxp_suspend, imx50_pxp_resume);
+
+/* Faulted DMA keeps its allocation and clock references until reset. The
+ * IRQ and CPU mapping can be released once all software callers are drained.
+ */
+static void imx50_pxp_put_clocks(void *data)
+{
+	struct imx50_pxp *p = data;
+
+	if (!p->clocks_retained)
+		clk_bulk_put(ARRAY_SIZE(p->clocks), p->clocks);
+}
+
+static int imx50_pxp_probe(struct platform_device *pdev)
+{
+	struct imx50_pxp *p;
+	struct resource *res;
+	int ret;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || resource_size(res) < 0x474)
+		return -EINVAL;
+	p = devm_kzalloc(&pdev->dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->dev = &pdev->dev;
+	p->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(p->base))
+		return PTR_ERR(p->base);
+	p->clocks[0].id = "apbh";
+	p->clocks[1].id = "pxp_axi";
+	ret = clk_bulk_get(p->dev, ARRAY_SIZE(p->clocks), p->clocks);
+	if (ret)
+		return dev_err_probe(p->dev, ret, "get clocks\n");
+	ret = devm_add_action_or_reset(p->dev, imx50_pxp_put_clocks, p);
+	if (ret)
+		return ret;
+	p->axi_parent = devm_clk_get_optional(p->dev, "axi_parent");
+	if (IS_ERR(p->axi_parent))
+		return dev_err_probe(p->dev, PTR_ERR(p->axi_parent), "AXI parent\n");
+	ret = dma_set_mask_and_coherent(p->dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	p->irq = platform_get_irq(pdev, 0);
+	if (p->irq < 0)
+		return p->irq;
+	mutex_init(&p->lock);
+	init_completion(&p->done);
+	ret = devm_request_irq(p->dev, p->irq, imx50_pxp_irq, IRQF_NO_AUTOEN,
+			       "imx50-pxp-kernel", p);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, p);
+	dev_info(p->dev, "kernel image service ready; hardware initialized on request\n");
+	return 0;
+}
+
+static void imx50_pxp_shutdown(struct platform_device *pdev)
+{
+	struct imx50_pxp *p = platform_get_drvdata(pdev);
+
+	mutex_lock(&p->lock);
+	p->stopped = true;
+	if (!p->fault)
+		imx50_pxp_free(p);
+	mutex_unlock(&p->lock);
+}
+
+static void imx50_pxp_remove(struct platform_device *pdev)
+{
+	struct imx50_pxp *p = platform_get_drvdata(pdev);
+
+	/* Device links have unbound consumers; the mutex drains a synchronous job.
+	 * Each job parks DMA and synchronizes its IRQ before dropping this lock.
+	 */
+	imx50_pxp_shutdown(pdev);
+	if (p->fault && p->arena) {
+		get_device(p->dev);
+		dev_warn(p->dev, "DMA fault: retaining %zu bytes until reset\n", p->capacity);
+	}
+	platform_set_drvdata(pdev, NULL);
+}
+
+static const struct of_device_id imx50_pxp_match[] = {
+	{ .compatible = "fsl,imx50-pxp" }, { }
+};
+
+static struct platform_driver imx50_pxp_driver = {
+	.probe = imx50_pxp_probe,
+	.shutdown = imx50_pxp_shutdown,
+	.remove_new = imx50_pxp_remove,
+	.driver = {
+		.name = "imx50-pxp-kernel",
+		.dev_groups = imx50_pxp_groups,
+		.of_match_table = imx50_pxp_match,
+		.pm = pm_sleep_ptr(&imx50_pxp_pm),
+	},
+};
+module_platform_driver(imx50_pxp_driver);
+MODULE_DEVICE_TABLE(of, imx50_pxp_match);
+MODULE_LICENSE("GPL");
