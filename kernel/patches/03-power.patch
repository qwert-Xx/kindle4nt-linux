+static struct attribute *papyrus_attrs[] = {
+	&dev_attr_acquisition_state.attr,
+	&dev_attr_rail_state.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(papyrus);
+
+static int papyrus_suspend(struct device *dev)
+{
+	struct k4_papyrus_temp *p = i2c_get_clientdata(to_i2c_client(dev));
+	int ret;
+
+	mutex_lock(&p->lock);
+	/* The display consumer must quiesce DMA and release both supplies first. */
+	if (p->display_on || p->vcom_on) {
+		ret = -EBUSY;
+	} else {
+		ret = papyrus_sleep(p);
+		if (!ret)
+			p->suspended = true;
+	}
+	mutex_unlock(&p->lock);
+	if (!ret)
+		cancel_delayed_work_sync(&p->temperature_work);
+	return ret;
+}
+
+static int papyrus_resume(struct device *dev)
+{
+	struct k4_papyrus_temp *p = i2c_get_clientdata(to_i2c_client(dev));
+
+	mutex_lock(&p->lock);
+	p->suspended = false;
+	mod_delayed_work(system_wq, &p->temperature_work, 0);
+	mutex_unlock(&p->lock);
+	return 0;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(papyrus_pm, papyrus_suspend, papyrus_resume);
+
+static int papyrus_profile(struct k4_papyrus_temp *p)
+{
+	struct device *dev = &p->client->dev;
+	u32 voltages[3], sequence[3], thresholds[2];
+	int i, hot, cool, ret;
+
+	ret = device_property_read_u32_array(dev, "ti,voltage-codes", voltages, 3);
+	if (ret)
+		return ret;
+	ret = device_property_read_u32_array(dev, "ti,power-sequence", sequence, 3);
+	if (ret)
+		return ret;
+	ret = device_property_read_u32_array(dev, "ti,thermistor-limits", thresholds, 2);
+	if (ret)
+		return ret;
+	/* Reserved fields/codes, internal VCOM DAC mode and guaranteed DAC range. */
+	if ((voltages[0] & ~0x77) || (voltages[0] & 7) == 7 ||
+	    ((voltages[0] >> 4) & 7) > 4 || (voltages[1] & ~0xf7) ||
+	    !(voltages[1] & 0x80) || (voltages[1] & 7) == 7 ||
+	    ((voltages[1] >> 4) & 7) > 4 || voltages[2] < 28 || voltages[2] > 231)
+		return -EINVAL;
+	hot = (s32)thresholds[0];
+	cool = (s32)thresholds[1];
+	if (hot < -10 || hot > 85 || cool < -10 || cool >= hot)
+		return -EINVAL;
+	for (i = 0; i < 3; i++) {
+		if (sequence[i] > 255)
+			return -EINVAL;
+		p->sequence[i] = sequence[i];
+	}
+	p->vp = voltages[0];
+	p->vn = voltages[1];
+	p->vcom_dac = voltages[2];
+	p->hot = hot;
+	p->cool = cool;
+	return 0;
+}
+
+/* Resolve calibration before GPIO takeover or any DISPLAY/VCOM write. */
+static int papyrus_panel_calibration(struct k4_papyrus_temp *p)
+{
+	struct device *dev = &p->client->dev;
+	struct nvmem_cell *cell;
+	unsigned char *data;
+	size_t length;
+	int code;
+
+	if (!device_property_present(dev, "nvmem-cells"))
+		return 0;
+	cell = devm_nvmem_cell_get(dev, "panel-vcom");
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+	data = nvmem_cell_read(cell, &length);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+	code = k4_panel_vcom_decode(data, length);
+	kfree(data);
+	if (code < 0)
+		return code;
+	p->vcom_dac = code;
+	dev_info(dev, "factory panel VCOM calibration selected before takeover\n");
+	return 0;
+}
+
+static void papyrus_stop(struct k4_papyrus_temp *p)
+{
+	mutex_lock(&p->lock);
+	p->stopping = true;
+	WRITE_ONCE(p->ready, false);
+	mutex_unlock(&p->lock);
+	cancel_delayed_work_sync(&p->monitor);
+	cancel_delayed_work_sync(&p->temperature_work);
+	mutex_lock(&p->lock);
+	if (p->owned) {
+		papyrus_off(p);
+		papyrus_sleep(p);
+	}
+	mutex_unlock(&p->lock);
+}
+
+/* Preload safe GPIO levels before explicitly selecting the control mux. */
+static int papyrus_takeover(struct k4_papyrus_temp *p)
+{
+	struct device *dev = &p->client->dev;
+	struct pinctrl *pins;
+	struct pinctrl_state *control;
+	int wake, ret;
+
+	p->wakeup = devm_gpiod_get(dev, "wakeup", GPIOD_ASIS);
+	if (IS_ERR(p->wakeup))
+		return PTR_ERR(p->wakeup);
+	p->vcom = devm_gpiod_get(dev, "vcom", GPIOD_ASIS);
+	if (IS_ERR(p->vcom))
+		return PTR_ERR(p->vcom);
+	p->pgood = devm_gpiod_get(dev, "powergood", GPIOD_ASIS);
+	if (IS_ERR(p->pgood))
+		return PTR_ERR(p->pgood);
+	p->nint = devm_gpiod_get(dev, "interrupt", GPIOD_ASIS);
+	if (IS_ERR(p->nint))
+		return PTR_ERR(p->nint);
+	pins = devm_pinctrl_get(dev);
+	if (IS_ERR(pins))
+		return PTR_ERR(pins);
+	control = pinctrl_lookup_state(pins, "control");
+	if (IS_ERR(control))
+		return PTR_ERR(control);
+	wake = gpiod_get_value_cansleep(p->wakeup);
+	if (wake < 0)
+		return wake;
+	/* A live inherited display belongs to its prior owner; don't steal it. */
+	if (wake) {
+		ret = i2c_smbus_read_byte_data(p->client, PAPYRUS_REVID);
+		if (ret < 0)
+			return ret;
+		if (!papyrus_revision_supported(ret))
+			return -ENODEV;
+		ret = papyrus_power_state(p);
+		if (ret)
+			return ret;
+	}
+	ret = gpiod_direction_output(p->vcom, 0);
+	if (ret)
+		return ret;
+	ret = gpiod_direction_output(p->wakeup, wake);
+	if (ret)
+		return ret;
+	ret = gpiod_direction_input(p->pgood);
+	if (ret)
+		return ret;
+	ret = gpiod_direction_input(p->nint);
+	if (ret)
+		return ret;
+	ret = pinctrl_select_state(pins, control);
+	if (ret)
+		return ret;
+	p->owned = true;
+	/* Explicit reset makes the same initialization serve warm and cold entry. */
+	ret = papyrus_sleep(p);
+	if (ret)
+		return ret;
+	return papyrus_prepare(p);
+}
+
+static int papyrus_probe(struct i2c_client *client)
+{
+	struct k4_papyrus_temp *p;
+	struct device *hwmon;
+	struct regulator_config config = { .dev = &client->dev };
+	int i, ret, irq;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA))
+		return -EOPNOTSUPP;
+	p = devm_kzalloc(&client->dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->client = client;
+	mutex_init(&p->lock);
+	INIT_DELAYED_WORK(&p->monitor, papyrus_monitor);
+	INIT_DELAYED_WORK(&p->temperature_work, papyrus_temperature_work);
+	i2c_set_clientdata(client, p);
+	ret = papyrus_profile(p);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "invalid panel power profile\n");
+	ret = devm_k4_panel_flash_link(&client->dev, "nvmem-cells");
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "panel flash supplier\n");
+	ret = papyrus_panel_calibration(p);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "panel VCOM calibration\n");
+	ret = papyrus_takeover(p);
+	if (ret)
+		goto fail;
+	irq = gpiod_to_irq(p->nint);
+	if (irq < 0) {
+		ret = irq;
+		goto fail;
+	}
+	/* Edge IRQ avoids a level storm; active polling catches held-low faults. */
+	ret = devm_request_threaded_irq(&client->dev, irq, NULL, papyrus_irq,
+			IRQF_ONESHOT | IRQF_TRIGGER_FALLING, "k4-papyrus", p);
+	if (ret)
+		goto fail;
+	p->irq = irq;
+	config.driver_data = p;
+	for (i = 0; i < ARRAY_SIZE(papyrus_regulators); i++) {
+		p->rdev[i] = devm_regulator_register(&client->dev,
+						    &papyrus_regulators[i], &config);
+		if (IS_ERR(p->rdev[i])) {
+			ret = PTR_ERR(p->rdev[i]);
+			goto fail;
+		}
+	}
+	hwmon = devm_hwmon_device_register_with_info(&client->dev, "k4_papyrus",
+						   p, &papyrus_chip, NULL);
+	ret = PTR_ERR_OR_ZERO(hwmon);
+	if (!ret) {
+		WRITE_ONCE(p->ready, true);
+		mod_delayed_work(system_wq, &p->temperature_work, 0);
+		return 0;
+	}
+fail:
+	papyrus_stop(p);
+	return dev_err_probe(&client->dev, ret, "Papyrus initialization\n");
+}
+
+static void papyrus_remove(struct i2c_client *client)
+{
+	struct k4_papyrus_temp *p = i2c_get_clientdata(client);
+
+	/* Consumers are detached by managed links. Synchronize the threaded IRQ
+	 * before stopping work and before devres unregisters regulator providers.
+	 */
+	disable_irq(p->irq);
+	papyrus_stop(p);
+}
