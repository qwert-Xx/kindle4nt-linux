+struct device *devm_k4_papyrus_get(struct device *consumer, const char *property)
+{
+	struct device_node *np;
+	struct i2c_client *client;
+	struct k4_papyrus_temp *p;
+	int ret;
+
+	np = of_parse_phandle(consumer->of_node, property, 0);
+	if (!np)
+		return ERR_PTR(-ENODEV);
+	if (!of_device_is_compatible(np, "amazon,k4-papyrus")) {
+		of_node_put(np);
+		return ERR_PTR(-EINVAL);
+	}
+	client = of_find_i2c_device_by_node(np);
+	of_node_put(np);
+	if (!client)
+		return ERR_PTR(-EPROBE_DEFER);
+	ret = devm_k4_provider_hold(consumer, &client->dev);
+	if (ret)
+		return ERR_PTR(ret);
+	p = i2c_get_clientdata(client);
+	if (!p || !READ_ONCE(p->ready))
+		return ERR_PTR(-EPROBE_DEFER);
+	return &client->dev;
+}
+EXPORT_SYMBOL_GPL(devm_k4_papyrus_get);
