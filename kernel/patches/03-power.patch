+/* Stock mxc_wdt_config enables WDT and pauses DEBUG. The loader may have
+ * already locked WDBG to zero on its first WCR write. Observe that loader
+ * difference; never reject the watchdog safety device for policy alignment.
+ * WDT is write-one-once: only request 0 -> 1, preserving every other bit.
+ */
+static void imx2_wdt_stock_k4_policy(struct imx2_wdt_device *wdev,
+				  struct device *dev)
+{
+	unsigned int before, after;
+	int ret;
+
+	ret = regmap_read(wdev->regmap, IMX2_WDT_WCR, &before);
+	if (ret) {
+		dev_warn(dev, "stock WCR read failed (%d); keeping watchdog registration\n", ret);
+		return;
+	}
+	after = before;
+	if (!(before & IMX2_WDT_WCR_WDBG))
+		dev_warn(dev, "loader WDBG=0 (first-write policy); keeping watchdog registration\n");
+	if (wdev->ext_reset && !(before & IMX2_WDT_WCR_WRE)) {
+		ret = regmap_update_bits(wdev->regmap, IMX2_WDT_WCR,
+					 IMX2_WDT_WCR_WRE, IMX2_WDT_WCR_WRE);
+		if (ret)
+			dev_warn(dev, "stock WDT write failed (%d); keeping watchdog registration\n", ret);
+		ret = regmap_read(wdev->regmap, IMX2_WDT_WCR, &after);
+		if (ret) {
+			after = before;
+			dev_warn(dev, "stock WDT readback failed (%d); keeping watchdog registration\n", ret);
+		} else if (!(after & IMX2_WDT_WCR_WRE)) {
+			dev_warn(dev, "stock WDT not set; keeping watchdog registration\n");
+		}
+	}
+	dev_info(dev, "stock WDBG/WDT observed: %04x -> %04x\n", before, after);
+}
