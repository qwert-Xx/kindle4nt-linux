+/* Give charger supplies their own consumer instead of blocking the PMIC. */
+static int mc13xxx_add_k4_charger(struct mc13xxx *mc13xxx)
+{
+	struct device *dev = mc13xxx->dev;
+	struct device_node *node;
+	const struct mfd_cell cell = {
+		.name = "k4-mc13892-charger",
+		.of_compatible = "amazon,kindle-k4-mc13892-charger",
+	};
+
+	for_each_child_of_node(dev->of_node, node) {
+		if (!of_device_is_compatible(node, cell.of_compatible))
+			continue;
+		of_node_put(node);
+		/* mfd-core also honors status = "disabled". */
+		return mfd_add_devices(dev, -1, &cell, 1, NULL, 0,
+				      regmap_irq_get_domain(mc13xxx->irq_data));
+	}
+
+	/* Compatibility for the earlier flat experimental device trees. */
+	if (of_property_read_bool(dev->of_node, "amazon,charger-policy"))
+		return mc13xxx_add_subdevice(mc13xxx, "k4-mc13892-charger");
+	return 0;
+}
