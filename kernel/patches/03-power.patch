+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_K4_PANEL_FLASH_H
+#define _LINUX_K4_PANEL_FLASH_H
+
+#include <linux/k4-provider.h>
+#include <linux/of.h>
+#include <linux/spi/spi.h>
+
+/* Express the dependency on the SPI driver, not just the nvmem child device.
+ * Cells can be under either the provider or its fixed-layout child. A managed
+ * link detaches the consumer before flash devres frees its callback context.
+ */
+static inline int devm_k4_panel_flash_link(struct device *consumer,
+					 const char *property)
+{
+	struct device_node *np, *parent;
+	struct device *supplier;
+
+	np = of_parse_phandle(consumer->of_node, property, 0);
+	if (!np)
+		return 0;
+	while (np && !of_device_is_compatible(np, "amazon,kindle-panel-flash")) {
+		parent = of_get_parent(np);
+		of_node_put(np);
+		np = parent;
+	}
+	if (!np)
+		return 0;
+	if (IS_REACHABLE(CONFIG_SPI))
+		supplier = bus_find_device_by_of_node(&spi_bus_type, np);
+	else
+		supplier = NULL;
+	of_node_put(np);
+	if (!supplier)
+		return -EPROBE_DEFER;
+	return devm_k4_provider_hold(consumer, supplier);
+}
+#endif
