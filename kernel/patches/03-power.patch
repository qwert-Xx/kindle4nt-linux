--- /dev/null
+++ b/drivers/power/reset/k4-mc13892-restart.c
@@ -0,0 +1,374 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Yoshi's PMIC RTC-assisted board restart; no GPIO change at probe. */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/ktime.h>
+#include <linux/kexec.h>
+#include <linux/mfd/mc13xxx.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/io.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/reboot.h>
+#include <linux/rtc.h>
+
+static bool reboot_pending;
+module_param(reboot_pending, bool, 0444);
+
+#define K4_PC2 15
+#define K4_MEMA 18
+#define K4_TODA 21
+#define K4_DAYA 23
+#define K4_MASK1 4
+#define K4_WDIRESET BIT(12)
+#define K4_RESTARTEN BIT(0)
+#define K4_REBOOT_FLAG BIT(1)
+#define K4_ALARM_MASK BIT(1)
+
+struct k4_restart {
+	struct device *dev;
+	struct mc13xxx *pmic;
+	struct rtc_device *rtc;
+	struct pinctrl *pins;
+	struct pinctrl_state *watchdog, *reset;
+	struct gpio_desc *gpio;
+	struct notifier_block prepare_nb, restart_nb;
+	u32 pc2, mema, toda, daya, mask;
+	bool snapshot, alarm_changed, pc2_changed, mema_changed, armed;
+	u64 deadline_ns;
+	int last_error, rollback_error;
+};
+
+static int k4_restart_rmw(struct k4_restart *k, unsigned int reg,
+			  u32 mask, u32 value)
+{
+	u32 readback;
+	int ret;
+
+	mc13xxx_lock(k->pmic);
+	ret = mc13xxx_reg_rmw(k->pmic, reg, mask, value);
+	if (!ret)
+		ret = mc13xxx_reg_read(k->pmic, reg, &readback);
+	if (!ret && (readback & mask) != (value & mask))
+		ret = -EIO;
+	mc13xxx_unlock(k->pmic);
+	return ret;
+}
+
+static int k4_restart_snapshot(struct k4_restart *k)
+{
+	int ret;
+
+	rtc_lock(k->rtc);
+	mc13xxx_lock(k->pmic);
+	ret = mc13xxx_reg_read(k->pmic, K4_PC2, &k->pc2);
+	if (!ret)
+		ret = mc13xxx_reg_read(k->pmic, K4_MEMA, &k->mema);
+	if (!ret)
+		ret = mc13xxx_reg_read(k->pmic, K4_TODA, &k->toda);
+	if (!ret)
+		ret = mc13xxx_reg_read(k->pmic, K4_DAYA, &k->daya);
+	if (!ret)
+		ret = mc13xxx_reg_read(k->pmic, K4_MASK1, &k->mask);
+	mc13xxx_unlock(k->pmic);
+	rtc_unlock(k->rtc);
+	k->snapshot = !ret;
+	return ret;
+}
+
+static int k4_restart_restore_alarm(struct k4_restart *k)
+{
+	struct rtc_wkalrm old = { .enabled = !(k->mask & K4_ALARM_MASK) };
+	int ret;
+
+	if ((k->toda & 0x1ffff) < 86400 && (k->daya & 0x7fff) == k->daya) {
+		rtc_time64_to_tm((time64_t)k->daya * 86400 +
+				(k->toda & 0x1ffff), &old.time);
+		ret = rtc_set_alarm(k->rtc, &old);
+		if (ret)
+			return ret;
+	} else {
+		/* Disabled legacy alarms can have an invalid TOD sentinel. */
+		ret = rtc_alarm_irq_enable(k->rtc, 0);
+		if (ret)
+			return ret;
+	}
+	rtc_lock(k->rtc);
+	mc13xxx_lock(k->pmic);
+	ret = mc13xxx_reg_write(k->pmic, K4_TODA, k->toda);
+	if (!ret)
+		ret = mc13xxx_reg_write(k->pmic, K4_DAYA, k->daya);
+	if (!ret)
+		ret = mc13xxx_reg_rmw(k->pmic, K4_MASK1,
+				     K4_ALARM_MASK, k->mask & K4_ALARM_MASK);
+	mc13xxx_unlock(k->pmic);
+	rtc_unlock(k->rtc);
+	return ret;
+}
+
+static void k4_restart_rollback(struct k4_restart *k)
+{
+	int ret;
+
+	k->armed = false;
+	k->rollback_error = 0;
+	if (k->gpio) {
+		gpiod_set_value_cansleep(k->gpio, 0); /* Preparation is sleepable. */
+		ret = pinctrl_select_state(k->pins, k->watchdog);
+		if (ret)
+			k->rollback_error = ret;
+		if (!ret) {
+			gpiod_put(k->gpio);
+			k->gpio = NULL;
+		}
+	}
+	if (k->pc2_changed) {
+		ret = k4_restart_rmw(k, K4_PC2, K4_WDIRESET | K4_RESTARTEN, k->pc2);
+		if (ret && !k->rollback_error)
+			k->rollback_error = ret;
+		if (!ret)
+			k->pc2_changed = false;
+	}
+	if (k->mema_changed) {
+		ret = k4_restart_rmw(k, K4_MEMA, K4_REBOOT_FLAG, k->mema);
+		if (ret && !k->rollback_error)
+			k->rollback_error = ret;
+		if (!ret)
+			k->mema_changed = false;
+	}
+	if (k->alarm_changed) {
+		ret = k4_restart_restore_alarm(k);
+		if (ret && !k->rollback_error)
+			k->rollback_error = ret;
+		if (!ret)
+			k->alarm_changed = false;
+	}
+}
+
+static int k4_restart_prepare(struct k4_restart *k)
+{
+	struct rtc_time now;
+	struct rtc_wkalrm alarm = { .enabled = 1 }, readback;
+	time64_t target, remaining;
+	int ret;
+
+	if (k->armed || k->gpio)
+		return -EBUSY;
+	ret = k4_restart_snapshot(k);
+	if (ret)
+		return ret;
+	ret = rtc_read_time(k->rtc, &now);
+	if (ret)
+		return ret;
+	target = rtc_tm_to_time64(&now) + 5; /* Original Yoshi interval. */
+	if (target > k->rtc->range_max)
+		return -ERANGE;
+	rtc_time64_to_tm(target, &alarm.time);
+	k->alarm_changed = true; /* A failed set can already have written fields. */
+	ret = rtc_set_alarm(k->rtc, &alarm);
+	if (ret)
+		goto fail;
+	ret = rtc_read_alarm(k->rtc, &readback);
+	if (ret)
+		goto fail;
+	if (!readback.enabled || rtc_tm_to_time64(&readback.time) != target) {
+		ret = -EIO;
+		goto fail;
+	}
+	k->mema_changed = true;
+	ret = k4_restart_rmw(k, K4_MEMA, K4_REBOOT_FLAG, K4_REBOOT_FLAG);
+	if (ret)
+		goto fail;
+	k->pc2_changed = true;
+	ret = k4_restart_rmw(k, K4_PC2, K4_WDIRESET | K4_RESTARTEN, K4_RESTARTEN);
+	if (ret)
+		goto fail;
+	/* Request only now, after the power-on alarm is verified. GPIO request
+	 * may switch mux on some pinctrl implementations, so it must not probe.
+	 */
+	k->gpio = gpiod_get(k->dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(k->gpio)) {
+		ret = PTR_ERR(k->gpio);
+		k->gpio = NULL;
+		goto fail;
+	}
+	if (gpiod_cansleep(k->gpio) || !gpiod_is_active_low(k->gpio)) {
+		ret = -EINVAL;
+		goto fail;
+	}
+	ret = pinctrl_select_state(k->pins, k->reset);
+	if (ret)
+		goto fail;
+	ret = rtc_read_time(k->rtc, &now);
+	if (ret)
+		goto fail;
+	remaining = target - rtc_tm_to_time64(&now);
+	if (remaining <= 1) {
+		ret = -ETIME;
+		goto fail;
+	}
+	/* RTC has whole-second granularity: stop before earliest alarm expiry. */
+	k->deadline_ns = ktime_get_boottime_ns() + (remaining - 1) * NSEC_PER_SEC;
+	k->armed = true;
+	return 0;
+fail:
+	k4_restart_rollback(k);
+	return ret;
+}
+
+static int k4_restart_prepare_notify(struct notifier_block *nb,
+				     unsigned long event, void *data)
+{
+	struct k4_restart *k = container_of(nb, struct k4_restart, prepare_nb);
+
+	/* kexec calls restart preparation without resetting the board.
+	 * Leave the PMIC alarm, reboot flag and reset wiring for the new kernel.
+	 */
+	if (event != SYS_RESTART || kexec_in_progress)
+		return NOTIFY_DONE;
+	WRITE_ONCE(reboot_pending, true);
+	k->last_error = k4_restart_prepare(k);
+	if (k->last_error)
+		dev_err(k->dev, "board restart preparation failed %d rollback %d; internal fallback\n",
+			k->last_error, k->rollback_error);
+	else
+		dev_info(k->dev, "board restart armed: PMIC alarm +5s, WDI held high\n");
+	return NOTIFY_DONE;
+}
+
+static int k4_restart_notify(struct notifier_block *nb, unsigned long mode, void *data)
+{
+	struct k4_restart *k = container_of(nb, struct k4_restart, restart_nb);
+
+	if (!k->armed || ktime_get_boottime_ns() >= k->deadline_ns) {
+		pr_emerg("K4 board restart unavailable/expired; internal fallback\n");
+		return NOTIFY_DONE;
+	}
+	/* Only non-sleeping GPIO here; all SPI/RTC/pinctrl work was prepared. */
+	pr_emerg("K4 board restart: asserting WDI low\n");
+	gpiod_set_value(k->gpio, 1);
+	mdelay(500);
+	pr_emerg("K4 board restart did not remove power; internal fallback\n");
+	return NOTIFY_DONE;
+}
+
+static int k4_restart_rtc_match(struct device *dev, const void *data)
+{
+	return dev->parent && dev->parent->parent == data;
+}
+
+/* Restore the POR default relied upon by the stock boot chain. barebox
+ * arch/arm/mach-imx/src.c:25-31 clears it to force cold resets; stock Yoshi
+ * leaves it enabled. Keep all other SRC reset controls unchanged.
+ */
+static int k4_restart_restore_src(struct device *dev)
+{
+	struct device_node *np;
+	void __iomem *src;
+	u32 before, after;
+
+	np = of_find_compatible_node(NULL, NULL, "fsl,imx50-src");
+	if (!np)
+		return -ENODEV;
+	src = of_iomap(np, 0);
+	of_node_put(np);
+	if (!src)
+		return -ENOMEM;
+	before = readl(src);
+	writel(before | BIT(0), src);
+	after = readl(src);
+	iounmap(src);
+	dev_info(dev, "stock SRC warm reset: %08x -> %08x\n", before, after);
+	return after == (before | BIT(0)) ? 0 : -EIO;
+}
+
+static int k4_restart_probe(struct platform_device *pdev)
+{
+	struct k4_restart *k;
+	struct device *rtc_dev;
+	struct of_phandle_args gpio_args;
+	int ret;
+
+	k = devm_kzalloc(&pdev->dev, sizeof(*k), GFP_KERNEL);
+	if (!k)
+		return -ENOMEM;
+	k->dev = &pdev->dev;
+	k->pmic = dev_get_drvdata(pdev->dev.parent);
+	if (!k->pmic || !pdev->dev.of_node)
+		return -ENODEV;
+	rtc_dev = class_find_device(rtc_class, NULL, pdev->dev.parent, k4_restart_rtc_match);
+	if (!rtc_dev)
+		return -EPROBE_DEFER;
+	k->rtc = to_rtc_device(rtc_dev);
+	k->pins = devm_pinctrl_get(k->dev);
+	if (IS_ERR(k->pins)) {
+		ret = PTR_ERR(k->pins);
+		goto put_rtc;
+	}
+	k->watchdog = pinctrl_lookup_state(k->pins, "watchdog");
+	k->reset = pinctrl_lookup_state(k->pins, "reset");
+	if (IS_ERR(k->watchdog) || IS_ERR(k->reset)) {
+		ret = -EINVAL;
+		goto put_rtc;
+	}
+	if (gpiod_count(k->dev, "reset") != 1) {
+		ret = -EINVAL;
+		goto put_rtc;
+	}
+	/* Verify polarity before a later OUT_LOW request can drive the pad. */
+	ret = of_parse_phandle_with_args(k->dev->of_node, "reset-gpios",
+					"#gpio-cells", 0, &gpio_args);
+	if (ret)
+		goto put_rtc;
+	of_node_put(gpio_args.np);
+	if (gpio_args.args_count != 2 || !(gpio_args.args[1] & GPIO_ACTIVE_LOW)) {
+		ret = -EINVAL;
+		goto put_rtc;
+	}
+	ret = k4_restart_restore_src(k->dev);
+	if (ret)
+		goto put_rtc;
+	k->prepare_nb.notifier_call = k4_restart_prepare_notify;
+	k->prepare_nb.priority = 192;
+	k->restart_nb.notifier_call = k4_restart_notify;
+	k->restart_nb.priority = 192; /* Higher than imx2_wdt's 128 fallback. */
+	ret = register_reboot_notifier(&k->prepare_nb);
+	if (ret)
+		goto put_rtc;
+	ret = register_restart_handler(&k->restart_nb);
+	if (ret) {
+		unregister_reboot_notifier(&k->prepare_nb);
+		goto put_rtc;
+	}
+	platform_set_drvdata(pdev, k);
+	dev_info(k->dev, "RTC-assisted board restart registered; GPIO unchanged\n");
+	return 0;
+put_rtc:
+	put_device(rtc_dev);
+	return ret;
+}
+
+static void k4_restart_remove(struct platform_device *pdev)
+{
+	struct k4_restart *k = platform_get_drvdata(pdev);
+	unregister_restart_handler(&k->restart_nb);
+	unregister_reboot_notifier(&k->prepare_nb);
+	if (k->snapshot)
+		k4_restart_rollback(k);
+	put_device(&k->rtc->dev);
+}
+
+static const struct of_device_id k4_restart_of_match[] = {
+	{ .compatible = "amazon,kindle-k4-restart" }, { }
+};
+static struct platform_driver k4_restart_driver = {
+	.probe = k4_restart_probe,
+	.remove_new = k4_restart_remove,
+	.driver = { .name = "k4-mc13892-restart", .of_match_table = k4_restart_of_match },
+};
+module_platform_driver(k4_restart_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Kindle K4 MC13892 RTC-assisted board restart");
