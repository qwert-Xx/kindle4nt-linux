+++ b/drivers/video/fbdev/imx50-epdc-image.c
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* EPDC update image preparation: snapshot, block padding, PxP, exact crop. */
+#include <linux/imx50-epdc-image.h>
+#include <linux/imx50-pxp.h>
+#include <linux/module.h>
+#include <linux/overflow.h>
+#include <linux/slab.h>
+
+struct imx50_epdc_layout {
+	struct imx50_epdc_rect update;
+	u32 bpp, padded_width, padded_height, output_stride;
+	u32 crop_x, crop_y;
+};
+
+static int imx50_epdc_layout(const struct imx50_epdc_source *s, size_t dst_size,
+			      u32 dst_stride, struct imx50_epdc_layout *l)
+{
+	const struct imx50_epdc_rect *r;
+	size_t need, row_bytes;
+
+	if (!s || !s->pixels || !s->width || !s->height ||
+	    s->rotation > 270 || s->rotation % 90)
+		return -EINVAL;
+	switch (s->format) {
+	case IMX50_EPDC_XRGB8888:
+		l->bpp = 4;
+		break;
+	case IMX50_EPDC_RGB565:
+		l->bpp = 2;
+		break;
+	case IMX50_EPDC_Y8:
+		l->bpp = 1;
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (check_mul_overflow((size_t)s->width, (size_t)l->bpp, &row_bytes) ||
+	    s->stride < row_bytes ||
+	    check_mul_overflow((size_t)(s->height - 1), (size_t)s->stride, &need) ||
+	    check_add_overflow(need, row_bytes, &need) || need > s->size)
+		return -EINVAL;
+	r = &s->region;
+	if (!r->width || !r->height || r->width > s->width || r->height > s->height ||
+	    r->left > s->width - r->width || r->top > s->height - r->height)
+		return -EINVAL;
+	/* The canvas can be larger; only this submitted region enters PxP. */
+	if (r->width > IMX50_PXP_MAX_DIMENSION || r->height > IMX50_PXP_MAX_DIMENSION)
+		return -E2BIG;
+	l->padded_width = ALIGN(r->width, 8);
+	l->padded_height = ALIGN(r->height, 8);
+	l->update = *r;
+	l->crop_x = 0;
+	l->crop_y = 0;
+	switch (s->rotation) {
+	case 90:
+		l->update.left = s->height - r->top - r->height;
+		l->update.top = r->left;
+		l->crop_x = l->padded_height - r->height;
+		break;
+	case 180:
+		l->update.left = s->width - r->left - r->width;
+		l->update.top = s->height - r->top - r->height;
+		l->crop_x = l->padded_width - r->width;
+		l->crop_y = l->padded_height - r->height;
+		break;
+	case 270:
+		l->update.left = r->top;
+		l->update.top = s->width - r->left - r->width;
+		l->crop_y = l->padded_width - r->width;
+		break;
+	}
+	if (s->rotation % 180) {
+		l->update.width = r->height;
+		l->update.height = r->width;
+		l->output_stride = l->padded_height;
+	} else {
+		l->output_stride = l->padded_width;
+	}
+	if (dst_stride < l->update.width ||
+	    check_mul_overflow((size_t)(l->update.height - 1), (size_t)dst_stride, &need) ||
+	    check_add_overflow(need, (size_t)l->update.width, &need) || need > dst_size)
+		return -EINVAL;
+	return 0;
+}
+
+static void imx50_epdc_snapshot(const struct imx50_epdc_source *s,
+			       const struct imx50_epdc_layout *l, u8 *rgb)
+{
+	u32 x, y;
+
+	/* Only copy the requested region. Do not read neighbouring pixels to pad. */
+	for (y = 0; y < s->region.height; y++) {
+		const u8 *in = (const u8 *)s->pixels +
+			(size_t)(s->region.top + y) * s->stride + s->region.left * l->bpp;
+		u8 *out = rgb + y * l->padded_width * 4;
+
+		for (x = 0; x < s->region.width; x++, in += l->bpp, out += 4) {
+			u32 v;
+
+			switch (s->format) {
+			case IMX50_EPDC_XRGB8888:
+				out[0] = in[0];
+				out[1] = in[1];
+				out[2] = in[2];
+				break;
+			case IMX50_EPDC_RGB565:
+				v = in[0] | (in[1] << 8);
+				out[0] = ((v & 31) << 3) | ((v & 31) >> 2);
+				out[1] = (((v >> 5) & 63) << 2) | (((v >> 5) & 63) >> 4);
+				out[2] = ((v >> 11) << 3) | ((v >> 11) >> 2);
+				break;
+			case IMX50_EPDC_Y8:
+				out[0] = in[0];
+				out[1] = in[0];
+				out[2] = in[0];
+				break;
+			}
+			out[3] = 0;
+		}
+		cond_resched();
+	}
+}
+
+int imx50_epdc_prepare(struct imx50_pxp *pxp,
+		       const struct imx50_epdc_source *s,
+		       void *dst, size_t dst_size, u32 dst_stride,
+		       struct imx50_epdc_rect *update)
+{
+	struct imx50_epdc_layout l;
+	struct imx50_pxp_image image;
+	u8 *rgb, *grey;
+	size_t pixels;
+	u32 x, y;
+	int ret;
+
+	if (!pxp || !dst || !update)
+		return -EINVAL;
+	ret = imx50_epdc_layout(s, dst_size, dst_stride, &l);
+	if (ret)
+		return ret;
+	pixels = l.padded_width * l.padded_height;
+	rgb = kvmalloc(pixels * 4, GFP_KERNEL);
+	grey = kvmalloc(pixels, GFP_KERNEL);
+	if (!rgb || !grey) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	memset(rgb, 0xff, pixels * 4);
+	imx50_epdc_snapshot(s, &l, rgb);
+	image = (struct imx50_pxp_image) {
+		.src = rgb, .dst = grey, .src_size = pixels * 4, .dst_size = pixels,
+		.width = l.padded_width, .height = l.padded_height,
+		.src_stride = l.padded_width * 4, .dst_stride = l.output_stride,
+		.rotation = s->rotation,
+	};
+	ret = imx50_pxp_convert(pxp, &image);
+	if (ret)
+		goto out;
+	for (y = 0; y < l.update.height; y++) {
+		const u8 *row = grey + (y + l.crop_y) * l.output_stride + l.crop_x;
+		u8 *out = (u8 *)dst + (size_t)y * dst_stride;
+
+		for (x = 0; x < l.update.width; x++)
+			out[x] = s->invert ? 255 - row[x] : row[x];
+		cond_resched();
+	}
+	*update = l.update;
+out:
+	kvfree(grey);
+	kvfree(rgb);
+	return ret;
+}
+MODULE_LICENSE("GPL");
