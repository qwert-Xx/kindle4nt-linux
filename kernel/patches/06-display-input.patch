@@ -0,0 +1,610 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* K4 EPDC owner: clocks, panel supplies, firmware and serialized updates. */
+#include <linux/clk.h>
+#include <linux/dma-mapping.h>
+#include <linux/gpio/consumer.h>
+#include <linux/imx50-epdc.h>
+#include <linux/imx50-epdc-buffer.h>
+#include <linux/imx50-epdc-image.h>
+#include <linux/imx50-pxp.h>
+#include <linux/k4-papyrus.h>
+#include <linux/k4-panel-flash.h>
+#include <linux/module.h>
+#include <linux/k4-provider.h>
+#include <linux/of_platform.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+#include "imx50-epdc-hw.h"
+#include "imx50-epdc-waveform.h"
+
+struct imx50_epdc {
+	struct device *dev, *papyrus;
+	struct mutex lock;
+	struct imx50_epdc_hw hw;
+	struct imx50_pxp *pxp;
+	struct imx50_epdc_waveform *wave;
+	struct imx50_epdc_buffers *buffers;
+	struct clk_bulk_data access[2];
+	struct clk *pixel, *pixel_parent;
+	struct regulator *display, *vcom;
+	struct pinctrl *pins;
+	struct pinctrl_state *active, *idle;
+	struct gpio_desc *gdsp, *sdce;
+	struct notifier_block power_nb;
+	struct work_struct power_work;
+	const char *wbf_name, *wrf_name;
+	u32 timeout_ms;
+	const char *startup_stage; /* Last attempted initialization step. */
+	int irq, fault, cleanup_error;
+	bool access_on, pixel_on, pixel_exclusive, axi_exclusive, irq_on;
+	bool pins_owned, display_held, vcom_held, initialized;
+	bool suspended, stopped, ready;
+};
+
+/* Same pad handoff as gpio_epdc_pins_enable(0) in the original K4 kernel.
+ * No PWRCOM/PWRCTRL pin belongs to this driver: Papyrus owns them.
+ */
+static int epdc_idle_pins(struct imx50_epdc *e)
+{
+	int ret;
+
+	ret = gpiod_direction_output(e->gdsp, 0);
+	if (ret)
+		return ret;
+	ret = gpiod_direction_output(e->sdce, 0);
+	if (ret)
+		return ret;
+	e->pins_owned = true; /* A failed mux operation may have applied partly. */
+	return pinctrl_select_state(e->pins, e->idle);
+}
+
+/* Caller holds the owner lock. Always try panel shutdown after a DMA fault,
+ * but retain its clocks and buffers until machine reset.
+ */
+static int epdc_off_locked(struct imx50_epdc *e)
+{
+	int ret = 0, err;
+
+	e->initialized = false;
+	if (e->pins_owned) {
+		err = epdc_idle_pins(e);
+		if (err)
+			ret = err;
+	}
+	if (e->vcom_held) {
+		err = regulator_disable(e->vcom);
+		if (!err)
+			e->vcom_held = false;
+		else if (!ret)
+			ret = err;
+	}
+	if (e->display_held && !e->vcom_held) {
+		err = regulator_disable(e->display);
+		if (!err)
+			e->display_held = false;
+		else if (!ret)
+			ret = err;
+	}
+	if (e->access_on && !e->fault) {
+		err = imx50_epdc_hw_stop(&e->hw);
+		if (err)
+			e->fault = err;
+	}
+	if (e->irq_on) {
+		disable_irq(e->irq); /* Synchronous before any clock release. */
+		e->irq_on = false;
+	}
+	if (!e->fault) {
+		if (e->pixel_on) {
+			clk_disable_unprepare(e->pixel);
+			e->pixel_on = false;
+		}
+		if (e->pixel_exclusive) {
+			clk_rate_exclusive_put(e->pixel);
+			e->pixel_exclusive = false;
+		}
+
+		if (e->access_on) {
+			clk_bulk_disable_unprepare(ARRAY_SIZE(e->access), e->access);
+			e->access_on = false;
+		}
+		if (e->axi_exclusive) {
+			clk_rate_exclusive_put(e->access[1].clk);
+			e->axi_exclusive = false;
+		}
+	}
+	e->cleanup_error = ret;
+	return e->fault ? e->fault : ret;
+}
+
+static void epdc_power_work(struct work_struct *work)
+{
+	struct imx50_epdc *e = container_of(work, struct imx50_epdc, power_work);
+
+	mutex_lock(&e->lock);
+	/* An old queued work item must not power off a successfully retried epoch. */
+	if (READ_ONCE(e->hw.supply_fault))
+		epdc_off_locked(e);
+	mutex_unlock(&e->lock);
+}
+
+static int epdc_power_notify(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct imx50_epdc *e = container_of(nb, struct imx50_epdc, power_nb);
+
+	if (!(event & REGULATOR_EVENT_FAIL))
+		return NOTIFY_DONE;
+	/* Temperature/enable can notify while this caller owns e->lock. */
+	imx50_epdc_hw_power_fault(&e->hw);
+	schedule_work(&e->power_work);
+	return NOTIFY_OK;
+}
+
+static int epdc_start_locked(struct imx50_epdc *e)
+{
+	int ret;
+
+	e->startup_stage = "supply-reset";
+	ret = imx50_epdc_hw_power_reset(&e->hw);
+	if (ret)
+		return ret;
+	e->startup_stage = "access-clocks";
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(e->access), e->access);
+	if (ret)
+		return ret;
+	e->access_on = true;
+	e->startup_stage = "inherited-idle";
+	ret = imx50_epdc_hw_inherited_idle(&e->hw);
+	if (ret) {
+		/* Unknown inherited activity: no pin, reset or pixel-clock change. */
+		e->fault = ret;
+		return ret;
+	}
+	e->startup_stage = "idle-pins";
+	ret = epdc_idle_pins(e);
+	if (ret)
+		return ret;
+	/* Only after inherited-idle proof may the owner stop/switch AXI. */
+	clk_bulk_disable_unprepare(ARRAY_SIZE(e->access), e->access);
+	e->access_on = false;
+	e->startup_stage = "axi-exclusive";
+	ret = clk_rate_exclusive_get(e->access[1].clk);
+	if (ret)
+		return ret;
+	e->axi_exclusive = true;
+	e->startup_stage = "axi-parent";
+	ret = clk_set_parent(e->access[1].clk, e->pixel_parent);
+	if (ret)
+		return ret;
+	e->startup_stage = "axi-rate";
+	ret = clk_set_rate(e->access[1].clk, 200000000);
+	if (ret)
+		return ret;
+	if (clk_get_rate(e->access[1].clk) != 200000000)
+		return -ERANGE;
+	e->startup_stage = "axi-enable";
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(e->access), e->access);
+	if (ret)
+		return ret;
+	e->access_on = true;
+	e->startup_stage = "pixel-exclusive";
+	ret = clk_rate_exclusive_get(e->pixel);
+	if (ret)
+		return ret;
+	e->pixel_exclusive = true;
+	e->startup_stage = "pixel-parent";
+	ret = clk_set_parent(e->pixel, e->pixel_parent);
+	if (ret)
+		return ret;
+	e->startup_stage = "pixel-rate";
+	ret = clk_set_rate(e->pixel, 32000000);
+	if (ret)
+		return ret;
+	/* K4 timing table is expressed in this panel's 32MHz pixel clock. */
+	if (clk_get_rate(e->pixel) != 32000000)
+		return -ERANGE;
+	e->startup_stage = "pixel-enable";
+	ret = clk_prepare_enable(e->pixel);
+	if (ret)
+		return ret;
+	e->pixel_on = true;
+	e->startup_stage = "controller-configure";
+	ret = imx50_epdc_hw_configure(&e->hw, e->buffers);
+	if (ret)
+		return ret;
+	enable_irq(e->irq);
+	e->irq_on = true;
+	e->startup_stage = "display-enable";
+	ret = regulator_enable(e->display);
+	if (ret)
+		return ret;
+	e->display_held = true;
+	e->startup_stage = "active-pins";
+	ret = pinctrl_select_state(e->pins, e->active);
+	if (ret)
+		return ret;
+	e->startup_stage = "vcom-enable";
+	ret = regulator_enable(e->vcom);
+	if (ret)
+		return ret;
+	e->vcom_held = true;
+	return READ_ONCE(e->hw.supply_fault) ? -EIO : 0;
+}
+
+static int epdc_temperature(struct imx50_epdc *e)
+{
+	long millicelsius;
+	int ret;
+
+	ret = k4_papyrus_read_temperature(e->papyrus, &millicelsius);
+	if (ret)
+		return ret;
+	return imx50_epdc_waveform_temperature(e->wave, millicelsius);
+}
+
+int imx50_epdc_update(struct imx50_epdc *e, const struct imx50_epdc_source *source,
+		      enum imx50_epdc_mode mode, bool full)
+{
+	struct imx50_epdc_source restore;
+	int ret, temperature, file_mode;
+
+	if (!source || mode < IMX50_EPDC_MODE_DU || mode > IMX50_EPDC_MODE_GL16_FAST)
+		return -EINVAL;
+	ret = mutex_lock_interruptible(&e->lock);
+	if (ret)
+		return ret;
+	if (e->stopped || e->suspended || e->fault) {
+		ret = e->fault ? e->fault : -EBUSY;
+		goto out;
+	}
+	if (e->cleanup_error || READ_ONCE(e->hw.supply_fault)) {
+		ret = epdc_off_locked(e);
+		if (ret)
+			goto out;
+	}
+	if (!e->wave) {
+		e->wave = imx50_epdc_waveform_load(e->dev, e->wbf_name, e->wrf_name, 800, 600);
+		if (IS_ERR(e->wave)) {
+			ret = PTR_ERR(e->wave);
+			e->wave = NULL;
+			goto out;
+		}
+		e->buffers = imx50_epdc_waveform_buffers(e->wave);
+	}
+	file_mode = imx50_epdc_waveform_mode(e->wave, (enum imx50_epdc_waveform_mode)mode);
+	if (file_mode < 0) {
+		ret = file_mode;
+		goto fail;
+	}
+	/* Validate/convert before changing panel power; INIT overwrites this copy. */
+	ret = imx50_epdc_buffers_prepare(e->buffers, e->pxp, source);
+	if (ret)
+		goto fail;
+	temperature = epdc_temperature(e);
+	if (temperature < 0) {
+		ret = temperature;
+		goto fail;
+	}
+	if (!e->initialized) {
+		ret = epdc_start_locked(e);
+		if (ret)
+			goto fail;
+		ret = imx50_epdc_hw_submit(&e->hw, true, true, 0, temperature, e->timeout_ms);
+		if (ret)
+			goto fail;
+		e->initialized = true;
+		/* INIT erased the full panel, including pixels outside this request.
+		 * The input describes a complete canvas; restore all of it after any
+		 * power-loss epoch, including one the consumer did not observe.
+		 */
+		restore = *source;
+		restore.region = (struct imx50_epdc_rect){ 0, 0, source->width, source->height };
+		source = &restore;
+		full = true;
+		ret = imx50_epdc_buffers_prepare(e->buffers, e->pxp, source);
+		if (ret)
+			goto fail;
+		/* INIT can take seconds; select the image mode using a fresh sample. */
+		temperature = epdc_temperature(e);
+		if (temperature < 0) {
+			ret = temperature;
+			goto fail;
+		}
+	}
+	ret = imx50_epdc_hw_submit(&e->hw, false, full, file_mode, temperature, e->timeout_ms);
+	if (ret)
+		goto fail;
+	goto out;
+fail:
+	epdc_off_locked(e); /* Preserve primary errno and separate cleanup_error. */
+out:
+	mutex_unlock(&e->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(imx50_epdc_update);
+
+int imx50_epdc_powerdown(struct imx50_epdc *e)
+{
+	int ret;
+
+	mutex_lock(&e->lock);
+	ret = epdc_off_locked(e);
+	mutex_unlock(&e->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(imx50_epdc_powerdown);
+
+struct imx50_epdc *devm_imx50_epdc_get(struct device *consumer, const char *property)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+	struct imx50_epdc *e;
+	int ret;
+
+	np = of_parse_phandle(consumer->of_node, property, 0);
+	if (!np)
+		return ERR_PTR(-ENODEV);
+	if (!of_device_is_compatible(np, "amazon,k4-imx50-epdc")) {
+		of_node_put(np);
+		return ERR_PTR(-EINVAL);
+	}
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+	ret = devm_k4_provider_hold(consumer, &pdev->dev);
+	if (ret)
+		return ERR_PTR(ret);
+	e = platform_get_drvdata(pdev);
+	if (!e || !READ_ONCE(e->ready))
+		return ERR_PTR(-EPROBE_DEFER);
+	return e;
+}
+EXPORT_SYMBOL_GPL(devm_imx50_epdc_get);
+
+static int epdc_suspend(struct device *dev)
+{
+	struct imx50_epdc *e = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&e->lock);
+	ret = epdc_off_locked(e);
+	if (!ret)
+		e->suspended = true;
+	mutex_unlock(&e->lock);
+	return ret;
+}
+
+static int epdc_resume(struct device *dev)
+{
+	struct imx50_epdc *e = dev_get_drvdata(dev);
+
+	mutex_lock(&e->lock);
+	e->suspended = false; /* Lazy power/INIT on the next image. */
+	mutex_unlock(&e->lock);
+	return 0;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(epdc_pm, epdc_suspend, epdc_resume);
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct imx50_epdc *e = dev_get_drvdata(dev);
+	ssize_t n;
+
+	mutex_lock(&e->lock);
+	n = sysfs_emit(buf,
+		"initialized=%u suspended=%u display_held=%u vcom_held=%u access_on=%u pixel_on=%u fault=%d hw_fault=%d supply_fault=%u cleanup_error=%d polled_completions=%u\n",
+		e->initialized, e->suspended, e->display_held, e->vcom_held,
+		e->access_on, e->pixel_on, e->fault, READ_ONCE(e->hw.fault),
+		READ_ONCE(e->hw.supply_fault), e->cleanup_error, e->hw.polled_completions);
+	n += sysfs_emit_at(buf, n,
+		"init_updates=%u canvas_updates=%u region_updates=%u last_coordinates=%08x last_size=%08x last_mode=%u last_full=%u\n",
+		e->hw.init_updates, e->hw.canvas_updates, e->hw.region_updates,
+		e->hw.last_coordinates, e->hw.last_size, e->hw.last_mode, e->hw.last_full);
+	n += sysfs_emit_at(buf, n,
+		"preflight_count=%u preflight_result=%d preflight_version=%08x preflight_ctrl=%08x preflight_status=%08x preflight_luts=%08x preflight_irq=%08x\n",
+		e->hw.preflight_count, e->hw.preflight_result, e->hw.preflight_version,
+		e->hw.preflight_ctrl, e->hw.preflight_status,
+		e->hw.preflight_luts, e->hw.preflight_irq);
+	n += sysfs_emit_at(buf, n, "startup_stage=%s\n",
+			   e->startup_stage ? e->startup_stage : "none");
+	mutex_unlock(&e->lock);
+	return n;
+}
+static DEVICE_ATTR_RO(state);
+
+static struct attribute *epdc_attrs[] = {
+	&dev_attr_state.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(epdc);
+
+static void epdc_cancel_work(void *data)
+{
+	struct imx50_epdc *e = data;
+
+	cancel_work_sync(&e->power_work);
+}
+
+static void epdc_put_clocks(void *data)
+{
+	struct imx50_epdc *e = data;
+
+	/* Unproven DMA stop must not release enabled/exclusive clock handles. */
+	if (e->fault)
+		return;
+	if (!IS_ERR_OR_NULL(e->pixel))
+		clk_put(e->pixel);
+	clk_bulk_put(ARRAY_SIZE(e->access), e->access);
+}
+
+static int epdc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct imx50_epdc *e;
+	void __iomem *base;
+	int ret;
+
+	e = devm_kzalloc(dev, sizeof(*e), GFP_KERNEL);
+	if (!e)
+		return -ENOMEM;
+	e->dev = dev;
+	if (!of_find_property(dev->of_node, "display-supply", NULL) ||
+	    !of_find_property(dev->of_node, "vcom-supply", NULL))
+		return dev_err_probe(dev, -EINVAL, "panel supplies are required\n");
+	e->timeout_ms = 30000;
+	if (of_find_property(dev->of_node, "update-timeout-ms", NULL)) {
+		ret = of_property_read_u32(dev->of_node, "update-timeout-ms", &e->timeout_ms);
+		if (ret || !e->timeout_ms)
+			return -EINVAL;
+	}
+	mutex_init(&e->lock);
+	INIT_WORK(&e->power_work, epdc_power_work);
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+	imx50_epdc_hw_init(&e->hw, base);
+	ret = devm_k4_panel_flash_link(dev, "nvmem");
+	if (ret)
+		return dev_err_probe(dev, ret, "panel flash supplier\n");
+	e->papyrus = devm_k4_papyrus_get(dev, "papyrus");
+	if (IS_ERR(e->papyrus))
+		return dev_err_probe(dev, PTR_ERR(e->papyrus), "Papyrus supplier\n");
+	e->pxp = devm_imx50_pxp_get(dev, "pxp");
+	if (IS_ERR(e->pxp))
+		return dev_err_probe(dev, PTR_ERR(e->pxp), "PxP supplier\n");
+	e->access[0].id = "apbh";
+	e->access[1].id = "epdc_axi";
+	ret = clk_bulk_get(dev, ARRAY_SIZE(e->access), e->access);
+	if (ret)
+		return dev_err_probe(dev, ret, "access clocks\n");
+	ret = devm_add_action_or_reset(dev, epdc_put_clocks, e);
+	if (ret)
+		return ret;
+	e->pixel = clk_get(dev, "epdc_pix");
+	if (IS_ERR(e->pixel))
+		return dev_err_probe(dev, PTR_ERR(e->pixel), "pixel clock\n");
+	e->pixel_parent = devm_clk_get(dev, "pixel_parent");
+	if (IS_ERR(e->pixel_parent))
+		return dev_err_probe(dev, PTR_ERR(e->pixel_parent), "pixel parent\n");
+	e->display = devm_regulator_get(dev, "display");
+	if (IS_ERR(e->display))
+		return dev_err_probe(dev, PTR_ERR(e->display), "DISPLAY\n");
+	e->vcom = devm_regulator_get(dev, "vcom");
+	if (IS_ERR(e->vcom))
+		return dev_err_probe(dev, PTR_ERR(e->vcom), "VCOM\n");
+	e->pins = devm_pinctrl_get(dev);
+	if (IS_ERR(e->pins))
+		return dev_err_probe(dev, PTR_ERR(e->pins), "panel pins\n");
+	e->active = pinctrl_lookup_state(e->pins, "active");
+	if (IS_ERR(e->active))
+		return PTR_ERR(e->active);
+	e->idle = pinctrl_lookup_state(e->pins, "idle");
+	if (IS_ERR(e->idle))
+		return PTR_ERR(e->idle);
+	e->gdsp = devm_gpiod_get(dev, "gdsp", GPIOD_ASIS);
+	if (IS_ERR(e->gdsp))
+		return dev_err_probe(dev, PTR_ERR(e->gdsp), "GDSP\n");
+	e->sdce = devm_gpiod_get(dev, "sdce", GPIOD_ASIS);
+	if (IS_ERR(e->sdce))
+		return dev_err_probe(dev, PTR_ERR(e->sdce), "SDCE0\n");
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	e->irq = platform_get_irq(pdev, 0);
+	if (e->irq < 0)
+		return e->irq;
+	ret = devm_request_irq(dev, e->irq, imx50_epdc_hw_irq, IRQF_NO_AUTOEN,
+			       "imx50-epdc", &e->hw);
+	if (ret)
+		return ret;
+	if (of_find_property(dev->of_node, "wbf-firmware", NULL)) {
+		ret = of_property_read_string(dev->of_node, "wbf-firmware", &e->wbf_name);
+		if (ret)
+			return ret;
+	}
+	if (of_find_property(dev->of_node, "wrf-firmware", NULL)) {
+		ret = of_property_read_string(dev->of_node, "wrf-firmware", &e->wrf_name);
+		if (ret)
+			return ret;
+	}
+	/* LIFO devres: detach the notifier before draining its queued work. */
+	ret = devm_add_action_or_reset(dev, epdc_cancel_work, e);
+	if (ret)
+		return ret;
+	e->power_nb.notifier_call = epdc_power_notify;
+	ret = devm_regulator_register_notifier(e->display, &e->power_nb);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, e);
+	WRITE_ONCE(e->ready, true);
+	dev_info(dev, "K4 display service ready; refresh requires a consumer request\n");
+	return 0;
+}
+
+static void epdc_shutdown(struct platform_device *pdev)
+{
+	struct imx50_epdc *e = platform_get_drvdata(pdev);
+
+	mutex_lock(&e->lock);
+	WRITE_ONCE(e->ready, false);
+	e->stopped = true;
+	epdc_off_locked(e);
+	mutex_unlock(&e->lock);
+	cancel_work_sync(&e->power_work);
+}
+
+static void epdc_remove(struct platform_device *pdev)
+{
+	struct imx50_epdc *e = platform_get_drvdata(pdev);
+	int ret;
+
+	/* Managed links have detached fbdev and other consumers. Unregister the
+	 * notifier before draining work so it cannot queue another power callback.
+	 */
+	WRITE_ONCE(e->ready, false);
+	devm_regulator_unregister_notifier(e->display, &e->power_nb);
+	cancel_work_sync(&e->power_work);
+	mutex_lock(&e->lock);
+	e->stopped = true;
+	epdc_off_locked(e);
+	if (e->wave && !e->fault) {
+		ret = imx50_epdc_waveform_free(e->wave);
+		if (ret)
+			e->fault = ret;
+		else
+			e->wave = NULL;
+	}
+	if (e->fault) {
+		/* No retained software callbacks: devres frees IRQ and MMIO. Only
+		 * the quarantined DMA data and clock handles survive until reset.
+		 */
+		get_device(e->dev);
+		dev_warn(e->dev, "DMA stop unproven: retaining arena/clocks until reset\n");
+	}
+	mutex_unlock(&e->lock);
+	platform_set_drvdata(pdev, NULL);
+}
+
+static const struct of_device_id epdc_match[] = {
+	{ .compatible = "amazon,k4-imx50-epdc" }, { }
+};
+
+static struct platform_driver epdc_driver = {
+	.probe = epdc_probe,
+	.shutdown = epdc_shutdown,
+	.remove_new = epdc_remove,
+	.driver = {
+		.name = "imx50-k4-epdc",
+		.of_match_table = epdc_match,
+		.dev_groups = epdc_groups,
+		.pm = pm_sleep_ptr(&epdc_pm),
+	},
+};
+module_platform_driver(epdc_driver);
+MODULE_DEVICE_TABLE(of, epdc_match);
+MODULE_LICENSE("GPL");
