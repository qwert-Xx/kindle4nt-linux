--- /dev/null
+++ b/drivers/video/fbdev/imx50-epdc-hw.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IMX50_EPDC_HW_H
+#define _IMX50_EPDC_HW_H
+
+#include <linux/completion.h>
+#include <linux/interrupt.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+struct imx50_epdc_buffers;
+
+/* Private backend for the forthcoming controller owner. No platform binding.
+ * The owner must keep APBH/AXI/pixel clocks and the MMIO mapping valid for
+ * every configure/submit/stop call and until stop succeeds. It owns
+ * the sole IRQ, buffer and MMIO mapping. No other caller may prepare/free the
+ * buffer during submit. Never release clocks, DMA or this object after fault.
+ * Submit additionally requires validated panel supplies, pins and waveform;
+ * the owner must handle emergency panel-power shutdown separately on fault.
+ * A successful reset/configure is NOT a panel INIT or permission to submit
+ * an unvalidated waveform. This backend currently programs K4 800x600 timing.
+ */
+struct imx50_epdc_hw {
+	void __iomem *base;
+	struct imx50_epdc_buffers *buffers;
+	struct mutex lock; /* Serializes reset/submit/stop and buffer ownership. */
+	spinlock_t irq_lock; /* Covers IRQ MMIO, running/configured and event state. */
+	struct completion done;
+	/* Read-only preflight snapshot, cached while access clocks are held. */
+	u32 preflight_version, preflight_ctrl, preflight_status;
+	u32 preflight_luts, preflight_irq, preflight_count;
+	int preflight_result;
+	u32 seen, interrupts, polled_completions;
+	u32 init_updates, canvas_updates, region_updates;
+	u32 last_coordinates, last_size, last_mode, last_full;
+	int fault, result;
+	bool configured, running, drained, supply_fault;
+};
+
+void imx50_epdc_hw_init(struct imx50_epdc_hw *hw, void __iomem *base);
+/* Only APBH/AXI access clocks needed; read-only before touching inherited pins. */
+int imx50_epdc_hw_inherited_idle(struct imx50_epdc_hw *hw);
+int imx50_epdc_hw_configure(struct imx50_epdc_hw *hw, struct imx50_epdc_buffers *buffers);
+/* Synchronous serial LUT0 submission; waits for WB + LUT0 + final TCE idle.
+ * timeout_ms is a nonzero finite waveform-aware deadline, not a cancel.
+ * At the deadline, a latched final IRQ may establish the same completion proof;
+ * otherwise timeout/error quarantines the active DMA until system reset.
+ */
+int imx50_epdc_hw_submit(struct imx50_epdc_hw *hw, bool initialize, bool full,
+			 u32 mode, u32 temperature, unsigned int timeout_ms);
+irqreturn_t imx50_epdc_hw_irq(int irq, void *data);
+/* Supplier fault notification: wake a running submit and quarantine its DMA.
+ * No MMIO while unconfigured; owner preserves clocks while configured.
+ */
+void imx50_epdc_hw_power_fault(struct imx50_epdc_hw *hw);
+/* Start a new supply epoch only while stopped, before enabling regulators.
+ * A later fault remains latched through preparation and the command write.
+ */
+int imx50_epdc_hw_power_reset(struct imx50_epdc_hw *hw);
+/* Only success permits the owner to gate clocks or release the IRQ/mapping. */
+int imx50_epdc_hw_stop(struct imx50_epdc_hw *hw);
+
+#endif
