+#ifndef _LINUX_IMX50_EPDC_IMAGE_H
+#define _LINUX_IMX50_EPDC_IMAGE_H
+
+#include <linux/types.h>
+
+struct imx50_pxp;
+
+enum imx50_epdc_format {
+	IMX50_EPDC_XRGB8888,
+	IMX50_EPDC_RGB565,
+	IMX50_EPDC_Y8,
+};
+
+struct imx50_epdc_rect {
+	u32 left, top, width, height;
+};
+
+/* CPU source image, little-endian pixels, immutable during prepare(). */
+struct imx50_epdc_source {
+	const void *pixels;
+	size_t size;
+	u32 width, height, stride;
+	enum imx50_epdc_format format;
+	struct imx50_epdc_rect region;
+	u32 rotation; /* clockwise degrees: 0, 90, 180, 270 */
+	bool invert;
+};
+
+/* Prepare one update for EPDC submission, without accessing EPDC or power.
+ * dst is caller-owned CPU memory containing Y8 rows after success. Its width
+ * and height equal region.width/height, swapped for 90/270 degrees; stride
+ * is in bytes. Padding is untouched. update receives the rotated rectangle
+ * in panel coordinates (whole source image rotated by the same angle).
+ * Source pixels must remain valid/unchanged throughout this sleepable call.
+ * On error, neither dst nor update is changed. No DMA address is exported.
+ */
+int imx50_epdc_prepare(struct imx50_pxp *pxp,
+		       const struct imx50_epdc_source *src,
+		       void *dst, size_t dst_size, u32 dst_stride,
+		       struct imx50_epdc_rect *update);
