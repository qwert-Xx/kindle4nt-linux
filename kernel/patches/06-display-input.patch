--- /dev/null
+++ b/drivers/misc/k4-accessory-inputs.c
@@ -0,0 +1,470 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* K4 accessory inputs and optional factory Apollo output policy. */
+#include <linux/gpio/consumer.h>
+#include <linux/fb.h>
+#include <linux/power_supply.h>
+#include <linux/regulator/consumer.h>
+#include "k4-accessory-policy.h"
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
+#include <linux/property.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+struct k4_accessory_inputs {
+	struct device *dev;
+	struct gpio_desc *detect, *charging;
+	struct mutex lock;
+	struct delayed_work work;
+	int irq, detected, charge_active, error, wake_error;
+	unsigned long events, samples;
+	bool suspended, stopping, wake_armed;
+	struct regulator *output;
+	struct power_supply *usb_supply;
+	struct notifier_block source_nb, fb_nb;
+	bool output_claim, screen, source_registered, fb_registered;
+	int usb_online, output_enabled, output_error;
+	int policy_detected, policy_usb;
+	unsigned long output_requests;
+
+};
+
+static int k4_accessory_power_read(void *context)
+{
+	struct k4_accessory_inputs *a = context;
+	int ret = regulator_is_enabled(a->output);
+
+	a->output_enabled = ret < 0 ? -1 : !!ret;
+	return ret;
+}
+
+static int k4_accessory_power_set(void *context, int enabled)
+{
+	struct k4_accessory_inputs *a = context;
+	int ret;
+
+	/* Recover a confirmed hardware/count mismatch without growing use_count. */
+	if (a->output_claim == !!enabled) {
+		ret = enabled ? regulator_disable(a->output) :
+			regulator_enable(a->output);
+		if (ret)
+			return ret;
+		a->output_claim = !enabled;
+	}
+	ret = enabled ? regulator_enable(a->output) : regulator_disable(a->output);
+	if (!ret)
+		a->output_claim = enabled;
+	return ret;
+}
+
+static const struct k4_accessory_power_io k4_accessory_output_io = {
+	.read = k4_accessory_power_read,
+	.set = k4_accessory_power_set,
+};
+
+static int k4_accessory_policy(struct k4_accessory_inputs *a, int event)
+{
+	int target, ret;
+
+	if (!a->output)
+		return 0;
+	if (event != K4_ACC_SHUTDOWN && a->error)
+		return a->error;
+	target = k4_accessory_decide(event, a->detected, a->usb_online, a->screen);
+	if (target < -1)
+		return target;
+	a->output_requests++;
+	ret = k4_accessory_power_apply(&k4_accessory_output_io, a, target);
+	a->output_error = ret;
+	if (!ret) {
+		if (event == K4_ACC_SCREEN_ENTER)
+			a->screen = true;
+		else if (event == K4_ACC_SCREEN_EXIT)
+			a->screen = false;
+	}
+	return ret;
+}
+
+static int k4_accessory_sample(struct k4_accessory_inputs *a)
+{
+	int detected, charging;
+
+	detected = gpiod_get_value_cansleep(a->detect);
+	if (detected < 0) {
+		a->error = detected;
+		return detected;
+	}
+	charging = gpiod_get_value_cansleep(a->charging);
+	if (charging < 0) {
+		a->error = charging;
+		return charging;
+	}
+	a->detected = detected;
+	a->charge_active = charging;
+	a->samples++;
+	a->error = 0;
+	if (a->usb_supply) {
+		union power_supply_propval value;
+		int ret = power_supply_get_property(a->usb_supply,
+						  POWER_SUPPLY_PROP_ONLINE, &value);
+		if (ret) {
+			a->error = ret;
+			return ret;
+		}
+		a->usb_online = !!value.intval;
+	}
+	return 0;
+}
+
+static void k4_accessory_work(struct work_struct *work)
+{
+	struct k4_accessory_inputs *a = container_of(to_delayed_work(work),
+										struct k4_accessory_inputs, work);
+
+	mutex_lock(&a->lock);
+	if (!a->suspended && !a->stopping) {
+		int old_detected = a->policy_detected, old_usb = a->policy_usb;
+		int ret = 0;
+
+		if (!k4_accessory_sample(a)) {
+			if (old_detected != a->detected)
+				ret = k4_accessory_policy(a, a->detected ? K4_ACC_ENABLE : K4_ACC_DISABLE);
+			else if (old_usb != a->usb_online)
+				ret = k4_accessory_policy(a, a->usb_online ? K4_ACC_DISABLE : K4_ACC_ENABLE);
+			if (!ret) {
+				a->policy_detected = a->detected;
+				a->policy_usb = a->usb_online;
+			}
+		}
+	}
+	mutex_unlock(&a->lock);
+}
+
+static irqreturn_t k4_accessory_irq(int irq, void *data)
+{
+	struct k4_accessory_inputs *a = data;
+
+	mutex_lock(&a->lock);
+	if (!a->stopping) {
+		a->events++;
+		if (a->suspended) {
+			if (device_may_wakeup(a->dev))
+				pm_wakeup_event(a->dev, 0);
+		} else {
+			mod_delayed_work(system_wq, &a->work, msecs_to_jiffies(10));
+		}
+	}
+	mutex_unlock(&a->lock);
+	return IRQ_HANDLED;
+}
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr,
+				char *buf)
+{
+	struct k4_accessory_inputs *a = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&a->lock);
+	if (a->stopping || a->suspended) {
+		mutex_unlock(&a->lock);
+		return -EBUSY;
+	}
+	/* ACC_CHRG_B has no dedicated IRQ in the original board implementation. */
+	k4_accessory_sample(a);
+	len = sysfs_emit(buf,
+			"detected=%d charging=%d samples=%lu irq_events=%lu error=%d wake_error=%d wake_armed=%u\n",
+			a->detected, a->charge_active, a->samples, a->events,
+			a->error, a->wake_error, a->wake_armed);
+	mutex_unlock(&a->lock);
+	return len;
+}
+static DEVICE_ATTR_RO(state);
+static ssize_t output_state_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct k4_accessory_inputs *a = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&a->lock);
+	if (a->output && !a->stopping && !a->suspended)
+		k4_accessory_power_read(a);
+	len = sysfs_emit(buf, "owned=%u enabled=%d usb=%d screen=%u requests=%lu error=%d\n",
+			!!a->output, a->output_enabled, a->usb_online, a->screen,
+			a->output_requests, a->output_error);
+	mutex_unlock(&a->lock);
+	return len;
+}
+static DEVICE_ATTR_RO(output_state);
+
+static ssize_t screensaver_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct k4_accessory_inputs *a = dev_get_drvdata(dev);
+	bool blank;
+	int ret = kstrtobool(buf, &blank);
+
+	if (ret)
+		return ret;
+	mutex_lock(&a->lock);
+	if (!a->output)
+		ret = -EOPNOTSUPP;
+	else if (a->stopping || a->suspended)
+		ret = -EBUSY;
+	else {
+		ret = k4_accessory_sample(a);
+		if (!ret)
+			ret = k4_accessory_policy(a, blank ? K4_ACC_SCREEN_ENTER : K4_ACC_SCREEN_EXIT);
+	}
+	mutex_unlock(&a->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(screensaver);
+
+static int k4_accessory_source_notify(struct notifier_block *nb,
+				      unsigned long event, void *data)
+{
+	struct k4_accessory_inputs *a = container_of(nb, struct k4_accessory_inputs, source_nb);
+
+	/* power_supply callbacks run on an atomic chain: only queue sleeping I/O. */
+	if (data == a->usb_supply && !READ_ONCE(a->stopping) && !READ_ONCE(a->suspended))
+		mod_delayed_work(system_wq, &a->work, 0);
+	return NOTIFY_OK;
+}
+
+static int k4_accessory_fb_notify(struct notifier_block *nb,
+				  unsigned long event, void *data)
+{
+	struct k4_accessory_inputs *a = container_of(nb, struct k4_accessory_inputs, fb_nb);
+	struct fb_event *ev = data;
+
+	if (event != FB_EVENT_BLANK || !ev || !ev->info || !ev->data ||
+	    strcmp(ev->info->fix.id, "k4-epdc"))
+		return NOTIFY_DONE;
+	mutex_lock(&a->lock);
+	if (!a->stopping && !a->suspended && !k4_accessory_sample(a))
+		k4_accessory_policy(a, *(int *)ev->data == FB_BLANK_UNBLANK ?
+				    K4_ACC_SCREEN_EXIT : K4_ACC_SCREEN_ENTER);
+	mutex_unlock(&a->lock);
+	return NOTIFY_OK;
+}
+
+static void k4_accessory_put_supply(void *data)
+{
+	power_supply_put(data);
+}
+
+static struct attribute *k4_accessory_attrs[] = {
+	&dev_attr_state.attr, &dev_attr_output_state.attr,
+	&dev_attr_screensaver.attr, NULL,
+};
+ATTRIBUTE_GROUPS(k4_accessory);
+
+static void k4_accessory_stop(void *data)
+{
+	struct k4_accessory_inputs *a = data;
+	int ret;
+
+	mutex_lock(&a->lock);
+	a->stopping = true;
+	mutex_unlock(&a->lock);
+	if (a->source_registered) {
+		power_supply_unreg_notifier(&a->source_nb);
+		a->source_registered = false;
+	}
+	if (IS_REACHABLE(CONFIG_FB) && a->fb_registered) {
+		fb_unregister_client(&a->fb_nb);
+		a->fb_registered = false;
+	}
+	cancel_delayed_work_sync(&a->work);
+	mutex_lock(&a->lock);
+	ret = k4_accessory_policy(a, K4_ACC_SHUTDOWN);
+	if (ret)
+		dev_err(a->dev, "output shutdown failed: %d\n", ret);
+	mutex_unlock(&a->lock);
+	if (a->wake_armed) {
+		ret = disable_irq_wake(a->irq);
+		if (ret)
+			dev_warn(a->dev, "wake IRQ cleanup failed: %d\n", ret);
+		else
+			a->wake_armed = false;
+	}
+	device_init_wakeup(a->dev, false);
+}
+
+static int k4_accessory_suspend(struct device *dev)
+{
+	struct k4_accessory_inputs *a = dev_get_drvdata(dev);
+	bool wake = device_may_wakeup(dev);
+	int ret = 0;
+
+	mutex_lock(&a->lock);
+	if (a->stopping || a->wake_armed) {
+		mutex_unlock(&a->lock);
+		return -EBUSY;
+	}
+	ret = k4_accessory_sample(a);
+	if (!ret)
+		ret = k4_accessory_policy(a, K4_ACC_SUSPEND);
+	if (ret) {
+		mutex_unlock(&a->lock);
+		return ret;
+	}
+	a->suspended = true;
+	mutex_unlock(&a->lock);
+	cancel_delayed_work_sync(&a->work);
+	if (wake)
+		ret = enable_irq_wake(a->irq);
+	mutex_lock(&a->lock);
+	a->wake_error = ret;
+	if (ret) {
+		a->suspended = false;
+		k4_accessory_policy(a, K4_ACC_ENABLE);
+		mod_delayed_work(system_wq, &a->work, 0);
+	} else {
+		a->wake_armed = wake;
+	}
+	mutex_unlock(&a->lock);
+	return ret;
+}
+
+static int k4_accessory_resume(struct device *dev)
+{
+	struct k4_accessory_inputs *a = dev_get_drvdata(dev);
+	int ret = 0;
+
+	if (a->wake_armed)
+		ret = disable_irq_wake(a->irq);
+	mutex_lock(&a->lock);
+	a->wake_error = ret;
+	if (!ret)
+		a->wake_armed = false;
+	a->suspended = false;
+	if (!a->stopping) {
+		int output_ret = k4_accessory_sample(a);
+
+		if (!output_ret)
+			output_ret = k4_accessory_policy(a, K4_ACC_ENABLE);
+		if (!ret)
+			ret = output_ret;
+	}
+	if (!a->stopping)
+		mod_delayed_work(system_wq, &a->work, 0);
+	mutex_unlock(&a->lock);
+	return ret;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(k4_accessory_pm_ops,
+								k4_accessory_suspend, k4_accessory_resume);
+
+static int k4_accessory_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct k4_accessory_inputs *a;
+	int ret;
+
+	a = devm_kzalloc(dev, sizeof(*a), GFP_KERNEL);
+	if (!a)
+		return -ENOMEM;
+	a->dev = dev;
+	a->detected = a->charge_active = -1;
+	a->usb_online = a->output_enabled = -1;
+	mutex_init(&a->lock);
+	INIT_DELAYED_WORK(&a->work, k4_accessory_work);
+	a->detect = devm_gpiod_get(dev, "detect", GPIOD_IN);
+	if (IS_ERR(a->detect))
+		return dev_err_probe(dev, PTR_ERR(a->detect), "detect GPIO\n");
+	a->charging = devm_gpiod_get(dev, "charging", GPIOD_IN);
+	if (IS_ERR(a->charging))
+		return dev_err_probe(dev, PTR_ERR(a->charging), "charging GPIO\n");
+	a->irq = gpiod_to_irq(a->detect);
+	if (a->irq < 0)
+		return dev_err_probe(dev, a->irq, "detect IRQ\n");
+	ret = k4_accessory_sample(a);
+	if (ret)
+		return dev_err_probe(dev, ret, "input sampling\n");
+	if (of_device_is_compatible(dev->of_node, "amazon,k4-accessory-controller")) {
+		a->usb_supply = power_supply_get_by_phandle(dev->of_node, "usb-source");
+		if (IS_ERR(a->usb_supply))
+			return dev_err_probe(dev, PTR_ERR(a->usb_supply), "USB source\n");
+		if (!a->usb_supply)
+			return -EPROBE_DEFER;
+		ret = devm_add_action_or_reset(dev, k4_accessory_put_supply, a->usb_supply);
+		if (ret)
+			return ret;
+		ret = k4_accessory_sample(a);
+		if (ret)
+			return dev_err_probe(dev, ret, "source sampling\n");
+		a->output = devm_regulator_get_exclusive(dev, "output");
+		if (IS_ERR(a->output))
+			return dev_err_probe(dev, PTR_ERR(a->output), "Apollo output\n");
+		ret = k4_accessory_power_read(a);
+		if (ret < 0)
+			return ret;
+		a->output_claim = !!ret;
+	}
+	platform_set_drvdata(pdev, a);
+	ret = devm_request_threaded_irq(dev, a->irq, NULL, k4_accessory_irq,
+				IRQF_ONESHOT | IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING,
+				dev_name(dev), a);
+	if (ret) {
+		k4_accessory_stop(a);
+		return dev_err_probe(dev, ret, "detect IRQ request");
+	}
+	/* Drain work/notifiers before devres releases the IRQ and GPIOs. */
+	ret = devm_add_action_or_reset(dev, k4_accessory_stop, a);
+	if (ret)
+		return ret;
+	a->policy_detected = a->detected;
+	a->policy_usb = a->usb_online;
+	if (a->output) {
+		a->source_nb.notifier_call = k4_accessory_source_notify;
+		ret = power_supply_reg_notifier(&a->source_nb);
+		if (ret)
+			return ret;
+		a->source_registered = true;
+		a->fb_nb.notifier_call = k4_accessory_fb_notify;
+		if (IS_REACHABLE(CONFIG_FB)) {
+			ret = fb_register_client(&a->fb_nb);
+			if (ret)
+				return ret;
+			a->fb_registered = true;
+		}
+		mutex_lock(&a->lock);
+		ret = k4_accessory_policy(a, K4_ACC_ENABLE);
+		mutex_unlock(&a->lock);
+		if (ret)
+			return dev_err_probe(dev, ret, "Apollo initial output\n");
+	}
+	ret = device_init_wakeup(dev, device_property_read_bool(dev, "wakeup-source"));
+	if (ret)
+		return ret;
+	return 0;
+}
+
+static void k4_accessory_shutdown(struct platform_device *pdev)
+{
+	k4_accessory_stop(platform_get_drvdata(pdev));
+}
+
+static const struct of_device_id k4_accessory_of_match[] = {
+	{ .compatible = "amazon,k4-accessory-inputs" },
+	{ .compatible = "amazon,k4-accessory-controller" }, { }
+};
+MODULE_DEVICE_TABLE(of, k4_accessory_of_match);
+
+static struct platform_driver k4_accessory_driver = {
+	.probe = k4_accessory_probe,
+	.shutdown = k4_accessory_shutdown,
+	.driver = {
+		.name = "k4-accessory-inputs",
+		.of_match_table = k4_accessory_of_match,
+		.dev_groups = k4_accessory_groups,
+		.pm = pm_sleep_ptr(&k4_accessory_pm_ops),
+	},
+};
+module_platform_driver(k4_accessory_driver);
+MODULE_DESCRIPTION("Kindle K4 accessory detection and factory output policy");
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/drivers/misc/k4-accessory-policy.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef K4_ACCESSORY_POLICY_H
+#define K4_ACCESSORY_POLICY_H
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#else
+#include <errno.h>
+#endif
+
+enum k4_accessory_event {
+ K4_ACC_ENABLE, K4_ACC_DISABLE, K4_ACC_SCREEN_ENTER,
+ K4_ACC_SCREEN_EXIT, K4_ACC_SUSPEND, K4_ACC_SHUTDOWN
+};
+/* -1 keeps the prior output, matching the factory conditional no-write paths. */
+static inline int k4_accessory_decide(int event, int detected, int usb, int screen)
+{
+ if (event == K4_ACC_SHUTDOWN) return 0;
+ if ((detected & ~1) || (usb & ~1) || (screen & ~1)) return -EINVAL;
+ switch (event) {
+ case K4_ACC_ENABLE:
+  return (detected && usb) || (!detected && screen) ? -1 : 1;
+ case K4_ACC_DISABLE: return detected || screen ? 0 : -1;
+ case K4_ACC_SCREEN_ENTER: return detected && !usb ? -1 : 0;
+ case K4_ACC_SCREEN_EXIT: return detected && usb ? -1 : 1;
+ case K4_ACC_SUSPEND: return detected && !usb;
+ default: return -EINVAL;
+ }
+}
+struct k4_accessory_power_io {
+ int (*read)(void *context);
+ int (*set)(void *context, int enabled);
+};
+static inline int k4_accessory_power_apply(const struct k4_accessory_power_io *io,
+                                         void *context, int requested)
+{
+ int read_value, ret;
+ if (requested == -1) return 0;
+ if (requested != 0 && requested != 1) return -EINVAL;
+ read_value = io->read(context);
+ if (read_value < 0) return read_value;
+ if (!!read_value == requested) return 0;
+ ret = io->set(context, requested);
+ if (ret) return ret;
+ read_value = io->read(context);
+ if (read_value < 0) return read_value;
+ return !!read_value == requested ? 0 : -EIO;
+}
+#endif
--- /dev/null
+++ b/drivers/misc/k4-papyrus-registers.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef K4_PAPYRUS_REGISTERS_H
+#define K4_PAPYRUS_REGISTERS_H
+
+/* TI TPS65180B, SLVSA76G sections 9.5 and 10.1.11. */
+#define PAPYRUS_TMST_VALUE	0x00
+#define PAPYRUS_ENABLE		0x01
+#define PAPYRUS_VP_ADJUST		0x02
+#define PAPYRUS_VN_ADJUST		0x03
+#define PAPYRUS_VCOM_ADJUST	0x04
+#define PAPYRUS_INT_ENABLE1	0x05
+#define PAPYRUS_INT_ENABLE2	0x06
+/* 0x07/0x08 are read-to-clear interrupt status, never monitor them. */
+#define PAPYRUS_PWR_SEQ0		0x09
+#define PAPYRUS_PWR_SEQ1		0x0a
+#define PAPYRUS_PWR_SEQ2		0x0b
+#define PAPYRUS_TMST_CONFIG	0x0c
+#define PAPYRUS_TMST_OS		0x0d
+#define PAPYRUS_TMST_HYST		0x0e
+#define PAPYRUS_PG_STATUS		0x0f
+#define PAPYRUS_REVID		0x10
+#define PAPYRUS_K4_REVID		0x80
+
+static inline bool k4_papyrus_monitor_readable(unsigned int reg)
+{
+	switch (reg) {
+	case PAPYRUS_TMST_VALUE:
+	case PAPYRUS_ENABLE:
+	case PAPYRUS_VP_ADJUST:
+	case PAPYRUS_VN_ADJUST:
+	case PAPYRUS_VCOM_ADJUST:
+	case PAPYRUS_INT_ENABLE1:
+	case PAPYRUS_INT_ENABLE2:
+	case PAPYRUS_PWR_SEQ0:
+	case PAPYRUS_PWR_SEQ1:
+	case PAPYRUS_PWR_SEQ2:
+	case PAPYRUS_TMST_CONFIG:
+	case PAPYRUS_TMST_OS:
+	case PAPYRUS_TMST_HYST:
+	case PAPYRUS_PG_STATUS:
+	case PAPYRUS_REVID:
+		return true;
+	default:
+		return false;
+	}
+}
+
+#endif
