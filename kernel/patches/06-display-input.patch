--- /dev/null
+++ b/drivers/video/fbdev/imx50-epdc-buffer.c
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* EPDC DMA ownership and serial update descriptors. No controller MMIO. */
+#include <linux/crc32.h>
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+#include <linux/imx50-epdc-buffer.h>
+#include <linux/imx50-epdc-image.h>
+#include <linux/module.h>
+#include <linux/overflow.h>
+#include <linux/slab.h>
+
+#define EPDC_GUARD 4096
+/* EPDC_RES horizontal/vertical fields are 13 bits (RM 24.4.4). */
+#define EPDC_RES_MAX 0x1fff
+
+struct imx50_epdc_dma {
+	u8 *cpu;
+	dma_addr_t dma;
+	size_t bytes, allocation;
+};
+
+struct imx50_epdc_buffers {
+	struct device *dev;
+	struct imx50_epdc_dma wave, work, update;
+	struct imx50_epdc_rect rect;
+	u32 width, height, modes, temperatures, stride;
+	u32 wave_crc, update_crc;
+	bool ready, active, initializing, primed;
+	int fault;
+};
+
+static void epdc_dma_free(struct device *dev, struct imx50_epdc_dma *d)
+{
+	if (d->cpu)
+		dma_free_coherent(dev, d->allocation, d->cpu, d->dma);
+}
+
+static int epdc_dma_alloc(struct device *dev, struct imx50_epdc_dma *d, size_t bytes)
+{
+	d->bytes = bytes;
+	if (check_add_overflow(bytes, (size_t)EPDC_GUARD - 1, &d->allocation))
+		return -EOVERFLOW;
+	d->allocation &= ~((size_t)EPDC_GUARD - 1);
+	if (check_add_overflow(d->allocation, (size_t)2 * EPDC_GUARD, &d->allocation))
+		return -EOVERFLOW;
+	d->cpu = dma_alloc_coherent(dev, d->allocation, &d->dma, GFP_KERNEL);
+	if (!d->cpu)
+		return -ENOMEM;
+	/* Check the entire allocation, including guards, for 32-bit reachability. */
+	if ((u64)d->dma > U32_MAX || d->allocation - 1 > U32_MAX - (u64)d->dma ||
+	    (d->dma & 7))
+		return -ERANGE;
+	if (IS_ENABLED(CONFIG_IMX50_EPDC_DMA_DEBUG))
+		memset(d->cpu, 0xa5, d->allocation);
+	memset(d->cpu + EPDC_GUARD, 0, bytes);
+	return 0;
+}
+
+static bool epdc_dma_guard(const struct imx50_epdc_dma *d)
+{
+	return !memchr_inv(d->cpu, 0xa5, EPDC_GUARD) &&
+	       !memchr_inv(d->cpu + EPDC_GUARD + d->bytes, 0xa5,
+			   d->allocation - EPDC_GUARD - d->bytes);
+}
+
+static int epdc_buffers_check(struct imx50_epdc_buffers *b, bool check_update)
+{
+	if (!IS_ENABLED(CONFIG_IMX50_EPDC_DMA_DEBUG))
+		return 0;
+	if (!epdc_dma_guard(&b->wave) || !epdc_dma_guard(&b->work) ||
+	    !epdc_dma_guard(&b->update))
+		return -EOVERFLOW;
+	if (crc32_le(~0, b->wave.cpu + EPDC_GUARD, b->wave.bytes) != b->wave_crc ||
+	    (check_update && crc32_le(~0, b->update.cpu + EPDC_GUARD,
+				     b->update.bytes) != b->update_crc))
+		return -EILSEQ;
+	return 0;
+}
+
+struct imx50_epdc_buffers *imx50_epdc_buffers_alloc(struct device *dev,
+	u32 width, u32 height, const void *waveform, size_t waveform_size,
+	u32 modes, u32 temperatures)
+{
+	struct imx50_epdc_buffers *b;
+	size_t work_bytes, update_bytes;
+	int ret;
+
+	if (!dev || !waveform || !waveform_size ||
+	    !width || !height || width > EPDC_RES_MAX || height > EPDC_RES_MAX || (width & 3) ||
+	    !modes || modes > 256 || !temperatures || temperatures > 256)
+		return ERR_PTR(-EINVAL);
+	if (check_mul_overflow((size_t)width * 2, (size_t)height, &work_bytes) ||
+	    check_mul_overflow((size_t)ALIGN(width, 8), (size_t)height, &update_bytes))
+		return ERR_PTR(-EOVERFLOW);
+	b = kzalloc(sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return ERR_PTR(-ENOMEM);
+	b->dev = dev;
+	b->width = width;
+	b->height = height;
+	b->modes = modes;
+	b->temperatures = temperatures;
+	ret = epdc_dma_alloc(dev, &b->wave, waveform_size);
+	if (ret)
+		goto fail;
+	ret = epdc_dma_alloc(dev, &b->work, work_bytes);
+	if (ret)
+		goto fail;
+	ret = epdc_dma_alloc(dev, &b->update, update_bytes);
+	if (ret)
+		goto fail;
+	memcpy(b->wave.cpu + EPDC_GUARD, waveform, waveform_size);
+	if (IS_ENABLED(CONFIG_IMX50_EPDC_DMA_DEBUG))
+		b->wave_crc = crc32_le(~0, b->wave.cpu + EPDC_GUARD, waveform_size);
+	return b;
+fail:
+	epdc_dma_free(dev, &b->update);
+	epdc_dma_free(dev, &b->work);
+	epdc_dma_free(dev, &b->wave);
+	kfree(b);
+	return ERR_PTR(ret);
+}
+
+int imx50_epdc_buffers_prepare(struct imx50_epdc_buffers *b, struct imx50_pxp *pxp,
+			       const struct imx50_epdc_source *src)
+{
+	u32 w, h;
+	int ret;
+
+	if (b->fault || b->active)
+		return b->fault ? b->fault : -EBUSY;
+	if (!src || src->rotation > 270 || src->rotation % 90)
+		return -EINVAL;
+	w = src->rotation % 180 ? src->height : src->width;
+	h = src->rotation % 180 ? src->width : src->height;
+	if (w != b->width || h != b->height)
+		return -EINVAL;
+	w = src->rotation % 180 ? src->region.height : src->region.width;
+	if (!w || w > b->width)
+		return -EINVAL;
+	/* A new request replaces the queued image; a failed preparation discards it. */
+	b->ready = false;
+	b->stride = ALIGN(w, 8);
+	memset(b->update.cpu + EPDC_GUARD, 0xff, b->update.bytes);
+	ret = imx50_epdc_prepare(pxp, src, b->update.cpu + EPDC_GUARD,
+				b->update.bytes, b->stride, &b->rect);
+	if (ret)
+		return ret;
+	b->ready = true;
+	return 0;
+}
+
+int imx50_epdc_buffers_begin(struct imx50_epdc_buffers *b, bool initialize,
+			     bool full, u32 mode, u32 temperature,
+			     struct imx50_epdc_command *command)
+{
+	struct imx50_epdc_rect r = b->rect;
+	struct imx50_epdc_command next;
+	int ret;
+
+	if (b->fault || b->active)
+		return b->fault ? b->fault : -EBUSY;
+	if (!command || mode >= b->modes || temperature >= b->temperatures ||
+	    (!initialize && !mode))
+		return -EINVAL;
+	ret = epdc_buffers_check(b, false);
+	if (ret) {
+		b->fault = ret;
+		return ret;
+	}
+	if (initialize) {
+		if (!full || mode)
+			return -EINVAL;
+		r = (struct imx50_epdc_rect){ 0, 0, b->width, b->height };
+		memset(b->update.cpu + EPDC_GUARD, 0xff, b->update.bytes);
+	} else if (!b->primed || !b->ready) {
+		return -ENODATA;
+	}
+	next = (struct imx50_epdc_command) {
+		.waveform_addr = b->wave.dma + EPDC_GUARD,
+		.working_addr = b->work.dma + EPDC_GUARD,
+		.update_addr = b->update.dma + EPDC_GUARD,
+		.resolution = b->width | (b->height << 16),
+		.coordinates = r.left | (r.top << 16),
+		.size = r.width | (r.height << 16),
+		.fixed = initialize ? 0xc000ffff : 0,
+		.control = (initialize ? BIT(31) : 0) | (mode << 8) | (full ? 1 : 0),
+		.temperature = temperature,
+	};
+	if (IS_ENABLED(CONFIG_IMX50_EPDC_DMA_DEBUG))
+		b->update_crc = crc32_le(~0, b->update.cpu + EPDC_GUARD, b->update.bytes);
+	b->initializing = initialize;
+	b->ready = false;
+	b->active = true;
+	dma_wmb();
+	*command = next;
+	return 0;
+}
+
+int imx50_epdc_buffers_complete(struct imx50_epdc_buffers *b, int error)
+{
+	if (b->fault)
+		return b->fault;
+	if (!b->active)
+		return -EINVAL;
+	if (error > 0)
+		error = -EIO;
+	dma_rmb();
+	if (!error)
+		error = epdc_buffers_check(b, true);
+	if (error) {
+		b->fault = error;
+		return error;
+	}
+	b->active = false;
+	if (b->initializing)
+		b->primed = true;
+	return 0;
+}
+
+int imx50_epdc_buffers_abort_unsubmitted(struct imx50_epdc_buffers *b)
+{
+	if (b->fault || !b->active)
+		return b->fault ? b->fault : -EINVAL;
+	b->active = false;
+	b->ready = false;
+	b->initializing = false;
+	b->primed = false;
+	return 0;
+}
+
+int imx50_epdc_buffers_invalidate(struct imx50_epdc_buffers *b)
+{
+	if (b->fault || b->active)
+		return b->fault ? b->fault : -EBUSY;
+	b->primed = false;
+	b->ready = false;
+	return 0;
+}
+
+int imx50_epdc_buffers_free(struct imx50_epdc_buffers *b)
+{
+	if (b->fault || b->active)
+		return b->fault ? b->fault : -EBUSY;
+	epdc_dma_free(b->dev, &b->update);
+	epdc_dma_free(b->dev, &b->work);
+	epdc_dma_free(b->dev, &b->wave);
+	kfree(b);
+	return 0;
+}
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/drivers/video/fbdev/imx50-epdc-fb.c
@@ -0,0 +1,672 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* RAM framebuffer consumer of the K4 EPDC service. */
+#include <linux/fb.h>
+#include <linux/imx50-epdc.h>
+#include <linux/imx50-epdc-image.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+#include <linux/workqueue.h>
+
+#define K4_FB_WIDTH 800
+#define K4_FB_HEIGHT 600
+#define K4_FB_BYTES (K4_FB_WIDTH * K4_FB_HEIGHT * 4)
+
+/* Same canonical ordering as imx50_epdc_mode; file indices belong to the loader. */
+static const char * const k4_fb_waveforms[] = {
+	"du", "gc16", "gc16-fast", "a2", "gl16", "gl16-fast",
+};
+
+struct k4_fb {
+	struct fb_info *info;
+	struct imx50_epdc *epdc;
+	struct fb_deferred_io defio;
+	struct delayed_work idle_work;
+	struct mutex io_lock;
+	spinlock_t dirty_lock;
+	struct imx50_epdc_rect damage;
+	void *snapshot;
+	u32 palette[16], updates;
+	u32 width, height, stride, bpp, rotation;
+	enum imx50_epdc_format format;
+	enum imx50_epdc_mode waveform_mode;
+	unsigned long idle_delay, idle_deadline;
+	int last_error, power_error;
+	bool dirty, blanked, suspended, stopped, needs_full, full_requested;
+};
+
+/* Damage callbacks can be called by console drawing: no sleeping or DMA. */
+static void k4_fb_merge(struct k4_fb *f, u32 x, u32 y, u32 w, u32 h, bool queue)
+{
+	struct imx50_epdc_rect *r = &f->damage;
+	unsigned long flags;
+	u32 right, bottom;
+	bool schedule;
+
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	if (!w || !h || x >= f->width || y >= f->height)
+		goto out;
+	w = min(w, f->width - x);
+	h = min(h, f->height - y);
+	if (f->dirty) {
+		right = max(r->left + r->width, x + w);
+		bottom = max(r->top + r->height, y + h);
+		r->left = min(r->left, x);
+		r->top = min(r->top, y);
+		r->width = right - r->left;
+		r->height = bottom - r->top;
+	} else {
+		*r = (struct imx50_epdc_rect){ x, y, w, h };
+	}
+	f->dirty = true;
+	schedule = queue && !f->blanked && !f->suspended && !f->stopped;
+	if (schedule)
+		schedule_delayed_work(&f->info->deferred_work, f->defio.delay);
+out:
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+}
+
+static void k4_fb_damage(struct k4_fb *f, u32 x, u32 y, u32 w, u32 h)
+{
+	k4_fb_merge(f, x, y, w, h, true);
+}
+
+/* Publish the full rectangle and algorithm request together before queueing. */
+static void k4_fb_request_full(struct k4_fb *f)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	f->damage = (struct imx50_epdc_rect){ 0, 0, f->width, f->height };
+	f->dirty = true;
+	f->full_requested = true;
+	if (!f->blanked && !f->suspended && !f->stopped)
+		schedule_delayed_work(&f->info->deferred_work, f->defio.delay);
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+}
+
+static void k4_fb_range(struct k4_fb *f, off_t offset, size_t len, bool queue)
+{
+	unsigned long flags, first, last;
+	u32 bytes, width, stride;
+
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	bytes = f->stride * f->height;
+	width = f->width;
+	stride = f->stride;
+	if (offset < 0 || offset >= bytes || !len) {
+		spin_unlock_irqrestore(&f->dirty_lock, flags);
+		return;
+	}
+	len = min_t(size_t, len, bytes - offset);
+	first = offset / stride;
+	last = (offset + len - 1) / stride;
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+	/* A simultaneous mode change itself marks the whole new canvas dirty. */
+	k4_fb_merge(f, 0, first, width, last - first + 1, queue);
+}
+
+static void k4_fb_damage_range(struct fb_info *info, off_t offset, size_t len)
+{
+	k4_fb_range(info->par, offset, len, true);
+}
+
+static void k4_fb_damage_area(struct fb_info *info, u32 x, u32 y, u32 w, u32 h)
+{
+	k4_fb_damage(info->par, x, y, w, h);
+}
+
+FB_GEN_DEFAULT_DEFERRED_SYSMEM_OPS(k4_fb, k4_fb_damage_range, k4_fb_damage_area)
+
+static void k4_fb_idle(struct work_struct *work)
+{
+	struct k4_fb *f = container_of(to_delayed_work(work), struct k4_fb, idle_work);
+	unsigned long flags;
+	bool paused;
+
+	mutex_lock(&f->io_lock);
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	paused = f->blanked || f->suspended || f->stopped;
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+	if (paused)
+		goto out;
+	/* A queued old idle worker may have waited behind a newer update. */
+	if (time_before(jiffies, f->idle_deadline)) {
+		mod_delayed_work(system_wq, &f->idle_work, f->idle_deadline - jiffies);
+	} else {
+		f->needs_full = true;
+		f->power_error = imx50_epdc_powerdown(f->epdc);
+	}
+out:
+	mutex_unlock(&f->io_lock);
+}
+
+static void k4_fb_deferred(struct fb_info *info, struct list_head *pages)
+{
+	struct k4_fb *f = info->par;
+	struct fb_deferred_io_pageref *page;
+	struct imx50_epdc_source source;
+	struct imx50_epdc_rect rect;
+	unsigned long flags;
+	bool full;
+	int ret;
+
+	/* Core has write-protected the dirty mmap pages before this callback. */
+	list_for_each_entry(page, pages, list)
+		k4_fb_range(f, page->offset, PAGE_SIZE, false);
+	mutex_lock(&f->io_lock);
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	if (!f->dirty || f->blanked || f->suspended || f->stopped) {
+		spin_unlock_irqrestore(&f->dirty_lock, flags);
+		goto out;
+	}
+	rect = f->damage;
+	full = f->needs_full || f->full_requested;
+	f->full_requested = false;
+	f->dirty = false;
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+	cancel_delayed_work(&f->idle_work);
+	/* After idle powerdown the owner runs INIT, which affects the full panel.
+	 * Restore the entire shadow image, even when the new damage is small.
+	 * Explicit refresh also applies the waveform to every unchanged pixel.
+	 */
+	if (full)
+		rect = (struct imx50_epdc_rect){ 0, 0, f->width, f->height };
+	memcpy(f->snapshot, info->screen_buffer, f->stride * f->height);
+	source = (struct imx50_epdc_source) {
+		.pixels = f->snapshot, .size = f->stride * f->height,
+		.width = f->width, .height = f->height, .stride = f->stride,
+		.format = f->format, .rotation = f->rotation * 90, .region = rect,
+	};
+	ret = imx50_epdc_update(f->epdc, &source, f->waveform_mode, full);
+	f->last_error = ret;
+	if (ret) {
+		/* Keep damage for an explicit retry/new write, not a busy retry loop. */
+		spin_lock_irqsave(&f->dirty_lock, flags);
+		f->damage = (struct imx50_epdc_rect){ 0, 0, f->width, f->height };
+		f->dirty = true;
+		spin_unlock_irqrestore(&f->dirty_lock, flags);
+		f->needs_full = true;
+		f->power_error = imx50_epdc_powerdown(f->epdc);
+	} else {
+		f->updates++;
+		f->needs_full = false;
+		f->idle_deadline = jiffies + f->idle_delay;
+		mod_delayed_work(system_wq, &f->idle_work, f->idle_delay);
+	}
+out:
+	mutex_unlock(&f->io_lock);
+}
+
+static int k4_fb_check_var(struct fb_var_screeninfo *v, struct fb_info *info)
+{
+	u32 width = v->rotate & 1 ? K4_FB_HEIGHT : K4_FB_WIDTH;
+	u32 height = v->rotate & 1 ? K4_FB_WIDTH : K4_FB_HEIGHT;
+
+	if (v->rotate > FB_ROTATE_CCW || v->xres != width || v->yres != height ||
+	    v->xres_virtual != width || v->yres_virtual != height ||
+	    (v->bits_per_pixel != 32 && v->bits_per_pixel != 16 && v->bits_per_pixel != 8) ||
+	    v->xoffset || v->yoffset || v->nonstd || v->grayscale > 1 ||
+	    v->vmode != FB_VMODE_NONINTERLACED)
+		return -EINVAL;
+	if (v->bits_per_pixel == 32) {
+		v->red = (struct fb_bitfield){ 16, 8, 0 };
+		v->green = (struct fb_bitfield){ 8, 8, 0 };
+		v->blue = (struct fb_bitfield){ 0, 8, 0 };
+	} else if (v->bits_per_pixel == 16) {
+		v->red = (struct fb_bitfield){ 11, 5, 0 };
+		v->green = (struct fb_bitfield){ 5, 6, 0 };
+		v->blue = (struct fb_bitfield){ 0, 5, 0 };
+	} else {
+		/* Direct Y8; overlapping grayscale components, no mutable color LUT. */
+		v->red = v->green = v->blue = (struct fb_bitfield){ 0, 8, 0 };
+		v->grayscale = 1;
+	}
+	v->transp = (struct fb_bitfield){ 0, 0, 0 };
+	return 0;
+}
+
+static int k4_fb_set_par(struct fb_info *info)
+{
+	struct k4_fb *f = info->par;
+	struct fb_var_screeninfo v = info->var;
+	unsigned long flags;
+	int ret;
+
+	ret = k4_fb_check_var(&v, info);
+	if (ret)
+		return ret;
+	mutex_lock(&f->io_lock);
+	if (f->stopped || f->suspended) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (f->width == v.xres && f->height == v.yres &&
+	    f->bpp == v.bits_per_pixel && f->rotation == v.rotate)
+		goto out;
+	cancel_delayed_work(&f->idle_work);
+	f->needs_full = true;
+	ret = imx50_epdc_powerdown(f->epdc);
+	f->power_error = ret;
+	if (ret)
+		goto out;
+	/* Keep allocation and deferred-IO page references stable for existing VMAs.
+	 * A mode switch changes their layout, not the mapped memory's lifetime.
+	 */
+	memset(info->screen_buffer, 0xff, K4_FB_BYTES);
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	f->width = v.xres;
+	f->height = v.yres;
+	f->bpp = v.bits_per_pixel;
+	f->rotation = v.rotate;
+	f->stride = f->width * (f->bpp / 8);
+	f->format = f->bpp == 32 ? IMX50_EPDC_XRGB8888 :
+		    f->bpp == 16 ? IMX50_EPDC_RGB565 : IMX50_EPDC_Y8;
+	info->fix.line_length = f->stride;
+	f->damage = (struct imx50_epdc_rect){ 0, 0, f->width, f->height };
+	f->dirty = true;
+	if (!f->blanked)
+		schedule_delayed_work(&info->deferred_work, f->defio.delay);
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+out:
+	mutex_unlock(&f->io_lock);
+	return ret;
+}
+
+static int k4_fb_setcolreg(unsigned int reg, unsigned int red, unsigned int green,
+			 unsigned int blue, unsigned int transp, struct fb_info *info)
+{
+	struct k4_fb *f = info->par;
+
+	if (reg >= ARRAY_SIZE(f->palette))
+		return -EINVAL;
+	red >>= 8;
+	green >>= 8;
+	blue >>= 8;
+	if (info->var.bits_per_pixel == 8)
+		f->palette[reg] = (77 * red + 150 * green + 29 * blue + 128) >> 8;
+	else if (info->var.bits_per_pixel == 16)
+		f->palette[reg] = ((red >> 3) << 11) | ((green >> 2) << 5) | (blue >> 3);
+	else
+		f->palette[reg] = (red << 16) | (green << 8) | blue;
+	return 0;
+}
+
+static int k4_fb_blank(int blank, struct fb_info *info)
+{
+	struct k4_fb *f = info->par;
+	unsigned long flags;
+	int ret = 0;
+
+	if (blank < FB_BLANK_UNBLANK || blank > FB_BLANK_POWERDOWN)
+		return -EINVAL;
+	mutex_lock(&f->io_lock);
+	if (f->stopped) {
+		mutex_unlock(&f->io_lock);
+		return -ENODEV;
+	}
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	f->blanked = blank != FB_BLANK_UNBLANK;
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+	if (blank) {
+		cancel_delayed_work(&f->idle_work);
+		f->needs_full = true;
+		ret = imx50_epdc_powerdown(f->epdc);
+		f->power_error = ret;
+	} else {
+		k4_fb_damage(f, 0, 0, ~0U, ~0U);
+	}
+	mutex_unlock(&f->io_lock);
+	return ret;
+}
+
+/* fb_info stays alive for existing files/VMAs after unregister. Those files
+ * pin fbops->owner; destroy runs on the final fb_info reference, not remove.
+ */
+static void k4_fb_destroy(struct fb_info *info)
+{
+	struct k4_fb *f = info->par;
+
+	fb_deferred_io_cleanup(info);
+	cancel_delayed_work_sync(&f->idle_work);
+	fb_dealloc_cmap(&info->cmap);
+	vfree(f->snapshot);
+	vfree(info->screen_buffer);
+	framebuffer_release(info);
+}
+
+static int k4_fb_open(struct fb_info *info, int user)
+{
+	struct k4_fb *f = info->par;
+
+	return READ_ONCE(f->stopped) ? -ENODEV : 0;
+}
+
+static const struct fb_ops k4_fb_ops = {
+	.owner = THIS_MODULE,
+	.fb_open = k4_fb_open,
+	.fb_destroy = k4_fb_destroy,
+	FB_DEFAULT_DEFERRED_OPS(k4_fb),
+	.fb_check_var = k4_fb_check_var,
+	.fb_set_par = k4_fb_set_par,
+	.fb_setcolreg = k4_fb_setcolreg,
+	.fb_blank = k4_fb_blank,
+};
+
+static int k4_fb_suspend(struct device *dev)
+{
+	struct k4_fb *f = dev_get_drvdata(dev);
+	unsigned long flags;
+	int ret;
+
+	mutex_lock(&f->io_lock);
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	f->suspended = true;
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+	cancel_delayed_work(&f->idle_work);
+	f->needs_full = true;
+	ret = imx50_epdc_powerdown(f->epdc);
+	f->power_error = ret;
+	if (ret) {
+		spin_lock_irqsave(&f->dirty_lock, flags);
+		f->suspended = false;
+		spin_unlock_irqrestore(&f->dirty_lock, flags);
+	}
+	mutex_unlock(&f->io_lock);
+	return ret;
+}
+
+static int k4_fb_resume(struct device *dev)
+{
+	struct k4_fb *f = dev_get_drvdata(dev);
+	unsigned long flags;
+
+	mutex_lock(&f->io_lock);
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	f->suspended = false;
+	if (!f->blanked && !f->stopped)
+		schedule_delayed_work(&f->info->deferred_work, f->defio.delay);
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+	mutex_unlock(&f->io_lock);
+	return 0;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(k4_fb_pm, k4_fb_suspend, k4_fb_resume);
+
+static int k4_fb_flush(struct k4_fb *f, bool full)
+{
+	unsigned long flags;
+	int ret;
+
+	if (full) {
+		k4_fb_request_full(f);
+	} else {
+		/* A prior failure retains damage without a busy retry loop. An
+		 * explicit flush is permission to retry that damage once.
+		 * mmap page faults already queue deferred work independently.
+		 */
+		spin_lock_irqsave(&f->dirty_lock, flags);
+		if (f->dirty && !f->stopped && !f->suspended && !f->blanked)
+			schedule_delayed_work(&f->info->deferred_work, f->defio.delay);
+		spin_unlock_irqrestore(&f->dirty_lock, flags);
+	}
+	flush_delayed_work(&f->info->deferred_work);
+	mutex_lock(&f->io_lock);
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	ret = f->stopped || f->suspended || f->blanked ? -EBUSY : f->last_error;
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+	mutex_unlock(&f->io_lock);
+	return ret;
+}
+
+static ssize_t refresh_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct k4_fb *f = dev_get_drvdata(dev);
+	bool request;
+	int ret;
+
+	ret = kstrtobool(buf, &request);
+	if (ret || !request)
+		return -EINVAL;
+	ret = k4_fb_flush(f, true);
+	if (ret)
+		return ret;
+	return count;
+}
+static DEVICE_ATTR_WO(refresh);
+
+static ssize_t flush_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct k4_fb *f = dev_get_drvdata(dev);
+	bool request;
+	int ret;
+
+	ret = kstrtobool(buf, &request);
+	if (ret || !request)
+		return -EINVAL;
+	ret = k4_fb_flush(f, false);
+	if (ret)
+		return ret;
+	return count;
+}
+static DEVICE_ATTR_WO(flush);
+
+static ssize_t waveform_mode_show(struct device *dev, struct device_attribute *attr,
+				  char *buf)
+{
+	struct k4_fb *f = dev_get_drvdata(dev);
+	ssize_t n;
+
+	mutex_lock(&f->io_lock);
+	n = sysfs_emit(buf, "%s\n", k4_fb_waveforms[f->waveform_mode - IMX50_EPDC_MODE_DU]);
+	mutex_unlock(&f->io_lock);
+	return n;
+}
+
+static ssize_t waveform_mode_store(struct device *dev, struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct k4_fb *f = dev_get_drvdata(dev);
+	int mode, ret = 0;
+
+	mode = sysfs_match_string(k4_fb_waveforms, buf);
+	if (mode < 0)
+		return -EINVAL;
+	mutex_lock(&f->io_lock);
+	if (f->stopped)
+		ret = -EBUSY;
+	else
+		/* Configuration only: do not queue a refresh or power the panel.
+		 * Work not yet started uses this mode; an in-flight snapshot holds
+		 * io_lock and finishes before the setting can change.
+		 */
+		f->waveform_mode = mode + IMX50_EPDC_MODE_DU;
+	mutex_unlock(&f->io_lock);
+	if (ret)
+		return ret;
+	return count;
+}
+static DEVICE_ATTR_RW(waveform_mode);
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct k4_fb *f = dev_get_drvdata(dev);
+	unsigned long flags;
+	bool dirty, full_requested;
+	ssize_t n;
+
+	mutex_lock(&f->io_lock);
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	dirty = f->dirty;
+	full_requested = f->full_requested;
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+	n = sysfs_emit(buf, "updates=%u last_error=%d power_error=%d dirty=%u needs_full=%u\n",
+		       f->updates, f->last_error, f->power_error, dirty, f->needs_full);
+	n += sysfs_emit_at(buf, n, "width=%u height=%u bpp=%u rotation=%u stride=%u\n",
+			   f->width, f->height, f->bpp, f->rotation * 90, f->stride);
+	n += sysfs_emit_at(buf, n, "waveform_mode=%s\n",
+			   k4_fb_waveforms[f->waveform_mode - IMX50_EPDC_MODE_DU]);
+	n += sysfs_emit_at(buf, n, "full_requested=%u\n", full_requested);
+	mutex_unlock(&f->io_lock);
+	return n;
+}
+static DEVICE_ATTR_RO(state);
+
+static struct attribute *k4_fb_attrs[] = {
+	&dev_attr_refresh.attr,
+	&dev_attr_flush.attr,
+	&dev_attr_waveform_mode.attr,
+	&dev_attr_state.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(k4_fb);
+
+static int k4_fb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct fb_info *info;
+	struct k4_fb *f;
+	u32 update_ms = 100, idle_ms = 500;
+	int ret;
+
+	info = framebuffer_alloc(sizeof(*f), dev);
+	if (!info)
+		return -ENOMEM;
+	f = info->par;
+	f->info = info;
+	f->needs_full = true;
+	f->width = K4_FB_WIDTH;
+	f->height = K4_FB_HEIGHT;
+	f->bpp = 32;
+	f->stride = K4_FB_WIDTH * 4;
+	f->format = IMX50_EPDC_XRGB8888;
+	f->waveform_mode = IMX50_EPDC_MODE_GC16;
+	f->epdc = devm_imx50_epdc_get(dev, "epdc");
+	if (IS_ERR(f->epdc)) {
+		ret = dev_err_probe(dev, PTR_ERR(f->epdc), "EPDC supplier\n");
+		goto free_info;
+	}
+	if (of_find_property(dev->of_node, "update-delay-ms", NULL)) {
+		ret = of_property_read_u32(dev->of_node, "update-delay-ms", &update_ms);
+		if (ret)
+			goto free_info;
+	}
+	if (of_find_property(dev->of_node, "idle-delay-ms", NULL)) {
+		ret = of_property_read_u32(dev->of_node, "idle-delay-ms", &idle_ms);
+		if (ret)
+			goto free_info;
+	}
+	mutex_init(&f->io_lock);
+	spin_lock_init(&f->dirty_lock);
+	INIT_DELAYED_WORK(&f->idle_work, k4_fb_idle);
+	f->idle_delay = msecs_to_jiffies(idle_ms);
+	f->defio.delay = max_t(unsigned long, 1, msecs_to_jiffies(update_ms));
+	f->defio.deferred_io = k4_fb_deferred;
+	info->screen_buffer = vzalloc(K4_FB_BYTES);
+	f->snapshot = vzalloc(K4_FB_BYTES);
+	if (!info->screen_buffer || !f->snapshot) {
+		ret = -ENOMEM;
+		goto free_memory;
+	}
+	memset(info->screen_buffer, 0xff, K4_FB_BYTES);
+	info->screen_size = K4_FB_BYTES;
+	info->fbops = &k4_fb_ops;
+	info->flags = FBINFO_VIRTFB;
+	info->pseudo_palette = f->palette;
+	info->fix = (struct fb_fix_screeninfo) {
+		.id = "k4-epdc", .type = FB_TYPE_PACKED_PIXELS,
+		.visual = FB_VISUAL_TRUECOLOR, .line_length = K4_FB_WIDTH * 4,
+		.smem_len = K4_FB_BYTES, .accel = FB_ACCEL_NONE,
+	};
+	info->var = (struct fb_var_screeninfo) {
+		.xres = K4_FB_WIDTH, .yres = K4_FB_HEIGHT,
+		.xres_virtual = K4_FB_WIDTH, .yres_virtual = K4_FB_HEIGHT,
+		.bits_per_pixel = 32, .width = -1, .height = -1,
+	};
+	k4_fb_check_var(&info->var, info);
+	info->fbdefio = &f->defio;
+	ret = fb_alloc_cmap(&info->cmap, 256, 0);
+	if (ret)
+		goto free_memory;
+	ret = fb_deferred_io_init(info);
+	if (ret)
+		goto free_cmap;
+	platform_set_drvdata(pdev, f);
+	ret = register_framebuffer(info);
+	if (ret)
+		goto free_defio;
+	dev_info(dev, "fb%d: K4 800x600, 8/16/32 bpp and four orientations\n", info->node);
+	return 0;
+free_defio:
+	spin_lock_irq(&f->dirty_lock);
+	f->stopped = true;
+	spin_unlock_irq(&f->dirty_lock);
+	fb_deferred_io_cleanup(info);
+	cancel_delayed_work_sync(&f->idle_work);
+	imx50_epdc_powerdown(f->epdc);
+free_cmap:
+	fb_dealloc_cmap(&info->cmap);
+free_memory:
+	vfree(f->snapshot);
+	vfree(info->screen_buffer);
+free_info:
+	framebuffer_release(info);
+	return ret;
+}
+
+static void k4_fb_shutdown(struct platform_device *pdev)
+{
+	struct k4_fb *f = platform_get_drvdata(pdev);
+	unsigned long flags;
+
+	spin_lock_irqsave(&f->dirty_lock, flags);
+	f->stopped = true;
+	spin_unlock_irqrestore(&f->dirty_lock, flags);
+	cancel_delayed_work_sync(&f->info->deferred_work);
+	cancel_delayed_work_sync(&f->idle_work);
+	mutex_lock(&f->io_lock);
+	f->power_error = imx50_epdc_powerdown(f->epdc);
+	mutex_unlock(&f->io_lock);
+}
+
+static void k4_fb_remove(struct platform_device *pdev)
+{
+	struct k4_fb *f = platform_get_drvdata(pdev);
+	struct fb_info *info = f->info;
+
+	/* Stop queueing and drain refresh/idle before supplier links are released.
+	 * Old mmap writes may still queue defio, but its stopped callback does no
+	 * hardware access. Memory/defio remain owned by the final fb_info reference.
+	 */
+	k4_fb_shutdown(pdev);
+	lock_fb_info(info);
+	info->state = FBINFO_STATE_SUSPENDED;
+	unlock_fb_info(info);
+	platform_set_drvdata(pdev, NULL);
+	unregister_framebuffer(info); /* May call k4_fb_destroy immediately. */
+}
+
+static const struct of_device_id k4_fb_match[] = {
+	{ .compatible = "amazon,k4-epdc-fb" }, { }
+};
+
+static struct platform_driver k4_fb_driver = {
+	.probe = k4_fb_probe,
+	.shutdown = k4_fb_shutdown,
+	.remove_new = k4_fb_remove,
+	.driver = {
+		.name = "k4-epdc-fb",
+		.of_match_table = k4_fb_match,
+		.pm = pm_sleep_ptr(&k4_fb_pm),
+		.dev_groups = k4_fb_groups,
+	},
+};
+module_platform_driver(k4_fb_driver);
+MODULE_DEVICE_TABLE(of, k4_fb_match);
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/drivers/video/fbdev/imx50-epdc-hw.c
@@ -0,0 +1,462 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* i.MX50 RM Rev.2 chapter 24: reset, K4 timing, serial DMA and IRQ drain. */
+#include <linux/bitops.h>
+#include <linux/imx50-epdc-buffer.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+
+#include "imx50-epdc-hw.h"
+
+#define E_CTRL		0x000
+#define E_CTRL_SET	0x004
+#define E_CTRL_CLR	0x008
+#define E_WAVE		0x020
+#define E_WORK		0x030
+#define E_RES		0x040
+#define E_UPDATE	0x100
+#define E_COORD		0x120
+#define E_SIZE		0x140
+#define E_COMMAND	0x160
+#define E_FIXED		0x180
+#define E_TEMP		0x1a0
+#define E_MASK		0x400
+#define E_IRQ		0x420
+#define E_IRQ_CLR	0x428
+#define E_LUTS		0x440
+#define E_STATUS	0x4a0
+#define E_GPIO		0x700
+#define E_VERSION	0x7f0
+
+#define E_RESET		BIT(31)
+#define E_GATE		BIT(30)
+#define E_LUT0		BIT(0)
+#define E_WB		BIT(16)
+#define E_COLLISION	BIT(17)
+#define E_UNDERRUN	BIT(18)
+#define E_BUS_ERROR	BIT(20)
+#define E_IDLE		BIT(21)
+#define E_ERRORS	(E_COLLISION | E_UNDERRUN | E_BUS_ERROR)
+#define E_DONE		(E_LUT0 | E_WB | E_IDLE)
+#define E_IRQS		(0xffff | E_WB | E_ERRORS | E_IDLE)
+#define E_ALL_IRQS	0x3fffff
+#define E_PANEL_RES	((600 << 16) | 800)
+
+/* Same E60_V220_WJ values as the original mx50_yoshi board mode. All registers
+ * here are configuration, not UPD_CTRL, DEBUG or a panel power-enable register.
+ */
+static const struct {
+	u32 offset, value;
+} k4_epdc_timing[] = {
+	{ 0x050, 0x00000400 }, /* P4N buffer; 2-bit TFT, default neutral pixel */
+	{ 0x0a0, 0x0064c864 }, /* FIFO initial/high/low = 100/200/100 */
+	{ E_RES, E_PANEL_RES },
+	{ 0x200, 0x00040002 }, /* holdoff 4, 4 pixels/SDCLK */
+	{ 0x220, 0x00314320 }, /* hold, SDSHR, CE1, pixel flip, 800 pixels/CE */
+	{ 0x240, 0x00000010 }, /* GDRL */
+	{ 0x260, 0x000f000f }, /* line sync width/end = 15/15 */
+	{ 0x280, 0x00ac0011 }, /* line end/begin = 172/17 */
+	{ 0x2a0, 0x00120404 }, /* frame end/begin/sync = 18/4/4 */
+	{ 0x2c0, 0x0a140a14 }, /* SDOED/Z width/delay = 10/20 */
+	{ 0x2e0, 0x0000000e }, /* SDLE/SDOE/GDOE active high */
+	{ 0x300, 0x00000000 },
+	{ 0x310, 0x01a90014 }, /* GDCLK half period/GDSP = 425/20 */
+	{ 0x320, 0x00000011 }, /* GDOE/GDCLK offset = 0/17 */
+};
+
+void imx50_epdc_hw_init(struct imx50_epdc_hw *hw, void __iomem *base)
+{
+	*hw = (struct imx50_epdc_hw){ .base = base };
+	mutex_init(&hw->lock);
+	spin_lock_init(&hw->irq_lock);
+	init_completion(&hw->done);
+}
+
+/* STATUS.LUTS_BUSY means ALL LUTs busy, not that there are no active LUTs.
+ * Always inspect the full STATUS_LUTS bitmap as well. No writes to DEBUG.
+ */
+static bool epdc_hw_quiet(struct imx50_epdc_hw *hw)
+{
+	return !(readl(hw->base + E_STATUS) & 7) &&
+	       !(readl(hw->base + E_LUTS) & 0xffff);
+}
+
+static int epdc_hw_reset(struct imx50_epdc_hw *hw)
+{
+	u32 value;
+	int ret;
+	/* Inherited CLKGATE must not satisfy the reset-assert handshake. */
+	writel(E_RESET | E_GATE, hw->base + E_CTRL_CLR);
+	ret = readl_poll_timeout(hw->base + E_CTRL, value,
+				 !(value & (E_RESET | E_GATE)), 10, 1000);
+	if (ret)
+		return ret;
+	writel(E_RESET, hw->base + E_CTRL_SET);
+	ret = readl_poll_timeout(hw->base + E_CTRL, value, value & E_GATE, 10, 1000);
+	if (ret)
+		return ret;
+	writel(E_RESET | E_GATE, hw->base + E_CTRL_CLR);
+	ret = readl_poll_timeout(hw->base + E_CTRL, value,
+				 !(value & (E_RESET | E_GATE)), 10, 1000);
+	return ret;
+}
+
+int imx50_epdc_hw_inherited_idle(struct imx50_epdc_hw *hw)
+{
+	hw->preflight_count++;
+	hw->preflight_version = readl(hw->base + E_VERSION);
+	hw->preflight_ctrl = hw->preflight_status = 0;
+	hw->preflight_luts = hw->preflight_irq = 0;
+	if (hw->preflight_version >> 24 != 1) {
+		hw->preflight_result = -ENODEV;
+		return hw->preflight_result;
+	}
+	hw->preflight_ctrl = readl(hw->base + E_CTRL);
+	hw->preflight_status = readl(hw->base + E_STATUS);
+	hw->preflight_luts = readl(hw->base + E_LUTS);
+	hw->preflight_irq = readl(hw->base + E_IRQ);
+	/* Preserve the inherited-DMA policy; the snapshot explains rejection. */
+	hw->preflight_result = (hw->preflight_status & 7) ||
+		(hw->preflight_luts & 0xffff) ||
+		(!(hw->preflight_ctrl & E_GATE) &&
+		 !(hw->preflight_irq & E_IDLE)) ? -EBUSY : 0;
+	return hw->preflight_result;
+}
+
+int imx50_epdc_hw_configure(struct imx50_epdc_hw *hw, struct imx50_epdc_buffers *buffers)
+{
+	unsigned long flags;
+	u32 value, actual;
+	const char *stage = "inherited";
+	unsigned int i;
+	int ret;
+
+	if (!buffers)
+		return -EINVAL;
+	mutex_lock(&hw->lock);
+	if (hw->fault || hw->configured) {
+		ret = hw->fault ? hw->fault : -EALREADY;
+		goto out;
+	}
+	ret = imx50_epdc_buffers_invalidate(buffers);
+	if (ret)
+		goto out;
+	/* Never reset an inherited DMA operation or discard its buffers. */
+	ret = imx50_epdc_hw_inherited_idle(hw);
+	if (ret)
+		goto fault;
+	stage = "reset";
+	ret = epdc_hw_reset(hw);
+	if (ret)
+		goto fault;
+	/* The inherited controller gate blocks ordinary register writes.
+	 * Reset ungates it first; the owner's Linux IRQ remains disabled.
+	 */
+	stage = "mask";
+	writel(0, hw->base + E_MASK);
+	if (readl(hw->base + E_MASK)) {
+		ret = -EIO;
+		goto fault;
+	}
+	stage = "control";
+	/* Clear SRAM powerdown and both data swizzles, preserve other bits. */
+	writel(0x1f0, hw->base + E_CTRL_CLR);
+	if (readl(hw->base + E_CTRL) & (E_RESET | E_GATE | 0x1f0)) {
+		ret = -EIO;
+		goto fault;
+	}
+	stage = "timing";
+	for (i = 0; i < ARRAY_SIZE(k4_epdc_timing); i++) {
+		writel(k4_epdc_timing[i].value, hw->base + k4_epdc_timing[i].offset);
+		actual = readl(hw->base + k4_epdc_timing[i].offset);
+		if (actual != k4_epdc_timing[i].value) {
+			pr_err("imx50-epdc: timing %03x expected=%08x actual=%08x\n",
+			       k4_epdc_timing[i].offset, k4_epdc_timing[i].value, actual);
+			ret = -EIO;
+			goto fault;
+		}
+	}
+	stage = "idle";
+	value = readl(hw->base + E_GPIO) & ~0x7f;
+	writel(value, hw->base + E_GPIO);
+	writel(0, hw->base + E_MASK);
+	writel(E_ALL_IRQS, hw->base + E_IRQ_CLR);
+	if (readl(hw->base + E_GPIO) != value || readl(hw->base + E_MASK) ||
+	    (readl(hw->base + E_IRQ) & E_ALL_IRQS) ||
+	    !epdc_hw_quiet(hw)) {
+		ret = -EIO;
+		goto fault;
+	}
+	hw->buffers = buffers;
+	spin_lock_irqsave(&hw->irq_lock, flags);
+	hw->configured = true;
+	hw->drained = true; /* Reset/config only; no update has started. */
+	spin_unlock_irqrestore(&hw->irq_lock, flags);
+	ret = 0;
+	goto out;
+fault:
+	pr_err("imx50-epdc: configure %s error=%d ctrl=%08x irq=%08x status=%08x luts=%08x\n",
+	       stage, ret, readl(hw->base + E_CTRL), readl(hw->base + E_IRQ),
+	       readl(hw->base + E_STATUS), readl(hw->base + E_LUTS));
+	hw->fault = ret;
+out:
+	mutex_unlock(&hw->lock);
+	return ret;
+}
+
+irqreturn_t imx50_epdc_hw_irq(int irq, void *data)
+{
+	struct imx50_epdc_hw *hw = data;
+	unsigned long flags;
+	u32 pending;
+	irqreturn_t handled = IRQ_NONE;
+
+	(void)irq;
+	spin_lock_irqsave(&hw->irq_lock, flags);
+	/* An IRQ before configure or after stop must not touch gated MMIO. */
+	if (!hw->configured)
+		goto out;
+	pending = readl(hw->base + E_IRQ) & readl(hw->base + E_MASK);
+	if (!pending)
+		goto out;
+	handled = IRQ_HANDLED;
+	hw->interrupts++;
+	writel(pending, hw->base + E_IRQ_CLR);
+	if (!hw->running || (pending & (E_ERRORS | 0xfffe))) {
+		hw->fault = -EIO;
+		hw->result = -EIO;
+		goto finish;
+	}
+	hw->seen |= pending & (E_WB | E_LUT0);
+	/* Do not mistake an idle event before this LUT completed for its drain. */
+	if ((hw->seen & E_LUT0) && (pending & E_IDLE))
+		hw->seen |= E_IDLE;
+	if ((hw->seen & E_DONE) != E_DONE)
+		goto out;
+finish:
+	writel(0, hw->base + E_MASK);
+	complete(&hw->done);
+out:
+	spin_unlock_irqrestore(&hw->irq_lock, flags);
+	return handled;
+}
+
+void imx50_epdc_hw_power_fault(struct imx50_epdc_hw *hw)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hw->irq_lock, flags);
+	hw->supply_fault = true;
+	if (hw->configured && hw->running) {
+		writel(0, hw->base + E_MASK);
+		hw->fault = -EIO;
+		hw->result = -EIO;
+		complete(&hw->done);
+	}
+	spin_unlock_irqrestore(&hw->irq_lock, flags);
+}
+
+int imx50_epdc_hw_power_reset(struct imx50_epdc_hw *hw)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	mutex_lock(&hw->lock);
+	spin_lock_irqsave(&hw->irq_lock, flags);
+	if (hw->fault || hw->configured || hw->running)
+		ret = hw->fault ? hw->fault : -EBUSY;
+	else
+		hw->supply_fault = false;
+	spin_unlock_irqrestore(&hw->irq_lock, flags);
+	mutex_unlock(&hw->lock);
+	return ret;
+}
+
+/* Called with irq_lock held after masking IRQs at the wait deadline. A missed
+ * final interrupt can leave its completion bit latched. Do not infer the order
+ * of an accumulated IDLE/LUT pair: only a previously witnessed LUT completion
+ * permits a new raw IDLE to establish final blanking. No extra wait or reset.
+ */
+static int epdc_hw_deadline(struct imx50_epdc_hw *hw)
+{
+	u32 pending = readl(hw->base + E_IRQ) & E_IRQS;
+
+	if (pending & (E_ERRORS | 0xfffe))
+		return -EIO;
+	if (hw->seen & E_LUT0)
+		hw->seen |= pending & E_DONE;
+	else
+		hw->seen |= pending & (E_WB | E_LUT0);
+	if ((hw->seen & E_DONE) != E_DONE)
+		return -ETIMEDOUT;
+	writel(pending, hw->base + E_IRQ_CLR);
+	return readl(hw->base + E_IRQ) & pending ? -EIO : 0;
+}
+
+int imx50_epdc_hw_submit(struct imx50_epdc_hw *hw, bool initialize, bool full,
+			 u32 mode, u32 temperature, unsigned int timeout_ms)
+{
+	struct imx50_epdc_command command;
+	unsigned long flags, waited;
+	int ret;
+
+	if (!timeout_ms)
+		return -EINVAL;
+	ret = mutex_lock_interruptible(&hw->lock);
+	if (ret)
+		return ret;
+	if (hw->fault || !hw->configured) {
+		ret = hw->fault ? hw->fault : -ENODEV;
+		goto out;
+	}
+	if (!hw->drained || !epdc_hw_quiet(hw) || readl(hw->base + E_MASK) ||
+	    (readl(hw->base + E_CTRL) & (E_RESET | E_GATE))) {
+		hw->fault = -EBUSY;
+		ret = hw->fault;
+		goto out;
+	}
+	ret = imx50_epdc_buffers_begin(hw->buffers, initialize, full, mode,
+				       temperature, &command);
+	if (ret)
+		goto out;
+	if (command.resolution != E_PANEL_RES) {
+		ret = -EINVAL;
+		goto abort;
+	}
+	reinit_completion(&hw->done);
+	spin_lock_irqsave(&hw->irq_lock, flags);
+	/* Serialize the supply fault with the actual command write. A fault
+	 * during begin() has not started DMA and must not quarantine its buffer.
+	 */
+	if (hw->supply_fault) {
+		spin_unlock_irqrestore(&hw->irq_lock, flags);
+		ret = imx50_epdc_buffers_abort_unsubmitted(hw->buffers);
+		if (!ret)
+			ret = -EIO;
+		goto out;
+	}
+	writel(E_ALL_IRQS, hw->base + E_IRQ_CLR);
+	hw->seen = 0;
+	hw->result = 0;
+	writel(command.waveform_addr, hw->base + E_WAVE);
+	writel(command.working_addr, hw->base + E_WORK);
+	writel(command.update_addr, hw->base + E_UPDATE);
+	writel(command.coordinates, hw->base + E_COORD);
+	writel(command.size, hw->base + E_SIZE);
+	writel(command.fixed, hw->base + E_FIXED);
+	writel(command.temperature, hw->base + E_TEMP);
+	writel(E_IRQS, hw->base + E_MASK);
+	if (readl(hw->base + E_WAVE) != command.waveform_addr ||
+	    readl(hw->base + E_WORK) != command.working_addr ||
+	    readl(hw->base + E_UPDATE) != command.update_addr ||
+	    readl(hw->base + E_COORD) != command.coordinates ||
+	    readl(hw->base + E_SIZE) != command.size ||
+	    readl(hw->base + E_FIXED) != command.fixed ||
+	    readl(hw->base + E_TEMP) != command.temperature ||
+	    readl(hw->base + E_MASK) != E_IRQS ||
+	    (readl(hw->base + E_IRQ) & E_ALL_IRQS)) {
+		writel(0, hw->base + E_MASK);
+		/* No command was written, but a stuck mask still forbids clock release. */
+		if (readl(hw->base + E_MASK))
+			hw->fault = -EIO;
+		spin_unlock_irqrestore(&hw->irq_lock, flags);
+		ret = -EIO;
+		goto abort;
+	}
+	/* Only UPD_CTRL can start this operation; register preparation is not DMA. */
+	hw->running = true;
+	hw->drained = false;
+	/* begin() did dma_wmb(); ordered writel of UPD_CTRL starts DMA last. */
+	writel(command.control, hw->base + E_COMMAND);
+	spin_unlock_irqrestore(&hw->irq_lock, flags);
+	waited = wait_for_completion_timeout(&hw->done, msecs_to_jiffies(timeout_ms));
+	spin_lock_irqsave(&hw->irq_lock, flags);
+	writel(0, hw->base + E_MASK);
+	ret = hw->result;
+	if (!waited && !ret)
+		ret = epdc_hw_deadline(hw);
+	if (!ret && ((hw->seen & E_DONE) != E_DONE || !epdc_hw_quiet(hw) ||
+		     readl(hw->base + E_MASK) ||
+		     (readl(hw->base + E_IRQ) & (E_ERRORS | 0xfffe))))
+		ret = -EIO;
+	hw->running = false;
+	spin_unlock_irqrestore(&hw->irq_lock, flags);
+	if (ret)
+		goto quarantine;
+	ret = imx50_epdc_buffers_complete(hw->buffers, 0);
+	if (ret)
+		goto quarantine;
+	hw->drained = true;
+	if (initialize)
+		hw->init_updates++;
+	else if (command.size == E_PANEL_RES)
+		hw->canvas_updates++;
+	else
+		hw->region_updates++;
+	hw->last_coordinates = command.coordinates;
+	hw->last_size = command.size;
+	hw->last_mode = mode;
+	hw->last_full = full;
+	if (!waited) {
+		hw->polled_completions++;
+	}
+	goto out;
+abort:
+	/* Withdraw only a command never written. An attempted command write, even
+	 * one without completion/readback, must keep the existing DMA quarantine.
+	 */
+	if (imx50_epdc_buffers_abort_unsubmitted(hw->buffers))
+		goto quarantine;
+	goto out;
+quarantine:
+	hw->fault = ret;
+	imx50_epdc_buffers_complete(hw->buffers, ret);
+out:
+	mutex_unlock(&hw->lock);
+	return ret;
+}
+
+int imx50_epdc_hw_stop(struct imx50_epdc_hw *hw)
+{
+	unsigned long flags;
+	u32 value;
+	int ret = 0;
+
+	mutex_lock(&hw->lock);
+	if (hw->fault) {
+		ret = hw->fault;
+		goto out;
+	}
+	if (!hw->configured)
+		goto out;
+	if (!hw->drained || !epdc_hw_quiet(hw)) {
+		hw->fault = -EBUSY;
+		ret = hw->fault;
+		goto out;
+	}
+	ret = imx50_epdc_buffers_invalidate(hw->buffers);
+	if (ret) {
+		hw->fault = ret;
+		goto out;
+	}
+	spin_lock_irqsave(&hw->irq_lock, flags);
+	writel(0, hw->base + E_MASK);
+	if (readl(hw->base + E_MASK)) {
+		hw->fault = -EIO;
+		ret = hw->fault;
+		spin_unlock_irqrestore(&hw->irq_lock, flags);
+		goto out;
+	}
+	hw->configured = false;
+	spin_unlock_irqrestore(&hw->irq_lock, flags);
+	writel(E_GATE, hw->base + E_CTRL_SET);
+	ret = readl_poll_timeout(hw->base + E_CTRL, value, value & E_GATE, 10, 1000);
+	if (ret)
+		hw->fault = ret;
+out:
+	mutex_unlock(&hw->lock);
+	return ret;
+}
+
