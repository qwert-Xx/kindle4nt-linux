+// SPDX-License-Identifier: GPL-2.0-only
+/* Decode format-1 WBF or load WRF; raw WBF never reaches controller DMA. */
+#include <linux/crc32.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/firmware.h>
+#include <linux/imx50-epdc-buffer.h>
+#include <linux/module.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/property.h>
+#include <linux/overflow.h>
+#include <linux/slab.h>
+#include <asm/unaligned.h>
+
+#include "imx50-epdc-waveform.h"
+
+#define K4_WBF_NAME "amazon/k4/panel-stock.wbf"
+#define K4_WRF_NAME "amazon/k4/panel-stock.wrf"
+#define K4_HEADER_SIZE 48
+
+/* Amazon eink_panel.c: mode versions 4/6 share a map; version 7 adds FAST. */
+static const u8 k4_modes_04[] = { 0, 1, 2, 2, 4, 5, 5 };
+static const u8 k4_modes_07[] = { 0, 1, 2, 3, 4, 5, 6 };
+
+struct imx50_epdc_waveform {
+	struct imx50_epdc_buffers *buffers;
+	const u8 *mode_map;
+	unsigned int temperature_count, mode_count;
+	u8 temperatures[256];
+};
+
+static int k4_waveform_check_wbf(const struct firmware *wbf,
+				 struct imx50_epdc_waveform *wave, size_t *offset)
+{
+	static const u8 zero_checksum[4];
+	const u8 *header;
+	unsigned int count, i;
+	u32 crc;
+
+	/* The header declares the complete file length; firmware owns that allocation. */
+	if (!wbf || !wbf->data ||
+	    wbf->size < K4_HEADER_SIZE)
+		return -EINVAL;
+	header = wbf->data;
+	count = (unsigned int)header[38] + 1;
+	*offset = K4_HEADER_SIZE + count + 1;
+	if (*offset >= wbf->size)
+		return -EINVAL;
+	if (get_unaligned_le32(header + 4) != wbf->size)
+		return -EBADMSG;
+	/* This reader implements the CRC-bearing format, not legacy sum8 files. */
+	if (header[35] != 1)
+		return -EOPNOTSUPP;
+	switch (header[16]) {
+	case 4:
+	case 6:
+		wave->mode_map = k4_modes_04;
+		break;
+	case 7:
+		wave->mode_map = k4_modes_07;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	/* The implemented lookup needs adjacent bounds, as in the stock loader. */
+	if (count < 2)
+		return -EOPNOTSUPP;
+	for (i = 1; i < count; i++)
+		if (header[K4_HEADER_SIZE + i] <= header[K4_HEADER_SIZE + i - 1])
+			return -EBADMSG;
+	/* WBF's checksum is calculated with its checksum word zeroed. The same
+	 * header in WRF is copied metadata and must NOT checksum the WRF bytes.
+	 */
+	crc = crc32_le(~0, zero_checksum, sizeof(zero_checksum));
+	crc = crc32_le(crc, header + 4, wbf->size - 4) ^ ~0;
+	if (crc != get_unaligned_le32(header))
+		return -EBADMSG;
+	wave->mode_count = (unsigned int)header[37] + 1;
+	wave->temperature_count = count;
+	memcpy(wave->temperatures, header + K4_HEADER_SIZE, count);
+	return 0;
+}
+
+static int k4_waveform_check_pair(const struct firmware *wbf, const struct firmware *wrf,
+				 struct imx50_epdc_waveform *wave, size_t *offset)
+{
+	int ret;
+
+	if (!wrf || !wrf->data || wrf->size < K4_HEADER_SIZE)
+		return -EINVAL;
+	ret = k4_waveform_check_wbf(wbf, wave, offset);
+	if (ret)
+		return ret;
+	if (*offset >= wrf->size)
+		return -EINVAL;
+	if (memcmp(wbf->data, wrf->data, *offset) ||
+	    (wbf->size == wrf->size && !memcmp(wbf->data, wrf->data, wbf->size)))
+		return -EBADMSG;
+	return 0;
+}
+
+/* WBF pointers are absolute LE24 addresses followed by an unsigned sum8. */
+static int k4_wbf_pointer(const struct firmware *wbf, size_t entry, size_t floor,
+			  size_t bytes, size_t *target)
+{
+	const u8 *p;
+	u32 address;
+
+	if (entry > wbf->size || wbf->size - entry < 4)
+		return -EBADMSG;
+	p = wbf->data + entry;
+	address = (u32)p[0] | (u32)p[1] << 8 | (u32)p[2] << 16;
+	if ((u8)(p[0] + p[1] + p[2]) != p[3] || address < floor ||
+	    address > wbf->size || bytes > wbf->size - address)
+		return -EBADMSG;
+	*target = address;
+	return 0;
+}
+
+/* Format-1, LUTS=0 has 16x16 transitions, four 2-bit actions per source byte.
+ * The stream starts in RLE mode. SB toggles literal/RLE, EB ends the stream,
+ * and its following byte checksums all encoded bytes including SB/EB/counts.
+ */
+static int k4_wbf_expand(const struct firmware *wbf, size_t cursor, u8 *output,
+			 size_t room, size_t *expanded)
+{
+	bool rle = true;
+	size_t packed = 0;
+	u8 sum = 0;
+
+	while (cursor < wbf->size) {
+		u8 value = wbf->data[cursor++];
+		unsigned int repeat = 1, i, shift;
+
+		sum += value;
+		if (value == wbf->data[41]) {
+			rle = !rle;
+			continue;
+		}
+		if (value == wbf->data[40]) {
+			if (cursor >= wbf->size || wbf->data[cursor] != sum ||
+			    !packed || packed % 64)
+				return -EBADMSG;
+			*expanded = packed * 4;
+			return 0;
+		}
+		if (rle) {
+			if (cursor >= wbf->size)
+				return -EBADMSG;
+			repeat += wbf->data[cursor];
+			sum += wbf->data[cursor++];
+		}
+		if (packed > room / 4 || repeat > room / 4 - packed)
+			return -E2BIG;
+		if (output)
+			for (i = 0; i < repeat; i++)
+				for (shift = 0; shift < 8; shift += 2)
+					output[(packed + i) * 4 + shift / 2] =
+						(value >> shift) & 3;
+		packed += repeat;
+	}
+	return -EBADMSG;
+}
+
+/* A sizing pass derives length from mode/temperature tables and expanded streams,
+ * bounded by size_t arithmetic rather than a sample size. Allocation may fail.
+ * It checks all streams before allocation. A second bounded pass
+ * creates EPDC's LE64 mode/temp offsets and frame counts, then action bytes.
+ * Offsets in WRF are relative to its payload, unlike WBF's absolute pointers.
+ */
+static int k4_wbf_convert_pass(const struct firmware *wbf, size_t offset, u8 *proxy,
+			     size_t limit, size_t *length)
+{
+	unsigned int modes = (unsigned int)wbf->data[37] + 1;
+	unsigned int temperatures = (unsigned int)wbf->data[38] + 1;
+	size_t mode_table, used, mode_bytes, temperature_bytes;
+	unsigned int mode, temperature;
+	int ret;
+
+	if (check_mul_overflow((size_t)modes, (size_t)8, &mode_bytes) ||
+	    check_mul_overflow((size_t)temperatures, (size_t)8, &temperature_bytes) ||
+	    check_add_overflow(offset, mode_bytes, &used))
+		return -EOVERFLOW;
+	mode_table = (u32)wbf->data[32] | (u32)wbf->data[33] << 8 |
+		     (u32)wbf->data[34] << 16;
+	if (mode_table < offset || mode_table > wbf->size ||
+	    modes * 4 > wbf->size - mode_table)
+		return -EBADMSG;
+	if (used > limit)
+		return -EOVERFLOW;
+	for (mode = 0; mode < modes; mode++) {
+		size_t source_temps, target_temps = used;
+
+		ret = k4_wbf_pointer(wbf, mode_table + mode * 4, offset,
+				     temperatures * 4, &source_temps);
+		if (ret)
+			return ret;
+		if (temperature_bytes > limit - used)
+			return -E2BIG;
+		if (proxy)
+			put_unaligned_le64(used - offset, proxy + offset + mode * 8);
+		used += temperature_bytes;
+		for (temperature = 0; temperature < temperatures; temperature++) {
+			size_t source, bytes;
+
+			ret = k4_wbf_pointer(wbf, source_temps + temperature * 4,
+					     offset, 1, &source);
+			if (ret)
+				return ret;
+			if (limit - used < 8)
+				return -E2BIG;
+			ret = k4_wbf_expand(wbf, source, proxy ? proxy + used + 8 : NULL,
+					    limit - used - 8, &bytes);
+			if (ret)
+				return ret;
+			if (proxy) {
+				put_unaligned_le64(used - offset,
+					proxy + target_temps + temperature * 8);
+				put_unaligned_le64(bytes / 256, proxy + used);
+			}
+			used += 8 + bytes;
+		}
+	}
+	*length = used;
+	return 0;
+}
+
+/* The caller has already checked WBF length, CRC, header and temperature table.
+ * This decoder implements the two-bit, 16-gray format; other LUT encodings need
+ * their own layout conversion and must not silently produce this payload.
+ */
+static int k4_waveform_decode(const struct firmware *wbf, size_t offset,
+			    struct firmware *wrf)
+{
+	size_t length, written;
+	u8 *proxy;
+	int ret;
+
+	if (wbf->data[36] || wbf->data[40] == wbf->data[41])
+		return -EOPNOTSUPP;
+	ret = k4_wbf_convert_pass(wbf, offset, NULL, SIZE_MAX, &length);
+	if (ret)
+		return ret;
+	proxy = kvzalloc(length, GFP_KERNEL);
+	if (!proxy)
+		return -ENOMEM;
+	memcpy(proxy, wbf->data, offset);
+	ret = k4_wbf_convert_pass(wbf, offset, proxy, length, &written);
+	if (ret || written != length) {
+		kvfree(proxy);
+		return ret ? ret : -EBADMSG;
+	}
+	wrf->data = proxy;
+	wrf->size = length;
+	return 0;
+}
+
+/* Read the allocated WBF length from the board's factory-data window. */
+static int k4_waveform_read_flash(struct device *dev, struct firmware *wbf)
+{
+	struct nvmem_device *nvmem;
+	u8 header[K4_HEADER_SIZE];
+	u8 *data = NULL;
+	u32 start, window, length;
+	size_t capacity;
+	int ret;
+
+	ret = device_property_read_u32(dev, "wbf-nvmem-offset", &start);
+	if (ret)
+		return ret;
+	ret = device_property_read_u32(dev, "wbf-nvmem-size", &window);
+	if (ret)
+		return ret;
+	nvmem = nvmem_device_get(dev, "wbf");
+	if (IS_ERR(nvmem))
+		return PTR_ERR(nvmem);
+	capacity = nvmem_dev_size(nvmem);
+	if (start > capacity || window > capacity - start || window < sizeof(header)) {
+		ret = -EINVAL;
+		goto put;
+	}
+	ret = nvmem_device_read(nvmem, start, sizeof(header), header);
+	if (ret != (int)sizeof(header)) {
+		if (ret >= 0)
+			ret = -EIO;
+		goto put;
+	}
+	length = get_unaligned_le32(header + 4);
+	if (length < sizeof(header) || length > window) {
+		ret = -EINVAL;
+		goto put;
+	}
+	data = kzalloc(length, GFP_KERNEL);
+	if (!data) {
+		ret = -ENOMEM;
+		goto put;
+	}
+	ret = nvmem_device_read(nvmem, start, length, data);
+	if (ret != (int)length) {
+		if (ret >= 0)
+			ret = -EIO;
+		goto free;
+	}
+	if (memcmp(header, data, sizeof(header))) {
+		ret = -EBADMSG;
+		goto free;
+	}
+	wbf->data = data;
+	wbf->size = length;
+	ret = 0;
+	goto put;
+free:
+	kfree(data);
+put:
+	nvmem_device_put(nvmem);
+	return ret;
+}
+
+struct imx50_epdc_waveform *imx50_epdc_waveform_load(struct device *dev,
+	const char *wbf_name, const char *wrf_name, u32 width, u32 height)
+{
+	const struct firmware *wbf = NULL, *wrf = NULL;
+	struct firmware flash_wbf = { }, decoded_wrf = { };
+	bool from_nvmem, decode;
+	struct imx50_epdc_waveform *wave = NULL;
+	size_t offset;
+	int ret;
+
+	if (!dev || !width || !height)
+		return ERR_PTR(-EINVAL);
+	from_nvmem = device_property_match_string(dev, "nvmem-names", "wbf") >= 0;
+	decode = device_property_read_bool(dev, "wbf-decode");
+	if (from_nvmem) {
+		ret = k4_waveform_read_flash(dev, &flash_wbf);
+		wbf = &flash_wbf;
+	} else {
+		ret = request_firmware_direct(&wbf, wbf_name ? wbf_name : K4_WBF_NAME, dev);
+	}
+	if (ret)
+		return ERR_PTR(ret);
+	if (!decode) {
+		ret = request_firmware_direct(&wrf, wrf_name ? wrf_name : K4_WRF_NAME, dev);
+		if (ret)
+			goto release;
+	}
+	wave = kzalloc(sizeof(*wave), GFP_KERNEL);
+	if (!wave) {
+		ret = -ENOMEM;
+		goto release;
+	}
+	if (decode) {
+		ret = k4_waveform_check_wbf(wbf, wave, &offset);
+		if (ret)
+			goto free;
+		ret = k4_waveform_decode(wbf, offset, &decoded_wrf);
+		if (ret)
+			goto free;
+		wrf = &decoded_wrf;
+	} else {
+		ret = k4_waveform_check_pair(wbf, wrf, wave, &offset);
+		if (ret)
+			goto free;
+	}
+	wave->buffers = imx50_epdc_buffers_alloc(dev, width, height,
+						 wrf->data + offset, wrf->size - offset,
+						 wave->mode_count, wave->temperature_count);
+	if (IS_ERR(wave->buffers)) {
+		ret = PTR_ERR(wave->buffers);
+		goto free;
+	}
+	/* buffers_alloc copied the entire validated proxy payload into owned DMA. */
+	if (decode)
+		dev_info(dev, "WBF decoded: %zu bytes to %zu bytes, source %s\n",
+			 wbf->size, wrf->size, from_nvmem ? "NVMEM" : "firmware");
+	else if (from_nvmem)
+		dev_info(dev, "WBF metadata from NVMEM: %zu bytes, validated WRF proxy\n",
+			 wbf->size);
+	ret = 0;
+	goto release;
+free:
+	kfree(wave);
+release:
+	if (decode)
+		kvfree(decoded_wrf.data);
+	else
+		release_firmware(wrf);
+	if (from_nvmem)
+		kfree(wbf->data);
+	else
+		release_firmware(wbf);
+	return ret ? ERR_PTR(ret) : wave;
+}
+
+struct imx50_epdc_buffers *imx50_epdc_waveform_buffers(struct imx50_epdc_waveform *wave)
+{
+	return wave->buffers;
+}
+
+int imx50_epdc_waveform_mode(struct imx50_epdc_waveform *wave,
+			     enum imx50_epdc_waveform_mode mode)
+{
+	if (!wave || (unsigned int)mode >= ARRAY_SIZE(k4_modes_04))
+		return -EINVAL;
+	if (wave->mode_map[mode] >= wave->mode_count)
+		return -EOPNOTSUPP;
+	return wave->mode_map[mode];
+}
+
+int imx50_epdc_waveform_temperature(struct imx50_epdc_waveform *wave, int millicelsius)
+{
+	unsigned int i;
+
+	if (!wave)
+		return -EINVAL;
+	/* The old loader copies trc+1 boundaries but searches only adjacent
+	 * pairs. Do not guess semantics for the following byte or extrapolate
+	 * below/above that table using its default/clamped temperature index.
+	 */
+	for (i = 0; i + 1 < wave->temperature_count; i++)
+		if (millicelsius >= wave->temperatures[i] * 1000 &&
+		    millicelsius < wave->temperatures[i + 1] * 1000)
+			return i;
+	return -ERANGE;
+}
+
+int imx50_epdc_waveform_free(struct imx50_epdc_waveform *wave)
+{
+	int ret;
+
+	if (!wave)
+		return 0;
+	ret = imx50_epdc_buffers_free(wave->buffers);
+	if (ret)
+		return ret;
+	kfree(wave);
+	return 0;
+}
+
+MODULE_FIRMWARE(K4_WBF_NAME);
+MODULE_FIRMWARE(K4_WRF_NAME);
+MODULE_LICENSE("GPL");
