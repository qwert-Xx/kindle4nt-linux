+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_IMX50_PXP_H
+#define _LINUX_IMX50_PXP_H
+
+#include <linux/types.h>
+
+struct device;
+struct imx50_pxp;
+
+/* RM 43.4.9: eight-bit S0 block counts, with the current 8x8 block mode. */
+#define IMX50_PXP_MAX_DIMENSION (255U * 8)
+
+/* Packed rows of little-endian XRGB8888 (B,G,R,X bytes) to 8-bit luma.
+ * Width/height must be multiples of eight, up to IMX50_PXP_MAX_DIMENSION.
+ * Strides are bytes. Larger regions need tiling, not truncated block counts.
+ * Caller owns both CPU buffers and keeps them valid until convert returns.
+ * Output is copied only after successful completion (and enabled diagnostics).
+ * Rotation is clockwise, in degrees: 0, 90, 180 or 270. Width/height describe
+ * the source; destination dimensions swap for 90/270. Destination stride and
+ * size describe that rotated layout. Zero keeps the original orientation.
+ */
+struct imx50_pxp_image {
+	const void *src;
+	void *dst;
+	size_t src_size, dst_size;
+	u32 width, height, src_stride, dst_stride;
+	u32 rotation;
+};
+
+struct imx50_pxp_stats {
+	u64 completed, irqs, allocations, releases;
+	size_t retained_bytes;
+	int fault, park_error;
+	bool clocks_retained;
+};
+
+struct imx50_pxp *devm_imx50_pxp_get(struct device *consumer, const char *property);
+/* Sleepable synchronous API; serialized across consumers, no FIFO guarantee. */
+int imx50_pxp_convert(struct imx50_pxp *pxp, const struct imx50_pxp_image *image);
+/* Release an idle healthy pool. A faulted pool cannot be freed until reboot. */
+int imx50_pxp_trim(struct imx50_pxp *pxp);
+void imx50_pxp_get_stats(struct imx50_pxp *pxp, struct imx50_pxp_stats *stats);
+
+#endif
