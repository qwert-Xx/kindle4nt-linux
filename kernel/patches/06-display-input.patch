+struct device;
+struct imx50_pxp;
+struct imx50_epdc_source;
+struct imx50_epdc_buffers;
+
+/* Controller submission values. Write UPD_CTRL last; it starts the update.
+ * Only LUT0 is used: the controller owner must establish ALL LUTs/WB idle.
+ * This descriptor is not permission to refresh without clocks/power/waveform
+ * validation. Buffers remain owned by the object until completion.
+ */
+struct imx50_epdc_command {
+	u32 waveform_addr, working_addr, update_addr;
+	u32 resolution, coordinates, size, fixed, control, temperature;
+};
+
+/* One controller owner serializes these calls. dev must have a 32-bit DMA
+ * coherent mask. The payload is already-validated panel-specific WRF data,
+ * without its header/temperature table; this layer does not validate WRF.
+ * Returned object is not devm: an uncertain transfer MUST retain it.
+ */
+struct imx50_epdc_buffers *imx50_epdc_buffers_alloc(struct device *dev,
+	u32 width, u32 height, const void *waveform, size_t waveform_size,
+	u32 modes, u32 temperatures);
+int imx50_epdc_buffers_prepare(struct imx50_epdc_buffers *b, struct imx50_pxp *pxp,
+			       const struct imx50_epdc_source *src);
