+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_IMX50_EPDC_H
+#define _LINUX_IMX50_EPDC_H
+
+#include <linux/types.h>
+
+struct device;
+struct imx50_epdc;
+struct imx50_epdc_source;
+
+/* Canonical modes; the waveform loader translates these to file mode indices. */
+enum imx50_epdc_mode {
+	IMX50_EPDC_MODE_DU = 1,
+	IMX50_EPDC_MODE_GC16,
+	IMX50_EPDC_MODE_GC16_FAST,
+	IMX50_EPDC_MODE_A2,
+	IMX50_EPDC_MODE_GL16,
+	IMX50_EPDC_MODE_GL16_FAST,
+};
+
+struct imx50_epdc *devm_imx50_epdc_get(struct device *consumer, const char *property);
+/* Sleepable and serialized. Source stays immutable until return. First update
+ * powers/configures the display and runs its full INIT before the image update.
+ * No fixed test image, refresh count or automatic action is implied by probe.
+ * Supplies stay enabled until powerdown or suspend. Consumers should powerdown
+ * when their update queue is idle; they must not retain an unused powered panel.
+ * Input must describe the desired complete canvas: after lost panel history,
+ * INIT is followed by a full-canvas restore even for a partial request.
+ */
+int imx50_epdc_update(struct imx50_epdc *epdc, const struct imx50_epdc_source *source,
+		      enum imx50_epdc_mode mode, bool full);
+/* Quiescent power/clock shutdown. The next update requires a new panel INIT. */
+int imx50_epdc_powerdown(struct imx50_epdc *epdc);
+
+#endif
