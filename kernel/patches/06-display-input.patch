--- /dev/null
+++ b/drivers/input/misc/k4-mc13892-power-button.c
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Kindle K4 power button on the MC13892 ONOFD1 input. */
+
+#include <linux/bitops.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/mfd/mc13783.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
+#include <linux/workqueue.h>
+
+#define MC13892_INT_SENSE1 5
+#define MC13892_POWER_CONTROL2 15
+#define MC13892_ONOFD1_SENSE BIT(3)
+
+struct k4_power_button {
+	struct device *dev;
+	struct mc13xxx *pmic;
+	struct input_dev *input;
+	struct delayed_work release_work;
+	struct mutex lock;
+	int irq;
+	bool suspended, stopped, pending, pressed, wake_armed, irq_disabled;
+	unsigned int wake_arms, wake_disarms, irqs, read_errors;
+};
+
+/* Caller holds lock; no SPI or requeue once suspend/remove has quiesced us. */
+static void k4_power_button_report(struct k4_power_button *button)
+{
+	u32 sense;
+	int ret;
+	bool pressed;
+
+	if (button->suspended || button->stopped)
+		return;
+	ret = mc13xxx_reg_read(button->pmic, MC13892_INT_SENSE1, &sense);
+
+	if (ret) {
+		button->read_errors++;
+		mod_delayed_work(system_wq, &button->release_work,
+				 msecs_to_jiffies(50));
+		return;
+	}
+
+	pressed = !(sense & MC13892_ONOFD1_SENSE);
+	/* Both edges latch this IRQ; never invent a press from a release IRQ. */
+	button->pending = false;
+	button->pressed = pressed;
+	input_report_key(button->input, KEY_POWER, pressed);
+	input_sync(button->input);
+
+	if (pressed)
+		mod_delayed_work(system_wq, &button->release_work,
+				 msecs_to_jiffies(50));
+}
+
+static void k4_power_button_release_work(struct work_struct *work)
+{
+	struct k4_power_button *button =
+		container_of(to_delayed_work(work), struct k4_power_button,
+			     release_work);
+
+	mutex_lock(&button->lock);
+	k4_power_button_report(button);
+	mutex_unlock(&button->lock);
+}
+
+static irqreturn_t k4_power_button_irq(int irq, void *data)
+{
+	struct k4_power_button *button = data;
+
+	pm_wakeup_event(button->dev, 500);
+	mutex_lock(&button->lock);
+	if (!button->stopped) {
+		button->irqs++;
+		button->pending = true;
+		k4_power_button_report(button);
+	}
+	mutex_unlock(&button->lock);
+	return IRQ_HANDLED;
+}
+
+static int k4_power_button_resume(struct device *dev)
+{
+	struct k4_power_button *button = dev_get_drvdata(dev);
+	int ret = 0;
+
+	if (button->wake_armed) {
+		ret = disable_irq_wake(button->irq);
+		if (!ret) {
+			button->wake_armed = false;
+			button->wake_disarms++;
+		}
+	}
+	mutex_lock(&button->lock);
+	button->suspended = false;
+	k4_power_button_report(button);
+	mutex_unlock(&button->lock);
+	if (button->irq_disabled) {
+		button->irq_disabled = false;
+		enable_irq(button->irq);
+	}
+	return ret;
+}
+
+static int k4_power_button_suspend(struct device *dev)
+{
+	struct k4_power_button *button = dev_get_drvdata(dev);
+	int ret;
+
+	if (button->wake_armed)
+		return -EBUSY;
+	mutex_lock(&button->lock);
+	button->suspended = true;
+	mutex_unlock(&button->lock);
+	cancel_delayed_work_sync(&button->release_work);
+	/* Do this while SPI is awake: regmap wake propagation can use its bus. */
+	if (device_may_wakeup(dev)) {
+		ret = enable_irq_wake(button->irq);
+		if (ret) {
+			k4_power_button_resume(dev);
+			return ret;
+		}
+		button->wake_armed = true;
+		button->wake_arms++;
+	} else {
+		disable_irq(button->irq);
+		button->irq_disabled = true;
+	}
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(k4_power_button_pm,
+			       k4_power_button_suspend, k4_power_button_resume);
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr,
+			 char *buf)
+{
+	struct k4_power_button *button = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&button->lock);
+	len = sysfs_emit(buf, "irq=%d suspended=%u pending=%u pressed=%u wake_armed=%u arms=%u disarms=%u irqs=%u read_errors=%u\n",
+		button->irq, button->suspended, button->pending, button->pressed,
+		button->wake_armed, button->wake_arms, button->wake_disarms,
+		button->irqs, button->read_errors);
+	mutex_unlock(&button->lock);
+	return len;
+}
+static DEVICE_ATTR_RO(state);
+static struct attribute *k4_power_button_attrs[] = { &dev_attr_state.attr, NULL };
+ATTRIBUTE_GROUPS(k4_power_button);
+
+static int k4_power_button_probe(struct platform_device *pdev)
+{
+	struct k4_power_button *button;
+	u32 sense, powerctl;
+	int ret;
+
+	button = devm_kzalloc(&pdev->dev, sizeof(*button), GFP_KERNEL);
+	if (!button)
+		return -ENOMEM;
+
+	button->dev = &pdev->dev;
+	button->irq = platform_get_irq(pdev, 0);
+	if (button->irq < 0)
+		return button->irq;
+	mutex_init(&button->lock);
+	button->pmic = dev_get_drvdata(pdev->dev.parent);
+	ret = mc13xxx_reg_read(button->pmic, MC13892_INT_SENSE1, &sense);
+	if (ret)
+		return ret;
+	/* Stock board init sets code1 for all buttons (31.25ms), then
+	 * yoshi_button.c:226 selects code2 for ON1B. Reproduce the final
+	 * initialization mechanism; change only debounce, keep reset policy.
+	 */
+	ret = mc13xxx_reg_rmw(button->pmic, MC13892_POWER_CONTROL2,
+			      GENMASK(9, 4), BIT(5) | BIT(6) | BIT(8));
+	if (ret)
+		return ret;
+	ret = mc13xxx_reg_read(button->pmic, MC13892_POWER_CONTROL2,
+			       &powerctl);
+	if (ret)
+		return ret;
+	if ((powerctl & GENMASK(9, 4)) != (BIT(5) | BIT(6) | BIT(8)))
+		return -EIO;
+
+	button->input = devm_input_allocate_device(&pdev->dev);
+	if (!button->input)
+		return -ENOMEM;
+	button->input->name = "k4-power-button";
+	button->input->phys = "mc13892/onofd1";
+	button->input->id.bustype = BUS_HOST;
+	input_set_capability(button->input, EV_KEY, KEY_POWER);
+
+	ret = input_register_device(button->input);
+	if (ret)
+		return ret;
+
+	INIT_DELAYED_WORK(&button->release_work, k4_power_button_release_work);
+	platform_set_drvdata(pdev, button);
+	ret = device_init_wakeup(&pdev->dev, true);
+	if (ret)
+		return ret;
+	ret = request_threaded_irq(button->irq, NULL, k4_power_button_irq,
+				   IRQF_ONESHOT, "k4-power-button", button);
+	if (ret) {
+		device_init_wakeup(&pdev->dev, false);
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to request ONOFD1 IRQ\n");
+	}
+
+	mutex_lock(&button->lock);
+	k4_power_button_report(button);
+	mutex_unlock(&button->lock);
+	dev_info(&pdev->dev,
+		 "ONOFD1 registered; sense1=0x%06x powerctl2=0x%06x (stock ON1B debounce=2)\n",
+		 sense, powerctl);
+	return 0;
+}
+
+static void k4_power_button_remove(struct platform_device *pdev)
+{
+	struct k4_power_button *button = platform_get_drvdata(pdev);
+
+	mutex_lock(&button->lock);
+	button->stopped = true;
+	mutex_unlock(&button->lock);
+	if (button->wake_armed)
+		disable_irq_wake(button->irq);
+	free_irq(button->irq, button);
+	cancel_delayed_work_sync(&button->release_work);
+	device_init_wakeup(&pdev->dev, false);
+}
+
+static struct platform_driver k4_power_button_driver = {
+	.probe = k4_power_button_probe,
+	.remove_new = k4_power_button_remove,
+	.driver = {
+		.name = "k4-mc13892-power-button",
+		.pm = pm_sleep_ptr(&k4_power_button_pm),
+		.dev_groups = k4_power_button_groups,
+	},
+};
+module_platform_driver(k4_power_button_driver);
+
+MODULE_DESCRIPTION("Kindle K4 MC13892 ONOFD1 power button");
+MODULE_LICENSE("GPL");
