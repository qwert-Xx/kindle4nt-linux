+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IMX50_EPDC_WAVEFORM_H
+#define _IMX50_EPDC_WAVEFORM_H
+
+#include <linux/types.h>
+
+struct device;
+struct imx50_epdc_buffers;
+struct imx50_epdc_waveform;
+
+/* Canonical modes, translated using the file's supported mode-version table. */
+enum imx50_epdc_waveform_mode {
+	IMX50_EPDC_INIT,
+	IMX50_EPDC_DU,
+	IMX50_EPDC_GC16,
+	IMX50_EPDC_GC16_FAST,
+	IMX50_EPDC_A2,
+	IMX50_EPDC_GL16,
+	IMX50_EPDC_GL16_FAST,
+};
+
+/* Uncompressed format-1 WBF/WRF; mode versions 4/6/7. Names may be NULL to
+ * use the K4 default paths. The caller selects firmware for its panel and
+ * supplies panel dimensions and a 32-bit DMA device. A named wbf NVMEM
+ * provider plus offset/size properties selects read-only factory metadata;
+ * provider errors are returned, with no firmware fallback. No EPDC/HV access.
+ */
+struct imx50_epdc_waveform *imx50_epdc_waveform_load(struct device *dev,
+	const char *wbf_name, const char *wrf_name, u32 width, u32 height);
+struct imx50_epdc_buffers *imx50_epdc_waveform_buffers(struct imx50_epdc_waveform *wave);
+int imx50_epdc_waveform_mode(struct imx50_epdc_waveform *wave,
+			     enum imx50_epdc_waveform_mode mode);
+/* Fresh panel temperature in millicelsius; no extrapolation or default 25C.
+ * Intervals come from the loaded file, not a fixed panel sample.
+ * The final payload temperature slot awaits independent format verification.
+ */
+int imx50_epdc_waveform_temperature(struct imx50_epdc_waveform *wave, int millicelsius);
+/* Fails without freeing anything if the DMA object is active/quarantined. */
+int imx50_epdc_waveform_free(struct imx50_epdc_waveform *wave);
+
+#endif
