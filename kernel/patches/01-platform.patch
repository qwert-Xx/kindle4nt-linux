+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * i.MX50 cache transition and optional DDR self-refresh round trip.
+ * Optional WAIT and PLL1 restart execute with DDR in self-refresh.
+ * Cache set/way traversal follows ARMv7 and the original mx50_suspend.S
+ * (Copyright 2010-2012 Amazon.com, Inc.).
+ */
+#include <linux/linkage.h>
+
+	.text
+	.arm
+	.arch armv7-a
+	.align 3
+ENTRY(imx50_ocram_cache)
+	/* r0: SRAM result words; r1: SRAM SP; r2: Databahn virtual base. */
+	push	{r4-r11, r12, lr}
+	mov	r8, sp
+	mov	sp, r1
+	mov	r12, r0
+	str	r2, [r12, #124]
+	ldr	r3, [r2]		/* Prefill Databahn's translation. DDR stays on. */
+	adr	r3, .Lcache_snapshot
+	str	r3, [r12, #0]
+	mov	r3, sp
+	str	r3, [r12, #4]
+	mrc	p15, 0, r0, c1, c0, 0
+	str	r0, [r12, #8]
+	mrc	p15, 0, r1, c1, c0, 1
+	str	r1, [r12, #20]
+	mrc	p15, 2, r1, c0, c0, 0
+	str	r1, [r12, #40]
+	dsb
+	/* Disable I/D caches and branch prediction before cleaning all levels. */
+	bic	r0, r0, #(1 << 2)
+	bic	r0, r0, #(1 << 11)
+	bic	r0, r0, #(1 << 12)
+	mcr	p15, 0, r0, c1, c0, 0
+	isb
+	mrc	p15, 0, r0, c1, c0, 0
+	str	r0, [r12, #12]
+	mrc	p15, 1, r0, c0, c0, 1
+	str	r0, [r12, #36]
+	ands	r3, r0, #0x7000000
+	mov	r3, r3, lsr #23
+	mov	r6, #0
+	beq	.Lcache_clean_done
+	mov	r10, #0
+.Lcache_level:
+	add	r2, r10, r10, lsr #1
+	mov	r1, r0, lsr r2
+	and	r1, r1, #7
+	cmp	r1, #2
+	blt	.Lcache_next
+	mcr	p15, 2, r10, c0, c0, 0
+	isb
+	mrc	p15, 1, r1, c0, c0, 0
+	and	r2, r1, #7
+	add	r2, r2, #4
+	ubfx	r4, r1, #3, #10
+	clz	r5, r4
+	ubfx	r7, r1, #13, #15
+.Lcache_set:
+	mov	r9, r4
+.Lcache_way:
+	orr	r11, r10, r9, lsl r5
+	orr	r11, r11, r7, lsl r2
+	mcr	p15, 0, r11, c7, c14, 2
+	add	r6, r6, #1
+	subs	r9, r9, #1
+	bge	.Lcache_way
+	subs	r7, r7, #1
+	bge	.Lcache_set
+.Lcache_next:
+	add	r10, r10, #2
+	cmp	r3, r10
+	bgt	.Lcache_level
+.Lcache_clean_done:
+	dsb
+	str	r6, [r12, #32]
+	ldr	r0, [r12, #20]
+	bic	r0, r0, #(1 << 1)
+	mcr	p15, 0, r0, c1, c0, 1
+	isb
+	mrc	p15, 0, r0, c1, c0, 1
+	str	r0, [r12, #24]
+.Lcache_snapshot:
+	/* Optional SRAM-only page tables; both roots preserve the same VAs. */
+	ldr	r0, [r12, #112]
+	cmp	r0, #0
+	beq	.Lcache_read_ddr
+	mrc	p15, 0, r1, c2, c0, 0
+	str	r1, [r12, #80]
+	mrc	p15, 0, r1, c2, c0, 1
+	str	r1, [r12, #84]
+	mrc	p15, 0, r1, c2, c0, 2
+	str	r1, [r12, #104]
+	dsb
+	mcr	p15, 0, r0, c2, c0, 0
+	mcr	p15, 0, r0, c2, c0, 1
+	isb
+	mov	r1, #0
+	mcr	p15, 0, r1, c8, c7, 0
+	dsb
+	isb
+	mrc	p15, 0, r0, c2, c0, 0
+	str	r0, [r12, #88]
+	mrc	p15, 0, r0, c2, c0, 1
+	str	r0, [r12, #92]
+.Lcache_read_ddr:
+	/* Only documented, non-destructive PIO/status reads. */
+	ldr	r6, [r12, #124]
+	ldr	r0, [r6, #0]
+	str	r0, [r12, #48]
+	ldr	r0, [r6, #0x4c]
+	str	r0, [r12, #52]
+	ldr	r0, [r6, #0x50]
+	str	r0, [r12, #56]
+	ldr	r0, [r6, #0xfc]
+	str	r0, [r12, #60]
+	ldr	r0, [r6, #0x13c]
+	str	r0, [r12, #64]
+	mov	r1, #256
+.Lcache_busy_sample:
+	ldr	r0, [r6, #0x13c]
+	subs	r1, r1, #1
+	bne	.Lcache_busy_sample
+	str	r0, [r12, #68]
+	ldr	r0, [r6, #0x264]
+	str	r0, [r12, #72]
+	/* This range is also executed by the host ARM fault-injection test. */
+	.global imx50_srefresh_begin
+imx50_srefresh_begin:
+	ldr	r0, [r12, #116]
+	cmp	r0, #0
+	beq	.Lsrefresh_done
+	/* Private roots are mandatory before making DDR unavailable. */
+	ldr	r0, [r12, #112]
+	cmp	r0, #0
+	beq	.Lsrefresh_unsafe
+	ldr	r0, [r6]
+	tst	r0, #1
+	beq	.Lsrefresh_unsafe
+	ldr	r4, [r6, #0x4c]
+	tst	r4, #1
+	bne	.Lsrefresh_unsafe
+	ldr	r5, [r6, #0x50]
+	ldr	r0, [r6, #0x58]
+	str	r0, [r12, #176]
+	mov	r7, #0
+	mov	r0, #1
+	str	r0, [r12, #128]
+	/* RM: manual SREFRESH is only valid with LOWPOWER_CONTROL zero. */
+	bic	r0, r5, #31
+	str	r0, [r6, #0x50]
+	dsb
+	ldr	r1, [r6, #0x50]
+	str	r1, [r12, #132]
+	cmp	r0, r1
+	bne	.Lsrefresh_entry_failed
+	mov	r2, #0x100000
+.Lsrefresh_wait_ready:
+	ldr	r0, [r6, #0xfc]
+	tst	r0, #(1 << 16)
+	beq	.Lsrefresh_ready_retry
+	ldr	r1, [r6, #0x13c]
+	tst	r1, #(1 << 8)
+	beq	.Lsrefresh_request
+.Lsrefresh_ready_retry:
+	subs	r2, r2, #1
+	bne	.Lsrefresh_wait_ready
+	b	.Lsrefresh_entry_failed
+.Lsrefresh_request:
+	str	r0, [r12, #136]
+	/* RM 20.8: separate modes by >=15 memory cycles. Clocks stay fixed;
+	 * 256 uncached ARM loop iterations exceed that at either tested OPP.
+	 */
+	mov	r2, #256
+.Lsrefresh_mode_gap:
+	subs	r2, r2, #1
+	bne	.Lsrefresh_mode_gap
+	mov	r0, #2
+	str	r0, [r12, #128]
+	orr	r0, r4, #1
+	str	r0, [r6, #0x4c]
+	dsb
+	ldr	r1, [r6, #0x4c]
+	cmp	r0, r1
+	bne	.Lsrefresh_entry_failed
+	mov	r2, #0x100000
+.Lsrefresh_wait_low:
+	ldr	r0, [r6, #0xfc]
+	tst	r0, #(1 << 16)
+	beq	.Lsrefresh_hold
+	subs	r2, r2, #1
+	bne	.Lsrefresh_wait_low
+	b	.Lsrefresh_entry_failed
+.Lsrefresh_hold:
+	str	r0, [r12, #140]
+	mov	r0, #3
+	str	r0, [r12, #128]
+	/* Bounded SRAM-only dwell, then verify manual request and CKE again. */
+	mov	r2, #4096
+.Lsrefresh_dwell:
+	subs	r2, r2, #1
+	bne	.Lsrefresh_dwell
+	mov	r0, #4096
+	str	r0, [r12, #164]
+	ldr	r0, [r12, #180]
+	cmp	r0, #0
+	beq	.Lsrefresh_after_wfi
+	/* TZIC wake masks/holdoff and WAIT policy are set before this call.
+	 * IRQ/FIQ stay masked until DDR, the original tables and stack return.
+	 */
+	ldr	r0, [r6, #0xfc]
+	str	r0, [r12, #188]
+	tst	r0, #(1 << 16)
+	bne	.Lsrefresh_entry_failed
+	.global imx50_pll_prepare_begin
+imx50_pll_prepare_begin:
+	ldr	r0, [r12, #192]
+	cmp	r0, #0
+	beq	.Lpll_prepared
+	ldr	r9, [r12, #196]
+	ldr	r10, [r12, #200]
+	/* START cycling reinitializes the PHY DLL; it does not isolate traffic.
+	 * All clients are quiesced and DDR is already in manual self-refresh.
+	 */
+	ldr	r0, [r12, #48]
+	bic	r0, r0, #1
+	str	r0, [r6]
+	dsb
+	ldr	r1, [r6]
+	str	r1, [r12, #296]
+	cmp	r0, r1
+	bne	.Lpll_unsafe
+	/* Select OSC via lp_apm while STEP output is unused, then select STEP. */
+	ldr	r0, [r12, #204]
+	bic	r0, r0, #0x180
+	str	r0, [r9, #0x0c]
+	dsb
+	ldr	r1, [r9, #0x0c]
+	cmp	r0, r1
+	bne	.Lpll_unsafe
+	orr	r0, r0, #4
+	str	r0, [r9, #0x0c]
+	dsb
+	isb
+	ldr	r1, [r9, #0x0c]
+	str	r1, [r12, #244]
+	cmp	r0, r1
+	bne	.Lpll_unsafe
+	mov	r0, #1
+	str	r0, [r12, #304]
+	/* Normalize the active bank to ENGcm12051's MFD179/MFN180 recipe.
+	 * Disable AREN before modifying MFD. The inactive bank is untouched.
+	 */
+	ldr	r0, [r12, #216]
+	bic	r0, r0, #3
+	str	r0, [r10, #4]
+	dsb
+	ldr	r1, [r10, #4]
+	cmp	r0, r1
+	bne	.Lpll_unsafe
+	ldr	r0, [r12, #212]
+	mov	r11, r10
+	tst	r0, #0x80
+	addne	r11, r11, #0x14
+	ldr	r1, [r11, #12]
+	bfc	r1, #0, #27
+	orr	r1, r1, #179
+	str	r1, [r11, #12]
+	dsb
