+/* PM .enter only: userspace frozen, one CPU, IRQs already disabled. */
+int imx50_ocram_cache_enter(void)
+{
+	struct imx50_ocram_probe *p = cache_probe;
+	void __iomem *data;
+	unsigned long flags;
+	u32 seed;
+	int ret, i;
+
+	if (!p || !READ_ONCE(p->cache_armed))
+		return 0;
+	WRITE_ONCE(p->cache_armed, false);
+	data = (void __iomem *)p->data;
+	/* Recheck the inherited gate at the actual noirq execution point. */
+	if (!(readl(p->ccm + 0x80) & GENMASK(3, 2))) {
+		ret = -EIO;
+		goto out;
+	}
+	if (p->pll_wait) {
+		ret = imx50_pll_prepare(p);
+		if (ret)
+			goto out;
+	}
+	p->ddr_checked = 0;
+	seed = 0x12345678 ^ p->cache_runs;
+	if (p->selfrefresh) {
+		for (i = 0; i < SZ_64K / sizeof(u32); i++) {
+			seed = seed * 1664525U + 1013904223U;
+			WRITE_ONCE(p->ddr_pattern[i], seed);
+		}
+		/* The assembly cleans these dirty cache lines before DDR entry. */
+		wmb();
+	}
+	local_irq_save(flags);
+	local_fiq_disable();
+	ret = p->cache_call(data, data + PAGE_SIZE - 16, p->databahn);
+	local_irq_restore(flags);
+	memcpy_fromio(p->cache_result, data, sizeof(p->cache_result));
+	if (!ret && !imx50_cache_result_valid(p->cache_result,
+			p->code + IMX50_CACHE_CODE_OFFSET, p->data,
+			imx50_ocram_cache_size))
+		ret = -EIO;
+	if (!ret && !imx50_cache_tables_valid(p->cache_result,
+		p->cache_tables ? p->tables_phys | BIT(1) : 0))
+		ret = -EIO;
+	if (p->selfrefresh) {
+		if (!imx50_srefresh_valid(p->cache_result) ||
+		    !imx50_srefresh_wait_valid(p->cache_result, p->selfrefresh_wait))
+			ret = -EIO;
+		seed = 0x12345678 ^ p->cache_runs;
+		for (i = 0; i < SZ_64K / sizeof(u32); i++) {
+			seed = seed * 1664525U + 1013904223U;
+			if (READ_ONCE(p->ddr_pattern[i]) != seed) {
+				ret = -EILSEQ;
+				break;
+			}
+			p->ddr_checked += sizeof(u32);
+		}
+	}
+	if (!ret && p->pll_wait && !imx50_pll_result_valid(p->cache_result))
+		ret = -EIO;
+	for (i = 0; !ret && i < 16; i += sizeof(u32))
+		if (readl(data + 512 + i) != 0xa5a5a5a5 ||
+		    readl(data + PAGE_SIZE - 16 + i) != 0xa5a5a5a5)
+			ret = -EOVERFLOW;
+out:
+	p->cache_error = ret;
+	if (!ret)
+		p->cache_runs++;
+	/* Positive means WFI already returned; platform code must not sleep twice. */
+	return ret ? ret : (p->selfrefresh_wait ? 1 : 0);
+}
+
+int imx50_cache_command(struct imx50_ocram_probe *p, const char *buf)
+{
+	void __iomem *data = (void __iomem *)p->data;
+	int ret = 0;
+
+	if (!sysfs_streq(buf, "arm") && !sysfs_streq(buf, "arm-tables") &&
+	    !sysfs_streq(buf, "arm-selfrefresh") &&
+	    !sysfs_streq(buf, "arm-selfrefresh-wait") &&
+	    !sysfs_streq(buf, "arm-pll-wait") &&
+	    !sysfs_streq(buf, "cancel"))
+		return -EINVAL;
+	mutex_lock(&p->lock);
+	if (sysfs_streq(buf, "cancel")) {
+		WRITE_ONCE(p->cache_armed, false);
+		goto out;
+	}
+	if (p->cache_armed) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (!(readl(p->ccm + 0x80) & GENMASK(3, 2))) {
+		ret = -EIO;
+		goto out;
+	}
+	if (!p->cache_call) {
+		p->cache_call = sram_exec_copy(p->code_pool,
+			(void *)(p->code + IMX50_CACHE_CODE_OFFSET),
+			imx50_ocram_cache, imx50_ocram_cache_size);
+		if (!p->cache_call) {
+			ret = -EFAULT;
+			goto out;
+		}
+	}
+	p->pll_wait = sysfs_streq(buf, "arm-pll-wait");
+	p->selfrefresh_wait = sysfs_streq(buf, "arm-selfrefresh-wait") || p->pll_wait;
+	p->selfrefresh = sysfs_streq(buf, "arm-selfrefresh") || p->selfrefresh_wait;
+	p->cache_tables = sysfs_streq(buf, "arm-tables") || p->selfrefresh;
+	if (p->cache_tables) {
+		ret = imx50_prepare_tables(p);
+		if (ret)
+			goto out;
+	}
+	memset_io(data, 0xa5, PAGE_SIZE);
+	memset_io(data, 0, sizeof(p->cache_result));
+	if (p->cache_tables)
+		writel(p->tables_phys | BIT(1), data + 112);
+	if (p->selfrefresh)
+		writel(1, data + 116);
+	if (p->selfrefresh_wait)
+		writel(1, data + 180);
+	if (p->pll_wait) {
+		writel(1, data + 192);
+		writel((u32)p->ccm, data + 196);
+		writel((u32)p->pll1, data + 200);
+	}
+	/* The noirq callback may consume the buffer only after it is prepared. */
+	wmb();
+	WRITE_ONCE(p->cache_armed, true);
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+int imx50_ocram_stop_prepare(void)
+{
+	if (!cache_probe)
+		return -ENODEV;
+	return imx50_cache_command(cache_probe, "arm-pll-wait");
+}
+
+void imx50_ocram_stop_finish(void)
+{
+	if (cache_probe)
+		imx50_cache_command(cache_probe, "cancel");
+}
+
+static int imx50_ocram_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *node, *parent;
+	struct platform_device *supplier;
+	struct imx50_ocram_probe *p;
+	struct resource *res;
+	int ret;
+
+	BUILD_BUG_ON(sizeof(struct imx50_ocram_result) != 16);
+	if (cache_probe)
+		return -EBUSY;
+	if (!imx50_ocram_call_size || imx50_ocram_call_size > IMX50_CACHE_CODE_OFFSET ||
+	    !imx50_ocram_cache_size ||
+	    imx50_ocram_cache_size > PAGE_SIZE - IMX50_CACHE_CODE_OFFSET)
+		return -EINVAL;
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	mutex_init(&p->lock);
+	p->ddr_pattern = devm_kmalloc(dev, SZ_64K, GFP_KERNEL);
+	if (!p->ddr_pattern)
+		return -ENOMEM;
+	p->code_pool = of_gen_pool_get(dev->of_node, "sram", 0);
+	p->data_pool = of_gen_pool_get(dev->of_node, "sram", 1);
+	p->tables_pool = of_gen_pool_get(dev->of_node, "sram", 2);
+	if (!p->code_pool || !p->data_pool || !p->tables_pool)
+		return -EPROBE_DEFER;
+	if (p->code_pool == p->data_pool || p->code_pool == p->tables_pool ||
+	    p->data_pool == p->tables_pool)
+		return -EINVAL;
+	/* sram_exec_copy changes permissions from the start of its partition. */
+	if (gen_pool_size(p->code_pool) != PAGE_SIZE ||
+	    gen_pool_size(p->data_pool) != PAGE_SIZE ||
+	    gen_pool_size(p->tables_pool) != SZ_32K)
+		return -EINVAL;
+	/* Keep the SRAM provider bound while the consumer owns pool memory. */
+	node = of_parse_phandle(dev->of_node, "sram", 0);
+	parent = of_get_parent(node);
+	of_node_put(node);
+	supplier = of_find_device_by_node(parent);
+	of_node_put(parent);
+	if (!supplier)
+		return -EPROBE_DEFER;
+	ret = device_link_add(dev, &supplier->dev, DL_FLAG_AUTOREMOVE_CONSUMER) ?
+		0 : -ENOMEM;
+	put_device(&supplier->dev);
+	if (ret)
+		return ret;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || resource_size(res) < 0x84)
+		return -EINVAL;
+	p->ccm = devm_ioremap(dev, res->start, resource_size(res));
+	if (!p->ccm)
+		return -ENOMEM;
+	/* PLL1 is shared with CCF; it is touched only at the noirq PM point. */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "pll1");
+	if (!res || resource_size(res) < 0x2c)
+		return -EINVAL;
+	p->pll1 = devm_ioremap(dev, res->start, resource_size(res));
+	if (!p->pll1)
+		return -ENOMEM;
+	p->databahn = devm_platform_ioremap_resource_byname(pdev, "databahn");
+	if (IS_ERR(p->databahn))
+		return PTR_ERR(p->databahn);
+	ret = devm_add_action_or_reset(dev, imx50_ocram_free, p);
+	if (ret)
+		return ret;
+	p->code = gen_pool_alloc(p->code_pool, PAGE_SIZE);
+	p->data = gen_pool_alloc(p->data_pool, PAGE_SIZE);
+	p->tables = gen_pool_alloc(p->tables_pool, SZ_32K);
+	if (!p->code || !p->data || !p->tables)
+		return -ENOMEM;
+	if (!PAGE_ALIGNED(p->code) || !PAGE_ALIGNED(p->data))
+		return -EINVAL;
+	p->code_phys = gen_pool_virt_to_phys(p->code_pool, p->code);
+	p->data_phys = gen_pool_virt_to_phys(p->data_pool, p->data);
+	p->tables_phys = gen_pool_virt_to_phys(p->tables_pool, p->tables);
+	if (!IS_ALIGNED(p->tables_phys, SZ_16K))
+		return -EINVAL;
+	platform_set_drvdata(pdev, p);
+	cache_probe = p;
+	dev_info(dev, "OCRAM probe ready; explicit run/arm required\n");
+	return 0;
+}
+
+static const struct of_device_id imx50_ocram_match[] = {
+	{ .compatible = "fsl,imx50-ocram-probe" },
+	{}
+};
+
+static struct platform_driver imx50_ocram_driver = {
+	.probe = imx50_ocram_probe,
+	.driver = {
+		.name = "imx50-ocram-probe",
+		.of_match_table = imx50_ocram_match,
+
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(imx50_ocram_driver);
