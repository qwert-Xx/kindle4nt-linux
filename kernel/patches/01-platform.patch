+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Position-independent OCRAM call/stack check. DDR and caches stay enabled. */
+#include <linux/linkage.h>
+
+	.text
+	.arm
+	.arch armv7-a
+	.align 3
+ENTRY(imx50_ocram_call)
+	/* r0: result area, r1: SRAM stack top, r2: seed. */
+	push	{r4-r11, r12, lr}
+	mov	r12, sp
+	mov	sp, r1
+	adr	r3, .Locram_loop
+	str	r3, [r0, #0]
+	mov	r3, sp
+	str	r3, [r0, #4]
+	mov	r4, r2
+	mov	r5, #0
+.Locram_loop:
+	eor	r4, r4, r5
+	ror	r4, r4, #1
+	str	r4, [sp, #-8]!
+	ldr	r6, [sp], #8
+	cmp	r6, r4
+	bne	.Locram_error
+	add	r5, r5, #1
+	cmp	r5, #256
+	bne	.Locram_loop
+	str	r4, [r0, #8]
+	str	r5, [r0, #12]
+	mov	r0, #0
+	b	.Locram_return
+.Locram_error:
+	mvn	r0, #4		/* -EIO */
+.Locram_return:
+	dsb
+	mov	sp, r12
+	pop	{r4-r11, r12, pc}
+ENDPROC(imx50_ocram_call)
+.Locram_end:
+
+	.section .rodata
+	.align 2
+	.global imx50_ocram_call_size
+imx50_ocram_call_size:
+	.word .Locram_end - imx50_ocram_call
