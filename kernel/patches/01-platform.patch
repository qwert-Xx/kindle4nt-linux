+++ b/arch/arm/mach-imx/k4-mc13892-standby.c
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* K4 first VSTBY stage: retain LDO/GPO outputs, use explicit buck standby banks. */
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/mfd/mc13xxx.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/spi/spi.h>
+#include "k4-mc13892-standby.h"
+
+#define K4_STBY_MODE0 (BIT(1) | BIT(4) | BIT(10) | BIT(13) | BIT(16) | BIT(19))
+#define K4_STBY_MODE1 (BIT(1) | BIT(7) | BIT(13) | BIT(16) | BIT(19))
+#define K4_STBY_MODE0_POWER_OFF (BIT(10) | BIT(13) | BIT(16) | BIT(19))
+
+struct k4_mc13892_standby {
+	struct mc13xxx *pmic;
+	u32 requested[3], raw[10], before[2], during[2], after[2];
+	u32 mode0_power_off;
+	unsigned int pending, prepares, restores;
+	bool armed;
+	int error, restore_error;
+};
+
+static const unsigned int k4_stby_regs[] = { 15, 24, 25, 26, 27, 28, 29, 32, 33, 34 };
+static const u32 k4_stby_masks[] = { K4_STBY_MODE0, K4_STBY_MODE1 };
+
+static u32 k4_stby_target(const struct k4_mc13892_standby *s,
+			  unsigned int index)
+{
+	u32 target = s->before[index] & ~k4_stby_masks[index];
+
+	if (!index)
+		target |= s->mode0_power_off;
+	return target;
+}
+
+static unsigned int k4_stby_voltage(u32 value, unsigned int id, bool standby)
+{
+	unsigned int base = id && (value & BIT(23)) ? 1100000 : 600000;
+
+	return base + ((value >> (standby ? 10 : 0)) & 31) * 25000;
+}
+
+static int k4_stby_validate(struct k4_mc13892_standby *s)
+{
+	unsigned int i, mode, speed;
+	u32 value;
+
+	/* K4 uses active-high requests; do not silently change board polarity. */
+	if (s->raw[0] & (BIT(10) | BIT(11)))
+		return -EOPNOTSUPP;
+	if (s->raw[5] & BIT(8)) /* SID changes the voltage-selection protocol. */
+		return -EOPNOTSUPP;
+	/* VIOHI and GPO outputs retain their existing board policy. */
+	if (s->mode0_power_off & ~K4_STBY_MODE0_POWER_OFF)
+		return -EINVAL;
+	for (i = 0; i < 4; i++) {
+		value = s->raw[1 + i];
+		if (i < 3 && k4_stby_voltage(value, i, true) != s->requested[i])
+			return -EINVAL;
+		/* Retain SW4; its full board load mapping is still being established. */
+		if (i == 3 && k4_stby_voltage(value, i, true) !=
+			     k4_stby_voltage(value, i, false))
+			return -EOPNOTSUPP;
+		mode = (s->raw[i < 2 ? 5 : 6] >> (i == 1 ? 10 : i == 3 ? 8 : 0)) & 15;
+		if (mode < 5 || mode == 7) /* Table 34: standby off or reserved. */
+			return -EOPNOTSUPP;
+		/* Bound even a full selector ramp, allowing DVFS after PM.begin. */
+		speed = i < 2 ? 2U << ((s->raw[5] >> (i ? 16 : 6)) & 3) : 4;
+		if (31 * speed > 16 * 1000000 / 32768)
+			return -ERANGE;
+	}
+	/* Keep already-powered LDOs on; no EN or voltage writes here. */
+	if ((s->raw[7] & (BIT(3) | BIT(9) | BIT(12) | BIT(15) | BIT(18))) !=
+	    (BIT(3) | BIT(9) | BIT(12) | BIT(15) | BIT(18)))
+		return -EOPNOTSUPP;
+	/* POWERMISC has special PWGT read semantics: inspect, never RMW it. */
+	for (i = 6; i <= 12; i += 2)
+		if ((s->raw[9] & BIT(i)) && (s->raw[9] & BIT(i + 1)))
+			return -EOPNOTSUPP;
+	return 0;
+}
+
+/* Caller holds the PMIC lock. A failed rollback stays pending for PM.end. */
+static int k4_stby_restore_locked(struct k4_mc13892_standby *s)
+{
+	int i, ret, error = 0;
+
+	s->armed = false;
+	for (i = 1; i >= 0; i--) {
+		if (!(s->pending & BIT(i)))
+			continue;
+		ret = mc13xxx_reg_rmw(s->pmic, 32 + i, k4_stby_masks[i],
+				      s->before[i] & k4_stby_masks[i]);
+		if (!ret)
+			ret = mc13xxx_reg_read(s->pmic, 32 + i, &s->after[i]);
+		if (!ret && ((s->after[i] ^ s->before[i]) & k4_stby_masks[i]))
+			ret = -EIO;
+		if (!ret)
+			s->pending &= ~BIT(i);
+		else if (!error)
+			error = ret;
+	}
+	s->restore_error = error;
+	return error;
+}
+
+int k4_mc13892_standby_prepare(struct k4_mc13892_standby *s)
+{
+	int i, ret;
+
+	if (!s)
+		return -ENODEV;
+	if (s->pending || s->armed)
+		return -EBUSY;
+	s->error = s->restore_error = 0;
+	mc13xxx_lock(s->pmic);
+	for (i = 0; i < ARRAY_SIZE(k4_stby_regs); i++) {
+		ret = mc13xxx_reg_read(s->pmic, k4_stby_regs[i], &s->raw[i]);
+		if (ret)
+			goto out;
+	}
+	ret = k4_stby_validate(s);
+	if (ret)
+		goto out;
+	for (i = 0; i < 2; i++) {
+		s->before[i] = s->raw[7 + i];
+		s->pending |= BIT(i); /* SPI error may still have reached the device. */
+		ret = mc13xxx_reg_rmw(s->pmic, 32 + i, k4_stby_masks[i],
+				      k4_stby_target(s, i) & k4_stby_masks[i]);
+		if (!ret)
+			ret = mc13xxx_reg_read(s->pmic, 32 + i, &s->during[i]);
+		if (!ret && s->during[i] != k4_stby_target(s, i))
+			ret = -EIO;
+		if (ret) {
+			k4_stby_restore_locked(s);
+			goto out;
+		}
+	}
+	s->armed = true;
+	s->prepares++;
+out:
+	s->error = ret;
+	mc13xxx_unlock(s->pmic);
+	return ret;
+}
+
+int k4_mc13892_standby_restore(struct k4_mc13892_standby *s)
+{
+	int ret;
+
+	if (!s || !s->pending)
+		return 0;
+	mc13xxx_lock(s->pmic);
+	ret = k4_stby_restore_locked(s);
+	mc13xxx_unlock(s->pmic);
+	if (!ret) {
+		s->restores++;
+	}
+	return ret;
+}
+
+bool k4_mc13892_standby_armed(struct k4_mc13892_standby *s)
+{
+	return s && s->armed && !s->error;
+}
+
+ssize_t k4_mc13892_standby_show(struct k4_mc13892_standby *s, char *buf)
+{
+	if (!s)
+		return sysfs_emit(buf, "disabled\n");
+	return sysfs_emit(buf, "armed=%u pending=%u prepares=%u restores=%u error=%d restore_error=%d mode0_power_off=%06x\n"
+		"mode_before=%06x,%06x during=%06x,%06x after=%06x,%06x\n"
+		"powerctl2=%06x sw=%06x,%06x,%06x,%06x modes=%06x,%06x misc=%06x\n",
+		s->armed, s->pending, s->prepares, s->restores, s->error, s->restore_error,
+		s->mode0_power_off,
+		s->before[0], s->before[1], s->during[0], s->during[1], s->after[0], s->after[1],
+		s->raw[0], s->raw[1], s->raw[2], s->raw[3], s->raw[4], s->raw[5], s->raw[6], s->raw[9]);
+}
+
+static void k4_stby_put(void *data)
+{
+	put_device(data);
+}
+
+struct k4_mc13892_standby *k4_mc13892_standby_get(struct device *dev)
+{
+	struct k4_mc13892_standby *s;
+	struct device_node *node;
+	struct device *supplier;
+	int ret;
+
+	node = of_parse_phandle(dev->of_node, "amazon,standby-pmic", 0);
+	if (!node)
+		return ERR_PTR(-EINVAL);
+	if (!of_device_is_compatible(node, "amazon,kindle-k4-mc13892")) {
+		of_node_put(node);
+		return ERR_PTR(-EINVAL);
+	}
+	supplier = bus_find_device_by_of_node(&spi_bus_type, node);
+	of_node_put(node);
+	if (!supplier)
+		return ERR_PTR(-EPROBE_DEFER);
+	ret = devm_add_action_or_reset(dev, k4_stby_put, supplier);
+	if (ret)
+		return ERR_PTR(ret);
+	if (!supplier->driver || !dev_get_drvdata(supplier))
+		return ERR_PTR(-EPROBE_DEFER);
+	if (!device_link_add(dev, supplier, DL_FLAG_AUTOREMOVE_CONSUMER))
+		return ERR_PTR(-ENOMEM);
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return ERR_PTR(-ENOMEM);
+	s->pmic = dev_get_drvdata(supplier);
+	ret = of_property_read_u32_array(dev->of_node, "amazon,standby-microvolt",
+					 s->requested, 3);
+	if (ret)
+		return ERR_PTR(ret);
+	ret = of_property_read_u32(dev->of_node,
+				   "amazon,standby-mode0-power-off-mask",
+				   &s->mode0_power_off);
+	if (ret && ret != -EINVAL)
+		return ERR_PTR(ret);
+	if (s->mode0_power_off & ~K4_STBY_MODE0_POWER_OFF)
+		return ERR_PTR(-EINVAL);
+	return s;
+}
