 #include "common.h"
 #include "hardware.h"
 
+static void imx50_pm_idle(void)
+{
+	/* Resume can enable device IRQs after TZIC restored its wake masks. */
+	if (!tzic_enable_wake())
+		cpu_do_idle();
+	/* A rejected entry must not leave normal interrupt delivery held off. */
+	tzic_clear_wake_holdoff();
+}
+
 static void __init imx50_init_early(void)
 {
 	mxc_set_cpu_type(MXC_CPU_MX50);
+	arm_pm_idle = imx50_pm_idle;
 }
+
+/* Original post_cpu_init sets AMC and OPACR before DDR power policy. */
+static int __init imx50_kindle_access_init(void)
+{
+	static const phys_addr_t aips[] = { 0x53f00000, 0x63f00000 };
+	void __iomem *cortex = ioremap(0x63fa0000, SZ_4K);
+	unsigned int i;
+	u32 before;
+
+	if (!cortex)
+		return -ENOMEM;
+	before = readl(cortex + 0x18);
+	/* AMC ALP=0, ALPEN=1; preserve all unrelated/reserved fields. */
+	writel((before & ~0xf) | 8, cortex + 0x18);
+	if ((readl(cortex + 0x18) & 0xf) != 8) {
+		iounmap(cortex);
+		return -EIO;
+	}
+	iounmap(cortex);
+	for (i = 0; i < ARRAY_SIZE(aips); i++) {
+		void __iomem *base = ioremap(aips[i], SZ_4K);
+
+		if (!base)
+			return -ENOMEM;
+		imx_set_aips(base);
+		iounmap(base);
+	}
+	return 0;
+}
+
+/* Stock cpu.c:post_cpu_init -> mx50_freq.c:init_ddr_settings, before devices.
+ * DDR timing/training and the live clock source stay owned by the loader.
+ * The port has no runtime DDR clock gate; the memory clock remains active.
+ */
+static int __init imx50_kindle_ddr_init(void)
+{
+	void __iomem *ddr, *qosc;
+	u32 ctl20, ctl21, ctl22, value;
+	int ret = 0;
+
+	if (!of_machine_is_compatible("amazon,kindle-4"))
+		return 0;
+	ret = imx50_kindle_access_init();
+	if (ret)
+		return ret;
+	ddr = ioremap(0x14000000, SZ_4K);
+	qosc = ioremap(0x41012000, SZ_4K);
+	if (!ddr || !qosc) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	/* This board uses initialized LPDDR1; do not apply a different DDR type. */
+	value = readl(ddr);
+	if ((value & 0xf00) != 0x100 || !(value & 1)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ctl20 = readl(ddr + 0x50);
+	ctl21 = readl(ddr + 0x54);
+	ctl22 = readl(ddr + 0x58);
+	/* Original init clears QoS CTRL[31:30], preserving the other fields. */
+	value = readl(qosc);
+	writel(value & ~0xc0000000, qosc);
+	/* Preserve the stock order: auto-enable, external count, mode enable.
+	 * Mode 4 is bit 1, not numerical value 4. The old count write sets
+	 * the whole CTL21 word to 128 << 16, including SELF_REFRESH_CNT=0.
+	 */
+	writel((ctl22 & ~0x1f) | 2, ddr + 0x58);
+	writel(128 << 16, ddr + 0x54);
+	writel((ctl20 & ~0x1f) | 2, ddr + 0x50);
+	if (readl(ddr + 0x58) != ((ctl22 & ~0x1f) | 2) ||
+	    readl(ddr + 0x54) != (128 << 16) ||
+	    readl(ddr + 0x50) != ((ctl20 & ~0x1f) | 2) ||
+	    readl(qosc) != (value & ~0xc0000000))
+		ret = -EIO;
+	pr_info("Yoshi DDR mode4 postcore: %08x/%08x/%08x -> %08x/%08x/%08x error=%d\n",
+		ctl20, ctl21, ctl22, readl(ddr + 0x50), readl(ddr + 0x54),
+		readl(ddr + 0x58), ret);
+out:
+	if (qosc)
+		iounmap(qosc);
+	if (ddr)
+		iounmap(ddr);
+	return ret;
+}
+postcore_initcall(imx50_kindle_ddr_init);
 
