+static struct imx50_ocram_probe *cache_probe;
+
+static void imx50_ocram_free(void *arg)
+{
+	struct imx50_ocram_probe *p = arg;
+
+	if (cache_probe == p)
+		cache_probe = NULL;
+	if (p->tables)
+		gen_pool_free(p->tables_pool, p->tables, SZ_32K);
+	if (p->data)
+		gen_pool_free(p->data_pool, p->data, PAGE_SIZE);
+	if (p->code)
+		gen_pool_free(p->code_pool, p->code, PAGE_SIZE);
+}
+
+static bool imx50_cache_result_valid(const u32 *r, unsigned long code,
+				     unsigned long data, u32 size)
+{
+	return r[0] >= code && r[0] < code + size &&
+		r[1] == data + PAGE_SIZE - 16 &&
+		r[2] == r[4] && r[3] == (r[2] & ~(BIT(2) | BIT(11) | BIT(12))) &&
+		r[5] == r[7] && r[6] == (r[5] & ~BIT(1)) &&
+		r[8] && r[10] == r[11] && r[19] == 0xcace0001;
+}
+
+static bool imx50_cache_tables_valid(const u32 *r, u32 expected)
+{
+	if (r[28] != expected)
+		return false;
+	if (!expected)
+		return true;
+	return r[20] == r[24] && r[21] == r[25] &&
+		r[22] == expected && r[23] == expected &&
+		r[26] == r[27] && !(r[26] & (BIT(31) | BIT(4) | BIT(5)));
+}
+
+static bool imx50_srefresh_valid(const u32 *r)
+{
+	return r[29] == 1 && !r[30] && r[32] == 4 &&
+		r[33] == (r[14] & ~31U) && (r[34] & BIT(16)) &&
+		!(r[35] & BIT(16)) && (r[36] & BIT(16)) &&
+		r[37] == r[13] && r[38] == r[14] && (r[39] & 1) &&
+		!(r[40] & BIT(8)) && r[41] == 4096 &&
+		!(r[42] & BIT(16)) && r[43] == (r[13] | 1);
+}
+
+static bool imx50_srefresh_wait_valid(const u32 *r, bool wait)
+{
+	return r[45] == wait && r[46] == wait &&
+		(!wait || !(r[47] & BIT(16)));
+}
+
+/* Up to five accessible pages, each may need its own 1 MiB coarse table. */
+static int imx50_sram_map_page(void __iomem *tables, u32 phys, u32 *used,
+			      u32 va, u32 pte, u32 domain)
+{
+	u32 first = va >> 20, second = (va >> 12) & 255;
+	u32 desc = readl(tables + first * 4), offset, old;
+
+	if (!IS_ALIGNED(va, PAGE_SIZE) || !IS_ALIGNED(phys, SZ_16K) ||
+	    (pte & 2) != 2 || (domain & ~PMD_DOMAIN_MASK))
+		return -EINVAL;
+	if (!desc) {
+		if (*used >= 5)
+			return -ENOSPC;
+		offset = SZ_16K + (*used)++ * SZ_1K;
+		desc = (phys + offset) | PMD_TYPE_TABLE | domain;
+		writel(desc, tables + first * 4);
+	} else {
+		if ((desc & (PMD_TYPE_MASK | PMD_DOMAIN_MASK)) !=
+		    (PMD_TYPE_TABLE | domain))
+			return -EINVAL;
+		offset = (desc & ~1023U) - phys;
+		if (offset < SZ_16K || offset >= SZ_16K + *used * SZ_1K)
+			return -EINVAL;
+	}
+	old = readl(tables + offset + second * 4);
+	if (old && old != pte)
+		return -EEXIST;
+	writel(pte, tables + offset + second * 4);
+	return 0;
+}
+
+static int imx50_copy_mapping(struct imx50_ocram_probe *p, unsigned long va,
+			      phys_addr_t phys, bool executable)
+{
+	pgd_t *pgd = pgd_offset_k(va);
+	p4d_t *p4d = p4d_offset(pgd, va);
+	pud_t *pud = pud_offset(p4d, va);
+	pmd_t *pmd = pmd_offset(pud, va);
+	pte_t *pte;
+	u32 first, hardware;
+
+	/* Match existing memory types/permissions; do not guess TEX remapping. */
+	first = ((u32 *)pmd)[(va >> SECTION_SHIFT) & 1];
+	if ((first & PMD_TYPE_MASK) != PMD_TYPE_TABLE)
+		return -EINVAL;
+	pte = pte_offset_kernel(pmd, va);
+	/* ARM short-descriptor Linux PTEs precede hardware PTEs by 2048 bytes. */
+	hardware = READ_ONCE(*(u32 *)((char *)pte + PTE_HWTABLE_OFF));
+	if ((hardware & PAGE_MASK) != phys || !(hardware & PTE_TYPE_SMALL) ||
+	    !!(hardware & PTE_EXT_XN) == executable ||
+	    (executable && (!(hardware & PTE_EXT_APX) || (first & PMD_PXNTABLE))))
+		return -EINVAL;
+	return imx50_sram_map_page((void __iomem *)p->tables, p->tables_phys,
+		&p->table_count, va, hardware, first & PMD_DOMAIN_MASK);
+}
+
+static int imx50_prepare_tables(struct imx50_ocram_probe *p)
+{
+	u32 ttbcr;
+	int ret;
+
+	asm volatile("mrc p15, 0, %0, c2, c0, 2" : "=r" (ttbcr));
+	if (ttbcr & (BIT(31) | BIT(4) | BIT(5)))
+		return -EOPNOTSUPP;
+	memset_io((void __iomem *)p->tables, 0, SZ_32K);
+	p->table_count = 0;
+	ret = imx50_copy_mapping(p, p->code, p->code_phys, true);
+	if (!ret)
+		ret = imx50_copy_mapping(p, p->data, p->data_phys, false);
+	if (!ret)
+		ret = imx50_copy_mapping(p, (unsigned long)p->databahn, 0x14000000, false);
+	if (!ret && p->pll_wait)
+		ret = imx50_copy_mapping(p, (unsigned long)p->ccm, 0x53fd4000, false);
+	if (!ret && p->pll_wait)
+		ret = imx50_copy_mapping(p, (unsigned long)p->pll1, 0x63f80000, false);
+	/* Publish hardware descriptors before the noirq walker can use them. */
+	wmb();
+	return ret;
+}
+
+/* ENGcm12051's 800 MHz recipe: oscillator/4x, MFI8, fraction 1/3.
+ * Normalize an equivalent 1/3 fraction to MFD179/MFN60, PLM and AREN=0.
+ * Do not guess how to restore an unrelated PLL operating mode. The inactive
+ * bank and unrelated register bits are preserved, not matched to a sample.
+ */
+static bool imx50_pll_supported(const u32 *r)
+{
+	u32 ctrl = r[53], bank = (ctrl & BIT(7)) ? 58 : 55;
+	u32 mask = BIT(13) | BIT(12) | BIT(11) | BIT(10) | GENMASK(9, 8) |
+		BIT(6) | BIT(5) | BIT(4) | BIT(3) | BIT(0);
+	u32 required = BIT(12) | BIT(9) | BIT(5) | BIT(0);
+
+	return !(r[51] & (BIT(11) | BIT(10) | BIT(2))) &&
+		(ctrl & mask) == required && !(r[54] & 1) &&
+		(r[bank] & 255) == 0x80 &&
+		3 * (r[bank + 2] & GENMASK(26, 0)) ==
+		(r[bank + 1] & GENMASK(26, 0)) + 1 &&
+		!(r[80] & BIT(16)) && !r[81];
+}
+
+static bool imx50_pll_result_valid(const u32 *r)
+{
+	u32 expected, active = (r[53] & BIT(7)) ? 3 : 0;
+	unsigned int i;
+
+	if (r[48] != 1 || r[63] || r[76] != 4 ||
+	    r[61] != ((r[51] & ~GENMASK(8, 7)) | BIT(2)) ||
+	    !(r[62] & BIT(0)) || r[64] != r[51] || r[65] != r[52] ||
+	    r[66] != (r[53] | BIT(2) | BIT(1)) || r[67] != (r[54] & ~3U) ||
+	    r[74] != (r[12] & ~1U) || r[75] != r[12])
+		return false;
+	for (i = 0; i < 6; i++) {
+		expected = r[55 + i];
+		if (i == active + 1)
+			expected = (expected & ~GENMASK(26, 0)) | 179;
+		if (i == active + 2)
+			expected = (expected & ~GENMASK(26, 0)) | 60;
+		if (r[68 + i] != expected)
+			return false;
+	}
+	return true;
+}
+
+static int imx50_pll_prepare(struct imx50_ocram_probe *p)
+{
+	static const u32 offsets[] = { 0, 4, 8, 12, 16, 28, 32, 36 };
+	u32 *r = p->cache_result;
+	int i;
+
+	r[51] = readl(p->ccm + 0x0c);
+	r[52] = readl(p->ccm + 0x10);
+	for (i = 0; i < ARRAY_SIZE(offsets); i++)
+		r[53 + i] = readl(p->pll1 + offsets[i]);
+	r[80] = readl(p->pll1 + 0x28);
+	r[81] = readl(p->ccm + 0x48);
+	r[82] = readl(p->ccm + 0x14);
+	memcpy_toio((void __iomem *)p->data + 204, &r[51], 10 * sizeof(u32));
+	memcpy_toio((void __iomem *)p->data + 320, &r[80], 3 * sizeof(u32));
+	wmb();
+	return imx50_pll_supported(r) ? 0 : -EOPNOTSUPP;
+}
