 	help
 	  This enables support for Freescale i.MX50 processor.
 
+config K4_DIAGNOSTICS
+	bool "Kindle K4 optional diagnostics"
+	depends on SOC_IMX50
+	help
+	  Debug-only probes and register/clock test controls. Keep disabled in
+	  production; watchdog, health clock, restart and STOP do not depend on it.
+
+config K4_BOOT_TRACE
+	bool "Kindle K4 RAM boot checkpoints"
+	depends on SOC_IMX50
+	depends on K4_DIAGNOSTICS
+	help
+	  Write early boot checkpoints to the last 8 KiB of the Kindle K4's
+	  256 MiB RAM. Enable only for a RAM-only K4 diagnostic kernel.
+	  The Amazon 2.6.31 kernel prints these records after watchdog reset.
+
+config IMX50_PM
+	bool "i.MX50 platform standby support"
+	depends on SOC_IMX50 && SUSPEND
+	help
+	  Provide clock-gated WAIT through the standard standby suspend state.
+	  A matching enabled fsl,imx50-pm DT node is required. Optional
+	  fsl,stop-with-ocram enables mem/deep through the OCRAM DDR/PLL path.
+	  Optional fsl,srpg-in-stop also enables ARM/NEON state retention power
+	  gating with sticky-status validation. PMIC standby voltage is not set.
+	  A bounded fsl,oscillator-startup-cycles also selects oscillator shutdown
+	  in STOP and programs the hardware wake stabilization delay.
+
+config K4_MC13892_STANDBY
+	bool "Kindle K4 explicit PMIC standby preparation"
+	depends on IMX50_PM && MFD_MC13XXX=y && SPI=y
+	help
+	  Prepare buck standby banks and retain LDO/GPO outputs before K4 STOP.
+	  Requires an explicit PMIC phandle and standby profile in the PM node.
+	  No changes are made unless the selected board DT requests this stage.
+
+config IMX50_OCRAM
+	bool "i.MX50 OCRAM DDR suspend core"
+	depends on SOC_IMX50 && SRAM_EXEC && !ARM_LPAE
+	help
+	  Add an explicit SRAM code/data/stack execution test for preparing DDR
+	  suspend support. Requires a separate DT node and SRAM pools. Optional
+	  explicit tests switch caches/page tables and round-trip manual DDR
+	  self-refresh during PM enter, optionally executing WAIT with PLL1
+	  restart and restoration from SRAM. The PM driver can prepare this
+	  path automatically for STOP, including optional ARM/NEON SRPG.
+
+config IMX50_OCRAM_PROBE
+	bool "i.MX50 explicit OCRAM diagnostics"
+	depends on IMX50_OCRAM
+	depends on K4_DIAGNOSTICS
+	help
+	  Optional run/state/cache sysfs test commands. Not required for STOP.
+
 config SOC_IMX51
 	bool "i.MX51 support"
 	select PINCTRL_IMX51
