+++ b/arch/arm/mach-imx/pm-imx50.c
@@ -0,0 +1,551 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* i.MX50 WAIT standby and optional STOP with the Databahn/OCRAM path. */
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/suspend.h>
+#include <asm/proc-fns.h>
+#include "common.h"
+#include "hardware.h"
+#include "k4-mc13892-standby.h"
+
+#define IMX50_CLPCR 0x54
+#define IMX50_ARM_LPC 0x0c
+#define IMX50_SRPG_ARM 0x2a0
+#define IMX50_SRPG_NEON 0x280
+#define IMX50_LPM_MASK 3
+#define IMX50_ARM_CLK_OFF BIT(5)
+#define IMX50_SBYOS BIT(6)
+#define IMX50_VSTBY BIT(8)
+#define IMX50_DSM (BIT(0) | BIT(1))
+#define IMX50_PCR BIT(0)
+#define IMX50_SRPG_PUP 0x04
+#define IMX50_SRPG_PDN 0x08
+#define IMX50_SRPG_STATUS 0x0c
+#define IMX50_SRPG_DEBUG 0x10
+#define IMX50_CCR 0x00
+#define IMX50_CSR 0x08
+#define IMX50_CISR 0x58
+#define IMX50_CIMR 0x5c
+#define IMX50_COSC_EN BIT(12)
+#define IMX50_COSC_READY BIT(5)
+#define IMX50_COSC_EVENT BIT(6)
+#define IMX50_COSC_PWRDOWN BIT(11)
+#define IMX50_PMIC_READY_BYPASS BIT(2)
+#define IMX50_STBY_COUNT_MASK (3 << 9)
+
+struct imx50_pm {
+	void __iomem *ccm, *cortex, *gpc;
+	u32 before[4], programmed[4], after[4];
+	unsigned int attempts, wfi_returns;
+	int last_error;
+	bool stop_enabled, stop_prepared, last_stop;
+	bool srpg_enabled, last_srpg;
+	u32 srpg_up[2], srpg_down[2], srpg_debug[2];
+	u32 srpg_before[2], srpg_cleared[2], srpg_after[2];
+	unsigned int power_cycles;
+	u32 osc_cycles;
+	bool last_osc, osc_saved;
+	u32 osc_ccr_before, osc_ccr_programmed, osc_ccr_after;
+	u32 osc_csr_before, osc_csr_after, osc_cimr;
+	u32 osc_event_before, osc_event_cleared, osc_event_after;
+	unsigned int osc_events;
+	struct k4_mc13892_standby *pmic_standby;
+	bool last_vstby;
+};
+
+static struct imx50_pm *imx50_pm;
+
+static void imx50_pm_read(struct imx50_pm *pm, u32 values[4])
+{
+	values[0] = readl(pm->ccm + IMX50_CLPCR);
+	values[1] = readl(pm->cortex + IMX50_ARM_LPC);
+	values[2] = readl(pm->gpc + IMX50_SRPG_ARM);
+	values[3] = readl(pm->gpc + IMX50_SRPG_NEON);
+}
+
+static void imx50_pm_restore(struct imx50_pm *pm)
+{
+	/* Stop making DSM requests before restoring the inherited power policy. */
+	writel(pm->before[1], pm->cortex + IMX50_ARM_LPC);
+	writel(pm->before[0], pm->ccm + IMX50_CLPCR);
+	writel(pm->before[2], pm->gpc + IMX50_SRPG_ARM);
+	writel(pm->before[3], pm->gpc + IMX50_SRPG_NEON);
+	imx50_pm_read(pm, pm->after);
+}
+
+static bool imx50_srpg_timing_valid(u32 up, u32 down, u32 debug)
+{
+	/* RM 50.4: all sequencing delays must be nonzero; no debug overrides. */
+	return !(debug & BIT(0)) && (up & 0x3f) && ((up >> 8) & 0x3f) &&
+		((up >> 16) & 0x3f) && ((up >> 24) & 3) &&
+		(down & 0x3f) && ((down >> 8) & 0x3f) &&
+		((down >> 16) & 3) && ((down >> 24) & 0x3f);
+}
+
+static int imx50_srpg_prepare(struct imx50_pm *pm)
+{
+	unsigned int i;
+	u32 offset;
+
+	for (i = 0; i < 2; i++) {
+		offset = i ? IMX50_SRPG_NEON : IMX50_SRPG_ARM;
+		pm->srpg_up[i] = readl(pm->gpc + offset + IMX50_SRPG_PUP);
+		pm->srpg_down[i] = readl(pm->gpc + offset + IMX50_SRPG_PDN);
+		pm->srpg_debug[i] = readl(pm->gpc + offset + IMX50_SRPG_DEBUG);
+		pm->srpg_before[i] = readl(pm->gpc + offset + IMX50_SRPG_STATUS);
+		pm->srpg_cleared[i] = pm->srpg_after[i] = 0;
+	}
+	for (i = 0; i < 2; i++)
+		if (!imx50_srpg_timing_valid(pm->srpg_up[i], pm->srpg_down[i],
+					   pm->srpg_debug[i]))
+			return -EOPNOTSUPP;
+	/* PSR is sticky W1C; clear and verify before each power-down request. */
+	for (i = 0; i < 2; i++) {
+		offset = i ? IMX50_SRPG_NEON : IMX50_SRPG_ARM;
+		writel(BIT(0), pm->gpc + offset + IMX50_SRPG_STATUS);
+		pm->srpg_cleared[i] = readl(pm->gpc + offset + IMX50_SRPG_STATUS);
+		if (pm->srpg_cleared[i] & BIT(0))
+			return -EIO;
+	}
+	return 0;
+}
+
+static int imx50_srpg_result(struct imx50_pm *pm)
+{
+	pm->srpg_after[0] = readl(pm->gpc + IMX50_SRPG_ARM + IMX50_SRPG_STATUS);
+	pm->srpg_after[1] = readl(pm->gpc + IMX50_SRPG_NEON + IMX50_SRPG_STATUS);
+	if (!(pm->srpg_after[0] & BIT(0)) || !(pm->srpg_after[1] & BIT(0)))
+		return -EAGAIN;
+	pm->power_cycles++;
+	return 0;
+}
+
+static int imx50_osc_prepare(struct imx50_pm *pm)
+{
+	pm->osc_ccr_before = readl(pm->ccm + IMX50_CCR);
+	pm->osc_csr_before = readl(pm->ccm + IMX50_CSR);
+	pm->osc_cimr = readl(pm->ccm + IMX50_CIMR);
+	pm->osc_event_before = readl(pm->ccm + IMX50_CISR);
+	pm->osc_event_cleared = pm->osc_event_after = 0;
+	pm->osc_csr_after = 0;
+	if (!(pm->osc_ccr_before & IMX50_COSC_EN) ||
+	    !(pm->osc_csr_before & IMX50_COSC_READY) ||
+	    (pm->before[0] & IMX50_COSC_PWRDOWN))
+		return -EOPNOTSUPP;
+	/* Do not consume an interrupt owned by another CCM user. */
+	if (!(pm->osc_cimr & IMX50_COSC_EVENT))
+		return -EBUSY;
+	pm->osc_ccr_programmed = (pm->osc_ccr_before & ~0xffU) | (pm->osc_cycles - 1);
+	pm->osc_saved = true;
+	writel(pm->osc_ccr_programmed, pm->ccm + IMX50_CCR);
+	if (readl(pm->ccm + IMX50_CCR) != pm->osc_ccr_programmed)
+		return -EIO;
+	/* W1C only the oscillator event; retain divider/PLL/temperature events. */
+	writel(IMX50_COSC_EVENT, pm->ccm + IMX50_CISR);
+	pm->osc_event_cleared = readl(pm->ccm + IMX50_CISR);
+	return (pm->osc_event_cleared & IMX50_COSC_EVENT) ? -EIO : 0;
+}
+
+static int imx50_osc_result(struct imx50_pm *pm)
+{
+	pm->osc_csr_after = readl(pm->ccm + IMX50_CSR);
+	pm->osc_event_after = readl(pm->ccm + IMX50_CISR);
+	if (!(pm->osc_csr_after & IMX50_COSC_READY) ||
+	    readl(pm->ccm + IMX50_CCR) != pm->osc_ccr_programmed ||
+	    readl(pm->ccm + IMX50_CIMR) != pm->osc_cimr)
+		return -EIO;
+	/* Event availability while masked is recorded, not assumed. */
+	if (pm->osc_event_after & IMX50_COSC_EVENT)
+		pm->osc_events++;
+	return 0;
+}
+
+static int imx50_standby_enter(suspend_state_t state)
+{
+	struct imx50_pm *pm = imx50_pm;
+	u32 clpcr, lpc, arm, neon;
+	int ret = 0;
+	bool stop = state == PM_SUSPEND_MEM;
+
+	if (!pm || (state != PM_SUSPEND_STANDBY && !stop))
+		return -EINVAL;
+	if (stop && (!pm->stop_enabled || !pm->stop_prepared))
+		return -EINVAL;
+	pm->last_stop = stop;
+	pm->last_srpg = stop && pm->srpg_enabled;
+	pm->last_osc = stop && pm->osc_cycles;
+	pm->last_vstby = stop && pm->pmic_standby;
+	pm->osc_saved = false;
+	pm->attempts++;
+	imx50_pm_read(pm, pm->before);
+	if (pm->last_vstby && !k4_mc13892_standby_armed(pm->pmic_standby)) {
+		ret = -EAGAIN;
+		goto restore;
+	}
+	if (pm->last_osc) {
+		ret = imx50_osc_prepare(pm);
+		if (ret)
+			goto restore;
+	}
+	if (pm->last_srpg) {
+		ret = imx50_srpg_prepare(pm);
+		if (ret)
+			goto restore;
+	}
+	clpcr = (pm->before[0] & ~(IMX50_LPM_MASK | IMX50_SBYOS | IMX50_VSTBY)) |
+		(stop ? 2 : 1) | IMX50_ARM_CLK_OFF;
+	if (pm->last_osc)
+		clpcr |= IMX50_SBYOS;
+	if (pm->last_vstby)
+		/* Stock Yoshi preserves the inherited ready policy (normally no bypass). */
+		clpcr |= IMX50_VSTBY | IMX50_STBY_COUNT_MASK;
+	lpc = pm->before[1] | IMX50_DSM;
+	arm = pm->before[2] & ~IMX50_PCR;
+	neon = pm->before[3] & ~IMX50_PCR;
+
+	if (pm->last_srpg) {
+		arm |= IMX50_PCR;
+		neon |= IMX50_PCR;
+	}
+	/* SRPG keeps architectural state in retention cells. PMIC voltage stays on. */
+	writel(arm, pm->gpc + IMX50_SRPG_ARM);
+	writel(neon, pm->gpc + IMX50_SRPG_NEON);
+	writel(clpcr, pm->ccm + IMX50_CLPCR);
+	writel(lpc, pm->cortex + IMX50_ARM_LPC);
+	imx50_pm_read(pm, pm->programmed);
+	if (pm->programmed[0] != clpcr || pm->programmed[1] != lpc ||
+	    pm->programmed[2] != arm || pm->programmed[3] != neon) {
+		ret = -EIO;
+		goto restore;
+	}
+	if (pm_wakeup_pending()) {
+		ret = -EAGAIN;
+		goto restore;
+	}
+	/* Preserve the wake-only masks installed by TZIC's syscore suspend. */
+	ret = tzic_suspend_wake();
+	if (ret)
+		goto restore;
+	/* An armed SRAM test may itself wait while DDR is in self-refresh. */
+	ret = imx50_ocram_cache_enter();
+	if (ret < 0)
+		goto restore;
+	if (ret > 0) {
+		pm->wfi_returns++;
+		ret = pm->last_srpg ? imx50_srpg_result(pm) : 0;
+		if (pm->last_osc) {
+			int osc_ret = imx50_osc_result(pm);
+
+			if (osc_ret)
+				ret = osc_ret;
+		}
+	} else if (stop) {
+		/* Never fall back to WFI from DDR while CCM is configured for STOP. */
+		ret = -EIO;
+	} else {
+		cpu_do_idle();
+		pm->wfi_returns++;
+	}
+restore:
+	/* Also clear holdoff on an aborted entry; otherwise IRQs can stay frozen. */
+	tzic_clear_wake_holdoff();
+	imx50_pm_restore(pm);
+	if (pm->osc_saved) {
+		writel(pm->osc_ccr_before, pm->ccm + IMX50_CCR);
+		pm->osc_ccr_after = readl(pm->ccm + IMX50_CCR);
+		if (pm->osc_ccr_after != pm->osc_ccr_before)
+			ret = -EIO;
+		pm->osc_saved = false;
+	}
+	if (memcmp(pm->before, pm->after, sizeof(pm->before)))
+		ret = -EIO;
+	pm->last_error = ret;
+	return ret;
+}
+
+static int imx50_standby_valid(suspend_state_t state)
+{
+	return state == PM_SUSPEND_STANDBY ||
+		(state == PM_SUSPEND_MEM && imx50_pm && imx50_pm->stop_enabled);
+}
+
+static int imx50_suspend_begin(suspend_state_t state)
+{
+	int ret;
+
+	if (state != PM_SUSPEND_MEM)
+		return 0;
+	if (!imx50_pm || !imx50_pm->stop_enabled)
+		return -EINVAL;
+	/* SRAM copy and page-table construction must run before noirq. */
+	ret = imx50_ocram_stop_prepare();
+	if (!ret && imx50_pm->pmic_standby) {
+		ret = k4_mc13892_standby_prepare(imx50_pm->pmic_standby);
+		if (ret)
+			imx50_ocram_stop_finish();
+	}
+	if (!ret)
+		imx50_pm->stop_prepared = true;
+	return ret;
+}
+
+static void imx50_suspend_end(void)
+{
+	if (imx50_pm && imx50_pm->pmic_standby) {
+		int ret = k4_mc13892_standby_restore(imx50_pm->pmic_standby);
+
+		if (ret) {
+			imx50_pm->last_error = ret;
+			pr_err("i.MX50 PMIC standby restore failed: %d\n", ret);
+		}
+	}
+	if (imx50_pm && imx50_pm->stop_prepared) {
+		imx50_ocram_stop_finish();
+		imx50_pm->stop_prepared = false;
+	}
+}
+
+static const struct platform_suspend_ops imx50_suspend_ops = {
+	.begin = imx50_suspend_begin,
+	.end = imx50_suspend_end,
+	.valid = imx50_standby_valid,
+	.enter = imx50_standby_enter,
+};
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct imx50_pm *pm = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf,
+		"mode=%s attempts=%u wfi_returns=%u error=%d vstby=%u\n"
+		"before=%08x,%08x,%08x,%08x\n"
+		"programmed=%08x,%08x,%08x,%08x\n"
+		"after=%08x,%08x,%08x,%08x\n"
+		"srpg=%u power_cycles=%u psr_before=%08x,%08x cleared=%08x,%08x after=%08x,%08x\n"
+		"srpg_up=%08x,%08x down=%08x,%08x debug=%08x,%08x\n"
+		"osc=%u cycles=%u events=%u ccr=%08x,%08x,%08x csr=%08x,%08x cimr=%08x\n"
+		"osc_cisr=%08x,%08x,%08x\n",
+		pm->last_stop ? "stop" : "wait", pm->attempts, pm->wfi_returns, pm->last_error,
+		pm->last_vstby,
+		pm->before[0], pm->before[1], pm->before[2], pm->before[3],
+		pm->programmed[0], pm->programmed[1], pm->programmed[2], pm->programmed[3],
+		pm->after[0], pm->after[1], pm->after[2], pm->after[3],
+		pm->last_srpg, pm->power_cycles,
+		pm->srpg_before[0], pm->srpg_before[1], pm->srpg_cleared[0], pm->srpg_cleared[1],
+		pm->srpg_after[0], pm->srpg_after[1], pm->srpg_up[0], pm->srpg_up[1],
+		pm->srpg_down[0], pm->srpg_down[1], pm->srpg_debug[0], pm->srpg_debug[1],
+		pm->last_osc, pm->osc_cycles, pm->osc_events,
+		pm->osc_ccr_before, pm->osc_ccr_programmed, pm->osc_ccr_after,
+		pm->osc_csr_before, pm->osc_csr_after, pm->osc_cimr,
+		pm->osc_event_before, pm->osc_event_cleared, pm->osc_event_after);
+}
+static DEVICE_ATTR_RO(state);
+
+static ssize_t pmic_standby_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct imx50_pm *pm = dev_get_drvdata(dev);
+
+	return k4_mc13892_standby_show(pm->pmic_standby, buf);
+}
+static DEVICE_ATTR_RO(pmic_standby);
+
+static ssize_t srpg_snapshot_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct imx50_pm *pm = dev_get_drvdata(dev);
+	u32 arm[4], neon[4];
+	unsigned int i;
+
+	/* SRPG registers require supervisor accesses; /dev/mem mmap is user mode. */
+	for (i = 0; i < 4; i++) {
+		arm[i] = readl(pm->gpc + IMX50_SRPG_ARM + 4 + 4 * i);
+		neon[i] = readl(pm->gpc + IMX50_SRPG_NEON + 4 + 4 * i);
+	}
+	return sysfs_emit(buf,
+		"arm_up=%08x down=%08x psr=%08x debug=%08x\n"
+		"neon_up=%08x down=%08x psr=%08x debug=%08x\n",
+		arm[0], arm[1], arm[2], arm[3], neon[0], neon[1], neon[2], neon[3]);
+}
+static DEVICE_ATTR_RO(srpg_snapshot);
+
+/* Explicit CCM control/status allowlist; no FIFO, SET/CLR or reserved gaps.
+ * GPC access stays in supervisor mode, using the already enabled owner clock.
+ */
+static ssize_t stock_registers_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	static const u16 offsets[] = {
+		0x00, 0x04, 0x08, 0x0c, 0x10, 0x14, 0x18, 0x1c,
+		0x20, 0x24, 0x28, 0x2c, 0x30, 0x38, 0x48, 0x4c,
+		0x50, 0x54, 0x58, 0x5c, 0x60, 0x64, 0x68, 0x6c,
+		0x70, 0x74, 0x78, 0x7c, 0x80, 0x84, 0x88, 0x8c,
+		0x90, 0x94, 0x98, 0x9c, 0xa0, 0xa4, 0xa8,
+	};
+	struct imx50_pm *pm = dev_get_drvdata(dev);
+	unsigned int i;
+	int pos = 0;
+
+	for (i = 0; i < ARRAY_SIZE(offsets); i++)
+		pos += sysfs_emit_at(buf, pos, "CCM_%03x=%08x\n", offsets[i],
+				     readl(pm->ccm + offsets[i]));
+	pos += sysfs_emit_at(buf, pos, "CORTEX_AMC=%08x LPC=%08x\n",
+			     readl(pm->cortex + 0x18), readl(pm->cortex + IMX50_ARM_LPC));
+	return pos;
+}
+static DEVICE_ATTR_RO(stock_registers);
+
+/* K4 audit only: original cpu.c / mx50_freq.c and RM register maps.
+ * These blocks are shared, so map without claiming them or writing fields.
+ * Read only explicit configuration words; never FIFO, SET/CLR or reserved.
+ */
+static ssize_t stock_shared_registers_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	static const struct {
+		const char *name;
+		phys_addr_t base;
+		u16 offsets[5];
+		u8 count;
+	} blocks[] = {
+		{ "DATABAHN", 0x14000000, { 0, 80, 84, 88 }, 4 },
+		{ "QOSC", 0x41012000, { 0 }, 1 },
+		{ "AIPS1", 0x53f00000, { 0x40, 0x44, 0x48, 0x4c, 0x50 }, 5 },
+		{ "AIPS2", 0x63f00000, { 0x40, 0x44, 0x48, 0x4c, 0x50 }, 5 },
+		{ "SRC", 0x53fd0000, { 0, 4, 8 }, 3 },
+	};
+	void __iomem *base;
+	unsigned int i, j;
+	int n = 0;
+
+	if (!of_machine_is_compatible("amazon,kindle-4"))
+		return -EOPNOTSUPP;
+	for (i = 0; i < ARRAY_SIZE(blocks); i++) {
+		base = ioremap(blocks[i].base, 0x100);
+		if (!base)
+			return -ENOMEM;
+		for (j = 0; j < blocks[i].count; j++)
+			n += sysfs_emit_at(buf, n, "%s_%03x=%08x\n", blocks[i].name,
+				blocks[i].offsets[j], readl(base + blocks[i].offsets[j]));
+		iounmap(base);
+	}
+	return n;
+}
+static DEVICE_ATTR_RO(stock_shared_registers);
+
+static struct attribute *imx50_pm_attrs[] = {
+	&dev_attr_state.attr, &dev_attr_stock_registers.attr, &dev_attr_stock_shared_registers.attr, &dev_attr_srpg_snapshot.attr, &dev_attr_pmic_standby.attr, NULL
+};
+ATTRIBUTE_GROUPS(imx50_pm);
+
+static void imx50_pm_cleanup(void *data)
+{
+	if (imx50_pm == data) {
+		suspend_set_ops(NULL);
+		imx50_pm = NULL;
+	}
+}
+
+static int imx50_pm_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	struct imx50_pm *pm;
+	struct clk *clk;
+	int ret;
+
+	if (imx50_pm)
+		return -EBUSY;
+	pm = devm_kzalloc(dev, sizeof(*pm), GFP_KERNEL);
+	if (!pm)
+		return -ENOMEM;
+	pm->cortex = devm_platform_ioremap_resource_byname(pdev, "cortex");
+	if (IS_ERR(pm->cortex))
+		return PTR_ERR(pm->cortex);
+	pm->gpc = devm_platform_ioremap_resource_byname(pdev, "gpc");
+	if (IS_ERR(pm->gpc))
+		return PTR_ERR(pm->gpc);
+	/* CCM is shared: own CLPCR and temporarily set CCR.OSCNT in noirq. */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "ccm");
+	if (!res || resource_size(res) < IMX50_CIMR + sizeof(u32))
+		return -EINVAL;
+	pm->ccm = devm_ioremap(dev, res->start, resource_size(res));
+	if (!pm->ccm)
+		return -ENOMEM;
+	clk = devm_clk_get_enabled(dev, "gpc");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "GPC clock unavailable\n");
+	/* Stock post_cpu_init establishes these before any suspend request.
+	 * Only ARM/NEON blocks are used on this port; do not touch the unused
+	 * EMPGC blocks or rely on bootloader-retained timing registers.
+	 */
+	if (of_machine_is_compatible("amazon,kindle-4")) {
+		unsigned int i;
+
+		for (i = 0; i < 2; i++) {
+			u32 offset = i ? IMX50_SRPG_NEON : IMX50_SRPG_ARM;
+
+			dev_info(dev, "stock SRPG %s up=%08x down=%08x ->010f0201/01010101\n",
+				 i ? "NEON" : "ARM",
+				 readl(pm->gpc + offset + IMX50_SRPG_PUP),
+				 readl(pm->gpc + offset + IMX50_SRPG_PDN));
+			writel(0x010f0201, pm->gpc + offset + IMX50_SRPG_PUP);
+			writel(0x01010101, pm->gpc + offset + IMX50_SRPG_PDN);
+			if (readl(pm->gpc + offset + IMX50_SRPG_PUP) != 0x010f0201 ||
+			    readl(pm->gpc + offset + IMX50_SRPG_PDN) != 0x01010101)
+				return -EIO;
+		}
+	}
+	pm->stop_enabled = of_property_read_bool(dev->of_node, "fsl,stop-with-ocram");
+	pm->srpg_enabled = of_property_read_bool(dev->of_node, "fsl,srpg-in-stop");
+	if (pm->srpg_enabled && !pm->stop_enabled)
+		return -EINVAL;
+	if (of_property_present(dev->of_node, "fsl,oscillator-startup-cycles")) {
+		ret = of_property_read_u32(dev->of_node, "fsl,oscillator-startup-cycles",
+					   &pm->osc_cycles);
+		if (ret || !pm->stop_enabled || !pm->osc_cycles || pm->osc_cycles > 256)
+			return -EINVAL;
+	}
+	if (pm->stop_enabled) {
+		/* RM 5.3.4.3: WEIM must run to acknowledge its LPM handshake. */
+		clk = devm_clk_get_enabled(dev, "weim");
+		if (IS_ERR(clk))
+			return dev_err_probe(dev, PTR_ERR(clk), "WEIM clock unavailable\n");
+	}
+	if (of_property_present(dev->of_node, "amazon,standby-pmic")) {
+		if (!pm->stop_enabled || !pm->srpg_enabled || !pm->osc_cycles)
+			return -EINVAL;
+		pm->pmic_standby = k4_mc13892_standby_get(dev);
+		if (IS_ERR(pm->pmic_standby))
+			return dev_err_probe(dev, PTR_ERR(pm->pmic_standby),
+					     "PMIC standby preparation unavailable\n");
+	}
+	ret = devm_add_action_or_reset(dev, imx50_pm_cleanup, pm);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, pm);
+	imx50_pm = pm;
+	suspend_set_ops(&imx50_suspend_ops);
+	dev_info(dev, "WAIT standby registered; OCRAM STOP %s\n",
+		 pm->stop_enabled ? "enabled" : "disabled");
+	return 0;
+}
+
+static const struct of_device_id imx50_pm_match[] = {
+	{ .compatible = "fsl,imx50-pm" },
+	{}
+};
+
+/* Built-in platform suspend owner; no unbind while its global ops are in use. */
+static struct platform_driver imx50_pm_driver = {
+	.probe = imx50_pm_probe,
+	.driver = {
+		.name = "imx50-pm",
+		.of_match_table = imx50_pm_match,
+		.dev_groups = imx50_pm_groups,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(imx50_pm_driver);
