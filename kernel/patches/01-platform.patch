+#include <linux/genalloc.h>
+#include <linux/mutex.h>
+#define IMX50_CACHE_CODE_OFFSET 512
+#define IMX50_CACHE_WORDS 96
+
+struct imx50_ocram_result {
+	u32 pc, sp, value, iterations;
+};
+
+struct imx50_ocram_probe {
+	struct mutex lock;
+	struct gen_pool *code_pool, *data_pool;
+	unsigned long code, data;
+	phys_addr_t code_phys, data_phys;
+	void __iomem *ccm;
+	int (*call)(void __iomem *data, void __iomem *stack, u32 seed);
+	struct imx50_ocram_result result;
+	u32 runs, gate;
+	int error;
+	void __iomem *databahn;
