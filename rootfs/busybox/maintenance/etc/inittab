# Watchdog is started once by rcS, never placed in a respawn action.
::sysinit:/etc/init.d/rcS
::respawn:/bin/k4-userspace-service usb-ssh
::respawn:/bin/k4-userspace-service wifi
ttyGS0::respawn:/bin/sh
::ctrlaltdel:/bin/busybox reboot
::shutdown:/etc/init.d/rcShutdown
