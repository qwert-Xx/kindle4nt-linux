#!/bin/sh
# Run detached from USB SSH: SRTC suspend temporarily removes USB.
set -eu
BB=/bin/busybox
ready=/tmp/k4-wifi-ready
dhcpfile=/var/run/k4-udhcpc.pid
wait_ready() {
	count=0
	while [ ! -s "$ready" ] || [ "$($BB cat /sys/class/net/wlan0/carrier)" != 1 ]; do
		count=$((count + 1))
		[ "$count" -lt 35 ] || exit 1
		$BB sleep 1
	done
}
ping_gateway() {
	gw=$($BB route -n | $BB awk '$1 == "0.0.0.0" && $8 == "wlan0" { print $2; exit }')
	[ -n "$gw" ]
	[ "$($BB route -n | $BB awk '$1 == "0.0.0.0" && $8 == "wlan0" { n++ } END { print n }')" = 1 ]
	$BB ping -I wlan0 -c 2 -W 2 "$gw"
}
wait_ready
[ "$($BB cat /sys/block/mmcblk2/ro)" = 1 ]
service=$($BB cat /var/run/k4-wifi-service.pid)
wpa=$($BB cat /var/run/k4-wpa.pid)
dhcp=$($BB cat "$dhcpfile")
seq=$($BB cat "$ready")
echo "INITIAL service=$service wpa=$wpa dhcp=$dhcp sequence=$seq"
ping_gateway
/bin/sh /bin/k4-wifi-connect start
[ "$($BB cat /var/run/k4-wifi-service.pid)" = "$service" ]
[ "$($BB cat "$dhcpfile")" = "$dhcp" ]
/bin/sh /bin/k4-wifi-connect --resume
[ "$($BB cat "$ready")" -gt "$seq" ]
[ "$($BB cat "$dhcpfile")" = "$dhcp" ]
echo "RENEW_SAME_PID sequence=$($BB cat "$ready")"
ping_gateway
# Terminate only the observed DHCP child; the service must replace it.
kill -TERM "$dhcp"
count=0
while [ "$($BB cat "$dhcpfile" 2>/dev/null || echo "$dhcp")" = "$dhcp" ]; do
	count=$((count + 1)); [ "$count" -lt 15 ] || exit 1
	$BB sleep 1
done
wait_ready
[ "$($BB cat /var/run/k4-wpa.pid)" = "$wpa" ]
echo "DHCP_RESTARTED pid=$($BB cat "$dhcpfile")"
ping_gateway
/bin/sh /bin/k4-pm-s2idle-probe
if ! /bin/sh /bin/k4-wifi-connect --resume; then
	$BB dmesg | $BB grep -E 'ath6kl|mmc1|PM:|K4_WIFI'
	exit 1
fi
[ "$($BB cat /var/run/k4-wifi-service.pid)" = "$service" ]
[ "$($BB cat /var/run/k4-wpa.pid)" = "$wpa" ]
echo "AFTER_PM sequence=$($BB cat "$ready")"
ping_gateway
$BB cat /sys/class/udc/ci_hdrc.0/state /sys/kernel/debug/suspend_stats
[ "$($BB cat /sys/block/mmcblk2/ro)" = 1 ]
hash0=$($BB dd if=/dev/mmcblk2 bs=1048576 count=1 2>/dev/null | $BB sha256sum)
hash16=$($BB dd if=/dev/mmcblk2 bs=1048576 skip=16 count=1 2>/dev/null | $BB sha256sum)
echo "$hash0"; echo "$hash16"
[ "${hash0%% *}" = c6f7f713bb57aad2203df61ffc348103848e41dea9451ae4b86c98ddd6862265 ]
[ "${hash16%% *}" = 4613632586282e084c1e148d63be1ee6d800f14d6691e9dc1d5628d3921e5a18 ]
$BB dmesg | $BB grep K4_WIFI_DHCP
echo K4_WIFI_LEASE_PM_PASS
