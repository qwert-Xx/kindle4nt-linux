+static void wpas_retry_aborted_connection_scan(struct wpa_supplicant *wpa_s,
+					      int own_request)
+{
+	unsigned int delay;
+
+	/* A canceled manual/background scan must not start an association. */
+	if (!own_request || wpa_s->conf->ap_scan != 1 ||
+	    wpa_s->last_scan_req == MANUAL_SCAN_REQ || wpa_s->disconnected ||
+	    wpa_s->wpa_state != WPA_SCANNING ||
+	    !wpa_supplicant_enabled_networks(wpa_s))
+		return;
+
+	/* Discard partial results, but keep the automatic connection alive.
+	 * Repeated aborts back off rather than forming a busy scan loop. */
+	delay = 1U << (wpa_s->aborted_scan_retries < 5 ?
+		       wpa_s->aborted_scan_retries : 5);
+	if (delay > 30)
+		delay = 30;
+	if (wpa_s->aborted_scan_retries < 5)
+		wpa_s->aborted_scan_retries++;
+	wpa_dbg(wpa_s, MSG_INFO, "K4_AUTO_SCAN_ABORT_RETRY delay=%u", delay);
+	wpa_supplicant_req_new_scan(wpa_s, delay, 0);
+}
+
+
 /*
  * Return a negative value if no scan results could be fetched or if scan
