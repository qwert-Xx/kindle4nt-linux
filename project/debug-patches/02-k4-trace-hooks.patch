+ATTRIBUTE_GROUPS(k4_papyrus);
+
+static int k4_papyrus_probe(struct i2c_client *client)
+{
+	int revision;
+
+	if (!i2c_check_functionality(client->adapter,
+				     I2C_FUNC_SMBUS_BYTE_DATA))
+		return -EOPNOTSUPP;
+
+	/* 0x07 is INT_STATUS1, not the product ID used by old Amazon names. */
+	revision = k4_papyrus_read_reg(client, PAPYRUS_REVID);
+	if (revision < 0)
+		return dev_err_probe(&client->dev, revision,
+				     "revision read failed\n");
+	if (revision != PAPYRUS_K4_REVID)
+		return dev_err_probe(&client->dev, -ENODEV,
+				     "unsupported REVID=0x%02x\n", revision);
+
+	dev_info(&client->dev,
+		 "TPS65180B 1p4 REVID=0x%02x; IRQ status reads excluded\n",
+		 revision);
+	return 0;
+}
+
+static const struct of_device_id k4_papyrus_of_match[] = {
