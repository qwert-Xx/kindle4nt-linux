+static struct attribute *k4_papyrus_attrs[] = {
+	&dev_attr_ext_temp_raw.attr,
+	&dev_attr_enable_raw.attr,
+	&dev_attr_vcom_raw.attr,
+	&dev_attr_vp_adjust_raw.attr,
+	&dev_attr_vn_adjust_raw.attr,
+	&dev_attr_irq_enable1_raw.attr,
+	&dev_attr_irq_enable2_raw.attr,
+	&dev_attr_power_sequence0_raw.attr,
