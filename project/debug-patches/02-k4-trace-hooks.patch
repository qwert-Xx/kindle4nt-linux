@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Kindle K4 RAM-test probe. This driver never writes a PMIC register. */
+#include <linux/errno.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/spi/spi.h>
+
+#define MC13892_REVISION 7
+
+static int k4_mc13892_read(struct spi_device *spi, u8 reg, u32 *value)
+{
+	/* Bit 31 is write-enable=0, bits 30:25 hold the register. The K4's
+	 * CSPI controller must clock this command as one 32-bit word.
+	 */
+	u32 tx_word = (u32)reg << 25;
+	u32 rx_word = 0;
+	struct spi_transfer transfer = {
+		.tx_buf = &tx_word,
+		.rx_buf = &rx_word,
+		.len = sizeof(tx_word),
+		.bits_per_word = 32,
+	};
+	int ret = spi_sync_transfer(spi, &transfer, 1);
+
+	if (!ret)
+		*value = rx_word & 0xffffff;
+
+	return ret;
+}
+
+static int k4_mc13892_id_probe(struct spi_device *spi)
+{
+	static const struct {
+		u8 reg;
+		const char *name;
+	} snapshot[] = {
+		{ 0, "IRQSTAT0" }, { 1, "IRQMASK0" },
+		{ 2, "IRQSENSE0" }, { 3, "IRQSTAT1" },
+		{ 4, "IRQMASK1" }, { 5, "IRQSENSE1" },
+		{ 13, "POWERCTL0" }, { 15, "POWERCTL2" },
+		{ 24, "SWITCHERS0" }, { 25, "SWITCHERS1" },
+		{ 26, "SWITCHERS2" }, { 27, "SWITCHERS3" },
+		{ 28, "SWITCHERS4" }, { 29, "SWITCHERS5" },
+		{ 30, "REGSETTING0" }, { 31, "REGSETTING1" },
+		{ 32, "REGMODE0" }, { 33, "REGMODE1" },
+	};
+	struct gpio_desc *irq_gpio;
+	u32 revision, value;
+	int ret, raw_level;
+	size_t i;
+
+	/* Match the bus mode and speed in the upstream MC13xxx SPI driver and
+	 * the old Yoshi board registration, without running their init writes.
+	 */
+	spi->mode = SPI_MODE_0 | SPI_CS_HIGH;
+	spi->max_speed_hz = 2000000;
+	ret = spi_setup(spi);
+	if (ret)
+		return dev_err_probe(&spi->dev, ret, "K4_PMIC_ID spi_setup failed\n");
+
+	ret = k4_mc13892_read(spi, MC13892_REVISION, &revision);
+	if (ret)
+		return dev_err_probe(&spi->dev, ret, "K4_PMIC_ID read failed\n");
+
+	dev_info(&spi->dev,
+		 "K4_PMIC_ID revision=%06x rev=%u.%u fin=%u\n",
+		 revision, (revision >> 3) & 3, revision & 7,
+		 (revision >> 9) & 3);
+	if (!revision || revision == 0xffffff)
+		return -ENODEV;
+
+	irq_gpio = devm_gpiod_get(&spi->dev, "irq", GPIOD_IN);
+	if (IS_ERR(irq_gpio))
+		return dev_err_probe(&spi->dev, PTR_ERR(irq_gpio),
+				     "K4_PMIC_IRQ GPIO request failed\n");
+
+	raw_level = gpiod_get_raw_value_cansleep(irq_gpio);
+	if (raw_level < 0)
+		return dev_err_probe(&spi->dev, raw_level,
+				     "K4_PMIC_IRQ GPIO read failed\n");
+
+	dev_info(&spi->dev, "K4_PMIC_IRQ gpio6_8 raw=%d irq=%d\n",
+		 raw_level, spi->irq);
+
+	for (i = 0; i < ARRAY_SIZE(snapshot); i++) {
+		ret = k4_mc13892_read(spi, snapshot[i].reg, &value);
+		if (ret)
+			return dev_err_probe(&spi->dev, ret,
+					     "K4_PMIC_REG read %u failed\n",
+					     snapshot[i].reg);
+
+		dev_info(&spi->dev, "K4_PMIC_REG %02u %-12s %06x\n",
+			 snapshot[i].reg, snapshot[i].name, value);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id k4_mc13892_id_of_match[] = {
+	{ .compatible = "amazon,k4-mc13892-id-probe" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, k4_mc13892_id_of_match);
+
+static struct spi_driver k4_mc13892_id_driver = {
+	.driver = {
+		.name = "k4-mc13892-id-probe",
+		.of_match_table = k4_mc13892_id_of_match,
+	},
+	.probe = k4_mc13892_id_probe,
+};
+module_spi_driver(k4_mc13892_id_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Read-only Kindle K4 MC13892 revision probe");
