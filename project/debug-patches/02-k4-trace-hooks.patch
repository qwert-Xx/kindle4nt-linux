+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Optional explicit OCRAM diagnostics; never needed by STOP. */
+#include <linux/io.h>
+#include <linux/k4_ram_trace.h>
+#include <linux/platform_device.h>
+#include <linux/sram.h>
+#include <linux/sizes.h>
+#include <asm/irqflags.h>
+#include "../ocram-imx50-internal.h"
+extern int imx50_ocram_call(void __iomem *data, void __iomem *stack, u32 seed);
+static int imx50_ocram_run(struct imx50_ocram_probe *p)
+{
+	static const u32 seeds[] = { 0, U32_MAX, 0x55555555, 0x12345678 };
+	void __iomem *data = (void __iomem *)p->data;
+	void __iomem *stack = data + PAGE_SIZE - 16;
+	unsigned long flags;
+	u32 expected;
+	int ret, n, i;
+
+	/* i.MX50 CCGR6 CG1 supplies OCRAM and NIC301 from sys_clk_root.
+	 * This warm-boot probe inherits that root; it never changes the gate.
+	 */
+	p->gate = readl(p->ccm + 0x80);
+	if (!(p->gate & GENMASK(3, 2)))
+		return -EIO;
+	if (!p->call) {
+		p->call = sram_exec_copy(p->code_pool, (void *)p->code,
+					imx50_ocram_call, imx50_ocram_call_size);
+		if (!p->call)
+			return -EFAULT;
+	}
+	for (n = 0; n < ARRAY_SIZE(seeds); n++) {
+		memset_io(data, 0xa5, PAGE_SIZE);
+		memset_io(data, 0, sizeof(p->result));
+		/* Publish the sentinel and result area before code executes from SRAM. */
+		wmb();
+		k4_ram_trace_mark("IMX50_OCRAM_CALL");
+		/* The assembly restores its original DDR stack before returning.
+		 * Keep interrupts off while SP points into our private SRAM page.
+		 */
+		local_irq_save(flags);
+		local_fiq_disable();
+		ret = p->call(data, stack, seeds[n]);
+		local_irq_restore(flags);
+		k4_ram_trace_mark("IMX50_OCRAM_RETURN");
+		if (ret)
+			return ret;
+		memcpy_fromio(&p->result, data, sizeof(p->result));
+		expected = seeds[n];
+		for (i = 0; i < 256; i++)
+			expected = ror32(expected ^ i, 1);
+		if (p->result.pc < p->code ||
+		    p->result.pc >= p->code + imx50_ocram_call_size ||
+		    p->result.sp != (unsigned long)stack ||
+		    p->result.value != expected || p->result.iterations != 256)
+			return -EIO;
+		/* Neither the result area nor the eight-byte stack may hit guards. */
+		for (i = 0; i < 16; i += sizeof(u32)) {
+			if (readl(data + 64 + i) != 0xa5a5a5a5 ||
+			    readl(data + PAGE_SIZE - 16 + i) != 0xa5a5a5a5)
+				return -EOVERFLOW;
+		}
+		p->runs++;
+	}
+	return 0;
+}
+
+static ssize_t run_store(struct device *dev, struct device_attribute *attr,
+			 const char *buf, size_t count)
+{
+	struct imx50_ocram_probe *p = dev_get_drvdata(dev);
+	int ret;
+
+	if (!sysfs_streq(buf, "run"))
+		return -EINVAL;
+	mutex_lock(&p->lock);
+	ret = p->cache_armed ? -EBUSY : imx50_ocram_run(p);
+	p->error = ret;
+	mutex_unlock(&p->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(run);
+
+static ssize_t cache_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	int ret = imx50_cache_command(dev_get_drvdata(dev), buf);
+
+	return ret ? ret : count;
+}
+
+static ssize_t cache_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct imx50_ocram_probe *p = dev_get_drvdata(dev);
+	const u32 *r = p->cache_result;
+	ssize_t ret;
+
+	mutex_lock(&p->lock);
+	ret = sysfs_emit(buf,
+		"armed=%u runs=%u error=%d code_size=%u\n"
+		"pc_offset=%u sp_offset=%u cache_ops=%u clidr=%08x phase=%08x\n"
+		"sctlr=%08x,%08x,%08x actlr=%08x,%08x,%08x csselr=%08x,%08x\n"
+		"ddr_ctl00=%08x ctl19=%08x ctl20=%08x ctl63=%08x ctl79=%08x,%08x phy25=%08x\n"
+		"tables=%u root=%pa coarse=%u new_ttbr=%08x\n"
+		"ttbr0=%08x,%08x,%08x ttbr1=%08x,%08x,%08x ttbcr=%08x,%08x\n"
+		"selfrefresh=%u status=%d stage=%u ddr_checked=%u dwell=%u\n"
+		"sr_wait=%u wfi_return=%u before_wfi_cke=%08x\n"
+		"sr_ctl20_off=%08x cke_ready=%08x cke_low=%08x cke_exit=%08x ctl22=%08x\n"
+		"sr_ctl19_after=%08x ctl20_after=%08x phy_after=%08x busy_after=%08x hold_cke=%08x hold_ctl19=%08x\n"
+		"pll_wait=%u status=%d stage=%u step=%08x lock864=%08x ddr_start=%08x,%08x\n"
+		"pll_before_ccsr=%08x cacrr=%08x ctl=%08x cfg=%08x op=%08x mfd=%08x mfn=%08x hfs=%08x,%08x,%08x\n"
+		"pll_after_ccsr=%08x cacrr=%08x ctl=%08x cfg=%08x op=%08x mfd=%08x mfn=%08x hfs=%08x,%08x,%08x\n"
+		"pll_togc=%08x cdhipr=%08x cbcdr=%08x\n",
+		p->cache_armed, p->cache_runs, p->cache_error, imx50_ocram_cache_size,
+		p->cache_runs ? r[0] - (u32)p->code : 0,
+		p->cache_runs ? r[1] - (u32)p->data : 0, r[8], r[9], r[19],
+		r[2], r[3], r[4], r[5], r[6], r[7], r[10], r[11],
+		r[12], r[13], r[14], r[15], r[16], r[17], r[18],
+		p->cache_tables, &p->tables_phys, p->table_count, r[28],
+		r[20], r[22], r[24], r[21], r[23], r[25], r[26], r[27],
+		p->selfrefresh, (s32)r[30], r[32], p->ddr_checked, r[41],
+		r[45], r[46], r[47],
+		r[33], r[34], r[35], r[36], r[44], r[37], r[38], r[39], r[40], r[42], r[43],
+		p->pll_wait, (s32)r[63], r[76], r[61], r[62], r[74], r[75],
+		r[51], r[52], r[53], r[54], r[55], r[56], r[57], r[58], r[59], r[60],
+		r[64], r[65], r[66], r[67], r[68], r[69], r[70], r[71], r[72], r[73],
+		r[80], r[81], r[82]);
+	mutex_unlock(&p->lock);
+	return ret;
+}
+static DEVICE_ATTR_RW(cache);
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct imx50_ocram_probe *p = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	mutex_lock(&p->lock);
+	ret = sysfs_emit(buf,
+		"runs=%u error=%d code_phys=%pa data_phys=%pa code_size=%u\n"
+		"pc_offset=%u sp_offset=%u value=%08x iterations=%u ccgr6=%08x\n",
+		p->runs, p->error, &p->code_phys, &p->data_phys, imx50_ocram_call_size,
+		p->runs ? p->result.pc - (u32)p->code : 0,
+		p->runs ? p->result.sp - (u32)p->data : 0,
+		p->result.value, p->result.iterations, p->gate);
+	mutex_unlock(&p->lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(state);
+
+static struct attribute *imx50_ocram_attrs[] = {
+	&dev_attr_run.attr, &dev_attr_state.attr, &dev_attr_cache.attr, NULL,
+};
+static const struct attribute_group imx50_ocram_group = { .attrs = imx50_ocram_attrs };
+const struct attribute_group *imx50_ocram_groups[] = { &imx50_ocram_group, NULL };
