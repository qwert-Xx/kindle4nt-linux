--- /dev/null
+++ b/drivers/misc/k4-debug/k4-pxp-client-test.c
@@ -0,0 +1,303 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Explicit test consumer of the exported service; never accesses PxP MMIO. */
+#include <linux/completion.h>
+#include <linux/imx50-pxp.h>
+#include <linux/kthread.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+
+struct k4_pxp_client {
+	struct imx50_pxp *pxp;
+	struct mutex lock;
+	atomic_t frames, pixels, max_error;
+	struct imx50_pxp_stats before, after;
+	int result;
+	bool attempted;
+};
+
+static int k4_pxp_frame(struct k4_pxp_client *c, unsigned int w,
+			unsigned int h, unsigned int seed, unsigned int rotation)
+{
+	unsigned int dw = rotation % 180 ? h : w;
+	unsigned int dh = rotation % 180 ? w : h;
+	size_t ss = w * 4 + 12, ds = dw + 7;
+	u8 *src, *dst;
+	struct imx50_pxp_image im;
+	unsigned int x, y, sx, sy, expected, actual;
+	int ret;
+
+	src = kvmalloc(ss * h, GFP_KERNEL);
+	dst = kvmalloc(ds * dh, GFP_KERNEL);
+	if (!src || !dst) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	memset(src, 0x5a, ss * h);
+	memset(dst, 0xa7, ds * dh);
+	for (y = 0; y < h; y++) {
+		for (x = 0; x < w; x++) {
+			u8 *q = src + y * ss + x * 4;
+
+			q[0] = x * 3 + seed;
+			q[1] = y * 7 + seed;
+			q[2] = x + y + seed;
+			q[3] = 0;
+		}
+		cond_resched();
+	}
+	im = (struct imx50_pxp_image) {
+		.src = src, .dst = dst, .src_size = ss * h, .dst_size = ds * dh,
+		.width = w, .height = h, .src_stride = ss, .dst_stride = ds,
+		.rotation = rotation,
+	};
+	ret = imx50_pxp_convert(c->pxp, &im);
+	if (ret)
+		goto out;
+	for (y = 0; y < dh; y++) {
+		for (x = 0; x < ds; x++) {
+			if (x >= dw) {
+				if (dst[y * ds + x] != 0xa7) {
+					ret = -EOVERFLOW;
+					goto out;
+				}
+				continue;
+			}
+			/* Inverse mapping, independent of the hardware DMA layout. */
+			switch (rotation) {
+			case 90:
+				sx = y;
+				sy = h - 1 - x;
+				break;
+			case 180:
+				sx = w - 1 - x;
+				sy = h - 1 - y;
+				break;
+			case 270:
+				sx = w - 1 - y;
+				sy = x;
+				break;
+			default:
+				sx = x;
+				sy = y;
+				break;
+			}
+			expected = (77 * src[sy * ss + sx * 4 + 2] +
+				    150 * src[sy * ss + sx * 4 + 1] +
+				    29 * src[sy * ss + sx * 4]) >> 8;
+			actual = dst[y * ds + x];
+			if (actual < expected || actual > expected + (expected != 255)) {
+				ret = -EILSEQ;
+				goto out;
+			}
+			if (actual != expected)
+				atomic_set(&c->max_error, 1);
+		}
+		cond_resched();
+	}
+	atomic_inc(&c->frames);
+	atomic_add(w * h, &c->pixels);
+out:
+	kvfree(src);
+	kvfree(dst);
+	return ret;
+}
+
+struct k4_pxp_thread {
+	struct k4_pxp_client *client;
+	struct completion done;
+	unsigned int seed;
+	int result;
+};
+
+static int k4_pxp_thread(void *data)
+{
+	struct k4_pxp_thread *t = data;
+	unsigned int i;
+
+	for (i = 0; i < 4; i++) {
+		t->result = k4_pxp_frame(t->client, 64, 48, t->seed + i, 0);
+		if (t->result)
+			break;
+	}
+	complete(&t->done);
+	return 0;
+}
+
+static int k4_pxp_suite(struct k4_pxp_client *c)
+{
+	static const unsigned int sizes[][2] = {
+		{8, 8}, {64, 48}, {800, 600}, {600, 800}, {800, 800},
+	};
+	struct k4_pxp_thread threads[2];
+	struct task_struct *task;
+	u8 src[256], dst[64];
+	struct imx50_pxp_image bad = {
+		.src = src, .dst = dst, .src_size = sizeof(src), .dst_size = sizeof(dst),
+		.width = 7, .height = 8, .src_stride = 32, .dst_stride = 8,
+	};
+	unsigned int i, launched = 0;
+	int ret;
+
+	if (imx50_pxp_convert(c->pxp, &bad) != -EINVAL)
+		return -EIO;
+	bad.width = 8;
+	bad.src_size--;
+	if (imx50_pxp_convert(c->pxp, &bad) != -EINVAL)
+		return -EIO;
+	for (i = 0; i < ARRAY_SIZE(sizes); i++) {
+		ret = k4_pxp_frame(c, sizes[i][0], sizes[i][1], i * 11, 0);
+		if (ret)
+			return ret;
+	}
+	ret = imx50_pxp_trim(c->pxp);
+	if (ret)
+		return ret;
+	ret = k4_pxp_frame(c, 64, 48, 73, 0);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(threads); i++) {
+		threads[i].client = c;
+		threads[i].seed = 101 + i * 23;
+		threads[i].result = -EINPROGRESS;
+		init_completion(&threads[i].done);
+		task = kthread_run(k4_pxp_thread, &threads[i], "pxp-client-%u", i);
+		if (IS_ERR(task)) {
+			ret = PTR_ERR(task);
+			break;
+		}
+		launched++;
+	}
+	/* Each worker's DMA wait is bounded; do not free its context while active. */
+	for (i = 0; i < launched; i++) {
+		wait_for_completion(&threads[i].done);
+		if (!ret)
+			ret = threads[i].result;
+	}
+	return ret;
+}
+
+static int k4_pxp_rotation_suite(struct k4_pxp_client *c, bool large)
+{
+	static const unsigned int sizes[][2] = {
+		{64, 48}, {800, 600}, {600, 800},
+	};
+	static const unsigned int large_sizes[][2] = {
+		{1024, 1024}, {2040, 8}, {8, 2040},
+	};
+	const unsigned int (*selected)[2] = large ? large_sizes : sizes;
+	unsigned int i, rotation;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(sizes); i++) {
+		for (rotation = 0; rotation < 360; rotation += 90) {
+			ret = k4_pxp_frame(c, selected[i][0], selected[i][1],
+					   13 + i * 7 + rotation / 90, rotation);
+			if (ret)
+				return ret;
+		}
+	}
+	return 0;
+}
+
+#if IS_ENABLED(CONFIG_K4_EPDC_IMAGE_TEST)
+#include "k4-epdc-image-test.h"
+#else
+static int k4_epdc_image_suite(struct k4_pxp_client *c)
+{
+	return -EOPNOTSUPP;
+}
+#endif
+
+static ssize_t run_store(struct device *dev, struct device_attribute *attr,
+			 const char *buf, size_t count)
+{
+	struct k4_pxp_client *c = dev_get_drvdata(dev);
+	bool rotation = sysfs_streq(buf, "rotate");
+	bool image = sysfs_streq(buf, "image");
+	bool large = sysfs_streq(buf, "large");
+	unsigned int frames = image ? 48 : (rotation || large) ? 12 : 14;
+	int ret, trim_ret;
+
+	if (!rotation && !image && !large && !sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!mutex_trylock(&c->lock))
+		return -EBUSY;
+	c->attempted = true;
+	atomic_set(&c->frames, 0);
+	atomic_set(&c->pixels, 0);
+	atomic_set(&c->max_error, 0);
+	imx50_pxp_get_stats(c->pxp, &c->before);
+	if (image)
+		ret = k4_epdc_image_suite(c);
+	else
+		ret = rotation || large ? k4_pxp_rotation_suite(c, large) : k4_pxp_suite(c);
+	trim_ret = imx50_pxp_trim(c->pxp);
+	if (!ret)
+		ret = trim_ret;
+	imx50_pxp_get_stats(c->pxp, &c->after);
+	if (!ret && (c->after.completed - c->before.completed != frames ||
+		     c->after.irqs - c->before.irqs != frames ||
+		     c->after.allocations != c->after.releases || c->after.retained_bytes))
+		ret = -EIO;
+	c->result = ret;
+	mutex_unlock(&c->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(run);
+
+static ssize_t result_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct k4_pxp_client *c = dev_get_drvdata(dev);
+	ssize_t n;
+
+	mutex_lock(&c->lock);
+	n = sysfs_emit(buf, "attempted=%u result=%d frames=%d pixels=%d max_error=%d\n"
+		       "completed=%llu irqs=%llu allocations=%llu releases=%llu retained=%zu fault=%d clocks_retained=%u park_error=%d\n",
+		       c->attempted, c->result, atomic_read(&c->frames), atomic_read(&c->pixels),
+		       atomic_read(&c->max_error), c->after.completed, c->after.irqs,
+		       c->after.allocations, c->after.releases, c->after.retained_bytes,
+		       c->after.fault, c->after.clocks_retained, c->after.park_error);
+	mutex_unlock(&c->lock);
+	return n;
+}
+static DEVICE_ATTR_RO(result);
+
+static struct attribute *k4_pxp_client_attrs[] = {
+	&dev_attr_run.attr, &dev_attr_result.attr, NULL,
+};
+ATTRIBUTE_GROUPS(k4_pxp_client);
+
+static int k4_pxp_client_probe(struct platform_device *pdev)
+{
+	struct k4_pxp_client *c;
+
+	c = devm_kzalloc(&pdev->dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	c->pxp = devm_imx50_pxp_get(&pdev->dev, "pxp");
+	if (IS_ERR(c->pxp))
+		return dev_err_probe(&pdev->dev, PTR_ERR(c->pxp), "get PxP service\n");
+	mutex_init(&c->lock);
+	c->result = -ENODATA;
+	platform_set_drvdata(pdev, c);
+	return 0;
+}
+
+static const struct of_device_id k4_pxp_client_match[] = {
+	{ .compatible = "amazon,k4-pxp-client-test" }, { }
+};
+
+static struct platform_driver k4_pxp_client_driver = {
+	.probe = k4_pxp_client_probe,
+	.driver = {
+		.name = "k4-pxp-client-test",
+		.of_match_table = k4_pxp_client_match,
+		.dev_groups = k4_pxp_client_groups,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(k4_pxp_client_driver);
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/drivers/misc/k4-debug/k4-pxp-dma-pattern.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef K4_PXP_DMA_PATTERN_H
+#define K4_PXP_DMA_PATTERN_H
+
+#define PXP_TEST_WIDTH 64
+#define PXP_TEST_HEIGHT 48
+#define PXP_TEST_PIXELS (PXP_TEST_WIDTH * PXP_TEST_HEIGHT)
+#define PXP_TEST_INPUT 4096
+#define PXP_TEST_OUTPUT 20480
+#define PXP_TEST_BYTES 28672
+
+static inline unsigned int pxp_test_rgb(unsigned int i)
+{
+	static const unsigned int colors[] = {
+		0, 0xffffff, 0xff0000, 0x00ff00, 0x0000ff,
+		0x00ffff, 0xff00ff, 0xffff00,
+	};
+	unsigned int x = i % PXP_TEST_WIDTH, y = i / PXP_TEST_WIDTH;
+	unsigned int r = (17 * x + 3 * y) & 255;
+	unsigned int g = (5 * x + 13 * y) & 255;
+	unsigned int b = (11 * x + 7 * y) & 255;
+
+	if (i < 8)
+		return colors[i];
+	if (y == PXP_TEST_HEIGHT - 1)
+		r = g = b = x * 4;
+	return (r << 16) | (g << 8) | b;
+}
+
+static inline unsigned int pxp_test_luma(unsigned int rgb)
+{
+	return (77 * ((rgb >> 16) & 255) + 150 * ((rgb >> 8) & 255) +
+		29 * (rgb & 255)) >> 8;
+}
+#endif
--- /dev/null
+++ b/drivers/misc/k4-debug/k4-pxp-dma-test.h
@@ -0,0 +1,222 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by the single, exclusive diagnostic driver; not a DMAengine API. */
+#include "k4-pxp-dma-pattern.h"
+
+static int k4_pxp_dma_test(struct k4_pxp_state *pxp)
+{
+	struct { u32 reg, value; } config[] = {
+		{ 0x000, 0x1080 }, /* RGB888 (32-bit unpacked) to MONOC8, IRQ masked */
+		{ 0x020, 0 }, { 0x030, 0 },
+		{ 0x040, (PXP_TEST_WIDTH << 12) | PXP_TEST_HEIGHT },
+		{ 0x050, 0 }, { 0x060, 0 }, { 0x070, 0 },
+		{ 0x080, ((PXP_TEST_WIDTH / 8) << 8) | (PXP_TEST_HEIGHT / 8) },
+		{ 0x090, 0 }, { 0x0a0, 0 }, { 0x0b0, 0x10001000 },
+		{ 0x0c0, 0 }, { 0x0d0, BIT(30) }, /* CSC1 bypass */
+		/* Do not write NEXT: even zero enqueues a command on i.MX50. */
+		{ 0x180, 0xffffff }, { 0x190, 0 }, /* disable source color key */
+		{ 0x220, 0 }, { 0x260, 0 }, { 0x2a0, 0 }, { 0x2e0, 0 },
+		{ 0x320, 0 }, { 0x360, 0 }, { 0x3a0, 0 }, { 0x3e0, 0 },
+		{ 0x400, 4 }, /* CSC2 RGB -> YUV, only Y is output */
+		{ 0x410, 0x0096004d }, { 0x420, 0x0000001d },
+		{ 0x430, 0 }, { 0x440, 0 }, { 0x450, 0 }, { 0x460, 0 },
+		{ 0x470, BIT(31) }, /* monochrome LUT bypass */
+	};
+	u32 value, idle_ctrl, pattern;
+	char mark[48];
+	unsigned int i;
+	bool touched = false;
+	int ret;
+
+	if (!pxp->allow_dma)
+		return -EOPNOTSUPP;
+	if (pxp->dma_attempted && (!pxp->allow_repeat || !pxp->use_irq ||
+	    pxp->configuration_only || pxp->dma_result || pxp->jobs_done >= 16))
+		return -EALREADY;
+	if (!pxp->reset_attempted || pxp->reset_result || pxp->park_result)
+		return -ENODATA;
+	idle_ctrl = pxp->dma_attempted ? pxp->dma_park : K4_PXP_GATE;
+	pattern = ((pxp->jobs_done * 37) & 255) * 0x010101;
+	snprintf(mark, sizeof(mark), "PXP DMA job %u begin", pxp->jobs_done);
+	ret = k4_ram_trace_mark(mark);
+	if (ret)
+		return ret;
+	pxp->dma_attempted = true;
+	pxp->dma_result = -EINPROGRESS;
+	pxp->dma_started = false;
+	pxp->dma_mismatches = pxp->dma_input_errors = pxp->dma_guard_errors = 0;
+	pxp->dma_max_error = 0;
+	ret = dma_set_mask_and_coherent(pxp->dev, DMA_BIT_MASK(32));
+	if (ret)
+		goto done;
+	/* Keep this bounded allocation until reboot, including every error path.
+	 * Do not infer that reset drains outstanding AXI writes and free it early.
+	 */
+	if (!pxp->arena)
+		pxp->arena = dma_alloc_coherent(pxp->dev, PXP_TEST_BYTES,
+						&pxp->arena_dma, GFP_KERNEL);
+	if (!pxp->arena) {
+		ret = -ENOMEM;
+		goto done;
+	}
+	if ((u64)pxp->arena_dma + PXP_TEST_BYTES - 1 > U32_MAX ||
+	    (pxp->arena_dma & 3)) {
+		ret = -ERANGE;
+		goto done;
+	}
+	memset(pxp->arena, 0xa5, PXP_TEST_BYTES);
+	for (i = 0; i < PXP_TEST_PIXELS; i++) {
+		u32 rgb = pxp_test_rgb(i) ^ pattern;
+		u8 *p = pxp->arena + PXP_TEST_INPUT + i * 4;
+
+		p[0] = rgb; p[1] = rgb >> 8; p[2] = rgb >> 16; p[3] = 0;
+	}
+	memset(pxp->arena + PXP_TEST_OUTPUT, 0xcc, PXP_TEST_PIXELS);
+	config[1].value = pxp->arena_dma + PXP_TEST_OUTPUT;
+	config[4].value = pxp->arena_dma + PXP_TEST_INPUT;
+	ret = k4_ram_trace_mark("PXP DMA buffers ready");
+	if (ret)
+		goto done;
+	if (clk_get_rate(pxp->clocks[1].clk) != 200000000) {
+		ret = -EINVAL;
+		goto done;
+	}
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(pxp->clocks), pxp->clocks);
+	if (ret)
+		goto done;
+	ret = k4_ram_trace_mark("PXP DMA preflight >");
+	if (ret)
+		goto out;
+	if (readl(pxp->base + K4_PXP_CTRL) != idle_ctrl ||
+	    (readl(pxp->base + K4_PXP_STAT) & GENMASK(3, 0)) ||
+	    readl(pxp->base + K4_PXP_NEXT)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = k4_ram_trace_mark("PXP DMA config >");
+	if (ret)
+		goto out;
+	touched = true;
+	/* Release the internal gate before programming fields in that domain. */
+	writel(K4_PXP_GATE, pxp->base + K4_PXP_CTRL_CLR);
+	ret = readl_poll_timeout(pxp->base + K4_PXP_CTRL, value,
+				value == (idle_ctrl & ~K4_PXP_GATE), 5, 1000);
+	pxp->dma_config_readback = value;
+	if (ret)
+		goto out;
+	for (i = 0; i < ARRAY_SIZE(config); i++) {
+		pxp->dma_config_reg = config[i].reg;
+		writel(config[i].value, pxp->base + config[i].reg);
+		value = readl(pxp->base + config[i].reg);
+		pxp->dma_config_readback = value;
+		if (value != config[i].value) {
+			ret = -EIO;
+			goto out;
+		}
+	}
+	/* Recheck after programming: no job or queued register reload is allowed. */
+	if (readl(pxp->base + K4_PXP_CTRL) != config[0].value ||
+	    (readl(pxp->base + K4_PXP_STAT) & GENMASK(3, 0)) ||
+	    readl(pxp->base + K4_PXP_NEXT)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = k4_ram_trace_mark("PXP DMA config <");
+	if (ret)
+		goto out;
+	if (pxp->configuration_only)
+		goto out;
+	if (pxp->use_irq) {
+		reinit_completion(&pxp->done);
+		WRITE_ONCE(pxp->irq_stat, 0);
+		enable_irq(pxp->irq);
+		pxp->irq_enabled = true;
+		writel(BIT(1), pxp->base + K4_PXP_CTRL_SET);
+	}
+	dma_wmb();
+	pxp->dma_started = true;
+	writel(BIT(0), pxp->base + K4_PXP_CTRL_SET);
+	ret = k4_ram_trace_mark("PXP DMA start < wait >");
+	if (ret)
+		goto out;
+	if (pxp->use_irq) {
+		ret = wait_for_completion_timeout(&pxp->done, msecs_to_jiffies(100)) ?
+			0 : -ETIMEDOUT;
+		value = READ_ONCE(pxp->irq_stat);
+	} else {
+		ret = readl_poll_timeout(pxp->base + K4_PXP_STAT, value,
+					 value & GENMASK(2, 0), 20, 100000);
+	}
+	pxp->dma_stat = value;
+	if (ret)
+		goto out;
+	if (!(value & BIT(0)) || (value & (BIT(1) | BIT(2) | BIT(3)))) {
+		ret = -EIO;
+		goto out;
+	}
+	ret = readl_poll_timeout(pxp->base + K4_PXP_CTRL, value,
+				 !(value & BIT(0)), 5, 1000);
+	pxp->dma_ctrl = value;
+	if (ret)
+		goto out;
+	ret = k4_ram_trace_mark("PXP DMA wait < verify >");
+	if (ret)
+		goto out;
+	dma_rmb();
+	for (i = 0; i < PXP_TEST_PIXELS; i++) {
+		u32 rgb = pxp_test_rgb(i) ^ pattern, expected = pxp_test_luma(rgb);
+		u8 *p = pxp->arena + PXP_TEST_INPUT + i * 4;
+		unsigned int actual = pxp->arena[PXP_TEST_OUTPUT + i];
+		unsigned int error = actual > expected ? actual - expected : expected - actual;
+
+		/* CSC quantization: accept floor or the next integer, not +/- 1. */
+		if (actual < expected || actual > expected + (expected != 255))
+			pxp->dma_mismatches++;
+		if (error > pxp->dma_max_error)
+			pxp->dma_max_error = error;
+		if (p[0] != (rgb & 255) || p[1] != ((rgb >> 8) & 255) ||
+		    p[2] != ((rgb >> 16) & 255) || p[3])
+			pxp->dma_input_errors++;
+	}
+	for (i = 0; i < PXP_TEST_BYTES; i++) {
+		if (i >= PXP_TEST_INPUT && i < PXP_TEST_INPUT + PXP_TEST_PIXELS * 4)
+			continue;
+		if (i >= PXP_TEST_OUTPUT && i < PXP_TEST_OUTPUT + PXP_TEST_PIXELS)
+			continue;
+		if (pxp->arena[i] != 0xa5)
+			pxp->dma_guard_errors++;
+	}
+	ret = pxp->dma_mismatches || pxp->dma_input_errors || pxp->dma_guard_errors ?
+		-EILSEQ : 0;
+out:
+	if (pxp->irq_enabled) {
+		writel(BIT(1), pxp->base + K4_PXP_CTRL_CLR);
+		disable_irq(pxp->irq); /* Synchronize the handler before gating clocks. */
+		pxp->irq_enabled = false;
+		if (!ret && (readl(pxp->base + K4_PXP_STAT) & GENMASK(3, 0)))
+			ret = -EIO;
+	}
+	if (touched) {
+		/* No start (or verified completion): gate the idle block. Keep reset
+		 * asserted only for an uncertain/failed in-flight DMA operation.
+		 */
+		u32 park = pxp->dma_started && ret ? K4_PXP_RESET | K4_PXP_GATE :
+			K4_PXP_GATE;
+
+		k4_ram_trace_mark("PXP DMA park >");
+		writel(park, pxp->base + K4_PXP_CTRL_SET);
+		pxp->dma_park_result = readl_poll_timeout(pxp->base + K4_PXP_CTRL,
+			value, (value & (K4_PXP_RESET | K4_PXP_GATE | BIT(0))) ==
+			park, 5, 1000);
+		pxp->dma_park = value;
+		if (!ret)
+			ret = pxp->dma_park_result;
+		k4_ram_trace_mark("PXP DMA park <");
+	}
+	clk_bulk_disable_unprepare(ARRAY_SIZE(pxp->clocks), pxp->clocks);
+done:
+	pxp->dma_result = ret;
+	if (!ret && pxp->dma_started)
+		pxp->jobs_done++;
+	k4_ram_trace_mark(ret ? "PXP DMA error" : "PXP DMA done");
+	return ret;
+}
--- /dev/null
+++ b/drivers/misc/k4-debug/k4-pxp-state.c
@@ -0,0 +1,397 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Explicit i.MX50 ePXP state capture and separately opted-in reset testing. */
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/k4_ram_trace.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define K4_PXP_CTRL 0x000
+#define K4_PXP_STAT 0x010
+#define K4_PXP_STAT_CLR 0x018
+#define K4_PXP_CTRL_SET 0x004
+#define K4_PXP_CTRL_CLR 0x008
+#define K4_PXP_NEXT 0x100
+#define K4_PXP_RESET BIT(31)
+#define K4_PXP_GATE BIT(30)
+#define K4_PXP_ACTIVE (BIT(28) | BIT(3) | BIT(0))
+
+struct k4_pxp_state {
+	void __iomem *base;
+	struct clk_bulk_data clocks[2];
+	struct mutex lock;
+	u32 ctrl, stat;
+	int result;
+	bool attempted;
+	bool allow_reset, reset_attempted;
+	int reset_result, park_result;
+	u32 reset_ctrl, reset_stat, reset_next, park_ctrl;
+	struct device *dev;
+	bool allow_dma, dma_attempted;
+	bool configuration_only, dma_started;
+	int dma_result, dma_park_result;
+	u8 *arena;
+	dma_addr_t arena_dma;
+	u32 dma_ctrl, dma_stat, dma_park, dma_config_reg;
+	u32 dma_config_readback;
+	u32 dma_mismatches, dma_input_errors, dma_guard_errors, dma_max_error;
+	bool use_irq, allow_repeat, irq_enabled;
+	int irq;
+	struct completion done;
+	u32 irq_stat, irq_count, jobs_done;
+};
+
+/* The line is enabled only while clocks are held by the job owner. */
+static irqreturn_t k4_pxp_irq(int irq, void *data)
+{
+	struct k4_pxp_state *pxp = data;
+	u32 stat = readl(pxp->base + K4_PXP_STAT);
+
+	if (!(stat & GENMASK(3, 0)))
+		return IRQ_NONE;
+	/* Mask the source before acknowledging this job, avoiding IRQ storms. */
+	writel(BIT(1), pxp->base + K4_PXP_CTRL_CLR);
+	writel(stat & GENMASK(3, 0), pxp->base + K4_PXP_STAT_CLR);
+	readl(pxp->base + K4_PXP_STAT);
+	WRITE_ONCE(pxp->irq_stat, stat);
+	pxp->irq_count++;
+	complete(&pxp->done);
+	return IRQ_HANDLED;
+}
+
+/* Caller holds lock. Software cannot time out a stalled bus transaction. */
+static int k4_pxp_capture(struct k4_pxp_state *pxp)
+{
+	int ret;
+
+	if (pxp->attempted)
+		return -EALREADY;
+	ret = k4_ram_trace_mark("PXP CAPTURE begin");
+	if (ret)
+		return ret;
+	pxp->attempted = true;
+	pxp->result = -EINPROGRESS;
+	if (clk_get_rate(pxp->clocks[1].clk) != 200000000) {
+		ret = -EINVAL;
+		goto done;
+	}
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(pxp->clocks), pxp->clocks);
+	if (ret)
+		goto done;
+	ret = k4_ram_trace_mark("PXP CTRL >");
+	if (ret)
+		goto disable;
+	pxp->ctrl = readl(pxp->base + K4_PXP_CTRL);
+	ret = k4_ram_trace_mark("PXP CTRL <");
+	if (ret)
+		goto disable;
+	ret = k4_ram_trace_mark("PXP STAT >");
+	if (ret)
+		goto disable;
+	pxp->stat = readl(pxp->base + K4_PXP_STAT);
+	ret = k4_ram_trace_mark("PXP STAT <");
+disable:
+	clk_bulk_disable_unprepare(ARRAY_SIZE(pxp->clocks), pxp->clocks);
+done:
+	pxp->result = ret;
+	k4_ram_trace_mark(ret ? "PXP CAPTURE error" : "PXP CAPTURE done");
+	return ret;
+}
+
+static ssize_t capture_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct k4_pxp_state *pxp = dev_get_drvdata(dev);
+	int ret;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	ret = mutex_lock_interruptible(&pxp->lock);
+	if (ret)
+		return ret;
+	ret = k4_pxp_capture(pxp);
+	mutex_unlock(&pxp->lock);
+	if (ret)
+		return ret;
+	return count;
+}
+static DEVICE_ATTR_WO(capture);
+
+static ssize_t snapshot_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct k4_pxp_state *pxp = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	mutex_lock(&pxp->lock);
+	ret = sysfs_emit(buf, "attempted=%u result=%d ctrl=%08x stat=%08x\n",
+			pxp->attempted, pxp->result, pxp->ctrl, pxp->stat);
+	mutex_unlock(&pxp->lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(snapshot);
+
+/* No buffers or DMA commands exist here. Reset deliberately discards old state. */
+static int k4_pxp_reset(struct k4_pxp_state *pxp)
+{
+	u32 ctrl, stat, next, value;
+	bool touched = false;
+	int ret;
+
+	if (!pxp->allow_reset)
+		return -EOPNOTSUPP;
+	if (pxp->reset_attempted)
+		return -EALREADY;
+	if (!pxp->attempted || pxp->result)
+		return -ENODATA;
+	ret = k4_ram_trace_mark("PXP RESET begin");
+	if (ret)
+		return ret;
+	pxp->reset_attempted = true;
+	pxp->reset_result = -EINPROGRESS;
+	if (clk_get_rate(pxp->clocks[1].clk) != 200000000) {
+		ret = -EINVAL;
+		goto done;
+	}
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(pxp->clocks), pxp->clocks);
+	if (ret)
+		goto done;
+	ret = k4_ram_trace_mark("PXP RESET CTRL >");
+	if (ret)
+		goto out;
+	ctrl = readl(pxp->base + K4_PXP_CTRL);
+	ret = k4_ram_trace_mark("PXP RESET CTRL < STAT >");
+	if (ret)
+		goto out;
+	stat = readl(pxp->base + K4_PXP_STAT);
+	ret = k4_ram_trace_mark("PXP RESET STAT < NEXT >");
+	if (ret)
+		goto out;
+	next = readl(pxp->base + K4_PXP_NEXT);
+	ret = k4_ram_trace_mark("PXP RESET NEXT <");
+	if (ret)
+		goto out;
+	/* Refuse a running/repeating/handshaking engine or queued command. */
+	if ((ctrl & K4_PXP_ACTIVE) || (next & BIT(0))) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (stat & GENMASK(3, 0)) {
+		ret = -EIO;
+		goto out;
+	}
+	ret = k4_ram_trace_mark("PXP RESET assert >");
+	if (ret)
+		goto out;
+	touched = true;
+	writel(K4_PXP_RESET, pxp->base + K4_PXP_CTRL_SET);
+	ret = readl_poll_timeout(pxp->base + K4_PXP_CTRL, value,
+		(value & (K4_PXP_RESET | K4_PXP_GATE)) ==
+		(K4_PXP_RESET | K4_PXP_GATE), 5, 1000);
+	if (ret)
+		goto out;
+	ret = k4_ram_trace_mark("PXP RESET assert < release >");
+	if (ret)
+		goto out;
+	writel(K4_PXP_RESET, pxp->base + K4_PXP_CTRL_CLR);
+	ret = readl_poll_timeout(pxp->base + K4_PXP_CTRL, value,
+				 !(value & K4_PXP_RESET), 5, 1000);
+	if (ret)
+		goto out;
+	writel(K4_PXP_GATE, pxp->base + K4_PXP_CTRL_CLR);
+	ret = readl_poll_timeout(pxp->base + K4_PXP_CTRL, value,
+				 !(value & (K4_PXP_RESET | K4_PXP_GATE)), 5, 1000);
+	if (ret)
+		goto out;
+	pxp->reset_ctrl = value;
+	ret = k4_ram_trace_mark("PXP RESET release < STAT >");
+	if (ret)
+		goto out;
+	pxp->reset_stat = readl(pxp->base + K4_PXP_STAT);
+	ret = k4_ram_trace_mark("PXP RESET STAT < NEXT >");
+	if (ret)
+		goto out;
+	pxp->reset_next = readl(pxp->base + K4_PXP_NEXT);
+	ret = k4_ram_trace_mark("PXP RESET NEXT < verified");
+	if (ret)
+		goto out;
+	if (pxp->reset_ctrl || pxp->reset_stat || pxp->reset_next)
+		ret = -EIO;
+out:
+	if (touched) {
+		/* Try to retain reset on error; report failed parking separately. */
+		k4_ram_trace_mark("PXP RESET park >");
+		writel(K4_PXP_GATE | (ret ? K4_PXP_RESET : 0),
+		       pxp->base + K4_PXP_CTRL_SET);
+		pxp->park_result = readl_poll_timeout(pxp->base + K4_PXP_CTRL,
+			value, (value & (K4_PXP_RESET | K4_PXP_GATE)) ==
+			(K4_PXP_GATE | (ret ? K4_PXP_RESET : 0)), 5, 1000);
+		pxp->park_ctrl = value;
+		k4_ram_trace_mark("PXP RESET park <");
+		if (!ret)
+			ret = pxp->park_result;
+	}
+	clk_bulk_disable_unprepare(ARRAY_SIZE(pxp->clocks), pxp->clocks);
+done:
+	pxp->reset_result = ret;
+	k4_ram_trace_mark(ret ? "PXP RESET error" : "PXP RESET done");
+	return ret;
+}
+
+static ssize_t reset_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct k4_pxp_state *pxp = dev_get_drvdata(dev);
+	int ret;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	ret = mutex_lock_interruptible(&pxp->lock);
+	if (ret)
+		return ret;
+	ret = k4_pxp_reset(pxp);
+	mutex_unlock(&pxp->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(reset);
+
+static ssize_t reset_snapshot_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct k4_pxp_state *pxp = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	mutex_lock(&pxp->lock);
+	ret = sysfs_emit(buf,
+		"allowed=%u attempted=%u result=%d ctrl=%08x stat=%08x next=%08x "
+		"park=%08x park_result=%d\n",
+		pxp->allow_reset, pxp->reset_attempted, pxp->reset_result,
+		pxp->reset_ctrl, pxp->reset_stat, pxp->reset_next,
+		pxp->park_ctrl, pxp->park_result);
+	mutex_unlock(&pxp->lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(reset_snapshot);
+
+#include "k4-pxp-dma-test.h"
+
+static ssize_t dma_test_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct k4_pxp_state *pxp = dev_get_drvdata(dev);
+	int ret;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	ret = mutex_lock_interruptible(&pxp->lock);
+	if (ret)
+		return ret;
+	ret = k4_pxp_dma_test(pxp);
+	mutex_unlock(&pxp->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(dma_test);
+
+static ssize_t dma_snapshot_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct k4_pxp_state *pxp = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	mutex_lock(&pxp->lock);
+	ret = sysfs_emit(buf,
+		"allowed=%u attempted=%u result=%d ctrl=%08x stat=%08x park=%08x park_result=%d\n"
+		"mismatches=%u input_errors=%u guard_errors=%u max_error=%u last_config=%03x readback=%08x retained=%u\n",
+		pxp->allow_dma, pxp->dma_attempted, pxp->dma_result,
+		pxp->dma_ctrl, pxp->dma_stat, pxp->dma_park, pxp->dma_park_result,
+		pxp->dma_mismatches, pxp->dma_input_errors, pxp->dma_guard_errors,
+		pxp->dma_max_error, pxp->dma_config_reg, pxp->dma_config_readback,
+		!!pxp->arena);
+	ret += sysfs_emit_at(buf, ret, "configuration_only=%u started=%u\n",
+			    pxp->configuration_only, pxp->dma_started);
+	ret += sysfs_emit_at(buf, ret, "use_irq=%u irq_count=%u jobs_done=%u repeat=%u\n",
+			    pxp->use_irq, pxp->irq_count, pxp->jobs_done,
+			    pxp->allow_repeat);
+	mutex_unlock(&pxp->lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(dma_snapshot);
+
+static struct attribute *k4_pxp_attrs[] = {
+	&dev_attr_capture.attr, &dev_attr_snapshot.attr,
+	&dev_attr_reset.attr, &dev_attr_reset_snapshot.attr,
+	&dev_attr_dma_test.attr, &dev_attr_dma_snapshot.attr, NULL,
+};
+ATTRIBUTE_GROUPS(k4_pxp);
+
+static int k4_pxp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct k4_pxp_state *pxp;
+	struct resource *res;
+	int ret;
+
+	if (!of_machine_is_compatible("amazon,kindle-4"))
+		return -ENODEV;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || res->start != 0x4100c000 || resource_size(res) != 0x2000)
+		return -EINVAL;
+	pxp = devm_kzalloc(dev, sizeof(*pxp), GFP_KERNEL);
+	if (!pxp)
+		return -ENOMEM;
+	pxp->base = devm_ioremap_resource(dev, res);
+	if (IS_ERR(pxp->base))
+		return PTR_ERR(pxp->base);
+	pxp->clocks[0].id = "apbh";
+	pxp->clocks[1].id = "pxp_axi";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(pxp->clocks), pxp->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "get register-access clocks\n");
+	mutex_init(&pxp->lock);
+	pxp->result = -ENODATA;
+	pxp->reset_result = -ENODATA;
+	pxp->park_result = -ENODATA;
+	pxp->allow_reset = of_property_read_bool(dev->of_node, "amazon,allow-reset-test");
+	pxp->allow_dma = of_property_read_bool(dev->of_node, "amazon,allow-dma-test");
+	pxp->configuration_only = of_property_read_bool(dev->of_node,
+						      "amazon,configuration-only");
+	pxp->use_irq = of_property_read_bool(dev->of_node, "amazon,irq-test");
+	pxp->allow_repeat = of_property_read_bool(dev->of_node, "amazon,repeat-test");
+	if (pxp->use_irq) {
+		pxp->irq = platform_get_irq(pdev, 0);
+		if (pxp->irq < 0)
+			return pxp->irq;
+		init_completion(&pxp->done);
+		ret = devm_request_irq(dev, pxp->irq, k4_pxp_irq, IRQF_NO_AUTOEN,
+				       "k4-pxp-job", pxp);
+		if (ret)
+			return dev_err_probe(dev, ret, "request job interrupt\n");
+	}
+	pxp->dev = dev;
+	pxp->dma_result = -ENODATA;
+	pxp->dma_park_result = -ENODATA;
+	platform_set_drvdata(pdev, pxp);
+	dev_info(dev, "armed only: reset allowed=%u, DMA test allowed=%u\n",
+		 pxp->allow_reset, pxp->allow_dma);
+	return 0;
+}
+
+static const struct of_device_id k4_pxp_match[] = {
+	{ .compatible = "amazon,k4-pxp-state-probe" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, k4_pxp_match);
+static struct platform_driver k4_pxp_driver = {
+	.probe = k4_pxp_probe,
+	.driver = {
+		.name = "k4-pxp-state",
+		.of_match_table = k4_pxp_match,
+		.dev_groups = k4_pxp_groups,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(k4_pxp_driver);
+MODULE_LICENSE("GPL");
