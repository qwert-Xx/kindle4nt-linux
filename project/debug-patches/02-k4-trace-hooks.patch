@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Explicit consumer for a supervised RAM trial; no automatic power cycle. */
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+
+struct k4_papyrus_test {
+	struct regulator *display, *vcom;
+	struct mutex lock;
+	bool display_held, vcom_held;
+	int result, voltage;
+	unsigned int cycles;
+};
+
+static int k4_papyrus_release(struct k4_papyrus_test *t)
+{
+	int ret;
+
+	if (t->vcom_held) {
+		ret = regulator_disable(t->vcom);
+		if (ret)
+			return ret;
+		t->vcom_held = false;
+	}
+	if (t->display_held) {
+		ret = regulator_disable(t->display);
+		if (ret)
+			return ret;
+		t->display_held = false;
+	}
+	return 0;
+}
+
+static ssize_t run_store(struct device *dev, struct device_attribute *attr,
+			 const char *buf, size_t count)
+{
+	struct k4_papyrus_test *t = dev_get_drvdata(dev);
+	unsigned int flags;
+	int ret, cleanup;
+
+	if (!sysfs_streq(buf, "cycle") && !sysfs_streq(buf, "release"))
+		return -EINVAL;
+	if (!mutex_trylock(&t->lock))
+		return -EBUSY;
+	if (sysfs_streq(buf, "release")) {
+		ret = k4_papyrus_release(t);
+		goto out;
+	}
+	if (t->display_held || t->vcom_held) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = regulator_enable(t->display);
+	if (ret)
+		goto out;
+	t->display_held = true;
+	ret = regulator_enable(t->vcom);
+	if (ret)
+		goto release;
+	t->vcom_held = true;
+	t->voltage = regulator_get_voltage(t->vcom);
+	if (t->voltage < 0) {
+		ret = t->voltage;
+		goto release;
+	}
+	/* A test observation interval, not a lifetime limit in the power driver. */
+	msleep(250);
+	ret = regulator_get_error_flags(t->display, &flags);
+	if (!ret && (flags || regulator_is_enabled(t->display) != 1 ||
+		     regulator_is_enabled(t->vcom) != 1))
+		ret = -EIO;
+release:
+	cleanup = k4_papyrus_release(t);
+	if (!ret)
+		ret = cleanup;
+	if (!ret)
+		t->cycles++;
+out:
+	t->result = ret;
+	mutex_unlock(&t->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(run);
+
+static ssize_t result_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct k4_papyrus_test *t = dev_get_drvdata(dev);
+	ssize_t size;
+
+	mutex_lock(&t->lock);
+	size = sysfs_emit(buf, "result=%d cycles=%u display_held=%u vcom_held=%u vcom_magnitude_uv=%d\n",
+			  t->result, t->cycles, t->display_held, t->vcom_held, t->voltage);
+	mutex_unlock(&t->lock);
+	return size;
+}
+static DEVICE_ATTR_RO(result);
+
+static struct attribute *k4_papyrus_test_attrs[] = {
+	&dev_attr_run.attr, &dev_attr_result.attr, NULL,
+};
+ATTRIBUTE_GROUPS(k4_papyrus_test);
+
+static int k4_papyrus_test_probe(struct platform_device *pdev)
+{
+	struct k4_papyrus_test *t;
+
+	t = devm_kzalloc(&pdev->dev, sizeof(*t), GFP_KERNEL);
+	if (!t)
+		return -ENOMEM;
+	t->display = devm_regulator_get(&pdev->dev, "display");
+	if (IS_ERR(t->display))
+		return dev_err_probe(&pdev->dev, PTR_ERR(t->display), "DISPLAY\n");
+	t->vcom = devm_regulator_get(&pdev->dev, "vcom");
+	if (IS_ERR(t->vcom))
+		return dev_err_probe(&pdev->dev, PTR_ERR(t->vcom), "VCOM\n");
+	mutex_init(&t->lock);
+	t->result = -ENODATA;
+	platform_set_drvdata(pdev, t);
+	return 0;
+}
+
+static void k4_papyrus_test_shutdown(struct platform_device *pdev)
+{
+	struct k4_papyrus_test *t = platform_get_drvdata(pdev);
+
+	mutex_lock(&t->lock);
+	k4_papyrus_release(t);
+	mutex_unlock(&t->lock);
+}
+
+static const struct of_device_id k4_papyrus_test_match[] = {
+	{ .compatible = "amazon,k4-papyrus-power-test" }, { }
+};
+
+static struct platform_driver k4_papyrus_test_driver = {
+	.probe = k4_papyrus_test_probe,
+	.shutdown = k4_papyrus_test_shutdown,
+	.driver = {
+		.name = "k4-papyrus-power-test",
+		.of_match_table = k4_papyrus_test_match,
+		.dev_groups = k4_papyrus_test_groups,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(k4_papyrus_test_driver);
+MODULE_LICENSE("GPL");
