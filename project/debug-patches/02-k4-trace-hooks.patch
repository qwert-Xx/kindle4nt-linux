+K4_PAPYRUS_RO_ATTR(power_sequence1_raw, PAPYRUS_PWR_SEQ1);
+K4_PAPYRUS_RO_ATTR(power_sequence2_raw, PAPYRUS_PWR_SEQ2);
+K4_PAPYRUS_RO_ATTR(temperature_config_raw, PAPYRUS_TMST_CONFIG);
+K4_PAPYRUS_RO_ATTR(temperature_hot_raw, PAPYRUS_TMST_OS);
+K4_PAPYRUS_RO_ATTR(temperature_cool_raw, PAPYRUS_TMST_HYST);
+K4_PAPYRUS_RO_ATTR(powergood_raw, PAPYRUS_PG_STATUS);
+K4_PAPYRUS_RO_ATTR(revision_raw, PAPYRUS_REVID);
