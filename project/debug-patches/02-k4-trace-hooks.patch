+	return i2c_smbus_read_byte_data(client, reg);
+}
+
+static ssize_t k4_papyrus_show_reg(struct device *dev, char *buf, u8 reg)
+{
+	int value = k4_papyrus_read_reg(to_i2c_client(dev), reg);
+
+	if (value < 0)
+		return value;
+	return sysfs_emit(buf, "0x%02x\n", value);
+}
+
+#define K4_PAPYRUS_RO_ATTR(_name, _reg) \
+static ssize_t _name##_show(struct device *dev, \
+			    struct device_attribute *attr, char *buf) \
+{ \
+	return k4_papyrus_show_reg(dev, buf, _reg); \
+} \
+static DEVICE_ATTR_RO(_name)
