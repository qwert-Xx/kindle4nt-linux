+++ b/drivers/misc/k4-debug/k4-display-clock-probe.c
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* RAM experiment: clocks only; never maps EPDC/PxP or touches panel pins. */
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+static int k4_test_pfd5(struct device *dev, struct clk *pfd)
+{
+	unsigned long before = clk_get_rate(pfd);
+	int ret, restore;
+
+	if (__clk_is_enabled(pfd) || !before)
+		return dev_err_probe(dev, -EBUSY, "PFD5 not safely idle\n");
+	if (clk_round_rate(pfd, 1) != 246857142 ||
+	    clk_round_rate(pfd, 1000000000) != 480000000)
+		return dev_err_probe(dev, -EINVAL, "PFD5 divisor bounds incorrect\n");
+	dev_info(dev, "PFD5 baseline=%lu\n", before);
+	ret = clk_set_rate(pfd, 320000000);
+	if (ret)
+		goto restore;
+	ret = clk_prepare_enable(pfd);
+	if (ret)
+		goto restore;
+	if (clk_get_rate(pfd) != 320000000 || !__clk_is_enabled(pfd))
+		ret = -EIO;
+	if (clk_set_rate(pfd, 480000000) != -EBUSY ||
+	    clk_get_rate(pfd) != 320000000)
+		ret = -EIO;
+	dev_info(dev, "PFD5 enabled rate=%lu result=%d; pixel output gated\n",
+		clk_get_rate(pfd), ret);
+	msleep(20);
+	clk_disable_unprepare(pfd);
+restore:
+	restore = clk_set_rate(pfd, before);
+	if (restore || __clk_is_enabled(pfd) || clk_get_rate(pfd) != before)
+		return dev_err_probe(dev, restore ?: -EIO, "PFD5 restore failed\n");
+	if (ret)
+		return dev_err_probe(dev, ret, "PFD5 test failed\n");
+	dev_info(dev, "PASS: PFD5 320 MHz and original rate/gate restored\n");
+	return 0;
+}
+
+static int k4_display_clock_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_bulk_data clocks[] = {
+		{ .id = "epdc_axi" }, { .id = "pxp_axi" },
+	};
+	struct clk *pfd;
+	int ret, i, j;
+
+	pfd = devm_clk_get_optional(dev, "pfd5");
+	if (IS_ERR(pfd))
+		return dev_err_probe(dev, PTR_ERR(pfd), "PFD5 provider\n");
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(clocks), clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "get AXI clocks\n");
+	for (i = 0; i < ARRAY_SIZE(clocks); i++) {
+		unsigned long rate = clk_get_rate(clocks[i].clk);
+
+		dev_info(dev, "%s inherited rate=%lu\n", clocks[i].id, rate);
+		if (rate != 200000000)
+			return dev_err_probe(dev, -EINVAL, "unexpected warm-boot rate\n");
+	}
+	for (i = 0; i < 3; i++) {
+		ret = clk_bulk_prepare_enable(ARRAY_SIZE(clocks), clocks);
+		if (ret)
+			return dev_err_probe(dev, ret, "enable AXI clocks\n");
+		for (j = 0; j < ARRAY_SIZE(clocks); j++) {
+			if (!__clk_is_enabled(clocks[j].clk)) {
+				clk_bulk_disable_unprepare(ARRAY_SIZE(clocks), clocks);
+				return dev_err_probe(dev, -EIO, "gate enable readback failed\n");
+			}
+		}
+		dev_info(dev, "cycle %d: both gates read enabled; no controller access\n", i);
+		msleep(20);
+		clk_bulk_disable_unprepare(ARRAY_SIZE(clocks), clocks);
+		for (j = 0; j < ARRAY_SIZE(clocks); j++)
+			if (__clk_is_enabled(clocks[j].clk))
+				return dev_err_probe(dev, -EIO, "gate disable readback failed\n");
+	}
+	dev_info(dev, "PASS: three AXI gate cycles; panel/controller untouched\n");
+	return pfd ? k4_test_pfd5(dev, pfd) : 0;
+}
+
+static const struct of_device_id k4_display_clock_match[] = {
+	{ .compatible = "amazon,k4-display-clock-probe" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, k4_display_clock_match);
+
+static struct platform_driver k4_display_clock_driver = {
+	.probe = k4_display_clock_probe,
+	.driver = {
+		.name = "k4-display-clock-probe",
+		.of_match_table = k4_display_clock_match,
+	},
+};
+module_platform_driver(k4_display_clock_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Kindle K4 RAM-only display AXI clock experiment");
--- /dev/null
+++ b/drivers/misc/k4-debug/k4-epdc-id.c
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Explicit RAM diagnostic: only AXI/APBH clocks and read-only EPDC registers. */
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/k4_ram_trace.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define EPDC_CTRL	0x000
+#define EPDC_STATUS	0x4a0
+#define EPDC_VERSION	0x7f0
+
+struct k4_epdc_id {
+	void __iomem *base;
+	struct clk_bulk_data clocks[2];
+	struct mutex lock;
+	u32 version, ctrl, status;
+	int result;
+	bool attempted;
+};
+
+/* Caller holds lock. A stalled bus read cannot be bounded by a software poll. */
+static int k4_epdc_capture(struct k4_epdc_id *id)
+{
+	int ret;
+
+	if (id->attempted)
+		return -EALREADY;
+	/* Refuse MMIO unless the reserved-RAM recorder is initialized/enabled. */
+	ret = k4_ram_trace_mark("EPDC CAPTURE begin");
+	if (ret)
+		return ret;
+	id->attempted = true;
+	id->result = -EINPROGRESS;
+	if (clk_get_rate(id->clocks[1].clk) != 200000000) {
+		ret = -EINVAL;
+		goto done;
+	}
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(id->clocks), id->clocks);
+	if (ret)
+		goto done;
+	ret = k4_ram_trace_mark("EPDC VERSION >");
+	if (ret)
+		goto disable;
+	id->version = readl(id->base + EPDC_VERSION);
+	ret = k4_ram_trace_mark("EPDC VERSION <");
+	if (ret)
+		goto disable;
+	/* The i.MX50 RM describes V1; do not interpret an unexpected block. */
+	if ((id->version >> 24) != 1) {
+		ret = -ENODEV;
+		goto disable;
+	}
+	ret = k4_ram_trace_mark("EPDC CTRL >");
+	if (ret)
+		goto disable;
+	id->ctrl = readl(id->base + EPDC_CTRL);
+	ret = k4_ram_trace_mark("EPDC CTRL <");
+	if (ret)
+		goto disable;
+	ret = k4_ram_trace_mark("EPDC STATUS >");
+	if (ret)
+		goto disable;
+	id->status = readl(id->base + EPDC_STATUS);
+	ret = k4_ram_trace_mark("EPDC STATUS <");
+disable:
+	clk_bulk_disable_unprepare(ARRAY_SIZE(id->clocks), id->clocks);
+done:
+	id->result = ret;
+	k4_ram_trace_mark(ret ? "EPDC CAPTURE error" : "EPDC CAPTURE done");
+	return ret;
+}
+
+static ssize_t capture_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct k4_epdc_id *id = dev_get_drvdata(dev);
+	int ret;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	ret = mutex_lock_interruptible(&id->lock);
+	if (ret)
+		return ret;
+	ret = k4_epdc_capture(id);
+	mutex_unlock(&id->lock);
+	if (ret)
+		return ret;
+	return count;
+}
+static DEVICE_ATTR_WO(capture);
+
+static ssize_t snapshot_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct k4_epdc_id *id = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	mutex_lock(&id->lock);
+	ret = sysfs_emit(buf, "attempted=%u result=%d version=%08x ctrl=%08x status=%08x\n",
+			id->attempted, id->result, id->version, id->ctrl, id->status);
+	mutex_unlock(&id->lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(snapshot);
+
+static struct attribute *k4_epdc_id_attrs[] = {
+	&dev_attr_capture.attr, &dev_attr_snapshot.attr, NULL,
+};
+ATTRIBUTE_GROUPS(k4_epdc_id);
+
+static int k4_epdc_id_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct k4_epdc_id *id;
+	struct resource *res;
+	int ret;
+
+	if (!of_machine_is_compatible("amazon,kindle-4"))
+		return -ENODEV;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || res->start != 0x41010000 || resource_size(res) != 0x1000)
+		return -EINVAL;
+	id = devm_kzalloc(dev, sizeof(*id), GFP_KERNEL);
+	if (!id)
+		return -ENOMEM;
+	id->base = devm_ioremap_resource(dev, res);
+	if (IS_ERR(id->base))
+		return PTR_ERR(id->base);
+	id->clocks[0].id = "apbh";
+	id->clocks[1].id = "epdc_axi";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(id->clocks), id->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "get register-access clocks\n");
+	mutex_init(&id->lock);
+	id->result = -ENODATA;
+	platform_set_drvdata(pdev, id);
+	dev_info(dev, "armed only: no EPDC MMIO until explicit capture\n");
+	return 0;
+}
+
+static const struct of_device_id k4_epdc_id_match[] = {
+	{ .compatible = "amazon,k4-epdc-id-probe" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, k4_epdc_id_match);
+static struct platform_driver k4_epdc_id_driver = {
+	.probe = k4_epdc_id_probe,
+	.driver = {
+		.name = "k4-epdc-id",
+		.of_match_table = k4_epdc_id_match,
+		.dev_groups = k4_epdc_id_groups,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(k4_epdc_id_driver);
+MODULE_LICENSE("GPL");
