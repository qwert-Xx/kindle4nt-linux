+++ b/drivers/misc/k4-debug/k4-papyrus-temperature.c
@@ -0,0 +1,306 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* K4 TPS65180B fresh thermistor acquisition; no display power control. */
+#include <linux/delay.h>
+#include <linux/hwmon.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm.h>
+
+#include "../k4-papyrus-registers.h"
+
+#define PAPYRUS_INT_STATUS1 0x07
+#define PAPYRUS_INT_STATUS2 0x08
+#define PAPYRUS_FAULT1 0x74
+#define PAPYRUS_FAULT2 0xfa
+#define PAPYRUS_EOC 0x01
+#define PAPYRUS_READ_THERM 0x80
+#define PAPYRUS_CONV_END 0x20
+#define PAPYRUS_FAULT_QUEUE 0x18
+
+struct k4_papyrus_temp {
+	struct i2c_client *client;
+	struct mutex lock;
+	unsigned int samples;
+	u8 irq_seen[2];
+	int last_error;
+	bool suspended;
+};
+
+/* All successful read-to-clear reads are saved even if the next read fails. */
+static int papyrus_ack(struct k4_papyrus_temp *p)
+{
+	int first, second;
+
+	first = i2c_smbus_read_byte_data(p->client, PAPYRUS_INT_STATUS1);
+	if (first < 0)
+		return first;
+	p->irq_seen[0] |= first;
+	second = i2c_smbus_read_byte_data(p->client, PAPYRUS_INT_STATUS2);
+	if (second < 0)
+		return second;
+	p->irq_seen[1] |= second;
+	if ((first & PAPYRUS_FAULT1) || (second & PAPYRUS_FAULT2))
+		return -EIO;
+	return second;
+}
+
+/* This stage only measures in inherited standby. Never writes ENABLE/GPIOs. */
+static int papyrus_standby(struct k4_papyrus_temp *p)
+{
+	int value;
+
+	value = i2c_smbus_read_byte_data(p->client, PAPYRUS_ENABLE);
+	if (value < 0)
+		return value;
+	if (value & 0xc0)
+		return -EBUSY;
+	value = i2c_smbus_read_byte_data(p->client, PAPYRUS_PG_STATUS);
+	if (value < 0)
+		return value;
+	return value ? -EBUSY : 0;
+}
+
+static int papyrus_wait_conversion(struct k4_papyrus_temp *p)
+{
+	int count, ret;
+
+	for (count = 0; count < 100; count++) {
+		usleep_range(1000, 1500);
+		ret = i2c_smbus_read_byte_data(p->client, PAPYRUS_TMST_CONFIG);
+		if (ret < 0)
+			return ret;
+		if (!(ret & PAPYRUS_READ_THERM) && (ret & PAPYRUS_CONV_END))
+			return ret;
+	}
+	return -ETIMEDOUT;
+}
+
+/* Caller holds lock. Only publish a value after this conversion's EOC. */
+static int papyrus_temperature(struct k4_papyrus_temp *p, long *result)
+{
+	int ret, config, raw;
+
+	if (p->suspended)
+		return -EBUSY;
+	ret = papyrus_standby(p);
+	if (ret)
+		goto fault;
+	config = i2c_smbus_read_byte_data(p->client, PAPYRUS_TMST_CONFIG);
+	if (config < 0) {
+		ret = config;
+		goto fault;
+	}
+	if (config & PAPYRUS_READ_THERM) {
+		/* A prior failed transfer may have left a conversion running.
+		 * Drain it before acknowledging EOC and starting our own sample.
+		 */
+		config = papyrus_wait_conversion(p);
+		if (config < 0) {
+			ret = config;
+			goto fault;
+		}
+	}
+	/* Discard stale EOC only after caching all status and checking faults. */
+	ret = papyrus_ack(p);
+	if (ret < 0)
+		goto fault;
+	/* Preserve queue length; never assert the fault-counter-clear bit. */
+	ret = i2c_smbus_write_byte_data(p->client, PAPYRUS_TMST_CONFIG,
+				      (config & PAPYRUS_FAULT_QUEUE) |
+				      PAPYRUS_READ_THERM);
+	if (ret < 0)
+		goto fault;
+	ret = papyrus_wait_conversion(p);
+	if (ret < 0)
+		goto fault;
+	ret = papyrus_ack(p);
+	if (ret < 0)
+		goto fault;
+	if (!(ret & PAPYRUS_EOC)) {
+		ret = -EIO;
+		goto fault;
+	}
+	raw = i2c_smbus_read_byte_data(p->client, PAPYRUS_TMST_VALUE);
+	if (raw < 0) {
+		ret = raw;
+		goto fault;
+	}
+	/* Explicit sign extension; reserved encodings must not become a sample. */
+	if (raw & 0x80)
+		raw -= 256;
+	if (raw < -10 || raw > 85) {
+		ret = -ERANGE;
+		goto fault;
+	}
+	ret = papyrus_standby(p);
+	if (ret)
+		goto fault;
+	*result = raw * 1000;
+	p->samples++;
+	p->last_error = 0;
+	return 0;
+
+fault:
+	/* This attempt failed; the next read rechecks hardware and starts fresh.
+	 * Do not reset display power to recover a thermistor bus transaction.
+	 */
+	p->last_error = ret;
+	return ret;
+}
+
+static umode_t papyrus_visible(const void *data, enum hwmon_sensor_types type,
+			      u32 attr, int channel)
+{
+	return type == hwmon_temp && attr == hwmon_temp_input ? 0444 : 0;
+}
+
+static int papyrus_read(struct device *dev, enum hwmon_sensor_types type,
+			u32 attr, int channel, long *value)
+{
+	struct k4_papyrus_temp *p = dev_get_drvdata(dev);
+	int ret;
+
+	if (type != hwmon_temp || attr != hwmon_temp_input || channel)
+		return -EOPNOTSUPP;
+	mutex_lock(&p->lock);
+	ret = papyrus_temperature(p, value);
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+static const struct hwmon_ops papyrus_hwmon_ops = {
+	.is_visible = papyrus_visible,
+	.read = papyrus_read,
+};
+
+static const struct hwmon_channel_info * const papyrus_info[] = {
+	HWMON_CHANNEL_INFO(temp, HWMON_T_INPUT),
+	NULL,
+};
+
+static const struct hwmon_chip_info papyrus_chip = {
+	.ops = &papyrus_hwmon_ops,
+	.info = papyrus_info,
+};
+
+static ssize_t acquisition_state_show(struct device *dev,
+				      struct device_attribute *attr, char *buf)
+{
+	struct k4_papyrus_temp *p = i2c_get_clientdata(to_i2c_client(dev));
+	ssize_t length;
+
+	mutex_lock(&p->lock);
+	length = sysfs_emit(buf, "samples=%u last_error=%d irq_seen=%02x/%02x suspended=%u\n",
+			    p->samples, p->last_error, p->irq_seen[0], p->irq_seen[1],
+			    p->suspended);
+	mutex_unlock(&p->lock);
+	return length;
+}
+static DEVICE_ATTR_RO(acquisition_state);
+
+/* Non-clearing power/settings snapshot; does not trigger an acquisition. */
+static ssize_t rail_state_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	static const u8 regs[] = {
+		PAPYRUS_ENABLE, PAPYRUS_VP_ADJUST, PAPYRUS_VN_ADJUST,
+		PAPYRUS_VCOM_ADJUST, PAPYRUS_INT_ENABLE1, PAPYRUS_INT_ENABLE2,
+		PAPYRUS_PWR_SEQ0, PAPYRUS_PWR_SEQ1, PAPYRUS_PWR_SEQ2,
+		PAPYRUS_TMST_OS, PAPYRUS_TMST_HYST, PAPYRUS_PG_STATUS,
+	};
+	struct k4_papyrus_temp *p = i2c_get_clientdata(to_i2c_client(dev));
+	ssize_t length = 0;
+	int i, ret;
+
+	mutex_lock(&p->lock);
+	if (p->suspended) {
+		length = -EBUSY;
+		goto out;
+	}
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		ret = i2c_smbus_read_byte_data(p->client, regs[i]);
+		if (ret < 0) {
+			length = ret;
+			goto out;
+		}
+		length += sysfs_emit_at(buf, length, "%02x=%02x%c", regs[i], ret,
+					i == ARRAY_SIZE(regs) - 1 ? '\n' : ' ');
+	}
+out:
+	mutex_unlock(&p->lock);
+	return length;
+}
+static DEVICE_ATTR_RO(rail_state);
+
+static struct attribute *papyrus_attrs[] = {
+	&dev_attr_acquisition_state.attr,
+	&dev_attr_rail_state.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(papyrus);
+
+static int papyrus_suspend(struct device *dev)
+{
+	struct k4_papyrus_temp *p = i2c_get_clientdata(to_i2c_client(dev));
+
+	mutex_lock(&p->lock);
+	p->suspended = true;
+	mutex_unlock(&p->lock);
+	return 0;
+}
+
+static int papyrus_resume(struct device *dev)
+{
+	struct k4_papyrus_temp *p = i2c_get_clientdata(to_i2c_client(dev));
+
+	mutex_lock(&p->lock);
+	p->suspended = false;
+	mutex_unlock(&p->lock);
+	return 0;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(papyrus_pm, papyrus_suspend, papyrus_resume);
+
+static int papyrus_probe(struct i2c_client *client)
+{
+	struct k4_papyrus_temp *p;
+	struct device *hwmon;
+	int ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA))
+		return -EOPNOTSUPP;
+	ret = i2c_smbus_read_byte_data(client, PAPYRUS_REVID);
+	if (ret < 0)
+		return ret;
+	if (ret != PAPYRUS_K4_REVID)
+		return -ENODEV;
+	p = devm_kzalloc(&client->dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->client = client;
+	mutex_init(&p->lock);
+	i2c_set_clientdata(client, p);
+	hwmon = devm_hwmon_device_register_with_info(&client->dev, "k4_papyrus",
+						   p, &papyrus_chip, NULL);
+	return PTR_ERR_OR_ZERO(hwmon);
+}
+
+static const struct of_device_id papyrus_of_match[] = {
+	{ .compatible = "amazon,k4-papyrus-temperature" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, papyrus_of_match);
+
+static struct i2c_driver papyrus_driver = {
+	.probe = papyrus_probe,
+	.driver = {
+		.name = "k4-papyrus-temperature",
+		.of_match_table = papyrus_of_match,
+		.dev_groups = papyrus_groups,
+		.pm = pm_sleep_ptr(&papyrus_pm),
+	},
+};
+module_i2c_driver(papyrus_driver);
+
+MODULE_DESCRIPTION("K4 TPS65180B standby thermistor acquisition");
