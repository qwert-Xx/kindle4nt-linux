+++ b/drivers/misc/k4-debug/k4-epdc-image-test.h
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Test consumer of EPDC preparation, included by k4-pxp-client-test.c. */
+#include <linux/imx50-epdc-image.h>
+
+static int k4_epdc_image_frame(struct k4_pxp_client *c, unsigned int rotation,
+			       unsigned int format, unsigned int shape)
+{
+	u32 sw = rotation % 180 ? 600 : 800;
+	u32 sh = rotation % 180 ? 800 : 600;
+	u32 bpp = format == IMX50_EPDC_XRGB8888 ? 4 : format == IMX50_EPDC_RGB565 ? 2 : 1;
+	struct imx50_epdc_rect r, got, expected;
+	struct imx50_epdc_source s;
+	u32 ss = sw * bpp + 3, dw, dh, ds, x, y, sx, sy, low, high, actual, turn;
+	u8 *src, *dst;
+	bool invert = (format + rotation / 90 + shape) & 1;
+	int ret;
+
+	switch (shape) {
+	case 0:
+		r = (struct imx50_epdc_rect){ sw - 1, sh - 1, 1, 1 };
+		break;
+	case 1:
+		r = (struct imx50_epdc_rect){ 3, 5, 13, 17 };
+		break;
+	case 2:
+		r = (struct imx50_epdc_rect){ sw - 7, sh - 9, 7, 9 };
+		break;
+	default:
+		r = (struct imx50_epdc_rect){ 0, 0, sw, sh };
+		break;
+	}
+	dw = rotation % 180 ? r.height : r.width;
+	dh = rotation % 180 ? r.width : r.height;
+	ds = dw + 7;
+	src = kvmalloc(ss * sh, GFP_KERNEL);
+	dst = kvmalloc(ds * dh, GFP_KERNEL);
+	if (!src || !dst) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	memset(src, 0x5a, ss * sh);
+	memset(dst, 0xa7, ds * dh);
+	for (y = 0; y < r.height; y++) {
+		for (x = 0; x < r.width; x++) {
+			u8 *q = src + (r.top + y) * ss + (r.left + x) * bpp;
+			u32 v;
+
+			if (format == IMX50_EPDC_RGB565) {
+				v = (((x + y) & 31) << 11) | (((y * 3) & 63) << 5) | (x & 31);
+				q[0] = v;
+				q[1] = v >> 8;
+			} else {
+				q[0] = x * 3 + y;
+				if (bpp == 4) {
+					q[1] = y * 7 + shape;
+					q[2] = x + y + 11;
+					q[3] = 0;
+				}
+			}
+		}
+		cond_resched();
+	}
+	s = (struct imx50_epdc_source) {
+		.pixels = src, .size = ss * sh, .width = sw, .height = sh,
+		.stride = ss, .format = format, .region = r,
+		.rotation = rotation, .invert = invert,
+	};
+	ret = imx50_epdc_prepare(c->pxp, &s, dst, ds * dh, ds, &got);
+	if (ret)
+		goto out;
+	expected = r;
+	/* Compose quarter-turns to check native coordinates independently. */
+	for (turn = 0; turn < rotation / 90; turn++) {
+		u32 height = turn & 1 ? sw : sh;
+		u32 old_left = expected.left, old_width = expected.width;
+
+		expected.left = height - expected.top - expected.height;
+		expected.top = old_left;
+		expected.width = expected.height;
+		expected.height = old_width;
+	}
+	if (memcmp(&expected, &got, sizeof(got))) {
+		ret = -ERANGE;
+		goto out;
+	}
+	for (y = 0; y < dh; y++) {
+		for (x = 0; x < ds; x++) {
+			const u8 *q;
+			u32 red, green, blue, v;
+
+			if (x >= dw) {
+				if (dst[y * ds + x] != 0xa7) {
+					ret = -EOVERFLOW;
+					goto out;
+				}
+				continue;
+			}
+			sx = x;
+			sy = y;
+			for (turn = 0; turn < rotation / 90; turn++) {
+				u32 width = turn & 1 ? dh : dw;
+				u32 old_x = sx;
+
+				sx = sy;
+				sy = width - 1 - old_x;
+			}
+			q = src + (r.top + sy) * ss + (r.left + sx) * bpp;
+			if (bpp == 4) {
+				blue = q[0];
+				green = q[1];
+				red = q[2];
+			} else if (bpp == 2) {
+				v = q[0] + 256 * q[1];
+				blue = (v % 32) * 8 + (v % 32) / 4;
+				green = ((v / 32) % 64) * 4 + ((v / 32) % 64) / 16;
+				red = (v / 2048) * 8 + (v / 2048) / 4;
+			} else {
+				red = q[0];
+				green = q[0];
+				blue = q[0];
+			}
+			low = (77 * red + 150 * green + 29 * blue) / 256;
+			high = low + (low != 255);
+			if (invert) {
+				v = low;
+				low = 255 - high;
+				high = 255 - v;
+			}
+			actual = dst[y * ds + x];
+			if (actual < low || actual > high) {
+				ret = -EILSEQ;
+				goto out;
+			}
+			if (actual != low)
+				atomic_set(&c->max_error, 1);
+		}
+		cond_resched();
+	}
+	atomic_inc(&c->frames);
+	atomic_add(r.width * r.height, &c->pixels);
+out:
+	kvfree(src);
+	kvfree(dst);
+	return ret;
+}
+
+static int k4_epdc_image_suite(struct k4_pxp_client *c)
+{
+	unsigned int angle, format, shape;
+	int ret;
+
+	for (angle = 0; angle < 360; angle += 90) {
+		for (format = 0; format < 3; format++) {
+			for (shape = 0; shape < 4; shape++) {
+				ret = k4_epdc_image_frame(c, angle, format, shape);
+				if (ret)
+					return ret;
+			}
+		}
+	}
+	return 0;
+}
