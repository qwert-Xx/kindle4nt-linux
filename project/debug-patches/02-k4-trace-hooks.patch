+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __ASM_ARM_K4_BOOT_TRACE_H
+#define __ASM_ARM_K4_BOOT_TRACE_H
+
+#include <linux/io.h>
+
+/*
+ * Valid only until paging_init() replaces the temporary 0xcff00000 mapping
+ * installed by __create_page_tables. The mapped memory is uncached.
+ */
+static inline void k4_trace_early(unsigned int index, const char *tag)
+{
+	u8 __iomem *log = (u8 __iomem *)0xcfffe000;
+	u8 __iomem *line = log + index * 96;
+	u8 __iomem *meta = log + 8192 - 96;
+	unsigned int i;
+
+	for (i = 0; tag[i]; i++)
+		writeb(tag[i], line + i);
+	writeb(0, line + i);
+	writel(0, meta + 4);
+	writel(index + 1, meta + 8);
+	wmb();
+	writel(0xbeadeabe, meta);
+	mb();
+}
+
+#endif
