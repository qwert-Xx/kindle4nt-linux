+++ b/drivers/soc/imx/k4-pm-trace.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Temporary diagnostics: keep the last 32 PM trace events across reset. */
+#include <linux/device.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/k4_ram_trace.h>
+#include <linux/module.h>
+#include <linux/of_address.h>
+#include <linux/panic_notifier.h>
+#include <linux/spinlock.h>
+#include <trace/events/power.h>
+
+#define K4_LOG_BASE 0x7fffe000
+#define K4_LOG_SIZE 8192
+#define K4_LINE_SIZE 96
+#define K4_FIRST_SLOT 48
+#define K4_SLOT_COUNT 32
+/* Slot 64 was partially overwritten across a stock-kernel reboot. */
+#define K4_SKIP_SLOT 64
+#define K4_END_SLOT (K4_FIRST_SLOT + K4_SLOT_COUNT + 1)
+#define K4_LEGACY_SLOTS 84
+
+static bool enabled;
+static bool ready;
+module_param(enabled, bool, 0600);
+MODULE_PARM_DESC(enabled, "Record PM callbacks in K4 reserved reboot RAM");
+static void __iomem *ram_log;
+static DEFINE_RAW_SPINLOCK(ram_lock);
+static unsigned int sequence;
+
+static int record(const char *event)
+{
+	char line[K4_LINE_SIZE] = {0};
+	unsigned long flags;
+	void __iomem *meta;
+	unsigned int slot;
+
+	if (!smp_load_acquire(&ready))
+		return -ENODEV;
+	if (!READ_ONCE(enabled))
+		return -EACCES;
+	raw_spin_lock_irqsave(&ram_lock, flags);
+	slot = K4_FIRST_SLOT + sequence % K4_SLOT_COUNT;
+	if (slot >= K4_SKIP_SLOT)
+		slot++;
+	scnprintf(line, sizeof(line), "K4_PM %06u %s\n", sequence++, event);
+	memcpy_toio(ram_log + slot * K4_LINE_SIZE, line, sizeof(line));
+	wmb();
+	meta = ram_log + K4_LOG_SIZE - K4_LINE_SIZE;
+	/* Repair malformed metadata, including older bootmark's END=84 bug. */
+	if (readl(meta) != 0xbeadeabe ||
+	    readl(meta + 4) >= K4_LEGACY_SLOTS ||
+	    readl(meta + 8) >= K4_LEGACY_SLOTS) {
+		writel(0, meta + 4);
+		writel(K4_END_SLOT, meta + 8);
+	} else if (readl(meta + 8) < K4_END_SLOT) {
+		writel(K4_END_SLOT, meta + 8);
+	}
+	wmb();
+	writel(0xbeadeabe, meta);
+	mb();
+	raw_spin_unlock_irqrestore(&ram_lock, flags);
+	return 0;
+}
+
+int k4_ram_trace_mark(const char *event)
+{
+	return record(event);
+}
+EXPORT_SYMBOL_GPL(k4_ram_trace_mark);
+
+static void callback_start(void *unused, struct device *dev,
+			   const char *ops, int event)
+{
+	char message[80];
+
+	scnprintf(message, sizeof(message), "C> %s %s %s event=%x",
+		  dev_name(dev), dev_driver_string(dev), ops ?: "", event);
+	record(message);
+}
+
+static void callback_end(void *unused, struct device *dev, int error)
+{
+	char message[80];
+
+	scnprintf(message, sizeof(message), "C< %s rc=%d", dev_name(dev), error);
+	record(message);
+}
+
+static void phase(void *unused, const char *action, int value, bool start)
+{
+	char message[80];
+
+	scnprintf(message, sizeof(message), "P%c %s value=%d",
+		  start ? '>' : '<', action, value);
+	record(message);
+}
+
+static int panic_record(struct notifier_block *nb, unsigned long code, void *data)
+{
+	char message[80];
+
+	scnprintf(message, sizeof(message), "PANIC %s", (char *)data);
+	record(message);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block panic_nb = {
+	.notifier_call = panic_record,
+};
+
+static int __init k4_pm_trace_init(void)
+{
+	struct device_node *node;
+	struct resource res;
+	int ret;
+
+	if (!of_machine_is_compatible("amazon,kindle-4"))
+		return -ENODEV;
+	node = of_find_node_by_path("/reserved-memory/watchdog-log@7fffe000");
+	if (!node)
+		return -ENODEV;
+	ret = of_address_to_resource(node, 0, &res);
+	if (!of_property_read_bool(node, "no-map"))
+		ret = -EINVAL;
+	of_node_put(node);
+	if (ret)
+		return ret;
+	if (res.start != K4_LOG_BASE || resource_size(&res) != K4_LOG_SIZE)
+		return -EINVAL;
+	ram_log = ioremap(K4_LOG_BASE, K4_LOG_SIZE);
+	if (!ram_log)
+		return -ENOMEM;
+	memset_io(ram_log + K4_FIRST_SLOT * K4_LINE_SIZE, 0,
+		  (K4_SKIP_SLOT - K4_FIRST_SLOT) * K4_LINE_SIZE);
+	memset_io(ram_log + (K4_SKIP_SLOT + 1) * K4_LINE_SIZE, 0,
+		  (K4_END_SLOT - K4_SKIP_SLOT - 1) * K4_LINE_SIZE);
+	ret = register_trace_device_pm_callback_start(callback_start, NULL);
+	if (ret)
+		goto unmap;
+	ret = register_trace_device_pm_callback_end(callback_end, NULL);
+	if (ret)
+		goto unregister_start;
+	ret = register_trace_suspend_resume(phase, NULL);
+	if (ret)
+		goto unregister_end;
+	ret = atomic_notifier_chain_register(&panic_notifier_list, &panic_nb);
+	if (ret)
+		goto unregister_phase;
+	smp_store_release(&ready, true);
+	pr_info("K4 PM RAM trace available (enabled=%d)\n", enabled);
+	return 0;
+
+unregister_phase:
+	unregister_trace_suspend_resume(phase, NULL);
+unregister_end:
+	unregister_trace_device_pm_callback_end(callback_end, NULL);
+unregister_start:
+	unregister_trace_device_pm_callback_start(callback_start, NULL);
+	tracepoint_synchronize_unregister();
+unmap:
+	iounmap(ram_log);
+	return ret;
+}
+late_initcall(k4_pm_trace_init);
+MODULE_LICENSE("GPL");
