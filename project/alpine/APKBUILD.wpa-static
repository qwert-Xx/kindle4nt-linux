# SPDX-License-Identifier: GPL-2.0-or-later
# K4 local package: wrap the already validated static 2.12 build.
# Binary inputs come from project/userspace/wifi.sh; no musl recompilation.
pkgname=wpa_supplicant
pkgver=2.12
pkgrel=0 # K4 local package revision, source selected by @k4 repository tag.
pkgdesc="K4 verified static wpa_supplicant with aborted scan retry patch"
url="https://w1.fi/wpa_supplicant/"
arch="armv7"
license="BSD-3-Clause"
options="!check !strip" # host policy tests recorded separately; preserve accepted bytes.
source="wpa_supplicant wpa_cli COPYING"
package() {
    install -Dm755 "$srcdir/wpa_supplicant" "$pkgdir/sbin/wpa_supplicant"
    install -Dm755 "$srcdir/wpa_cli" "$pkgdir/sbin/wpa_cli"
    install -Dm644 "$srcdir/COPYING" "$pkgdir/usr/share/licenses/wpa_supplicant/COPYING"
}
